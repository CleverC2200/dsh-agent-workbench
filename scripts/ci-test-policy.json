{
  "schemaVersion": 1,
  "required": ["tests/official-entry.test.mjs", "tests/workbench-recovery.test.mjs"],
  "tests": [
    "tests/*.test.mjs",
    "tests/*.browser.mjs",
    "scripts/*.test.mjs",
    "business/inventory-fc/source/inventory-light-plugins/tests/*.test.mjs",
    "business/inventory-apsplan/source/tests/data/*.test.mjs",
    "tests/final-group-input.contract.mjs"
  ],
  "rules": [
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^src/(?:workbench/api-log|business-views|workbench/page)|^tests/api-log",
      "tests": ["tests/api-log-center.browser.mjs", "tests/api-log-batch.browser.mjs"]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^src/(?:host\\.ts|host/(?:api-log|business|debug-run))",
      "tests": ["tests/api-log-center.browser.mjs", "tests/api-log-batch.browser.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/task-status\\.mjs$",
      "tests": ["tests/task-status.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^(?:package\\.json|package-lock\\.json|tsconfig|\\.github/)",
      "tests": [
        "tests/quality-ci.test.mjs",
        "tests/candidate-input.test.mjs",
        "tests/quality-cli.test.mjs",
        "tests/ci-test-plan.test.mjs",
        "tests/final-group-input.contract.mjs"
      ],
      "exclusive": true
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/(?:build|build-inventory|build-inventory-fc)\\.mjs$",
      "tests": ["tests/core-resource-build.test.mjs", "tests/inventory-storage-build.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^business/inventory-fc/|^business/shared/",
      "tests": ["tests/inventory-storage-build.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^(?:static|theme|src/company)/",
      "tests": ["tests/frame-layout.browser.mjs"]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^(?:src|scripts|presets|default-presets)/",
      "tests": ["tests/hosted-peer-input.test.mjs"]
    },
    {
      "repo": "dsh-agent-manage",
      "pattern": "^(?:src|scripts|business-resources)/",
      "tests": ["tests/candidate-input.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^src/workbench/original/workbenches/regionalApproval/(?:RegionalApproval(?:ActionDialog|LiveAdjustmentDialog)\\.tsx|RegionalApprovalPlanDetail\\.(?:tsx|module\\.css)|regionalApproval(?:ActionModel|DetailFixture|DetailModel|Fixture|Model)\\.ts|models/salesPlanAdjustmentModel\\.ts)$",
      "tests": [
        "tests/sales-plan-detail.browser.mjs",
        "tests/role-approval.test.mjs",
        "tests/approval-visibility.test.mjs",
        "tests/regional-state-restore.test.mjs"
      ]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/",
      "tests": ["tests/quality-ci.test.mjs", "tests/candidate-input.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/(?:run-quality-fast|check-agent-knowledge)\\.mjs$",
      "tests": ["tests/quality-knowledge.test.mjs", "tests/agent-knowledge.test.mjs"]
    }
  ]
}
