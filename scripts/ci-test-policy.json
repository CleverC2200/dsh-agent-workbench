{
  "schemaVersion": 1,
  "required": ["tests/official-entry.test.mjs", "tests/workbench-recovery.test.mjs"],
  "tests": [
    "tests/*.test.mjs",
    "tests/*.browser.mjs",
    "scripts/*.test.mjs",
    "business/inventory-fc/source/inventory-light-plugins/tests/*.test.mjs",
    "business/inventory-apsplan/source/tests/data/*.test.mjs",
    "tests/final-group-input.contract.mjs"
  ],
  "sourceFixtures": {
    "scripts/source-quality.test.mjs": {
      "dependencies": false
    },
    "tests/ci-test-plan.test.mjs": {
      "dependencies": false
    },
    "tests/quality-ci.test.mjs": {
      "dependencies": false
    },
    "tests/source-checks.test.mjs": {
      "dependencies": false
    },
    "tests/source-typecheck.test.mjs": {
      "dependencies": true
    }
  },
  "rules": [
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^src/workbench/original/workbenches/regionalApproval/models/salesPlanCorrectionModel\\.ts$",
      "tests": ["tests/sales-plan-legacy-exports.test.mjs", "tests/correction-rules.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/build\\.mjs$",
      "tests": ["tests/core-resource-build.test.mjs", "tests/plugin-package-version.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^business/inventory-(?:apsplan|aqkc|dealer|fc|qll)/(?:source/|theme\\.css$)|^business/shared/.*\\.css$",
      "tests": [
        "tests/agent-authored-layout.browser.mjs",
        "tests/agent-responsive-layout.browser.mjs"
      ]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^(?:prototypes/inventory-customer/|scripts/build-customer-prototype\\.mjs$|src/frame-presenter\\.tsx$|business/shared/(?:channel\\.js|sql-reader\\.ts|query-error\\.js)$)",
      "tests": [
        "tests/customer-inventory-loading.browser.mjs",
        "tests/customer-inventory-data-source.test.mjs"
      ]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^src/(?:workbench/api-log|business-views|workbench/page)|^tests/api-log",
      "tests": ["tests/api-log-center.browser.mjs", "tests/api-log-batch.browser.mjs"]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^src/(?:host\\.ts|host/(?:api-log|business|debug-run))",
      "tests": ["tests/api-log-center.browser.mjs", "tests/api-log-batch.browser.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/task-status\\.mjs$",
      "tests": ["tests/task-status.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^(?:package\\.json|package-lock\\.json|tsconfig|\\.github/)",
      "tests": [
        "tests/quality-ci.test.mjs",
        "tests/candidate-input.test.mjs",
        "tests/quality-cli.test.mjs",
        "tests/ci-test-plan.test.mjs",
        "tests/final-group-input.contract.mjs"
      ],
      "exclusive": true
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/(?:build|build-inventory|build-inventory-fc)\\.mjs$",
      "tests": ["tests/core-resource-build.test.mjs", "tests/inventory-storage-build.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^business/inventory-fc/|^business/shared/",
      "tests": ["tests/inventory-storage-build.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^(?:static|theme|src/company)/",
      "tests": ["tests/frame-layout.browser.mjs"]
    },
    {
      "repo": "dsh-gea-plugin",
      "pattern": "^(?:src|scripts|presets|default-presets)/",
      "tests": ["tests/hosted-peer-input.test.mjs"]
    },
    {
      "repo": "dsh-agent-manage",
      "pattern": "^(?:src|scripts|business-resources)/",
      "tests": ["tests/candidate-input.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^src/workbench/original/workbenches/regionalApproval/(?:RegionalApproval(?:ActionDialog|LiveAdjustmentDialog)\\.tsx|RegionalApprovalPlanDetail\\.(?:tsx|module\\.css)|regionalApproval(?:ActionModel|DetailFixture|DetailModel|Fixture|Model)\\.ts|models/salesPlanAdjustmentModel\\.ts)$",
      "tests": [
        "tests/sales-plan-detail.browser.mjs",
        "tests/role-approval.test.mjs",
        "tests/approval-visibility.test.mjs",
        "tests/regional-state-restore.test.mjs"
      ]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/",
      "tests": ["tests/quality-ci.test.mjs", "tests/candidate-input.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/(?:run-quality-fast|check-agent-knowledge)\\.mjs$",
      "tests": ["tests/quality-knowledge.test.mjs", "tests/agent-knowledge.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/(?:agent_sql\\.py|test_agent_sql\\.py|requirements-sql\\.txt|build_deep_query_configs\\.py|update-inventory-batch-source\\.py)$|^business/inventory-(?:aqkc|fc|qll|apsplan|dealer)/sql\\.config\\.json$",
      "tests": ["tests/agent-sql-direct.test.mjs", "tests/agent-sql-config.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^business/inventory-(?:aqkc|fc|qll|apsplan|dealer)/sql\\.config\\.json$",
      "tests": [
        "tests/configured-channel.test.mjs",
        "tests/gea-page-limit.test.mjs",
        "tests/five-agent-supplement.test.mjs",
        "tests/page-runtime.test.mjs"
      ]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^business/inventory-(?:fc|qll|dealer)/sql\\.config\\.json$",
      "tests": [
        "tests/configured-facts.test.mjs",
        "tests/restored-workbench.test.mjs",
        "tests/summary-query-performance.test.mjs",
        "tests/overview-progress.test.mjs"
      ]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^business/inventory-(?:aqkc|fc|qll|dealer)/sql\\.config\\.json$",
      "tests": ["tests/original-field-parity.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^business/inventory-(?:qll|dealer)/sql\\.config\\.json$",
      "tests": ["tests/inventory-pc-layout.browser.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^business/inventory-dealer/sql\\.config\\.json$",
      "tests": ["tests/dealer-page-reception.test.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/(?:run-quality-ci|build)\\.mjs$",
      "tests": ["tests/agent-authored-layout.browser.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^business/inventory-qll/source/inventory-light-plugins/src/pages/configured-workbench\\.tsx$",
      "tests": ["tests/agent-authored-layout.browser.mjs"]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^(?:scripts/(?:source-quality|source-checks|ci-test-plan)\\.mjs|\\.github/workflows/source-quality\\.yml)$",
      "sourceTests": ["scripts/source-quality.test.mjs", "tests/source-checks.test.mjs", "tests/source-typecheck.test.mjs", "tests/ci-test-plan.test.mjs"],
      "tests": [
        "scripts/source-quality.test.mjs",
        "tests/source-checks.test.mjs",
        "tests/source-typecheck.test.mjs",
        "tests/ci-test-plan.test.mjs"
      ]
    },
    {
      "repo": "dsh-agent-workbench",
      "pattern": "^scripts/(?:run-quality-ci|ci-test-policy)\\.(?:mjs|json)$",
      "tests": [],
      "sourceTests": [
        "tests/quality-ci.test.mjs",
        "tests/ci-test-plan.test.mjs"
      ]
    }
  ]
}
