{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["DOM", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "dsh-agent-manage/aps-compute/*": ["../../../../dsh-agent-manage/src/aps-compute/*.ts"],
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "components/ui/table.tsx", "lib/utils.ts"]
}
