{
  "name": "@cleverc2200/dsh-agent-workbench",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Shared Agent workbench layout for unmodified DeepSeek Harness",
  "exports": {
    ".": {
      "types": "./lib/types/host.d.ts",
      "default": "./lib/host.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./workbench": {
      "types": "./lib/types/workbench.d.ts"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./page-interaction/client": {
      "types": "./lib/types/page-interaction/client.d.ts",
      "default": "./lib/page-interaction/client.js"
    },
    "./page-interaction/picker": {
      "types": "./lib/types/page-interaction/picker.d.ts",
      "default": "./lib/page-interaction/picker.js"
    },
    "./page-interaction/bridge": {
      "types": "./lib/types/page-interaction/page-bridge/client.d.ts",
      "default": "./lib/page-interaction/page-bridge/client.js"
    },
    "./page-interaction/reference": {
      "types": "./lib/types/page-interaction/reference.d.ts",
      "default": "./lib/page-interaction/reference.js"
    },
    "./page-interaction/protocol": {
      "types": "./lib/types/page-interaction/page-bridge/protocol.d.ts",
      "default": "./lib/page-interaction/page-bridge/protocol.js"
    },
    "./page-interaction/inject": {
      "types": "./lib/types/page-interaction/inject.d.ts",
      "default": "./lib/page-interaction/inject.js"
    },
    "./page-interaction/payload-budget": {
      "types": "./lib/types/page-interaction/shared/payload-budget.d.ts",
      "default": "./lib/page-interaction/shared/payload-budget.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "@deepseek-ai/dsh-client-store"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE",
    "UPSTREAM.md",
    "cordis.patch.yml",
    "theme/"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "node --test tests/*.test.mjs business/inventory-fc/source/inventory-light-plugins/tests/*.test.mjs",
    "build:core": "node scripts/build.mjs --target core",
    "typecheck:official": "node scripts/verify-official-input.mjs && tsc -p tsconfig.official.json --noEmit --emitDeclarationOnly false"
  },
  "repository": {
    "type": "git",
    "url": "http://100.100.6.191:20656/chenyonghao/dsh-agent-workbench.git"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@types/node": "24.3.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "0.25.9",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-grab": "0.2.0",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.11.0"
}
