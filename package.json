{
  "name": "@cleverc2200/dsh-agent-workbench",
  "version": "0.1.27",
  "private": true,
  "type": "module",
  "description": "提供统一的智能体工作台布局，连接业务页面与会话。",
  "exports": {
    ".": {
      "types": "./lib/types/host.d.ts",
      "default": "./lib/host.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./workbench": {
      "types": "./lib/types/workbench.d.ts"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./page-interaction/client": {
      "types": "./lib/types/page-interaction/client.d.ts",
      "default": "./lib/page-interaction/client.js"
    },
    "./page-interaction/picker": {
      "types": "./lib/types/page-interaction/picker.d.ts",
      "default": "./lib/page-interaction/picker.js"
    },
    "./page-interaction/bridge": {
      "types": "./lib/types/page-interaction/page-bridge/client.d.ts",
      "default": "./lib/page-interaction/page-bridge/client.js"
    },
    "./page-interaction/reference": {
      "types": "./lib/types/page-interaction/reference.d.ts",
      "default": "./lib/page-interaction/reference.js"
    },
    "./page-interaction/protocol": {
      "types": "./lib/types/page-interaction/page-bridge/protocol.d.ts",
      "default": "./lib/page-interaction/page-bridge/protocol.js"
    },
    "./page-interaction/inject": {
      "types": "./lib/types/page-interaction/inject.d.ts",
      "default": "./lib/page-interaction/inject.js"
    },
    "./page-interaction/payload-budget": {
      "types": "./lib/types/page-interaction/shared/payload-budget.d.ts",
      "default": "./lib/page-interaction/shared/payload-budget.js"
    },
    "./notifications": {
      "types": "./lib/types/shared/notifications.d.ts",
      "default": "./lib/shared/notifications.js"
    },
    "./sales-plan": {
      "types": "./lib/types/sales-plan.d.ts",
      "default": "./lib/sales-plan.js"
    },
    "./api-log": {
      "types": "./lib/types/workbench/api-log-contract.d.ts"
    },
    "./dms-mock": "./lib/prototypes/dms/model.js",
    "./locale/*.json": "./locale/*.json",
    "./configured-query": {
      "types": "./lib/configured-query-client.d.mts",
      "default": "./lib/configured-query-client.mjs"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "external": [
        "@deepseek-ai/dsh-client-store",
        "react-dom",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE",
    "UPSTREAM.md",
    "cordis.patch.yml",
    "theme/",
    "locale/"
  ],
  "license": "MIT",
  "scripts": {
    "check:knowledge": "node scripts/check-agent-knowledge.mjs --root . --config agent-knowledge.json",
    "candidate:verify": "node scripts/verify-candidate-input.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/generate-plugin-package-version.mjs --check && tsc --noEmit --emitDeclarationOnly false",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs business/inventory-fc/source/inventory-light-plugins/tests/*.test.mjs",
    "build:core": "node scripts/build.mjs --target core",
    "typecheck:official": "npm run check:official-input && tsc -p tsconfig.official.json --noEmit --emitDeclarationOnly false",
    "test:browser": "node --test --test-concurrency=1 tests/*.browser.mjs",
    "test:aps": "node --test business/inventory-apsplan/source/tests/data/*.test.mjs tests/aps-*.test.mjs",
    "lint": "node scripts/quality.mjs lint --changed",
    "lint:audit": "node scripts/quality.mjs lint-audit",
    "format:check": "node scripts/quality.mjs format --changed",
    "format:audit": "node scripts/quality.mjs format-audit",
    "test:ci": "node --test --test-concurrency=2 tests/*.test.mjs business/inventory-fc/source/inventory-light-plugins/tests/*.test.mjs scripts/run-quality-checks.test.mjs business/inventory-apsplan/source/tests/data/*.test.mjs",
    "test:quality": "node --test scripts/run-quality-checks.test.mjs tests/quality-cli.test.mjs tests/quality-ci.test.mjs tests/hosted-peer-input.test.mjs tests/quality-knowledge.test.mjs tests/candidate-input.test.mjs tests/migration-history-input.test.mjs",
    "test:final-group": "node --test tests/final-group-input.contract.mjs",
    "quality:fast": "node scripts/run-quality-fast.mjs",
    "quality:ci": "node scripts/run-quality-ci.mjs",
    "test:api-log": "node --test --test-concurrency=1 tests/api-log-center.browser.mjs tests/api-log-batch.browser.mjs",
    "check:official-input": "node scripts/generate-plugin-package-version.mjs --check && node scripts/verify-official-input.mjs"
  },
  "repository": {
    "type": "git",
    "url": "http://100.100.6.191:20656/chenyonghao/dsh-agent-workbench.git"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-storage-domain": "file:../../official-latest-standard/packages/storage/storage-domain",
    "@deepseek-ai/cordis": "file:../../official-latest-standard/vendor/cordis",
    "@deepseek-ai/dsh-api-remotes": "file:../../official-latest-standard/packages/api/remotes",
    "@deepseek-ai/dsh-api-session-controller": "file:../../official-latest-standard/packages/api/session-controller",
    "@deepseek-ai/dsh-api-workspace-controller": "file:../../official-latest-standard/packages/api/workspace-controller",
    "@deepseek-ai/dsh-brand": "file:../../official-latest-standard/packages/util/brand",
    "@deepseek-ai/dsh-client-connection": "file:../../official-latest-standard/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "file:../../official-latest-standard/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "file:../../official-latest-standard/packages/client/store",
    "@deepseek-ai/dsh-client-ui-layout": "file:../../official-latest-standard/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-renderer": "file:../../official-latest-standard/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "file:../../official-latest-standard/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-slots": "file:../../official-latest-standard/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-theme": "file:../../official-latest-standard/packages/client/ui-theme",
    "@deepseek-ai/dsh-session": "file:../../official-latest-standard/packages/core/session",
    "@types/node": "24.3.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "0.25.9",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-grab": "0.2.0",
    "typescript": "5.9.3",
    "@arco-design/web-react": "2.66.1",
    "@icon-park/react": "1.4.2",
    "i18next": "23.7.16",
    "xlsx-republish": "0.20.3",
    "decimal.js": "10.6.0",
    "clsx": "2.1.1",
    "@deepseek-ai/dsh-tools": "file:../../official-latest-standard/packages/core/tools",
    "@deepseek-ai/dsh-agent": "file:../../official-latest-standard/packages/core/agent",
    "@playwright/test": "1.58.2",
    "@deepseek-ai/dsh-agent-preset-registry": "file:../../official-latest-standard/packages/preset/agent-preset-registry",
    "@deepseek-ai/dsh-client-ui-conversation": "file:../../official-latest-standard/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-input-trigger": "file:../../official-latest-standard/packages/client/ui-input-trigger",
    "@deepseek-ai/dsh-client-ui-settings": "file:../../official-latest-standard/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-sidebar": "file:../../official-latest-standard/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-workspace": "file:../../official-latest-standard/packages/client/ui-workspace",
    "@deepseek-ai/dsh-client-ui-primitives": "file:../../official-latest-standard/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-chat": "file:../../official-latest-standard/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "file:../../official-latest-standard/packages/client/ui-sidebar-right",
    "oxlint": "1.87.0",
    "oxfmt": "0.72.0",
    "lucide-react": "1.31.0"
  },
  "packageManager": "npm@11.11.0"
}
