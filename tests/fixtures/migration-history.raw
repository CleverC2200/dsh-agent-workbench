{"dealer":{"commit":"67e1007aa400a8a9c65c132f144dabd5168a49df","files":{"source/README.md":{"blob":"f75bceccbac7796e69ffff905f3ffa2c6d03c9b2","sha256":"a88d22adbc2d1cef29b5f3ca5381a85559fbd185bd9673ba85836d520639f229","text":"# 开发源码快照\n\n收录本轮实际构建的第一方页面、业务计算、样式和公共桥接源码，以及构建打包脚本。SNAPSHOT.json 为本轮来源清单。\n运行包已经可独立交付；此源码快照仍依赖原开发工作区目录结构，不宣称独立 CI 构建就绪。外部 DSH 源码保存在 workspace-dependencies 下供审阅，构建时需恢复工作区相对布局。无凭据或真实业务数据。\n"},"source/SNAPSHOT.json":{"blob":"595b9cec3cf6a91650de79965135e006cb5ca370","sha256":"d38a811f6d836bec392bc9321e6f5524970230f970ef83a6115d0fd2b2b4afd1","text":"{\n  \"plugin\": \"dealer\",\n  \"version\": \"0.2.6-preview.6\",\n  \"files\": {\n    \"README.md\": \"a88d22adbc2d1cef29b5f3ca5381a85559fbd185bd9673ba85836d520639f229\",\n    \"inventory-light-plugins/DELIVERY.md\": \"4e2b4faa489f75edcca6503c758afd540b02b2f39ba6897e7246fcccbc7d1e5e\",\n    \"inventory-light-plugins/README.md\": \"a9a127a7ecdea37bf262fd71717e082b1a2a407248a301dfdeb9c56333a1be47\",\n    \"inventory-light-plugins/package.json\": \"70501fccc61ea28053f47e994da28cfa5fd80679b728b794710f5fb166032e9f\",\n    \"inventory-light-plugins/pnpm-lock.yaml\": \"03f31afab0b1bb07d95136aa3fa088a2b09400643b051146de9c8e2f5b53b906\",\n    \"inventory-light-plugins/build/build.mjs\": \"3b31c1b07d19d17f8e5011de7eb5bf3dcaf88d4558787845351b3baec4b26c53\",\n    \"inventory-light-plugins/build/frontend-boundary.mjs\": \"62cfb94e8d69e33d25e877981501e987f5723d64942611a626dc028615ff5112\",\n    \"inventory-light-plugins/build/package.mjs\": \"42ef2c9ea6112e62edb12d90e4da5ae509c697431914762590c82b00515ec524\",\n    \"inventory-light-plugins/build/qll-regression.test.mjs\": \"2240968e3c47dd7ef4ecc79f769a4b0da252613957b90c24954ebba901635d23\",\n    \"inventory-light-plugins/build/typecheck-pages.mjs\": \"3b74113267ad3d2e22675663a5c3eb08f36fc00146f48532749677f729515eda\",\n    \"inventory-light-plugins/build/verify-packages.mjs\": \"f6f4212db435cba59fc3d11833cc9b5605bca59e2601da1989e618f4ce1348b2\",\n    \"inventory-light-plugins/src/aqkc-transfer.ts\": \"e7391c65cacb999fd387b4ca6e89b5c9994b19c68e40ad68d3b913029b952edc\",\n    \"inventory-light-plugins/src/channel.js\": \"41ec894972f85b02b1dadec5b24c15c99e93f07341a3a320666dc44b27f34bed\",\n    \"inventory-light-plugins/src/data.ts\": \"bd0a4db6d10ae45f812552e9253a3664fe4a76a14a82b4ddf8f9188a0c6d58d1\",\n    \"inventory-light-plugins/src/dealer-draft.ts\": \"5b60dc7a1678d14a0ae073e6450b2d73f7392c0172de08b88ca2d7bc44a648a8\",\n    \"inventory-light-plugins/src/dealer-engine.ts\": \"dcdd73a3c146a8ecc021583ba400164aea19efb63d2b8092cd49cef937ab9031\",\n    \"inventory-light-plugins/src/dealer-order.ts\": \"046d227ee59030da760de7d075c605b5891ccf3e071bf40caff8aed530cd1fd0\",\n    \"inventory-light-plugins/src/platform-pending.ts\": \"edba04c342397b24be9d38ecff1bd04a5408b6e1133cf09fc4869ea6823707c5\",\n    \"dealer/config/biz-rules/exceptions.json\": \"a950ce3fde8ff2e660018ed35a14a4f99a3d3612e55b5cdc7bb5422d26d74fa2\",\n    \"dealer/config/biz-rules/filter-labels.json\": \"49d845c72cc300e87ad92729a1fa3ef98d3e98a517c10fd8b13bfb87a2a0ecf2\",\n    \"dealer/config/biz-rules/fuse-rules.json\": \"42c6219ce965250765e28c24ba0ae4ac2eec726c00b39606073ebd278622c923\",\n    \"dealer/config/biz-rules/metric-cards.json\": \"80b51e5c5613730bb8965527bed5701dee45a24244bf4e2fab7df92edd2d659d\",\n    \"dealer/config/biz-rules/report-templates.json\": \"af0fa90edd4a3440c2b209170514c05e8f81a6af3112d4f761963e82ad859a8f\",\n    \"dealer/config/biz-rules/split-params.json\": \"72764fbffba55b45714a6a780fac2c16c819feb3fcc278029f224b5995794817\",\n    \"dealer/config/biz-rules/stock-health.json\": \"5e11248581ced9ac9c1da38c8a401211c292e709977b285c6584fd4864cd407d\",\n    \"inventory-light-plugins/src/dsh-ui/Button.module.css\": \"0b6fc685b366edacbb549dbac46601534c4b86902377ccb56d7fda43737272c9\",\n    \"inventory-light-plugins/src/dsh-ui/DshButton.tsx\": \"fb45bad260a59a51359a80262abd619d44d439f0825230f157303eb1cf391a18\",\n    \"inventory-light-plugins/src/dsh-ui/base.css\": \"e834b61874dc4b2dcbd671323fd6ff00ba3d7fc81d8d4270d4fa5b295fa939d2\",\n    \"inventory-light-plugins/src/dsh-ui/controls.module.css\": \"d41567d543907b929f6f4e108ec36a6991d73a764458988a34a8156d2e460864\",\n    \"inventory-light-plugins/src/dsh-ui/controls.tsx\": \"49318b6eb3bd1718fde4c8734400bc60654243a2634a966f0c621ad86023caa5\",\n    \"inventory-light-plugins/src/dsh-ui/workbench-loading.module.css\": \"5d0d3a34ccc20bc6e81d6ebd3514d73d5f836abaadf178f3d4cf80b1c3d16c11\",\n    \"inventory-light-plugins/src/dsh-ui/workbench-loading.tsx\": \"d94c28fcfdbf295b7c10957f7a086e32eddb2083f51f03b830cb1eb401af6899\",\n    \"inventory-light-plugins/src/governed/batch.ts\": \"ae81797a3c464262c3f601eb85d8b11c2bfdb956a19cece174ceb1ccfbd375f1\",\n    \"inventory-light-plugins/src/governed/columnar.ts\": \"81c248c74238004ede74b1ab17319f31323c2c2556b2a9291d104704d0efbb52\",\n    \"inventory-light-plugins/src/governed/parameters.ts\": \"780117245df97ff507ab4ec5e251cb2317fd39136b7df7e0ec2d0af734ec3e10\",\n    \"inventory-light-plugins/src/governed/qll-projections.json\": \"6647ce7e80ba7aa9175add4024872d3df5ec557c05e6aeb68f9ed2537d9e7ea4\",\n    \"inventory-light-plugins/src/native/api.ts\": \"a28fa9be4569bdb847694f4760d67b567964afcb93f57dd4b2e119a84d0ecc52\",\n    \"inventory-light-plugins/src/native/context.ts\": \"f911ace5d2feb140150b13430730289a105d525a6bf11b4af0840916be280ec8\",\n    \"inventory-light-plugins/src/native/dealer.tsx\": \"71fbe6ede12bbeb6407c94b3e3806341d4220a9891ff47ddd5a1e50d138671a2\",\n    \"inventory-light-plugins/src/native/entry.tsx\": \"84c1242fe2fd4c52fe41e34a1e0f87cc65cdb89647d7a5aca7cfd7e719879604\",\n    \"inventory-light-plugins/src/native/page-filter.tsx\": \"c02645406e124c6e473ec5126e3e5a87bfedd44be182680311aa1b670a92fbba\",\n    \"dealer/web/src/contracts/dealer-inventory-cube.json\": \"de48e3b5994f96b9b852ba1cdc9f24f8cb931fbf9e57b5af1b6917e57198c9b6\",\n    \"dealer/web/src/lib/dealer-dashboard.ts\": \"7e6aae3dcf45191ae46febc6a54235ec8e27dd06fd56b2dd2cabe8141813e960\",\n    \"dealer/web/src/lib/dealer-demo-live-data.ts\": \"6b89c1461182db4b933e0673506404b7747a05bf4572f00c2618d5c9976de3cd\",\n    \"dealer/web/src/lib/dealer-overview-facts.ts\": \"55db967b3a1e9f43c42801d0c5a498821595c8969ac9df4741d35b0d9bb052ee\",\n    \"dealer/web/src/lib/dealer-promotion-policy.ts\": \"0f6e076d4e1c646757844423bde01b67172f811ca4f4c38a6382e134e05952f3\",\n    \"dealer/web/src/lib/dealer-status-filters.ts\": \"cbf3022fe0bf52c26b1a33c415dc69aeedca6611af31b739b3118a69cd812344\",\n    \"dealer/web/src/lib/dealer-workbench-sql.ts\": \"51fe1dfa68d6870044124196debf59fc6c80e3112a545cde396334069ee45830\",\n    \"dealer/web/src/lib/inventory-date-label.ts\": \"4cfa757a73339ec1899d04a2dbebe378623b66b955f0ec61bb45721af82facd7\",\n    \"inventory-light-plugins/src/governed/modules/aqkc-report.ts\": \"f3a743d05e70fb48c2303927026d65654d10e831bb34485add51c8c6d848917c\",\n    \"inventory-light-plugins/src/governed/modules/fc-engine.ts\": \"4cf94a45d6c52698d490f7f6553543320bbd4a639b752d0f5079a9e7d6204cd6\",\n    \"inventory-light-plugins/src/governed/modules/personal-daily.json\": \"11b02c4f96fe3a923e475f31b811704d3783c4badce726696cb186bb710a8441\",\n    \"inventory-light-plugins/src/governed/modules/plan-product-metadata.ts\": \"fd6f35964d8e0672b84f35169bf713c90c2ef75c2a132393350c352176e4e09a\",\n    \"inventory-light-plugins/src/governed/modules/postgres-adapter.ts\": \"c0508f19a782b9d4d37f35e6fba8e9fdf71bb19176a22fc23f2c3ed2c4a71122\",\n    \"inventory-light-plugins/src/governed/modules/warehouse-catalog.ts\": \"48dba514a39a30c79d94ca46462f73f1e2a93c3b0d2eaa49de0fbf4a01001d67\",\n    \"inventory-light-plugins/src/governed/modules/warehouse-snapshot.ts\": \"7750435c48424dde829150d4fbc75baf01622b8b36220679aa0c50c62d204432\",\n    \"inventory-light-plugins/src/pages/dealer/overview.tsx\": \"28e8c1fb67923843dc6fb4cab7a51a7b42ecee5f0b7e78c6b2a44986dcdc0289\",\n    \"inventory-light-plugins/src/pages/dealer/workbench.module.css\": \"b9609e7a6688fba5adcccf0eaed41804a42e062e8b5d46ded6189e0e0c7b7260\",\n    \"inventory-light-plugins/src/query-error.js\": \"f6535b2b354b3625e288e46d904cf44edd03b1b18a27a1010d4acb3dba485df6\",\n    \"inventory-light-plugins/tests/query-error.test.mjs\": \"6f80e30aa987d09f7ea17be8c67c5c1bb776b3461e7d3ab7fd69cd98bcb86c20\"\n  }\n}\n"},"source/dealer/config/biz-rules/exceptions.json":{"blob":"fc3a6028e16481aa350d1a64f50d780bcfebedfe","sha256":"a950ce3fde8ff2e660018ed35a14a4f99a3d3612e55b5cdc7bb5422d26d74fa2","text":"{\n  \"version\": \"1\",\n  \"updatedAt\": \"2026-08-10\",\n  \"status\": \"生效\",\n  \"priority\": [\"customer_sku\", \"sku\", \"customer\", \"default\"],\n  \"exceptions\": [],\n  \"note\": \"客户/SKU 业务例外表（业务维护规则包 3.4）：对象层级 customer_sku/sku/customer，命中条件为不可下单、暂缓、控货、停用、下市等；精确匹配，不允许进 RAG。当前无生效记录，由业务维护后台维护后生效。\"\n}\n"},"source/dealer/config/biz-rules/filter-labels.json":{"blob":"9a7d6c937107a211d7a554e408dd626f014d5bf8","sha256":"49d845c72cc300e87ad92729a1fa3ef98d3e98a517c10fd8b13bfb87a2a0ecf2","text":"{\n  \"version\": \"1\",\n  \"updatedAt\": \"2026-08-09\",\n  \"status\": \"生效\",\n  \"filters\": [\n    { \"key\": \"建议下单\", \"label\": \"建议下单\", \"anchor\": \"pre_order_qty > 0\", \"display\": \"绿色标签，按建议量降序\" },\n    { \"key\": \"不可下单\", \"label\": \"不可下单\", \"anchor\": \"命中货龄熔断/高风险或业务例外\", \"display\": \"红色标签，优先展示原因\" },\n    { \"key\": \"货龄风险\", \"label\": \"货龄风险\", \"anchor\": \"avg_stock_age 或 stock_age_turnover_status 命中阈值/状态\", \"display\": \"红色或橙色标签\" },\n    { \"key\": \"高库存低动销\", \"label\": \"高库存低动销\", \"anchor\": \"库存偏高且日均偏低（周转高）\", \"display\": \"橙色标签，提示谨慎下单或控货\" },\n    { \"key\": \"低库存高动销\", \"label\": \"低库存高动销\", \"anchor\": \"库存偏低且日均较高（有补货建议）\", \"display\": \"蓝色机会标签，提示优先沟通补货\" },\n    { \"key\": \"数据异常\", \"label\": \"数据异常\", \"anchor\": \"空值、负值、重复、无货龄\", \"display\": \"灰色/橙色标签，提示人工核查\" }\n  ]\n}\n"},"source/dealer/config/biz-rules/fuse-rules.json":{"blob":"cfd3b3b7fe365ae877c937c22912e74eac42eb43","sha256":"42c6219ce965250765e28c24ba0ae4ac2eec726c00b39606073ebd278622c923","text":"{\n  \"version\": \"1\",\n  \"updatedAt\": \"2026-08-09\",\n  \"status\": \"生效\",\n  \"scope\": \"客户-SKU\",\n  \"priority\": [\"customer_sku\", \"sku\", \"material_group\", \"category\", \"product_label\", \"default\"],\n  \"default\": {\n    \"thresholdsDays\": [60, 90, 120],\n    \"levels\": [\n      { \"level\": \"normal\", \"label\": \"正常\", \"maxDays\": 60, \"preOrderAction\": \"允许\", \"display\": \"绿色/正常\" },\n      { \"level\": \"low\", \"label\": \"低风险观察\", \"minDays\": 60, \"maxDays\": 90, \"preOrderAction\": \"允许并标记观察\", \"display\": \"黄色/低风险\" },\n      { \"level\": \"high\", \"label\": \"高风险需确认\", \"minDays\": 90, \"maxDays\": 120, \"preOrderAction\": \"不建议直接下单，需业务确认\", \"display\": \"橙色/高风险/需确认\" },\n      { \"level\": \"fused\", \"label\": \"熔断暂停建议\", \"minDays\": 120, \"preOrderAction\": \"暂停正向预订单建议，除非人工例外审批\", \"display\": \"红色/熔断/暂停下单\" }\n    ]\n  },\n  \"overrides\": []\n}\n"},"source/dealer/config/biz-rules/metric-cards.json":{"blob":"0d1c7db1880c1a3a3369eb91e263e1d0afad8a1b","sha256":"80b51e5c5613730bb8965527bed5701dee45a24244bf4e2fab7df92edd2d659d","text":"{\n  \"version\": \"1\",\n  \"updatedAt\": \"2026-08-09\",\n  \"status\": \"生效\",\n  \"cards\": [\n    {\n      \"key\": \"operating_achievement\",\n      \"label\": \"经营目标达成\",\n      \"main\": { \"field\": \"达成金额\", \"source\": \"budget_amount * budget_rate\" },\n      \"aux\": [\n        { \"field\": \"经营目标\", \"source\": \"budget_amount\" },\n        { \"field\": \"达成进度\", \"source\": \"budget_rate\" }\n      ]\n    },\n    {\n      \"key\": \"plan_achievement\",\n      \"label\": \"计划量达成\",\n      \"main\": { \"field\": \"达成量\", \"source\": \"shipped_qty + in_transit_qty\" },\n      \"aux\": [\n        { \"field\": \"计划量\", \"source\": \"planned_qty\" },\n        { \"field\": \"达成进度\", \"source\": \"planned_qty_rate\" }\n      ]\n    },\n    {\n      \"key\": \"current_stock\",\n      \"label\": \"当前库存\",\n      \"main\": { \"field\": \"当前库存量\", \"source\": \"stock_qty + in_transit_qty\" },\n      \"aux\": [\n        { \"field\": \"周转天数\", \"source\": \"turnover_days\" },\n        { \"field\": \"平均货龄\", \"source\": \"avg_stock_age\" }\n      ],\n      \"note\": \"当前库存=T-2库存+在途库存；在途库存指未签收或库存日期之后发货量。\"\n    },\n    {\n      \"key\": \"suggested_preorder\",\n      \"label\": \"建议预订单\",\n      \"main\": { \"field\": \"建议预订单量\", \"source\": \"pre_order_qty\" },\n      \"aux\": [\n        { \"field\": \"建议SKU个数\", \"source\": \"pre_order_qty > 0 的SKU去重数\" },\n        { \"field\": \"客户总SKU个数\", \"source\": \"当前客户当前快照和计划月份下的SKU去重数\" }\n      ],\n      \"note\": \"建议预订单量不等于正式订单量；人工调整后进入预加购物车，提交DMS前仍需人工确认。\"\n    }\n  ]\n}\n"},"source/dealer/config/biz-rules/report-templates.json":{"blob":"d83f65c908b811e9fd8aadb0c8389ce3883818a8","sha256":"af0fa90edd4a3440c2b209170514c05e8f81a6af3112d4f761963e82ad859a8f","text":"{\n  \"version\": \"1\",\n  \"updatedAt\": \"2026-08-10\",\n  \"status\": \"生效\",\n  \"templates\": [\n    {\n      \"key\": \"REPORT-ORDER-01\",\n      \"name\": \"客户下单概览报告\",\n      \"status\": \"生效\",\n      \"keywords\": [\"整体怎么样\", \"整体情况\", \"客户概览\", \"下单概览\"],\n      \"trigger\": \"用户问“这个客户整体怎么样”\",\n      \"sections\": [\n        \"查询口径：客户、计划月份、快照日期\",\n        \"整体指标：预算、发货、计划、库存、在途、预订单\",\n        \"重点清单：建议下单、不可下单、货龄风险、高库存低动销、低库存高动销\",\n        \"主要解释：预订单来源、库存与动销、货龄情况\",\n        \"待人工确认：数据异常、不可下单、预购物车调整\"\n      ]\n    },\n    {\n      \"key\": \"REPORT-ORDER-02\",\n      \"name\": \"建议下单SKU清单\",\n      \"status\": \"生效\",\n      \"keywords\": [\"哪些sku建议下单\", \"哪些sku需要补货\", \"建议下单sku\"],\n      \"trigger\": \"用户问“哪些SKU建议下单”\",\n      \"sections\": [\n        \"查询口径：客户、计划月份、快照日期\",\n        \"SKU清单：按建议预订单量降序\",\n        \"重点解释：建议量来源与货龄/库存风险\"\n      ]\n    },\n    {\n      \"key\": \"REPORT-ORDER-03\",\n      \"name\": \"库存与货龄风险报告\",\n      \"status\": \"生效\",\n      \"keywords\": [\"库存和货龄风险\", \"货龄风险\", \"库存风险\"],\n      \"trigger\": \"用户问“库存和货龄风险”\",\n      \"sections\": [\n        \"查询口径：客户、计划月份、快照日期\",\n        \"高库存与低库存清单\",\n        \"长货龄与需核查 SKU 清单\",\n        \"待人工确认：数据异常与货龄口径\"\n      ]\n    },\n    {\n      \"key\": \"REPORT-ORDER-04\",\n      \"name\": \"预购物车确认清单\",\n      \"status\": \"草稿\",\n      \"keywords\": [\"预购物车确认\", \"提交dms前\"],\n      \"trigger\": \"用户确认提交DMS前\",\n      \"sections\": [\n        \"已加入 SKU、数量、人工调整量\",\n        \"风险提示：熔断、高风险、数据异常\",\n        \"提交 DMS 边界说明\"\n      ]\n    }\n  ],\n  \"note\": \"报告模板（业务维护规则包 5.1/5.2）：模板优先级=用户明确指定模板 → 业务维护模板 → 规划默认模板；关键结论必须能追溯到主表或货龄表字段，不输出新测算量。\"\n}\n"},"source/dealer/config/biz-rules/split-params.json":{"blob":"da72b2a58d5562d95b84d84999ad9f08c04d2900","sha256":"72764fbffba55b45714a6a780fac2c16c819feb3fcc278029f224b5995794817","text":"{\n  \"version\": \"1\",\n  \"updatedAt\": \"2026-08-10\",\n  \"status\": \"生效\",\n  \"serviceFrequency\": {\n    \"一级\": 8,\n    \"二级\": 6,\n    \"三级\": 4,\n    \"四级\": 3,\n    \"五级\": 3\n  },\n  \"vehicleCapacity\": {\n    \"note\": \"车型平均件数、载重、里程区间；定车型按标准车型、里程车型、主发车型取较大值，并受历史最大车型约束。参数待业务维护。\"\n  },\n  \"skuPerBatch\": {\n    \"formula\": \"预订单SKU个数 ÷ 发货次数向上取整\",\n    \"note\": \"控制每批 SKU 集中度。\"\n  },\n  \"shipDate\": {\n    \"note\": \"首批日期结合缺货情况、补货周期和月发运间隔；批次间隔按库存可撑天数和月发运间隔取较小值。参数待业务维护。\"\n  },\n  \"priority\": [\n    \"缺货/即将缺货\",\n    \"新品/次新品/试销品/预下市\",\n    \"正常在售品（按近30日日均动销降序）\"\n  ],\n  \"note\": \"预订单拆分参数（业务维护规则包 3.5 BIZ-SPLIT-01~06）：当前阶段以总量向下拆为主，不承担小单向上合并凑车。\"\n}\n"},"source/dealer/config/biz-rules/stock-health.json":{"blob":"a28b1bc20e1742c80f797935a437d98e9c710c59","sha256":"5e11248581ced9ac9c1da38c8a401211c292e709977b285c6584fd4864cd407d","text":"{\n  \"version\": \"1\",\n  \"updatedAt\": \"2026-08-09\",\n  \"status\": \"生效\",\n  \"healthBands\": [\n    { \"productLabel\": \"基量品\", \"minDays\": 7, \"maxDays\": 20 },\n    { \"productLabel\": \"补充品\", \"minDays\": 7, \"maxDays\": 20 }\n  ],\n  \"healthLevels\": [\n    { \"level\": \"告急\", \"label\": \"告急\", \"condition\": \"turnover < minDays\", \"display\": \"红色\", \"action\": \"优先沟通补货或关注未发货/在途履约\" },\n    { \"level\": \"健康\", \"label\": \"健康\", \"condition\": \"minDays <= turnover <= maxDays\", \"display\": \"绿色\", \"action\": \"保持当前补货节奏\" },\n    { \"level\": \"偏高\", \"label\": \"偏高\", \"condition\": \"maxDays < turnover <= 60\", \"display\": \"黄色\", \"action\": \"控制新增下单，结合货龄和动销观察\" },\n    { \"level\": \"滞销\", \"label\": \"滞销\", \"condition\": \"turnover > 60\", \"display\": \"深色\", \"action\": \"建议促销清库，暂停或谨慎下单\" }\n  ],\n  \"stockVsTarget\": {\n    \"highRatio\": 1.2,\n    \"lowRatio\": 0.8,\n    \"note\": \"当前库存/目标库存 >= highRatio 视为高库存；<= lowRatio 视为低库存；阈值待业务确认后维护。\"\n  },\n  \"ageDisplayBands\": [\n    { \"band\": \"新近\", \"minDays\": 0, \"maxDays\": 30, \"display\": \"新近库存\" },\n    { \"band\": \"常规\", \"minDays\": 31, \"maxDays\": 60, \"display\": \"常规库存\" },\n    { \"band\": \"关注\", \"minDays\": 61, \"maxDays\": 90, \"display\": \"关注库存\" },\n    { \"band\": \"长货龄\", \"minDays\": 91, \"display\": \"长货龄风险\" }\n  ]\n}\n"},"source/dealer/web/src/contracts/dealer-inventory-cube.json":{"blob":"11b991f8e32e86a1a210d7e8feb84f783684d65c","sha256":"de48e3b5994f96b9b852ba1cdc9f24f8cb931fbf9e57b5af1b6917e57198c9b6","text":"{\n  \"cube\": \"dealer_plan_order\",\n  \"timezone\": \"Asia/Shanghai\",\n  \"transportPageSize\": 1000,\n  \"workspacePreviewRows\": 100,\n  \"maxCustomerLookupRows\": 20000,\n  \"snapshotDimension\": \"dealer_plan_order.snapshot_date\",\n  \"planMonthDimension\": \"dealer_plan_order.plan_month\",\n  \"customerCodeDimension\": \"dealer_plan_order.cust_code\",\n  \"customerNameDimension\": \"dealer_plan_order.cust_name\",\n  \"materialCodeDimension\": \"dealer_plan_order.material_code\",\n  \"materialNameDimension\": \"dealer_plan_order.material_name\",\n  \"productCategoryDimension\": \"dealer_plan_order.product_categ_name\",\n  \"inventorySourceDimension\": \"dealer_plan_order.inventory_source\",\n  \"stockAgeStatusDimension\": \"dealer_plan_order.stock_age_turnover_status\",\n  \"sourceLoadTimeDimension\": \"dealer_plan_order.source_load_time\",\n  \"updatedTimeDimension\": \"dealer_plan_order.updated_time\",\n \"measures\": [\n  \"dealer_plan_order.record_count\",\n  \"dealer_plan_order.budget_amount\",\n  \"dealer_plan_order.shipped_qty\",\n  \"dealer_plan_order.ship_amount\",\n  \"dealer_plan_order.unship_qty\",\n  \"dealer_plan_order.unship_amount\",\n  \"dealer_plan_order.total_qty\",\n  \"dealer_plan_order.total_amount\",\n  \"dealer_plan_order.planned_qty\",\n  \"dealer_plan_order.daily_sales\",\n  \"dealer_plan_order.stock_qty\",\n  \"dealer_plan_order.target_inventory\",\n  \"dealer_plan_order.pre_order_qty\",\n  \"dealer_plan_order.average_turnover_days\",\n  \"dealer_plan_order.label_turnover_days\",\n  \"dealer_plan_order.average_stock_age\",\n  \"dealer_plan_order.average_stock_age_weighted\"\n ],\n  \"workbenchMeasures\": [\n  \"dealer_plan_order.record_count\",\n  \"dealer_plan_order.budget_amount\",\n  \"dealer_plan_order.shipped_qty\",\n  \"dealer_plan_order.ship_amount\",\n  \"dealer_plan_order.unship_qty\",\n  \"dealer_plan_order.unship_amount\",\n  \"dealer_plan_order.total_qty\",\n  \"dealer_plan_order.total_amount\",\n  \"dealer_plan_order.planned_qty\",\n  \"dealer_plan_order.daily_sales\",\n  \"dealer_plan_order.in_transit_qty\",\n  \"dealer_plan_order.stock_qty\",\n  \"dealer_plan_order.target_inventory\",\n  \"dealer_plan_order.pre_order_qty\",\n  \"dealer_plan_order.average_turnover_days\",\n  \"dealer_plan_order.label_turnover_days\",\n  \"dealer_plan_order.average_stock_age\",\n  \"dealer_plan_order.average_stock_age_weighted\",\n  \"dealer_plan_order.average_budget_rate\",\n  \"dealer_plan_order.average_planned_qty_rate\"\n ],\n  \"detailDimensions\": [\n    \"dealer_plan_order.snapshot_date\",\n    \"dealer_plan_order.plan_month\",\n    \"dealer_plan_order.cust_code\",\n    \"dealer_plan_order.cust_name\",\n    \"dealer_plan_order.material_code\",\n    \"dealer_plan_order.material_name\",\n    \"dealer_plan_order.inventory_source\",\n    \"dealer_plan_order.stock_age_turnover_status\",\n    \"dealer_plan_order.source_load_time\",\n    \"dealer_plan_order.updated_time\"\n ],\n  \"customerAggregateDimensions\": [\n    \"dealer_plan_order.snapshot_date\",\n    \"dealer_plan_order.cust_code\",\n    \"dealer_plan_order.cust_name\"\n  ],\n  \"skuAggregateDimensions\": [\n    \"dealer_plan_order.snapshot_date\",\n    \"dealer_plan_order.material_code\",\n    \"dealer_plan_order.material_name\"\n  ]\n}\n"},"source/dealer/web/src/lib/dealer-dashboard.ts":{"blob":"3a96ebd782df1d9afc52ece41f3691ef85753777","sha256":"7e6aae3dcf45191ae46febc6a54235ec8e27dd06fd56b2dd2cabe8141813e960","text":"import \"server-only\";\nimport { inventoryDateLabel } from \"@/lib/inventory-date-label\";\nimport { evaluateStatusFilters, rowActionStatus, statusMatches, statusFilterLabel, validStatusFilters, type DealerStatusFilter, type StatusContext } from \"@/lib/dealer-status-filters\";\n\nimport { readFileSync } from \"node:fs\";\nimport { resolve } from \"node:path\";\n\nimport {\n  dealerWorkbenchSql,\n  queryAllWorkbenchSqlRows,\n  queryWorkbenchAging,\n  queryWorkbenchCategorySummaries,\n  queryWorkbenchCustomerSummaries,\n  queryWorkbenchCustomers,\n  queryWorkbenchDashboard,\n  type CompanyProductFilters,\n  queryWorkbenchInventoryDailyDetails,\n  queryWorkbenchInventoryDailyCustomerSummaries,\n  queryWorkbenchInventoryDailySummary,\n  queryWorkbenchLatestSnapshot,\n  queryWorkbenchSnapshotMonths,\n  queryWorkbenchLatestInventoryDailySnapshot,\n  queryWorkbenchPlanMonths,\n  queryWorkbenchShortageDetails,\n  queryWorkbenchSummary,\n  queryWorkbenchSqlPage,\n} from \"@/lib/dealer-workbench-sql\";\nimport { GeaSqlApiError } from \"@/lib/gea-sql-client\";\nimport dealerCubeContract from \"@/contracts/dealer-inventory-cube.json\";\n\ntype CubeValue = string | number | null | undefined;\ntype CubeRow = Record<string, CubeValue>;\n\nconst cube = dealerCubeContract.cube;\nconst planMonthDimension = dealerCubeContract.planMonthDimension;\nconst sourceLoadTimeDimension = dealerCubeContract.sourceLoadTimeDimension;\nconst updatedTimeDimension = dealerCubeContract.updatedTimeDimension;\nconst GEA_CUSTOMER_BOOTSTRAP_LIMIT = 10;\nconst GEA_CUSTOMER_SEARCH_LIMIT = 20;\nconst GEA_DASHBOARD_INITIAL_ROW_LIMIT = 200;\n\nconst DEFAULT_FUSE_RULES = { low: 60, high: 90, fused: 120 };\nconst DISABLED_FUSE_RULES = { low: Number.MAX_SAFE_INTEGER, high: Number.MAX_SAFE_INTEGER, fused: Number.MAX_SAFE_INTEGER };\n\ntype BizRuleFile = {\n  status?: string;\n  effective_time?: string;\n  expire_time?: string;\n  default?: { thresholdsDays?: number[]; levels?: Array<Record<string, unknown>> };\n  overrides?: Array<Record<string, unknown>>;\n  exceptions?: Array<Record<string, unknown>>;\n  filters?: Array<Record<string, unknown>>;\n  cards?: Array<Record<string, unknown>>;\n  healthLevels?: Array<Record<string, unknown>>;\n  healthBands?: Array<Record<string, unknown>>;\n  ageDisplayBands?: Array<Record<string, unknown>>;\n  stockVsTarget?: Record<string, unknown>;\n};\n\nfunction loadBizRuleFile(name: string): BizRuleFile {\n  try {\n    const path = resolve(process.cwd(), `../config/biz-rules/${name}.json`);\n    return JSON.parse(readFileSync(path, \"utf8\")) as BizRuleFile;\n  } catch {\n    return {};\n  }\n}\n\nfunction isActiveBizRuleFile(config: BizRuleFile) {\n  return isEffectiveBizRule(config);\n}\n\nfunction isEffectiveBizRule(rule: Record<string, unknown>) {\n  if (String(rule.status ?? \"生效\") !== \"生效\") return false;\n  const now = Date.now();\n  const effective = typeof rule.effective_time === \"string\" ? Date.parse(rule.effective_time) : Number.NaN;\n  const expire = typeof rule.expire_time === \"string\" ? Date.parse(rule.expire_time) : Number.NaN;\n  return (Number.isNaN(effective) || effective <= now) && (Number.isNaN(expire) || expire > now);\n}\n\nfunction fuseRulesFrom(config: Pick<BizRuleFile, \"default\"> | Record<string, unknown>): typeof DEFAULT_FUSE_RULES | null {\n  const rawConfig = config as Record<string, unknown>;\n  const levels = Array.isArray(rawConfig.levels)\n    ? rawConfig.levels as Array<Record<string, unknown>>\n    : undefined;\n  if (levels) {\n    const minDays = (name: string) => levels.find((level) => String(level.level ?? \"\") === name)?.minDays;\n    const [low, high, fused] = [minDays(\"low\"), minDays(\"high\"), minDays(\"fused\")];\n    if (typeof low === \"number\" && low > 0 && typeof high === \"number\" && high > 0 && typeof fused === \"number\" && fused > 0) return { low, high, fused };\n  }\n  const defaults = rawConfig.default as { thresholdsDays?: unknown } | undefined;\n  const thresholds = defaults?.thresholdsDays;\n  if (Array.isArray(thresholds) && thresholds.length >= 3) {\n    const [low, high, fused] = thresholds;\n    if ([low, high, fused].every((value) => typeof value === \"number\" && value > 0)) return { low, high, fused };\n  }\n  return null;\n}\n\nfunction loadFuseRules(config = loadBizRuleFile(\"fuse-rules\")) {\n  // 与 Agent 共用 fuse-rules.json；文件、规则项均需同时满足生效状态和有效期。\n  if (!isActiveBizRuleFile(config)) return DISABLED_FUSE_RULES;\n  const rules = fuseRulesFrom(config);\n  if (rules) return rules;\n  return DEFAULT_FUSE_RULES;\n}\n\ntype RuleScope = { customerCode: string; materialCode: string };\n\nfunction scopeMatches(rule: Record<string, unknown>, scope: RuleScope) {\n  const customer = String(rule.cust_code ?? rule.customer_code ?? \"\").trim();\n  const material = String(rule.material_code ?? rule.sku_code ?? \"\").trim();\n  if (customer && customer !== scope.customerCode) return false;\n  if (material && material !== scope.materialCode) return false;\n  // 当前工作台没有品类/标签字段，不能将该层级规则误匹配为任意 SKU。\n  return ![\"material_group\", \"category\", \"product_label\"].some((key) => String(rule[key] ?? \"\").trim());\n}\n\nfunction fuseRuleRank(rule: Record<string, unknown>) {\n  // 与 biz_rule_config._rule_specificity 保持同一优先级。\n  return ({ customer_sku: 0, sku: 1, material_group: 2, category: 3, product_label: 4, default: 5 } as Record<string, number>)[String(rule.scope ?? rule.level ?? \"\")] ?? 6;\n}\n\nfunction effectiveRuleFor(rules: Array<Record<string, unknown>>, scope: RuleScope, rank: (rule: Record<string, unknown>) => number) {\n  return rules\n    .filter((rule) => isEffectiveBizRule(rule) && scopeMatches(rule, scope))\n    .sort((left, right) => rank(left) - rank(right) || String(right.updated_at ?? right.updatedAt ?? \"\").localeCompare(String(left.updated_at ?? left.updatedAt ?? \"\")))[0];\n}\n\nfunction fuseRulesFor(scope: RuleScope, config: BizRuleFile) {\n  if (!isActiveBizRuleFile(config)) return DISABLED_FUSE_RULES;\n  const override = effectiveRuleFor(config.overrides ?? [], scope, fuseRuleRank);\n  return (override && fuseRulesFrom(override)) ?? loadFuseRules(config);\n}\n\nfunction fuseLevelForRow(row: CubeRow, config = loadBizRuleFile(\"fuse-rules\")): string {\n  const age = nullableNumber(row[`${cube}.average_stock_age`]);\n  if (age === null || !isActiveBizRuleFile(config)) return \"unknown\";\n  const scope = {\n    customerCode: String(row[dealerCubeContract.customerCodeDimension] ?? \"\"),\n    materialCode: String(row[dealerCubeContract.materialCodeDimension] ?? \"\"),\n  };\n  const override = effectiveRuleFor(config.overrides ?? [], scope, fuseRuleRank);\n  const levels = (Array.isArray(override?.levels) ? override.levels : config.default?.levels ?? []) as Array<Record<string, unknown>>;\n  const match = levels.find((level) =>\n    (typeof level.minDays === \"number\" || typeof level.maxDays === \"number\")\n    && (typeof level.minDays !== \"number\" || age >= level.minDays)\n    && (typeof level.maxDays !== \"number\" || age < level.maxDays));\n  if (match) return String(match.level ?? \"unknown\");\n  const last = levels.at(-1);\n  return last && typeof last.minDays === \"number\" && age >= last.minDays ? String(last.level ?? \"unknown\") : \"unknown\";\n}\n\nfunction isFusedSku(row: CubeRow) { return fuseLevelForRow(row) === \"fused\"; }\n\nfunction statusContext(): StatusContext {\n  const fuseConfig = loadBizRuleFile(\"fuse-rules\"), healthConfig = loadBizRuleFile(\"stock-health\"), exceptions = loadBizRuleFile(\"exceptions\");\n  return {\n    fuse: row => fuseLevelForRow(row, fuseConfig),\n    dataIssues: row => dataIssuesFor(row, false).length > 0,\n    exception: row => Boolean(orderExceptionFor({customerCode: String(row[dealerCubeContract.customerCodeDimension] ?? \"\"), materialCode: String(row[dealerCubeContract.materialCodeDimension] ?? \"\")}, exceptions)),\n    health: days => {\n      if (days === null || !isActiveBizRuleFile(healthConfig)) return \"未知\";\n      const band = healthConfig.healthBands?.[0] ?? {};\n      const match = healthConfig.healthLevels?.find(level => {\n        const min = Number(level.minDays ?? band.minDays ?? -Infinity), max = Number(level.maxDays ?? band.maxDays ?? Infinity);\n        switch (String(level.condition ?? \"\").replaceAll(\" \", \"\").toLowerCase()) {\n          case \"turnover<mindays\": case \"turnover<min\": return days < min;\n          case \"turnover>maxdays\": case \"turnover>max\": return days > max;\n          case \"mindays<=turnover<=maxdays\": case \"min<=turnover<=max\": return min <= days && days <= max;\n          case \"maxdays<turnover<=60\": case \"max<turnover<=60\": return max < days && days <= 60;\n          case \"turnover>60\": return days > 60;\n          case \"turnover>=60\": return days >= 60;\n          default: return false;\n        }\n      });\n      return String(match?.level ?? \"未知\");\n    },\n    ageBand: days => {\n      if (days === null || !isActiveBizRuleFile(healthConfig)) return \"未知\";\n      const bands = healthConfig.ageDisplayBands ?? [];\n      const match = bands.find(band => (typeof band.minDays !== \"number\" || days >= band.minDays) && (typeof band.maxDays !== \"number\" || days <= band.maxDays));\n      const last = bands.at(-1);\n      return String(match?.band ?? (last && typeof last.minDays === \"number\" && days >= last.minDays ? last.band : \"未知\"));\n    },\n  };\n}\n\nfunction orderExceptionFor(scope: RuleScope, config: BizRuleFile) {\n  if (!isActiveBizRuleFile(config)) return null;\n  const exception = effectiveRuleFor(\n    config.exceptions ?? [],\n    scope,\n    (rule) => ({ customer_sku: 0, sku: 1, customer: 2 } as Record<string, number>)[String(rule.level ?? \"\")] ?? 3,\n  );\n  if (!exception) return null;\n  const processing = String(exception.processing ?? exception.reason ?? \"\").trim();\n  return /不可下单|暂缓|控货|停用|下市/.test(processing) ? processing : null;\n}\n\nfunction loadFilterLabels() {\n  const config = loadBizRuleFile(\"filter-labels\");\n  if (!isActiveBizRuleFile(config)) return [];\n  const filters = config.filters;\n  if (!Array.isArray(filters)) return [];\n  return filters\n    .filter((item) => String(item.status ?? \"生效\") === \"生效\")\n    .map((item) => ({\n      key: String(item.key ?? \"\"),\n      label: String(item.label ?? item.key ?? \"\"),\n      anchor: String(item.anchor ?? \"\"),\n      display: String(item.display ?? \"\"),\n    }));\n}\n\nfunction loadMetricCards() {\n  const config = loadBizRuleFile(\"metric-cards\");\n  if (!isActiveBizRuleFile(config)) return [];\n  const cards = config.cards;\n  if (!Array.isArray(cards)) return [];\n  return cards\n    .filter((item) => String(item.status ?? \"生效\") === \"生效\")\n    .map((item) => ({\n      key: String(item.key ?? \"\"),\n      label: String(item.label ?? \"\"),\n      note: String(item.note ?? \"\"),\n      main: String((item.main as { field?: string } | undefined)?.field ?? \"\"),\n      aux: Array.isArray(item.aux) ? item.aux.map((aux) => String((aux as { field?: string }).field ?? \"\")) : [],\n    }));\n}\n\nfunction loadStockHealth() {\n  const config = loadBizRuleFile(\"stock-health\");\n  if (!isActiveBizRuleFile(config)) {\n    return { healthLevels: [], healthBands: [], highRatio: 1.2, lowRatio: 0.8 };\n  }\n  const ratios = config.stockVsTarget ?? {};\n  return {\n    healthLevels: Array.isArray(config.healthLevels) ? config.healthLevels : [],\n    healthBands: Array.isArray(config.healthBands) ? config.healthBands : [],\n    highRatio: Number(ratios.highRatio ?? 1.2),\n    lowRatio: Number(ratios.lowRatio ?? 0.8),\n  };\n}\n\nexport type DealerCustomer = { code: string; name: string };\nexport type DealerCustomerInventorySummary = {\n  code: string;\n  name: string;\n  hasInventoryData: boolean;\n  skuCount: number;\n  inventory: number;\n  inTransit: number;\n  normalInventory: number | null;\n  stockAmount: number | null;\n  dailyRowCount: number;\n  normalStockCoverage: number;\n  stockAmountCoverage: number;\n  targetInventory: number;\n  suggestedQuantity: number;\n};\nexport type DealerCategoryInventorySummary = {\n  riskInventory?: number | null;\n  riskTransit?: number | null;\n  riskDataComplete?: boolean;\n  category: string;\n  skuCount: number;\n  inventory: number;\n  inTransit: number;\n  normalInventory: number | null;\n  sales30: number | null;\n  stockAmount: number | null;\n  dailyMatchedSkuCount: number;\n  targetInventory: number;\n};\nexport type DealerDashboardRecord = {\n  // Only populated from verified batch-expiry / effective-transit facts.\n  verifiedNearExpiryInventory?: number | null;\n  verifiedEffectiveInTransit?: number | null;\n  id: string;\n  recordCount: number;\n  planMonth: string | null;\n  sourceLoadTime: string | null;\n  updatedTime: string | null;\n  customerCode: string;\n  customerName: string;\n  materialCode: string;\n  materialName: string;\n  productCategory: string | null;\n  budget: number;\n  shipped: number;\n  inTransit: number;\n  inventory: number | null;\n  turnoverDays: number | null;\n  targetInventory: number | null;\n  averageAge: number | null;\n  agingStatus: string | null;\n  suggestedQuantity: number;\n  budgetRate: number | null;\n  // Keep source nulls for company products; legacy inventory metrics use numeric defaults.\n  publishedInTransit?: number | null;\n  publishedSuggestedQuantity?: number | null;\n  plannedQtyRate: number | null;\n  plannedQty: number | null;\n  dailySales: number | null;\n  shipAmount: number;\n  unshipQty: number;\n  unshipAmount: number;\n  totalQty: number;\n  totalAmount: number;\n  labelTurnoverDays: number | null;\n  inventorySource: string | null;\n  inventoryDailyStatDate: string | null;\n  inventorySnapshotDate: string | null;\n  actualInventory: number | null;\n  actualInTransit: number | null;\n  normalInventory: number | null;\n  stockAmount: number | null;\n  sales7: number | null;\n  sales7DailyAverage: number | null;\n  sales30: number | null;\n  sales30DailyAverage: number | null;\n  salesAmount30: number | null;\n  salesAmount30DailyAverage: number | null;\n  productRange: string | null;\n  productTag: string | null;\n  materialSize: string | null;\n  cifPrice: number | null;\n  inventoryDailySource: string | null;\n  dataIssues: string[];\n  fuseRules: typeof DEFAULT_FUSE_RULES;\n  orderException: string | null;\n};\n\nexport type DealerDashboardSummary = {\n  nearExpirySkuCount?: number | null;\n  skuCount: number;\n  reasonableSkuCount: number;\n  unreasonableSkuCount: number;\n  shortageSkuCount: number;\n  coveredSkuCount: number;\n  budget: number | null;\n  shipAmount: number | null;\n  shipped: number;\n  inTransit: number;\n  inventory: number;\n  targetInventory: number;\n  suggestedQuantity: number;\n  dailySales: number;\n  averageAge: number | null;\n};\n\nexport type DealerInventoryDailySummary = {\n  noSalesSkuCount?: number | null;\n  statDate: string;\n  inventoryDateLabel?: string;\n  rowCount: number;\n  customerCount: number;\n  coverageComplete: boolean;\n  stockQtyComplete: boolean;\n  inTransitQtyComplete: boolean;\n  normalStockQtyComplete: boolean;\n  stockAmountComplete: boolean;\n  sales7Complete: boolean;\n  sales7DailyAverageComplete: boolean;\n  sales30Complete: boolean;\n  sales30DailyAverageComplete: boolean;\n  salesAmount30Complete: boolean;\n  sales7Coverage: number;\n  sales30Coverage: number;\n  salesAmount30Coverage: number;\n  normalStockCoverage: number;\n  stockAmountCoverage: number;\n  inventory: number;\n  inTransit: number;\n  normalInventory: number;\n  stockAmount: number;\n  sales7: number;\n  sales7DailyAverage: number;\n  sales30: number;\n  sales30DailyAverage: number;\n  salesAmount30: number;\n  salesAmount30DailyAverage: number;\n};\n\nexport type DealerFilterLabel = { key: string; label: string; anchor: string; display: string };\nexport type DealerMetricCard = { key: string; label: string; note: string; main: string; aux: string[] };\nexport type DealerStockHealth = {\n  healthLevels: Array<Record<string, unknown>>;\n  healthBands: Array<Record<string, unknown>>;\n  highRatio: number;\n  lowRatio: number;\n};\n\nexport type DealerAgingRow = {\n  source: \"文沥/D-Link\" | \"提报推演\";\n  statDate: string | null;\n  produceDate: string | null;\n  batchNo: string | null;\n  shipType: string | null;\n  ageDays: number | null;\n  stockQty: number;\n  finalQty: number;\n};\n\nexport type DealerDetailScope = {\n  snapshotDate: string;\n  planMonth?: string;\n  customerCodes: string[];\n  materialCode: string;\n  mode: \"detail\" | \"aggregate\";\n  groupBy: string;\n  orderBy: \"preOrder\" | \"stockAge\" | \"metric\";\n  stockCondition?: \"none\" | \"equals_zero\";\n  metricCondition?: DealerMetricCondition;\n};\n\nexport type DealerMetric =\n  | \"budget_amount\"\n  | \"budget_rate\"\n  | \"planned_qty_rate\"\n  | \"shipped_qty\"\n  | \"in_transit_qty\"\n  | \"stock_qty\"\n  | \"target_inventory\"\n  | \"pre_order_qty\"\n  | \"turnover_days\"\n  | \"stock_age\";\n\nexport type DealerMetricCondition = {\n  metric: DealerMetric;\n  comparison: \"none\" | \"gt\" | \"gte\" | \"lt\" | \"lte\" | \"equals\";\n  threshold: number | null;\n  stockCondition: \"none\" | \"equals_zero\";\n  inventoryRelation: \"none\" | \"below_target\" | \"above_target\";\n  replenishmentRequired: boolean;\n  agingAttentionOnly: boolean;\n  orderBlocked?: boolean;\n  fuseStatus?: \"none\" | \"fused\";\n  statusFilters?: DealerStatusFilter[];\n};\n\nconst metricMembers: Record<DealerMetric, string> = {\n  budget_amount: `${cube}.budget_amount`,\n  budget_rate: `${cube}.average_budget_rate`,\n  planned_qty_rate: `${cube}.average_planned_qty_rate`,\n  shipped_qty: `${cube}.shipped_qty`,\n  in_transit_qty: `${cube}.in_transit_qty`,\n  stock_qty: `${cube}.stock_qty`,\n  target_inventory: `${cube}.target_inventory`,\n  pre_order_qty: `${cube}.pre_order_qty`,\n  turnover_days: `${cube}.average_turnover_days`,\n  stock_age: `${cube}.average_stock_age`,\n};\n\nconst metricSqlColumns: Record<DealerMetric, string> = {\n  budget_amount: \"simulation_need_amount\",\n  budget_rate: \"budget_rate\",\n  planned_qty_rate: \"planned_qty_rate\",\n  shipped_qty: \"ship_qty\",\n  in_transit_qty: \"in_transit_qty\",\n  stock_qty: \"stock_qty\",\n  target_inventory: \"target_inventory\",\n  pre_order_qty: \"pre_order_qty\",\n  turnover_days: \"turnover_days\",\n  stock_age: \"avg_stock_age\",\n};\n\nconst metricLabels: Record<DealerMetric, string> = {\n  budget_amount: \"月度预算额\",\n  budget_rate: \"预算达成率\",\n  planned_qty_rate: \"计划量达成率\",\n  shipped_qty: \"已发货量\",\n  in_transit_qty: \"在途量\",\n  stock_qty: \"当前库存\",\n  target_inventory: \"目标库存\",\n  pre_order_qty: \"建议补货量\",\n  turnover_days: \"库存周转天数\",\n  stock_age: \"货龄\",\n};\n\nfunction numberOf(value: CubeValue) {\n  const number = Number(value ?? 0);\n  return Number.isFinite(number) ? number : 0;\n}\n\nfunction nullableNumber(value: CubeValue) {\n  if (value === null || value === undefined || value === \"\") return null;\n  const number = Number(value);\n  return Number.isFinite(number) ? number : null;\n}\n\nfunction dateOnly(value: CubeValue) {\n  const normalized = String(value ?? \"\").trim();\n  return normalized ? normalized.slice(0, 10) : null;\n}\n\nfunction planMonthOf(value: CubeValue) {\n  const normalized = String(value ?? \"\").trim();\n  return normalized ? normalized.slice(0, 7) : null;\n}\n\nfunction mainGrainKey(row: CubeRow) {\n  return [\n    dateOnly(row[dealerCubeContract.snapshotDimension]),\n    String(row[dealerCubeContract.customerCodeDimension] ?? \"\").trim(),\n    String(row[dealerCubeContract.materialCodeDimension] ?? \"\").trim(),\n    planMonthOf(row[planMonthDimension]),\n  ].join(\"|\");\n}\n\nfunction dedupeRows(rows: CubeRow[]) {\n  const seen = new Map<string, CubeRow>();\n  const duplicateKeys = new Set<string>();\n  let dropped = 0;\n  for (const row of rows) {\n    const key = mainGrainKey(row);\n    if (!key || key === \"||||\") {\n      seen.set(`unkeyed-${seen.size}`, row);\n      continue;\n    }\n    const existing = seen.get(key);\n    if (!existing) {\n      seen.set(key, row);\n      continue;\n    }\n    duplicateKeys.add(key);\n    const existingTime = [String(existing[sourceLoadTimeDimension] ?? \"\"), String(existing[updatedTimeDimension] ?? \"\")];\n    const rowTime = [String(row[sourceLoadTimeDimension] ?? \"\"), String(row[updatedTimeDimension] ?? \"\")];\n    if (rowTime.join() > existingTime.join()) seen.set(key, row);\n    dropped += 1;\n  }\n  return { rows: [...seen.values()], dropped, duplicateKeys };\n}\n\n/** BIZ-FILTER-06 / BIZ-CHECK-02: preserve missing values instead of coercing them to 0. */\nfunction dataIssuesFor(row: CubeRow, duplicate: boolean) {\n  const issues: string[] = [];\n  const stock = nullableNumber(row[`${cube}.stock_qty`]);\n  const dailySales = nullableNumber(row[`${cube}.daily_sales`]);\n  const target = nullableNumber(row[`${cube}.target_inventory`]);\n  const averageAge = nullableNumber(row[`${cube}.average_stock_age`]);\n  if (stock == null) issues.push(\"库存缺失\");\n  else if (stock < 0) issues.push(\"库存为负\");\n  if (dailySales == null || dailySales === 0) issues.push(\"日均销量缺失或为0\");\n  else if (dailySales < 0) issues.push(\"日均销量为负\");\n  if (target == null) issues.push(\"目标库存缺失\");\n  else if (target < 0) issues.push(\"目标库存为负\");\n  if (averageAge == null) issues.push(\"平均货龄缺失\");\n  else if (averageAge < 0) issues.push(\"平均货龄为负\");\n  // Cube may already aggregate identical detail dimensions into one response\n  // row. `record_count > 1` keeps that duplicate signal visible as well.\n  if (duplicate || numberOf(row[`${cube}.record_count`]) > 1) issues.push(\"主粒度重复\");\n  return issues;\n}\n\nfunction dailyInventoryDataIssuesFor(row: CubeRow | undefined) {\n  if (!row) return [];\n  const issues: string[] = [];\n  const stock = nullableNumber(row[\"dealer_inventory_daily.stock_qty\"]);\n  const transit = nullableNumber(row[\"dealer_inventory_daily.in_transit_qty\"]);\n  const cifPrice = nullableNumber(row[\"dealer_inventory_daily.cif_price\"]);\n  const sales7 = nullableNumber(row[\"dealer_inventory_daily.sales_qty_7days_avg\"]);\n  const sales30 = nullableNumber(row[\"dealer_inventory_daily.sales_qty_30days_avg\"]);\n  if (stock != null && stock < 0) issues.push(\"库存日快照为负\");\n  if (transit != null && transit < 0) issues.push(\"库存日快照在途为负\");\n  if (cifPrice != null && cifPrice < 0) issues.push(\"统一到岸价为负\");\n  if ((sales7 != null && sales7 < 0) || (sales30 != null && sales30 < 0)) issues.push(\"库存日快照动销为负\");\n  return issues;\n}\n\nfunction ageInDays(statDate: string | null, produceDate: string | null) {\n  if (!statDate || !produceDate) return null;\n  const stat = Date.parse(`${statDate}T00:00:00Z`);\n  const produced = Date.parse(`${produceDate}T00:00:00Z`);\n  if (!Number.isFinite(stat) || !Number.isFinite(produced)) return null;\n  return Math.floor((stat - produced) / 86_400_000);\n}\n\nfunction assertGeaSqlWorkbenchTransport() {\n  const configured = process.env.DEALER_WORKBENCH_DATA_TRANSPORT?.trim().toLowerCase();\n  if (configured && configured !== \"gea_sql\" && configured !== \"sql\" && configured !== \"direct\" && configured !== \"postgres\") {\n    throw new GeaSqlApiError(\n      \"工作台仅支持 GEA SQL 数据链路\",\n      \"GEA_SQL_WORKBENCH_TRANSPORT_INVALID\",\n      503,\n      false,\n    );\n  }\n}\n\nfunction directWorkbenchCustomerCode() {\n  const transport = process.env.DEALER_WORKBENCH_DATA_TRANSPORT?.trim().toLowerCase();\n  if (transport !== \"direct\" && transport !== \"postgres\") return null;\n  const allowAllCustomers = process.env.DEALER_WORKBENCH_DIRECT_ALLOW_ALL_CUSTOMERS?.trim().toLowerCase() === \"true\";\n  if (allowAllCustomers) return null;\n  const customerCode = process.env.DEALER_WORKBENCH_DIRECT_CUSTOMER_CODE?.trim() ?? \"\";\n  if (!/^[A-Za-z0-9_-]{1,64}$/.test(customerCode)) {\n    throw new GeaSqlApiError(\n      \"直连数据库模式必须配置唯一允许访问的客户编码\",\n      \"DIRECT_DB_SCOPE_NOT_CONFIGURED\",\n      503,\n      false,\n    );\n  }\n  return customerCode;\n}\n\nfunction directScopedCustomerCodes(requested: string[]) {\n  const directCode = directWorkbenchCustomerCode();\n  if (!directCode) return requested;\n  if (requested.some((code) => code !== directCode)) {\n    throw new GeaSqlApiError(\n      \"查询范围超出直连数据库临时授权客户\",\n      \"DIRECT_DB_CUSTOMER_SCOPE_FORBIDDEN\",\n      403,\n      false,\n    );\n  }\n  return [directCode];\n}\n\nasync function assertAuthorizedSqlCustomerCodes(customerCodes: string[]) {\n  assertGeaSqlWorkbenchTransport();\n  const scopedCustomerCodes = directScopedCustomerCodes(customerCodes);\n  if (scopedCustomerCodes.length === 0) return scopedCustomerCodes;\n  // GEA 会在该受控 SQL 上注入当前用户的数据范围；不再为二次校验拉取完整客户清单。\n  const rows = await queryWorkbenchLatestSnapshot(scopedCustomerCodes);\n  if (!dateOnly(rows[0]?.[dealerCubeContract.snapshotDimension])) {\n    throw new GeaSqlApiError(\n      \"查询范围包含当前用户无权访问的客户\",\n      \"GEA_SQL_CUSTOMER_SCOPE_FORBIDDEN\",\n      403,\n      false,\n    );\n  }\n  return scopedCustomerCodes;\n}\n\nexport type DealerDashboardLoadOptions = {\n  /** Internal overview reads use only metadata and database aggregate queries. */\n  overviewOnly?: boolean;\n  overviewCustomerCodes?: string[];\n  /** UI default: select the sole visible customer using the queried total. */\n  autoSelectOnlyCustomer?: boolean;\n  /** Only fetch this stock tab; omitted by existing full-workspace consumers. */\n  stockTab?: \"customer\" | \"category\" | \"sku\" | \"shortage\" | \"expiry\";\n  /** Partial table response; global metrics remain in the existing document. */\n  tabDataOnly?: boolean;\n  planMonth?: string;\n  inventoryDailyStatDate?: string;\n  /** Include the current page of authorized products for the company catalog. */\n  includeCompanyProducts?: boolean;\n  /** Catalog pagination needs only product facts, not dashboard aggregates. */\n  companyProductsOnly?: boolean;\n  companyProductFilters?: CompanyProductFilters;\n  companyProductFacets?: boolean;\n  onTiming?: (stage: string, durationMs: number) => void;\n  /** Internal export scope; never used for normal screen pagination. */\n  exportTab?: \"sku\" | \"shortage\" | \"customer\" | \"category\" | \"expiry\";\n  actionId?: string;\n  clientRequestId?: string;\n  signal?: AbortSignal;\n  /** Zero-based database detail page used by the review prototype. */\n  detailPage?: number;\n  /** Database detail page size; summary metrics remain scoped to all rows. */\n  detailPageSize?: number;\n  /** Independent zero-based customer-summary page for the customer inventory tab. */\n  customerPage?: number;\n  /** Customer-summary page size; does not change SKU detail pagination. */\n  customerPageSize?: number;\n  /** Independent zero-based shortage-SKU page for the shortage inventory tab. */\n  shortagePage?: number;\n  /** Shortage-SKU page size; does not change the regular SKU page. */\n  shortagePageSize?: number;\n  scope?: \"single\" | \"sales\" | \"all\";\n  snapshotDate?: string;\n  /** Trusted GEA dealer identity; narrows customer-list queries to one code. */\n  lockedCustomerCode?: string;\n};\n\nexport type DealerCustomerSearchResult = {\n  customers: DealerCustomer[];\n  offset: number;\n  limit: number;\n  hasMore: boolean;\n};\n\nfunction asCustomer(row: CubeRow): DealerCustomer | null {\n  const code = String(row[\"dealer_plan_order.cust_code\"] ?? \"\").trim();\n  if (!code) return null;\n  return { code, name: String(row[\"dealer_plan_order.cust_name\"] ?? code).trim() || code };\n}\n\n/**\n * Search the authorized customer list with a bound JDBC parameter. The result\n * stays server-paged, so opening the picker never reads all authorized rows.\n */\nexport async function loadDealerCustomers(\n  search = \"\",\n  offset = 0,\n  limit = GEA_CUSTOMER_SEARCH_LIMIT,\n  options: DealerDashboardLoadOptions = {},\n): Promise<DealerCustomerSearchResult> {\n  const safeSearch = search.trim().slice(0, 100);\n  const safeOffset = Number.isFinite(offset) ? Math.max(0, Math.floor(offset)) : 0;\n  const safeLimit = Number.isFinite(limit)\n    ? Math.max(1, Math.min(GEA_CUSTOMER_SEARCH_LIMIT, Math.floor(limit)))\n    : GEA_CUSTOMER_SEARCH_LIMIT;\n  assertGeaSqlWorkbenchTransport();\n  const directCode = directWorkbenchCustomerCode();\n  const exactCustomerCode = directCode ?? options.lockedCustomerCode ?? \"\";\n  const directScope = directScopedCustomerCodes(exactCustomerCode ? [exactCustomerCode] : []);\n  const snapshotRows = options.snapshotDate\n    ? []\n    : await queryWorkbenchLatestSnapshot(directScope, options);\n  const snapshotDate = options.snapshotDate\n    ?? dateOnly(snapshotRows[0]?.[dealerCubeContract.snapshotDimension]);\n  if (!snapshotDate) return { customers: [], offset: safeOffset, limit: safeLimit, hasMore: false };\n  const page = Math.floor(safeOffset / safeLimit);\n  const result = await queryWorkbenchCustomers(snapshotDate, safeSearch, exactCustomerCode, page, safeLimit, options);\n  const customers = result.records.map(asCustomer).filter((value): value is DealerCustomer => Boolean(value));\n  return {\n    customers,\n    offset: safeOffset,\n    limit: safeLimit,\n    hasMore: safeOffset + customers.length < result.total,\n  };\n}\n\nfunction resultStatus(row: CubeRow, context = statusContext()) {\n  return rowActionStatus(row, context);\n}\n\nfunction formatMetricValue(metric: DealerMetric, row: CubeRow) {\n  const value = numberOf(row[metricMembers[metric]]);\n  if (metric === \"budget_rate\" || metric === \"planned_qty_rate\") return `${(value * 100).toFixed(1)}%`;\n  if (metric === \"turnover_days\" || metric === \"stock_age\") return `${value.toFixed(1)}天`;\n  return value.toLocaleString(\"zh-CN\");\n}\n\nfunction resultTableRow(row: CubeRow, condition?: DealerMetricCondition, context = statusContext()) {\n  return {\n    customerCode: String(row[dealerCubeContract.customerCodeDimension] ?? \"-\") || \"-\",\n    customerName: String(row[dealerCubeContract.customerNameDimension] ?? \"-\") || \"-\",\n    materialCode: String(row[dealerCubeContract.materialCodeDimension] ?? \"-\") || \"-\",\n    materialName: String(row[dealerCubeContract.materialNameDimension] ?? \"-\") || \"-\",\n    stock: numberOf(row[`${cube}.stock_qty`]).toLocaleString(\"zh-CN\"),\n    target: numberOf(row[`${cube}.target_inventory`]).toLocaleString(\"zh-CN\"),\n    preOrder: numberOf(row[`${cube}.pre_order_qty`]).toLocaleString(\"zh-CN\"),\n    budget: numberOf(row[`${cube}.budget_amount`]).toLocaleString(\"zh-CN\"),\n    budgetRate: formatMetricValue(\"budget_rate\", row),\n    plannedQtyRate: formatMetricValue(\"planned_qty_rate\", row),\n    shipped: numberOf(row[`${cube}.shipped_qty`]).toLocaleString(\"zh-CN\"),\n    inTransit: numberOf(row[`${cube}.in_transit_qty`]).toLocaleString(\"zh-CN\"),\n    turnoverDays: formatMetricValue(\"turnover_days\", row),\n    averageAge: formatMetricValue(\"stock_age\", row),\n    metricValue: condition ? formatMetricValue(condition.metric, row) : \"-\",\n    businessStatus: statusFilterLabel((condition?.statusFilters ?? []).filter(item => item.exclude || statusMatches(row, item.code, context) === true)),\n    status: resultStatus(row, context),\n  };\n}\n\nfunction isMetric(value: unknown): value is DealerMetric {\n  return typeof value === \"string\" && value in metricMembers;\n}\n\nfunction validMetricCondition(value: DealerMetricCondition | undefined) {\n  return value === undefined || (\n    isMetric(value.metric)\n    && [\"none\", \"gt\", \"gte\", \"lt\", \"lte\", \"equals\"].includes(value.comparison)\n    && (value.threshold === null || (typeof value.threshold === \"number\" && Number.isFinite(value.threshold) && value.threshold >= 0))\n    && (value.stockCondition === \"none\" || value.stockCondition === \"equals_zero\")\n    && [\"none\", \"below_target\", \"above_target\"].includes(value.inventoryRelation)\n    && typeof value.replenishmentRequired === \"boolean\"\n    && typeof value.agingAttentionOnly === \"boolean\"\n    && (value.orderBlocked === undefined || typeof value.orderBlocked === \"boolean\")\n    && validStatusFilters(value.statusFilters)\n    && (value.fuseStatus === undefined || value.fuseStatus === \"none\" || value.fuseStatus === \"fused\")\n  );\n}\n\nfunction matchesMetricCondition(row: CubeRow, condition: DealerMetricCondition, context = statusContext()) {\n  if (condition.statusFilters?.length && evaluateStatusFilters(row, condition.statusFilters, context) !== true) return false;\n  if (condition.fuseStatus === \"fused\" && !condition.statusFilters?.length) {\n    if (!isFusedSku(row)) return false;\n  }\n  if (condition.stockCondition === \"equals_zero\" && numberOf(row[`${cube}.stock_qty`]) !== 0) return false;\n  if (condition.comparison !== \"none\" && condition.threshold !== null) {\n    const rawValue = row[metricMembers[condition.metric]];\n    if (rawValue === null || rawValue === undefined || rawValue === \"\") return false;\n    const value = numberOf(rawValue);\n    const comparisons = {\n      gt: value > condition.threshold,\n      gte: value >= condition.threshold,\n      lt: value < condition.threshold,\n      lte: value <= condition.threshold,\n      equals: value === condition.threshold,\n    };\n    if (!comparisons[condition.comparison as Exclude<DealerMetricCondition[\"comparison\"], \"none\">]) return false;\n  }\n  const stock = numberOf(row[`${cube}.stock_qty`]);\n  const rawTarget = row[`${cube}.target_inventory`];\n  if (condition.inventoryRelation !== \"none\" && (rawTarget === null || rawTarget === undefined || rawTarget === \"\")) return false;\n  const target = numberOf(rawTarget);\n  if (condition.inventoryRelation === \"below_target\" && !(stock < target)) return false;\n  if (condition.inventoryRelation === \"above_target\" && !(stock > target)) return false;\n  if (condition.replenishmentRequired && !(numberOf(row[`${cube}.pre_order_qty`]) > 0)) return false;\n  if (condition.agingAttentionOnly && !/风险|异常|待核查|需核查/.test(String(row[dealerCubeContract.stockAgeStatusDimension] ?? \"\"))) return false;\n  if (condition.orderBlocked && statusMatches(row, \"action_blocked\", context) !== true) return false;\n  return true;\n}\n\nfunction validDetailScope(value: DealerDetailScope) {\n  return /^20\\d{2}-\\d{2}-\\d{2}$/.test(value.snapshotDate)\n    && (value.planMonth === undefined || value.planMonth === \"\" || /^20\\d{2}-\\d{2}$/.test(value.planMonth))\n    && (value.mode === \"detail\" || value.mode === \"aggregate\")\n    && (value.mode === \"detail\" || value.groupBy === \"客户\" || value.groupBy === \"SKU\")\n    && (value.orderBy === \"preOrder\" || value.orderBy === \"stockAge\" || value.orderBy === \"metric\")\n    && (value.stockCondition === undefined || value.stockCondition === \"none\" || value.stockCondition === \"equals_zero\")\n    && validMetricCondition(value.metricCondition)\n    && Array.isArray(value.customerCodes)\n    && value.customerCodes.length <= dealerCubeContract.maxCustomerLookupRows\n    && value.customerCodes.every((code) => typeof code === \"string\" && /^[A-Za-z0-9_-]{1,64}$/.test(code))\n    && (!value.materialCode || (typeof value.materialCode === \"string\" && /^[A-Za-z0-9_-]{1,64}$/.test(value.materialCode)));\n}\n\n/** Read one result-table page using the exact scope recorded by the Agent. */\nexport async function loadDeal