Only && (!stockTab || stockTab === \"category\" || stockTab === \"sku\");\n  const readShortage = !options.overviewOnly && !options.companyProductsOnly && (!stockTab || stockTab === \"shortage\");\n  const detailPage = Number.isFinite(options.detailPage)\n    ? Math.max(0, Math.floor(options.detailPage ?? 0))\n    : 0;\n  const detailPageSize = Number.isFinite(options.detailPageSize)\n    ? Math.max(1, Math.min(200, Math.floor(options.detailPageSize ?? GEA_DASHBOARD_INITIAL_ROW_LIMIT)))\n    : GEA_DASHBOARD_INITIAL_ROW_LIMIT;\n  const customerPage = Number.isFinite(options.customerPage)\n    ? Math.max(0, Math.floor(options.customerPage ?? 0))\n    : 0;\n  const customerPageSize = Number.isFinite(options.customerPageSize)\n    ? Math.max(1, Math.min(100, Math.floor(options.customerPageSize ?? 10)))\n    : 10;\n  const shortagePage = Number.isFinite(options.shortagePage)\n    ? Math.max(0, Math.floor(options.shortagePage ?? 0))\n    : 0;\n  const shortagePageSize = Number.isFinite(options.shortagePageSize)\n    ? Math.max(1, Math.min(100, Math.floor(options.shortagePageSize ?? 10)))\n    : 10;\n  const includeCompanyProducts = Boolean(options.includeCompanyProducts && requestedScope === \"single\" && scopedCustomerCodes.length === 1);\n  const fullSkuDetails = options.exportTab === \"expiry\" || stockTab === \"expiry\" || options.exportTab === \"sku\" || Boolean(options.companyProductsOnly && options.companyProductFilters?.download);\n  const customerPageResultPromise = !readCustomers\n    ? Promise.resolve({ records: [] as CubeRow[], total: customerResult.total })\n    : customerPage === 0 && customerPageSize === customerBootstrapLimit\n    ? Promise.resolve(customerResult)\n    : measure(\"customers\", () => queryWorkbenchCustomers(snapshotDate, \"\", \"\", customerPage, customerPageSize, options));\n  const dailySnapshotPromise = (autoSelectedCustomer ? null : earlyDailySnapshot) ?? measure(\"daily_snapshot\", () => queryWorkbenchLatestInventoryDailySnapshot(scopedCustomerCodes, options));\n  const categorySummaryPromise = dailySnapshotPromise.then(snapshotRows => {\n    const inventoryDailyStatDate = dateOnly(snapshotRows[0]?.[\"dealer_inventory_daily.stat_date\"]);\n    return inventoryDailyStatDate && readCategory\n      ? measure(\"category\", () => queryWorkbenchCategorySummaries(snapshotDate, planMonth, inventoryDailyStatDate, scopedCustomerCodes, options))\n      : [] as CubeRow[];\n  });\n  const [detailResult, summaryRow, customerSummaryResult, customerPageResult, inventoryDailySnapshotRows, shortageResult, categorySummaryRows] = await Promise.all([\n    readSku ? dailySnapshotPromise.then(snapshotRows => measure(\"details\", () => queryWorkbenchDashboard(snapshotDate, planMonth, scopedCustomerCodes, detailPage, detailPageSize, stockTab === \"expiry\" ? {...options, exportTab: \"expiry\"} : options, dateOnly(snapshotRows[0]?.[\"dealer_inventory_daily.stat_date\"]), options.companyProductsOnly ? options.companyProductFilters || {} : undefined))) : Promise.resolve({ records: [] as CubeRow[], total: 0 }),\n    options.companyProductsOnly || options.tabDataOnly ? Promise.resolve({} as CubeRow) : measure(\"summary\", () => queryWorkbenchSummary(snapshotDate, planMonth, scopedCustomerCodes, options)),\n    !readCustomers ? Promise.resolve({ records: [] as CubeRow[], total: 0 }) : measure(\"customer_summary\", () => queryWorkbenchCustomerSummaries(snapshotDate, planMonth, scopedCustomerCodes, customerPage, customerPageSize, options)),\n    customerPageResultPromise,\n    dailySnapshotPromise,\n    !readShortage ? Promise.resolve({ records: [] as CubeRow[], total: 0 }) : measure(\"shortage\", () => queryWorkbenchShortageDetails(snapshotDate, planMonth, scopedCustomerCodes, shortagePage, shortagePageSize, options)),\n    categorySummaryPromise,\n  ]);\n  const rows = detailResult.records;\n  const shortageRows = shortageResult.records;\n\n  const inventoryDailyStatDate = dateOnly(inventoryDailySnapshotRows[0]?.[\"dealer_inventory_daily.stat_date\"]);\n  const dailyKeysFor = (sourceRows: CubeRow[]) => {\n    const seen = new Set<string>();\n    return sourceRows.map(row=>({customerCode:String(row[\"dealer_plan_order.cust_code\"] ?? \"\").trim(),materialCode:String(row[\"dealer_plan_order.material_code\"] ?? \"\").trim()})).filter(key=>{\n      const id=JSON.stringify([key.customerCode,key.materialCode]);\n      if(!key.customerCode || !key.materialCode || seen.has(id))return false;\n      seen.add(id);return true;\n    });\n  };\n  const inventoryDailyKeys = fullSkuDetails ? [] : dailyKeysFor(rows);\n  const shortageInventoryDailyKeys = options.exportTab === \"shortage\" ? [] : dailyKeysFor(shortageRows);\n  const dailyCustomerCodes = (options.exportTab === \"customer\" ? customerSummaryResult.records : customerPageResult.records)\n    .map((row) => String(row[\"dealer_plan_order.cust_code\"] ?? \"\").trim())\n    .filter(Boolean);\n  const [inventoryDailyRows, inventoryDailySummaryRow, inventoryDailyCustomerRows, shortageInventoryDailyRows] = inventoryDailyStatDate\n    ? await Promise.all([\n        !readSku ? Promise.resolve([] as CubeRow[]) : measure(\"daily_details\", () => queryWorkbenchInventoryDailyDetails(inventoryDailyStatDate, inventoryDailyKeys, options, fullSkuDetails ? scopedCustomerCodes : undefined)),\n        (autoSelectedCustomer ? null : earlyDailySummary) ?? (options.companyProductsOnly || options.tabDataOnly ? Promise.resolve({} as CubeRow) : measure(\"daily_summary\", () => queryWorkbenchInventoryDailySummary(inventoryDailyStatDate, scopedCustomerCodes, options))),\n        !readCustomers ? Promise.resolve([] as CubeRow[]) : measure(\"daily_customers\", () => queryWorkbenchInventoryDailyCustomerSummaries(inventoryDailyStatDate, dailyCustomerCodes, options)),\n        !readShortage ? Promise.resolve([] as CubeRow[]) : measure(\"shortage_daily\", () => queryWorkbenchInventoryDailyDetails(inventoryDailyStatDate, shortageInventoryDailyKeys, options, options.exportTab === \"shortage\" ? scopedCustomerCodes : undefined)),\n      ])\n    : [[], {} as CubeRow, [] as CubeRow[], [] as CubeRow[]];\n  if (includeCompanyProducts && (\n    rows.some(row => String(row[\"dealer_plan_order.cust_code\"] ?? \"\").trim() !== activeCustomerCode)\n    || inventoryDailyRows.some(row => String(row[\"dealer_inventory_daily.cust_code\"] ?? \"\").trim() !== activeCustomerCode)\n  )) throw new GeaSqlApiError(\"商品客户范围不匹配\", \"COMPANY_PRODUCT_SCOPE_FORBIDDEN\", 403, false);\n  const inventoryDailyBySku = new Map([...inventoryDailyRows, ...shortageInventoryDailyRows].map((row) => [\n    `${String(row[\"dealer_inventory_daily.cust_code\"] ?? \"\").trim()}|${String(row[\"dealer_inventory_daily.material_code\"] ?? \"\").trim()}`,\n    row,\n  ]));\n  const dailyRowCount = numberOf(inventoryDailySummaryRow.row_count);\n  const dailyCustomerCount = numberOf(inventoryDailySummaryRow.customer_count);\n  const expectedCustomerCount = scopedCustomerCodes.length || customerResult.total;\n  const dailyInventoryCoverageComplete = dailyRowCount > 0 && dailyCustomerCount >= expectedCustomerCount;\n  const completeCount = (field: string) => dailyRowCount > 0 && numberOf(inventoryDailySummaryRow[field]) === dailyRowCount;\n  const coverageRatio = (field: string) => dailyRowCount > 0\n    ? numberOf(inventoryDailySummaryRow[field]) / dailyRowCount\n    : 0;\n  const inventoryDailySummary: DealerInventoryDailySummary | null = inventoryDailyStatDate && dailyRowCount > 0 ? {\n    noSalesSkuCount: dailyInventoryCoverageComplete ? nullableNumber(inventoryDailySummaryRow.no_sales_sku_count) : null,\n    statDate: inventoryDailyStatDate,\n    inventoryDateLabel: inventoryDateLabel(\n      dateOnly(inventoryDailySummaryRow.earliest_inventory_date),\n      dateOnly(inventoryDailySummaryRow.latest_inventory_date),\n      numberOf(inventoryDailySummaryRow.missing_inventory_date_count),\n    ),\n    rowCount: dailyRowCount,\n    customerCount: dailyCustomerCount,\n    coverageComplete: dailyInventoryCoverageComplete,\n    stockQtyComplete: completeCount(\"stock_qty_present\"),\n    inTransitQtyComplete: completeCount(\"in_transit_qty_present\"),\n    normalStockQtyComplete: completeCount(\"normal_stock_qty_present\"),\n    stockAmountComplete: completeCount(\"stock_amount_present\"),\n    sales7Complete: completeCount(\"sales_qty_7days_present\"),\n    sales7DailyAverageComplete: completeCount(\"sales_qty_7days_avg_present\"),\n    sales30Complete: completeCount(\"sales_qty_30days_present\"),\n    sales30DailyAverageComplete: completeCount(\"sales_qty_30days_avg_present\"),\n    salesAmount30Complete: completeCount(\"sales_amount_30days_present\"),\n    sales7Coverage: coverageRatio(\"sales_qty_7days_present\"),\n    sales30Coverage: coverageRatio(\"sales_qty_30days_present\"),\n    salesAmount30Coverage: coverageRatio(\"sales_amount_30days_present\"),\n    normalStockCoverage: coverageRatio(\"normal_stock_qty_present\"),\n    stockAmountCoverage: coverageRatio(\"stock_amount_present\"),\n    inventory: numberOf(inventoryDailySummaryRow.stock_qty),\n    inTransit: numberOf(inventoryDailySummaryRow.in_transit_qty),\n    normalInventory: numberOf(inventoryDailySummaryRow.normal_stock_qty),\n    stockAmount: numberOf(inventoryDailySummaryRow.stock_amount),\n    sales7: numberOf(inventoryDailySummaryRow.sales_qty_7days),\n    sales7DailyAverage: numberOf(inventoryDailySummaryRow.sales_qty_7days_avg),\n    sales30: numberOf(inventoryDailySummaryRow.sales_qty_30days),\n    sales30DailyAverage: numberOf(inventoryDailySummaryRow.sales_qty_30days_avg),\n    salesAmount30: numberOf(inventoryDailySummaryRow.sales_amount_30days),\n    salesAmount30DailyAverage: numberOf(inventoryDailySummaryRow.sales_amount_30days_avg),\n  } : null;\n\n  const { rows: deduped, dropped: dedupedRows, duplicateKeys } = dedupeRows(rows);\n  const toDashboardRecord = (row: CubeRow): DealerDashboardRecord => {\n    const dailyRow = inventoryDailyBySku.get(`${String(row[\"dealer_plan_order.cust_code\"] ?? \"\").trim()}|${String(row[\"dealer_plan_order.material_code\"] ?? \"\").trim()}`);\n    return {\n    id: `${row[\"dealer_plan_order.cust_code\"] ?? \"-\"}-${row[\"dealer_plan_order.material_code\"] ?? \"-\"}-${planMonthOf(row[planMonthDimension]) ?? \"-\"}`,\n    recordCount: numberOf(row[\"dealer_plan_order.record_count\"]),\n    planMonth: planMonthOf(row[planMonthDimension]),\n    sourceLoadTime: String(row[sourceLoadTimeDimension] ?? \"\").trim() || null,\n    updatedTime: String(row[updatedTimeDimension] ?? \"\").trim() || null,\n    customerCode: String(row[\"dealer_plan_order.cust_code\"] ?? \"\"),\n    customerName: String(row[\"dealer_plan_order.cust_name\"] ?? \"\"),\n    materialCode: String(row[\"dealer_plan_order.material_code\"] ?? \"\"),\n    materialName: String(row[\"dealer_plan_order.material_name\"] ?? \"\"),\n    productCategory: String(row[dealerCubeContract.productCategoryDimension] ?? \"\").trim() || null,\n    budget: numberOf(row[\"dealer_plan_order.budget_amount\"]),\n    shipped: numberOf(row[\"dealer_plan_order.shipped_qty\"]),\n    inTransit: numberOf(row[\"dealer_plan_order.in_transit_qty\"]),\n    inventory: nullableNumber(row[\"dealer_plan_order.stock_qty\"]),\n    turnoverDays: nullableNumber(row[\"dealer_plan_order.average_turnover_days\"]),\n    targetInventory: nullableNumber(row[\"dealer_plan_order.target_inventory\"]),\n    averageAge: nullableNumber(row[\"dealer_plan_order.average_stock_age\"]),\n    agingStatus: String(row[\"dealer_plan_order.stock_age_turnover_status\"] ?? \"\").trim() || null,\n    suggestedQuantity: numberOf(row[\"dealer_plan_order.pre_order_qty\"]),\n    publishedInTransit: nullableNumber(row[\"dealer_plan_order.in_transit_qty\"]),\n    publishedSuggestedQuantity: nullableNumber(row[\"dealer_plan_order.pre_order_qty\"]),\n    budgetRate: nullableNumber(row[\"dealer_plan_order.average_budget_rate\"]),\n    plannedQtyRate: nullableNumber(row[\"dealer_plan_order.average_planned_qty_rate\"]),\n    dataIssues: dataIssuesFor(row, duplicateKeys.has(mainGrainKey(row))).concat(dailyInventoryDataIssuesFor(dailyRow)),\n    fuseRules: fuseRulesFor({\n      customerCode: String(row[\"dealer_plan_order.cust_code\"] ?? \"\").trim(),\n      materialCode: String(row[\"dealer_plan_order.material_code\"] ?? \"\").trim(),\n    }, fuseRuleConfig),\n    orderException: orderExceptionFor({\n      customerCode: String(row[\"dealer_plan_order.cust_code\"] ?? \"\").trim(),\n      materialCode: String(row[\"dealer_plan_order.material_code\"] ?? \"\").trim(),\n    }, exceptionRuleConfig),\n    plannedQty: nullableNumber(row[\"dealer_plan_order.planned_qty\"]),\n    dailySales: nullableNumber(row[\"dealer_plan_order.daily_sales\"]),\n    shipAmount: numberOf(row[\"dealer_plan_order.ship_amount\"]),\n    unshipQty: numberOf(row[\"dealer_plan_order.unship_qty\"]),\n    unshipAmount: numberOf(row[\"dealer_plan_order.unship_amount\"]),\n    totalQty: numberOf(row[\"dealer_plan_order.total_qty\"]),\n    totalAmount: numberOf(row[\"dealer_plan_order.total_amount\"]),\n    labelTurnoverDays: nullableNumber(row[\"dealer_plan_order.label_turnover_days\"]),\n    inventorySource: String(row[\"dealer_plan_order.inventory_source\"] ?? \"\").trim() || null,\n    inventoryDailyStatDate: dateOnly(dailyRow?.[\"dealer_inventory_daily.stat_date\"]),\n    inventorySnapshotDate: dateOnly(dailyRow?.[\"dealer_inventory_daily.inventory_snapshot_date\"]),\n    actualInventory: nullableNumber(dailyRow?.[\"dealer_inventory_daily.stock_qty\"]),\n    actualInTransit: nullableNumber(dailyRow?.[\"dealer_inventory_daily.in_transit_qty\"]),\n    normalInventory: nullableNumber(dailyRow?.[\"dealer_inventory_daily.normal_stock_qty\"]),\n    stockAmount: nullableNumber(dailyRow?.[\"dealer_inventory_daily.stock_amount\"]),\n    sales7: nullableNumber(dailyRow?.[\"dealer_inventory_daily.sales_qty_7days\"]),\n    sales7DailyAverage: nullableNumber(dailyRow?.[\"dealer_inventory_daily.sales_qty_7days_avg\"]),\n    sales30: nullableNumber(dailyRow?.[\"dealer_inventory_daily.sales_qty_30days\"]),\n    sales30DailyAverage: nullableNumber(dailyRow?.[\"dealer_inventory_daily.sales_qty_30days_avg\"]),\n    salesAmount30: nullableNumber(dailyRow?.[\"dealer_inventory_daily.sales_amount_30days\"]),\n    salesAmount30DailyAverage: nullableNumber(dailyRow?.[\"dealer_inventory_daily.sales_amount_30days_avg\"]),\n    productRange: String(dailyRow?.[\"dealer_inventory_daily.product_range_name\"] ?? \"\").trim() || null,\n    productTag: String(options.companyProductsOnly ? row.catalog_product_tag ?? \"\" : dailyRow?.[\"dealer_inventory_daily.product_tag\"] ?? \"\").trim() || null,\n    materialSize: String(dailyRow?.[\"dealer_inventory_daily.material_size\"] ?? \"\").trim() || null,\n    cifPrice: nullableNumber(dailyRow?.[\"dealer_inventory_daily.cif_price\"]),\n    inventoryDailySource: String(dailyRow?.[\"dealer_inventory_daily.inventory_source\"] ?? \"\").trim() || null,\n  };\n  };\n  const records = deduped.map(toDashboardRecord).sort((left, right) =>\n    right.suggestedQuantity - left.suggestedQuantity\n    || right.shipped - left.shipped\n    || right.inTransit - left.inTransit\n    || left.materialCode.localeCompare(right.materialCode),\n  );\n  const shortageRecords = dedupeRows(shortageRows).rows.map(toDashboardRecord);\n  const ageWeight = numberOf(summaryRow.stock_age_weight);\n  const summary: DealerDashboardSummary | null = options.tabDataOnly || options.companyProductsOnly ? null : {\n    nearExpirySkuCount: nullableNumber(summaryRow.near_expiry_sku_count),\n    skuCount: numberOf(summaryRow.sku_count),\n    reasonableSkuCount: numberOf(summaryRow.reasonable_sku_count),\n    unreasonableSkuCount: numberOf(summaryRow.unreasonable_sku_count),\n    shortageSkuCount: numberOf(summaryRow.shortage_sku_count),\n    coveredSkuCount: numberOf(summaryRow.covered_sku_count),\n    budget: nullableNumber(summaryRow.budget_amount),\n    shipAmount: nullableNumber(summaryRow.ship_amount),\n    shipped: numberOf(summaryRow.shipped_qty),\n    inTransit: numberOf(summaryRow.in_transit_qty),\n    inventory: numberOf(summaryRow.stock_qty),\n    targetInventory: numberOf(summaryRow.target_inventory),\n    suggestedQuantity: numberOf(summaryRow.pre_order_qty),\n    dailySales: numberOf(summaryRow.daily_sales),\n    averageAge: ageWeight > 0 ? numberOf(summaryRow.stock_age_weighted_sum) / ageWeight : null,\n  };\n  const inventorySummaryByCustomer = new Map(customerSummaryResult.records.map((row) => [\n    String(row[\"dealer_plan_order.cust_code\"] ?? \"\"),\n    row,\n  ]));\n  const inventoryDailySummaryByCustomer = new Map(inventoryDailyCustomerRows.map((row) => [\n    String(row[\"dealer_inventory_daily.cust_code\"] ?? \"\"),\n    row,\n  ]));\n  const customerSummaries: DealerCustomerInventorySummary[] = customerPageResult.records\n    .map(asCustomer)\n    .filter((value): value is DealerCustomer => Boolean(value))\n    .map((customer) => {\n      const row = inventorySummaryByCustomer.get(customer.code);\n      const dailyRow = inventoryDailySummaryByCustomer.get(customer.code);\n      const dailyRowCount = numberOf(dailyRow?.row_count);\n      const dailyInventory = dailyRowCount > 0 && numberOf(dailyRow?.stock_qty_present) === dailyRowCount\n        ? nullableNumber(dailyRow?.[\"dealer_inventory_daily.stock_qty\"])\n        : null;\n      const dailyInTransit = dailyRowCount > 0 && numberOf(dailyRow?.in_transit_qty_present) === dailyRowCount\n        ? nullableNumber(dailyRow?.[\"dealer_inventory_daily.in_transit_qty\"])\n        : null;\n      return {\n        code: customer.code,\n        name: customer.name,\n        hasInventoryData: Boolean(row || dailyRow),\n        skuCount: numberOf(row?.sku_count),\n        inventory: dailyInventory ?? numberOf(row?.[\"dealer_plan_order.stock_qty\"]),\n        inTransit: dailyInTransit ?? numberOf(row?.[\"dealer_plan_order.in_transit_qty\"]),\n        normalInventory: nullableNumber(dailyRow?.[\"dealer_inventory_daily.normal_stock_qty\"]),\n        stockAmount: nullableNumber(dailyRow?.[\"dealer_inventory_daily.stock_amount\"]),\n        dailyRowCount,\n        normalStockCoverage: dailyRowCount > 0 ? numberOf(dailyRow?.normal_stock_qty_present) / dailyRowCount : 0,\n        stockAmountCoverage: dailyRowCount > 0 ? numberOf(dailyRow?.stock_amount_present) / dailyRowCount : 0,\n        targetInventory: numberOf(row?.[\"dealer_plan_order.target_inventory\"]),\n        suggestedQuantity: numberOf(row?.[\"dealer_plan_order.pre_order_qty\"]),\n      };\n    });\n  const categorySummaries: DealerCategoryInventorySummary[] = categorySummaryRows.map((row) => ({\n    riskInventory: nullableNumber(row.category_actual_stock_qty),\n    riskTransit: nullableNumber(row.category_actual_transit_qty),\n    riskDataComplete: numberOf(row.sku_count) > 0 && nullableNumber(row.category_risk_valid_count) === numberOf(row.sku_count),\n    category: String(row[dealerCubeContract.productCategoryDimension] ?? \"\").trim() || \"未分类\",\n    skuCount: numberOf(row.sku_count),\n    inventory: numberOf(row[\"dealer_plan_order.stock_qty\"]),\n    inTransit: numberOf(row[\"dealer_plan_order.in_transit_qty\"]),\n    normalInventory: nullableNumber(row.category_normal_stock_qty),\n    sales30: nullableNumber(row.category_sales_qty_30days),\n    stockAmount: nullableNumber(row.category_stock_amount),\n    dailyMatchedSkuCount: numberOf(row.daily_matched_sku_count),\n    targetInventory: numberOf(row[\"dealer_plan_order.target_inventory\"]),\n  }));\n  return {\n    customers,\n    customerTotal: customerResult.total,\n    customerSummaries,\n    customerSummaryTotal: customerPageResult.total,\n    customerPage,\n    customerPageSize,\n    categorySummaries,\n    shortageRecords,\n    shortageTotal: readShortage ? shortageResult.total : numberOf(summaryRow.shortage_sku_count),\n    shortagePage,\n    shortagePageSize,\n    activeCustomerCode,\n    scope: requestedScope,\n    scopeCustomerCodes: scopedCustomerCodes,\n    snapshotDate,\n    planMonth,\n    records,\n    companyProductRecords: includeCompanyProducts ? records : [],\n    recordTotal: readSku ? detailResult.total : numberOf(summaryRow.sku_count),\n    summary,\n    inventoryDailySummary,\n    dailyInventoryCoverageComplete,\n    fuseRules,\n    filterLabels,\n    metricCards,\n    stockHealth,\n    dedupedRows,\n  };\n}\n\nfunction ageRowsFromCube(rows: CubeRow[], source: DealerAgingRow[\"source\"]): DealerAgingRow[] {\n  const prefix = source === \"文沥/D-Link\" ? \"dealer_wl_stock_age\" : \"dealer_simulated_stock_age\";\n  return rows.map((row) => {\n    const statDate = dateOnly(row[`${prefix}.stat_date`]);\n    const produceDate = dateOnly(row[`${prefix}.produce_date`]);\n    return {\n      source,\n      statDate,\n      produceDate,\n      batchNo: String(row[`${prefix}.batch_no`] ?? \"\").trim() || null,\n      shipType: String(row[`${prefix}.ship_type`] ?? \"\").trim() || null,\n      ageDays: ageInDays(statDate, produceDate),\n      stockQty: numberOf(row[`${prefix}.stock_qty`]),\n      finalQty: numberOf(row[`${prefix}.final_qty`]),\n    };\n  });\n}\n\nexport async function loadDealerAging(customerCode: string, materialCode: string, inventorySource?: string | null) {\n  await assertAuthorizedSqlCustomerCodes([customerCode]);\n  const source = String(inventorySource ?? \"\").trim();\n  const isWenli = /文沥|D-Link|dlink/i.test(source);\n  const isSimulated = /提报|推演|库存推演/i.test(source);\n  if (isWenli && !isSimulated) {\n    const rows = await queryWorkbenchAging(\"wl\", customerCode, materialCode);\n    return {\n      sourceUnknown: false,\n      rows: withRatio(ageRowsFromCube(rows, \"文沥/D-Link\")),\n    };\n  }\n  if (isSimulated && !isWenli) {\n    const rows = await queryWorkbenchAging(\"simulated\", customerCode, materialCode);\n    return {\n      sourceUnknown: false,\n      rows: withRatio(ageRowsFromCube(rows, \"提报推演\")),\n    };\n  }\n  // 主表库存来源缺失或不明确：不直接穿透单一明细表、不合并口径判断，\n  // 两套来源分别展示并提示先确认主表库存口径（规划规则包 5.4/6.2）。\n  const [wlRows, simulatedRows] = await Promise.all([\n    queryWorkbenchAging(\"wl\", customerCode, materialCode),\n    queryWorkbenchAging(\"simulated\", customerCode, materialCode),\n  ]);\n  return {\n    sourceUnknown: true,\n    rows: [\n      ...withRatio(ageRowsFromCube(wlRows, \"文沥/D-Link\")),\n      ...withRatio(ageRowsFromCube(simulatedRows, \"提报推演\")),\n    ],\n  };\n}\n\nfunction withRatio(rows: DealerAgingRow[]): Array<DealerAgingRow & { ratio: number | null }> {\n  const total = rows.reduce((sum, row) => sum + row.finalQty, 0);\n  return rows.map((row) => ({\n    ...row,\n    ratio: total > 0 ? row.finalQty / total : null,\n  }));\n}\n"},"source/dealer/web/src/lib/dealer-demo-live-data.ts":{"blob":"f2abd1d6c55c108287fc9f62b127c0ae6180ad52","sha256":"6b89c1461182db4b933e0673506404b7747a05bf4572f00c2618d5c9976de3cd","text":"import \"server-only\";\nimport { dealerOverviewFacts } from \"@/lib/dealer-overview-facts\";\nimport { queryWorkbenchCustomerCars, queryWorkbenchCustomerReceives, queryWorkbenchCustomerPickupPoints, type CustomerPickupPoint, queryWorkbenchCompanyProductFacets, queryWorkbenchCompanyProductTotal } from \"@/lib/dealer-workbench-sql\";\nimport { loadDealerPromotionPolicies, type DealerPromotionResult } from \"@/lib/dealer-promotion-policy\";\nimport { loadDealerSapPrices, type SapPricingResult } from \"@/lib/dealer-sap-pricing\";\n\nimport { loadDealerDashboard, type DealerDashboardLoadOptions } from \"@/lib/dealer-dashboard\";\n\ntype Dashboard = Awaited<ReturnType<typeof loadDealerDashboard>>;\n\n/** Chinese-calendar season, evaluated in the business timezone (including leap months). */\nexport function seasonalReplenishmentReason(category: string, now = new Date()) {\n  if (!category.includes(\"粽\")) return null;\n  const parts = new Intl.DateTimeFormat(\"en-u-ca-chinese\", {timeZone:\"Asia/Shanghai\", month:\"numeric\", day:\"numeric\"}).formatToParts(now);\n  const monthText = parts.find(part => part.type === \"month\")?.value || \"\";\n  const month = Number.parseInt(monthText, 10);\n  const day = Number(parts.find(part => part.type === \"day\")?.value);\n  const leap = /bis/.test(monthText);\n  const stopped = month > 5 || (month === 5 && (leap || day >= 5)) || (month === 1 && !leap && day <= 15);\n  return stopped ? \"季节性商品过节日后不补货\" : null;\n}\n\nexport function skuExpiryFacts(age: number | null | undefined, stock: number | null | undefined) {\n  if (age == null || stock == null) return {near: 0, expired: 0, remaining: null};\n  const known = age != null && Number.isFinite(age) && age >= 0 && stock != null && Number.isFinite(stock) && stock >= 0;\n  if (!known) return {near: null, expired: null, remaining: null};\n  return {near: age! >= 365 * 2 / 3 && age! <= 365 ? stock! : 0, expired: age! > 365 ? stock! : 0, remaining: 365 - age!};\n}\n\nexport function replenishmentFacts(stock: number | null | undefined, expiryStock: number | null | undefined, transitStock: number | null | undefined, sales30: number | null | undefined) {\n  transitStock ??= 0;\n  expiryStock ??= 0;\n  const fields: [string, number | null | undefined][] = [[\"在仓库存\", stock], [\"在仓临期库存\", expiryStock], [\"在途库存\", transitStock], [\"近30日销量\", sales30]];\n  const missing = fields.flatMap(([name, value]) => value == null ? [name + \"未提供\"] : !Number.isFinite(value) || value < 0 ? [name + \"异常\"] : []);\n  if (missing.length) return {quantity: null, reason: missing.join(\"、\") + \"，暂无法计算建议备货量\", action: \"待核查\"};\n  const target = sales30! / 30 * 20;\n  const available = Math.max(stock! - expiryStock!, 0) + transitStock!;\n  const quantity = Math.max(0, Math.round(Number((target - available).toFixed(6))));\n  if (![target, available, quantity].every(Number.isFinite)) return {quantity: null, reason: \"库存或动销数值超出可计算范围，请核查数据\", action: \"待核查\"};\n  const fmt = (value: number) => new Intl.NumberFormat(\"zh-CN\", {maximumFractionDigits: 0}).format(value);\n  return {quantity, reason: `按近30日销量${fmt(sales30!)}箱、20天目标计算目标库存${fmt(target)}箱；在仓可用库存${fmt(Math.max(stock! - expiryStock!, 0))}箱，在途${fmt(transitStock!)}箱；建议备货${fmt(quantity)}箱${quantity === 0 ? \"，无需补货\" : \"\"}`, action: quantity > 0 ? \"建议补货\" : \"无需补货\"};\n}\n\nexport function missingStockFactsReason(stock: number | null | undefined, transit: number | null | undefined, target: number | null | undefined): string {\n  const fields: [string, number | null | undefined][] = [[\"在仓库存\", stock], [\"在途数量\", transit ?? 0], [\"目标备货\", target]];\n  const issues = fields.flatMap(([name, value]) => value == null ? [name + \"未提供\"] : !Number.isFinite(value) || value < 0 ? [name + \"异常\"] : []);\n  return issues.length ? issues.join(\"、\") + \"，暂无法确定建议备货量，请核查对应数据\" : \"\";\n}\n\nexport function inventoryStructureRisk(categories: Dashboard[\"categorySummaries\"]) {\n  const details = categories.map(row => {\n    const stock = row.riskInventory, transit = row.riskTransit, sales = row.sales30;\n    const complete = row.riskDataComplete === true && row.category !== \"未分类\" && [stock, transit, sales].every(value => value != null && Number.isFinite(value) && value >= 0);\n    const reasons: string[] = [];\n    if (complete) {\n      const total = stock! + transit!;\n      if (sales === 0 && total > 0) reasons.push(\"近30天无动销\");\n      if (sales! > 0 && total / (sales! / 30) < 20) reasons.push(\"覆盖低于20天\");\n      if (sales! > 0 && total / (sales! / 30) > 20) reasons.push(\"覆盖超过20天\");\n    }\n    return { category: row.category, complete, reasons };\n  });\n  return { count: details.length && details.every(row => row.complete) ? details.filter(row => row.reasons.length > 0).length : null, details };\n}\n\ntype LiveDemoSku = {\n  // 公司商品与购物车只消费真实字段，不能复用旧库存演示补齐值。\n  commerceFacts: {\n    stock: number | null;\n    transit: number | null;\n    recommendedQty: number | null;\n    nearExpiryStock: number | null;\n    price: number | null;\n    warehouse: string | null;\n  };\n  dealer: string;\n  dealerCode: string;\n  dealerName: string;\n  plannedQty: number | null;\n  region: string;\n  code: string;\n  sku: string;\n  category: string;\n  stock: number | null;\n  transit: number | null;\n  normalStock: number | null;\n  stockAmount: number | null;\n  targetInventory: number | null;\n  suggestedStockQty: number | null;\n  orderRecommendation?: {quantity: number | null; reason: string; action: string};\n  // 用户指定按平均货龄判断整款在仓库存；未知货龄不按0处理。\n  nearExpiryStock: number | null;\n  expiredStock: number | null;\n  remainingValidityDays: number | null;\n  totalValidityDays: number;\n  sales7: number | null;\n  sales30: number | null;\n  shortageSales30: number | null;\n  publishedSales7: number | null;\n  publishedSales30: number | null;\n  publishedSalesAmount30: number | null;\n  productRange: string | null;\n  productTag: string | null;\n  materialSize: string | null;\n  cifPrice: number | null;\n  averageAge: number | null;\n  inventorySnapshotDate: string | null;\n  inventoryDailySource: string | null;\n  margin: number | null;\n  price: number | null;\n  sellThrough: number | null;\n  manualQtyOverride: number;\n  manualAdjustNote: string;\n  liveAction: string;\n  liveReason: string;\n};\n\ntype LivePendingTask = {\n  id: string;\n  conversationId: string;\n  title: string;\n  createdTime: string;\n};\n\ntype LiveCategorySummary = {\n  category: string;\n  skuCount: number;\n  stock: number;\n  transit: number;\n  nearExpiryStock?: number | null;\n  normalStock: number | null;\n  sales30: number | null;\n  stockAmount: number | null;\n  dailyMatchedSkuCount: number;\n  targetInventory: number;\n};\n\ntype LiveCustomerSummary = {\n  code: string;\n  name: string;\n  hasInventoryData: boolean;\n  skuCount: number;\n  stock: number;\n  transit: number;\n  nearExpiryStock?: number | null;\n  normalStock: number | null;\n  stockAmount: number | null;\n  dailyRowCount: number;\n  normalStockCoverage: number;\n  stockAmountCoverage: number;\n  targetInventory: number;\n  suggestedQuantity: number;\n};\n\ntype CompanyProduct = Pick<LiveDemoSku, \"commerceFacts\" | \"dealerCode\" | \"code\" | \"sku\" | \"category\" | \"productTag\" | \"materialSize\" | \"publishedSales30\">;\n\ntype LiveDemoPayload = DealerPromotionResult & {\n  pricing?: SapPricingResult;\n  loadedStockTab?: DealerDashboardLoadOptions[\"stockTab\"];\n  companyProducts: CompanyProduct[];\n  companyProductsSource?: \"customer_saleable_material\";\n  companyProductTotal?: number | null;\n  companyProductFacets?: { categories: string[]; tags: string[] };\n  companyProductsStatus: \"available\" | \"partial\" | \"empty\" | \"select_customer\" | \"unavailable\";\n  customerPickupPoints?: CustomerPickupPoint[];\n  customerPickupPointsStatus?: \"available\" | \"empty\" | \"unavailable\" | \"select_customer\";\n  customerCars?: Array<{ id: string; organization: string; warehouse: string; type: string; code: string; name: string; min: string | null; max: string | null }>;\n  customerCarsStatus?: \"available\" | \"empty\" | \"unavailable\" | \"select_customer\";\n  customerReceives?: Array<{ id: string; code: string; name: string; address: string; mainDriver: string; maxDriver: string }>;\n  customerReceivesStatus?: \"available\" | \"empty\" | \"unavailable\" | \"select_customer\";\n  customerName: string;\n  customerCode: string;\n  customerOptions: Array<{ code: string; name: string }>;\n  customerCount: number;\n  customerSummaries: LiveCustomerSummary[];\n  categorySummaries: LiveCategorySummary[];\n  customerSummaryTotal: number;\n  customerPage: number;\n  customerPageSize: number;\n  scope: \"single\" | \"sales\" | \"all\";\n  scopeCustomerCodes: string[];\n  scopeLabel: string;\n  snapshotDate: string | null;\n  planMonth: string | null;\n  targetAmount: number | null;\n  completedAmount: number | null;\n  totalInventory: number;\n  totalTransitInventory: number;\n  totalTargetInventory: number;\n  totalNormalInventory: number | null;\n  totalInventoryValue: number | null;\n  inventoryDailyCustomerCount: number;\n  inventoryDailyExpectedCustomerCount: number;\n  normalStockCoverage: number | null;\n  stockAmountCoverage: number | null;\n  totalSales7: number | null;\n  totalSales30: number | null;\n  totalSalesAmount30: number | null;\n  sales7Coverage: number | null;\n  sales30Coverage: number | null;\n  salesAmount30Coverage: number | null;\n  forecastSales: number;\n  inventoryDailyStatDate: string | null;\n  inventoryDateLabel: string;\n  averageAge: number | null;\n  storeCount: number | null;\n  skuCount: number;\n  reasonableSkuCount: number;\n  unreasonableSkuCount: number;\n  nearExpirySkuCount: number | null;\n  noSalesSkuCount: number | null;\n  abnormalCategoryCount: number | null;\n  inventoryStructureRisks: ReturnType<typeof inventoryStructureRisk>[\"details\"];\n  shortageSkuCount: number;\n  coveredSkuCount: number;\n  loadedSkuCount: number;\n  recordTotal: number;\n  page: number;\n  pageSize: number;\n  skus: LiveDemoSku[];\n  shortageTotal: number;\n  shortagePage: number;\n  shortagePageSize: number;\n  shortageSkus: LiveDemoSku[];\n  mockedFields: string[];\n  // 当前经销商库存 Agent 尚未发布待审批任务数据源，页面必须保持真实空态，\n  // 不能沿用设计稿或参考项目中的示例任务。\n  pendingTaskCount: number | null;\n  pendingTasks: LivePendingTask[];\n  capabilities: {\n    nearExpiry: boolean;\n    inventoryValue: boolean;\n    normalInventory: boolean;\n    skuLifecycle: boolean;\n    storeCount: boolean;\n  };\n};\n\nfunction finite(value: number | null | undefined) {\n  return typeof value === \"number\" && Number.isFinite(value) ? value : 0;\n}\n\nfunction actionFor(record: Dashboard[\"records\"][number]) {\n  if (record.orderException || record.dataIssues.length > 0) return \"\";\n  // 订补货动作直接以数据通道返回的已核验建议量为准。\n  if (record.suggestedQuantity > 0) return \"建议补货\";\n  return \"暂无补货建议\";\n}\n\nexport function suggestedStockQuantity(target: number | null | undefined, stock: number | null | undefined, transit: number | null | undefined): number | null {\n  transit ??= 0;\n  if ([target, stock, transit].some(value => value == null || !Number.isFinite(value) || value < 0)) return null;\n  return Math.max(0, Number((target! - stock! - transit!).toFixed(6)));\n}\n\nfunction reasonFor(record: Dashboard[\"records\"][number]) {\n  const valid = (value: number | null | undefined) => value != null && Number.isFinite(value) && value >= 0 ? value : null;\n  const fmt = (value: number) => new Intl.NumberFormat(\"zh-CN\", { maximumFractionDigits: 2 }).format(value);\n  if (record.orderException) return `暂停建议：${record.orderException}`;\n  if (record.dataIssues.length) return `数据待核查：${record.dataIssues.join(\"、\")}`;\n  const stock = valid(record.actualInventory ?? record.inventory);\n  const transit = valid(record.actualInTransit ?? record.publishedInTransit);\n  const target = valid(record.targetInventory);\n  const sales = valid(record.sales30);\n  const qty = valid(record.publishedSuggestedQuantity);\n  const total = stock != null && transit != null ? stock + transit : null;\n  const reasons: string[] = [];\n  if (total != null && target != null) {\n    reasons.push(total < target\n      ? `库存${fmt(total)}箱，低于目标${fmt(target)}箱，差额${fmt(target-total)}箱`\n      : `库存${fmt(total)}箱，已达到目标${fmt(target)}箱`);\n  } else reasons.push(\"库存、在途或目标备货缺失，暂不能比较缺口\");\n  if (sales != null && sales > 0 && total != null) reasons.push(`近30日销量${fmt(sales)}箱，参考覆盖${fmt(total / (sales / 30))}天`);\n  else reasons.push(sales === 0 ? \"近30日销量为0，覆盖天数无法计算\" : \"动销或库存数据不完整，覆盖天数待核查\");\n  if (qty == null) reasons.push(\"已发布建议量缺失，需核查\");\n  else if (qty === 0) reasons.push(\"已发布建议量为0，暂无补货建议\");\n  else {\n    reasons.push(`已发布建议补货${fmt(qty)}箱`);\n    reasons.push(total != null && target != null && total >= target\n      ? \"与当前库存对比不一致，请核查建议日期及备货口径\"\n      : \"源未提供具体测算原因，以上为当前库存参考\");\n  }\n  return reasons.join(\"；\");\n}\n\n/** Adapt authorized inventory records without synthetic data fallback. */\nexport async function loadDealerDemoPayload(customerCode?: string, options: DealerDashboardLoadOptions & { orderSuggestionsOnly?: boolean } = {}): Promise<LiveDemoPayload> {\n  const reportDeliveryError = (resource: string, error: unknown) => {\n    const code = error && typeof error === \"object\" && \"code\" in error ? error.code : null;\n    console.warn(JSON.stringify({ event: \"dealer_delivery_load_failed\", resource, trace_id: options.actionId || crypto.randomUUID(),\n      source_code: typeof code === \"string\" && /^[A-Z][A-Z0-9_]{2,127}$/.test(code) ? code : \"DATA_VALIDATION_FAILED\" }));\n  };\n  const measure = async <T>(stage: string, task: () => Promise<T>): Promise<T> => {\n    const start = performance.now();\n    try { return await task(); } finally { options.onTiming?.(stage, performance.now() - start); }\n  };\n  const dashboard = await measure(\"dashboard\", () => loadDealerDashboard(customerCode, { ...options, autoSelectOnlyCustomer: true, includeCompanyProducts: !options.exportTab }));\n  const activeCustomer = dashboard.customers.find((customer) => customer.code === dashboard.activeCustomerCode);\n  if (!activeCustomer || !dashboard.snapshotDate) throw new Error(\"当前授权范围没有可展示的经销商库存数据\");\n\n  const promotionPromise = dashboard.scope === \"single\" && !options.companyProductsOnly && !options.tabDataOnly && !options.exportTab\n    ? measure(\"policies\", () => loadDealerPromotionPolicies(activeCustomer.code, { ...options }))\n    : Promise.resolve({ policies: [], policiesStatus: \"select_customer\" as const });\n\n  const catalogTotalPromise = dashboard.scope === \"single\" && !options.companyProductsOnly && !options.tabDataOnly && !options.exportTab && !options.orderSuggestionsOnly\n    ? measure(\"catalog_count\", async () => {\n      try { return await queryWorkbenchCompanyProductTotal(activeCustomer.code, options); }\n      catch (error) { if (options.signal?.aborted) throw error; return null; }\n    }) : Promise.resolve(null);\n\n  const pickupsPromise = measure(\"pickups\", async () => {\n    if (dashboard.scope !== \"single\" || options.companyProductsOnly || options.tabDataOnly || options.exportTab)\n      return {customerPickupPoints: [] as CustomerPickupPoint[], customerPickupPointsStatus: \"select_customer\" as const};\n    try {\n      const points = await queryWorkbenchCustomerPickupPoints(activeCustomer.code, options);\n      return {customerPickupPoints: points, customerPickupPointsStatus: points.length ? \"available\" as const : \"empty\" as const};\n    } catch (error) {\n      if (options.signal?.aborted) throw options.signal.reason;\n      reportDeliveryError(\"customer_pickup\", error);\n      return {customerPickupPoints: [] as CustomerPickupPoint[], customerPickupPointsStatus: \"unavailable\" as const};\n    }\n  });\n  const carsPromise = measure(\"cars\", async () => {\n    let customerCars: NonNullable<LiveDemoPayload[\"customerCars\"]> = [];\n    let customerCarsStatus: LiveDemoPayload[\"customerCarsStatus\"] = \"select_customer\";\n    if (dashboard.scope === \"single\" && !options.companyProductsOnly && !options.tabDataOnly && !options.exportTab) {\n      try {\n        const rows = await queryWorkbenchCustomerCars(activeCustomer.code, { ...options });\n        if (rows.some(row => String(row.cust_code) !== activeCustomer.code || !String(row.source_record_id ?? \"\").trim() || !String(row.car_code ?? \"\").trim()) || new Set(rows.map(row => String(row.source_record_id))).size !== rows.length) throw new Error(\"车型客户范围或标识不匹配\");\n        customerCars = rows.map(row => ({\n          id: String(row.source_record_id), organization: String(row.organization_id ?? \"\"),\n          warehouse: String(row.warehouse_group_id ?? \"\"), type: String(row.car_type ?? \"\"),\n          code: String(row.car_code ?? \"\"), name: String(row.car_name ?? \"\"),\n          min: row.min_discount_num == null ? null : String(row.min_discount_num),\n          max: row.max_discount_num == null ? null : String(row.max_discount_num),\n        }));\n        customerCarsStatus = rows.length ? \"available\" : \"empty\";\n      } catch (error) {\n        if (options.signal?.aborted) throw options.signal.reason;\n        reportDeliveryError(\"customer_car\", error);\n        customerCarsStatus = \"unavailable\";\n      }\n    }\n    return { customerCars, customerCarsStatus };\n  });\n  const receivesPromise = measure(\"receives\", async () => {\n    let customerReceives: NonNullable<LiveDemoPayload[\"customerReceives\"]> = [];\n    let customerReceivesStatus: LiveDemoPayload[\"customerReceivesStatus\"] = \"select_customer\";\n    if (dashboard.scope === \"single\" && !options.companyProductsOnly && !options.tabDataOnly && !options.exportTab) {\n      try {\n        const rows = await queryWorkbenchCustomerReceives(activeCustomer.code, { ...options });\n        if (rows.some(row => String(row.cust_code) !== activeCustomer.code || !String(row.source_record_id ?? \"\").trim() || !String(row.receive_cust_code ?? \"\").trim())\n          || new Set(rows.map(row => String(row.source_record_id))).size !== rows.length) throw new Error(\"收货地数据范围或标识异常\");\n        customerReceives = rows.map(row => ({\n          id: String(row.source_record_id), code: String(row.receive_cust_code), name: String(row.receive_cust_name ?? \"\"),\n          address: String(row.goods_address ?? \"\"), mainDriver: String(row.main_drivertype ?? \"\"), maxDriver: String(row.max_drivertype ?? \"\"),\n        }));\n        customerReceivesStatus = rows.length ? \"available\" : \"empty\";\n      } catch (error) {\n        if (options.signal?.aborted) throw options.signal.reason;\n        reportDeliveryError(\"customer_receive\", error);\n        customerReceivesStatus = \"unavailable\";\n      }\n    }\n    return { customerReceives, customerReceivesStatus };\n  });\n  let sapPrices = new Map<string, number>();\n  const orderPrice = (record: Dashboard[\"records\"][number]) => record.customerCode === activeCustomer.code ? sapPrices.get(record.materialCode) ?? null : null;\n  const inventoryDailySummary = dashboard.inventoryDailySummary;\n  const overviewFacts = dealerOverviewFacts(dashboard.summary, inventoryDailySummary);\n  const hasInventoryValue = Boolean(inventoryDailySummary?.stockAmountCoverage);\n  const hasNormalInventory = Boolean(inventoryDailySummary?.normalStockCoverage);\n  const liveSkuFor = (record: Dashboard[\"records\"][number], useDailyInventory = true): LiveDemoSku => {\n    const inventory = (useDailyInventory ? record.actualInventory ?? record.inventory : record.inventory) ?? null;\n    const realTransit = (useDailyInventory ? record.actualInTransit ?? record.publishedInTransit : record.publishedInTransit) ?? 0;\n    const transit = realTransit;\n    const targetInventory = record.targetInventory ?? null;\n    const blockingDataIssues = record.dataIssues.filter((issue) => ![\n      \"日均销量缺失或为0\",\n      \"目标库存缺失\",\n      \"平均货龄缺失\",\n    ].includes(issue));\n    const validOrderSuggestion = !record.orderException && blockingDataIssues.length === 0;\n    const expiry = skuExpiryFacts(record.averageAge, useDailyInventory ? record.actualInventory ?? record.inventory : record.inventory);\n    const recommendation = replenishmentFacts(\n      useDailyInventory ? record.actualInventory ?? record.inventory : record.inventory,\n      expiry.near == null || expiry.expired == null ? null : expiry.near + expiry.expired, realTransit, record.sales30);\n    const orderInputs = [useDailyInventory ? record.actualInventory ?? record.inventory : record.inventory,\n      expiry.near == null || expiry.expired == null ? null : expiry.near + expiry.expired, realTransit, record.sales30];\n    const orderMissing = [\"在仓库存\", \"在仓临期库存\", \"在途库存\", \"近30日销量\"].filter((_, index) => orderInputs[index] == null);\n    const orderRecommendation = replenishmentFacts(orderInputs[0] ?? 0, orderInputs[1] ?? 0, orderInputs[2] ?? 0, orderInputs[3] ?? 0);\n    const orderIssues = blockingDataIssues.filter(issue => [\"主粒度重复\", \"平均货龄为负\", \"统一到岸价为负\"].includes(issue));\n    if (record.orderException || orderIssues.length) {\n      orderRecommendation.quantity = null;\n      orderRecommendation.action = \"待核查\";\n      orderRecommendation.reason = \"业务校验未通过：\" + (record.orderException || orderIssues.join(\"、\"));\n    }\n    if (orderRecommendation.quantity != null && orderRecommendation.quantity > 0) {\n      const integerQuantity = Math.round(orderRecommendation.quantity);\n      if (integerQuantity !== orderRecommendation.quantity) orderRecommendation.reason += \"；整箱订货四舍五入为\" + integerQuantity + \"箱\";\n      orderRecommendation.quantity = integerQuantity;\n    }\n    if (orderMissing.length) orderRecommendation.reason += \"；仅订单计算：\" + orderMissing.join(\"、\") + \"缺失按0参与计算，源数据仍缺失\";\n    const seasonalReason = record.materialCode === \"10005290\" ? \"商品已下架，不推荐补货\" : seasonalReplenishmentReason(record.productCategory || \"\");\n    if (seasonalReason) {\n      Object.assign(recommendation, {quantity:0, action:\"无需补货\", reason:seasonalReason});\n      Object.assign(orderRecommendation, {quantity:0, action:\"无需补货\", reason:seasonalReason});\n    }\n    const suggestedStockQty = recommendation.quantity;\n    const noReplenishment = suggestedStockQty === 0;\n    return {\n      commerceFacts: {\n        stock: useDailyInventory ? record.actualInventory ?? record.inventory : record.inventory,\n        transit: realTransit,\n        recommendedQty: suggestedStockQty == null ? null : noReplenishment ? 0 : !validOrderSuggestion ? null : suggestedStockQty,\n        nearExpiryStock: expiry.near,\n        price: orderPrice(record),\n        warehouse: null,\n      },\n      dealer: record.customerCode,\n      dealerCode: record.customerCode,\n      plannedQty: record.plannedQty ?? null,\n      dealerName: record.customerName || record.customerCode,\n      region: \"已授权范围\",\n      code: record.materialCode,\n      sku: record.materialName || record.materialCode,\n      category: record.productCategory || \"未分类\",\n      stock: inventory,\n      transit,\n      normalStock: record.normalInventory,\n      stockAmount: record.stockAmount,\n      targetInventory,\n      suggestedStockQty,\n      orderRecommendation,\n      nearExpiryStock: expiry.near,\n      expiredStock: expiry.expired,\n      totalValidityDays: 365,\n      remainingValidityDays: expiry.remaining,\n      sales7: record.sales7 ?? null,\n      sales30: record.sales30 ?? null,\n      shortageSales30: record.dailySales != null && record.dailySales > 0 ? record.dailySales * 30 : null,\n      publishedSales7: record.sales7,\n      publishedSales30: record.sales30,\n      publishedSalesAmount30: record.salesAmount30,\n      productRange: record.productRange,\n      productTag: record.productTag,\n      materialSize: record.materialSize,\n      cifPrice: record.cifPrice,\n      averageAge: record.averageAge ?? null,\n      inventorySnapshotDate: record.inventorySnapshotDate,\n      inventoryDailySource: record.inventoryDailySource,\n      margin: null,\n      price: orderPrice(record),\n      sellThrough: null,\n      manualQtyOverride: suggestedStockQty != null && !noReplenishment && validOrderSuggestion ? suggestedStockQty : 0,\n      manualAdjustNote: suggestedStockQty == null ? \"补货数据待完善\" : \"按20天目标及可用库存计算\",\n      liveAction: suggestedStockQty == null ? recommendation.action : !noReplenishment && !validOrderSuggestion ? \"待核查\" : recommendation.action,\n      liveReason: suggestedStockQty != null && !noReplenishment && !validOrderSuggestion ? recommendation.reason + \"；业务校验未通过：\" + (record.orderException || blockingDataIssues.join(\"、\")) : recommendation.reason,\n\n    };\n  };\n  // Reuse the final recommendation builder; non-suggested SKUs cannot consume the SAP budget.\n  const pricingRecords = options.orderSuggestionsOnly\n    ? dashboard.records.filter(record => (record.plannedQty ?? 0) > 0 && record.materialCode !== \"10005290\" && (liveSkuFor(record).orderRecommendation?.quantity ?? 0) > 0)\n    : [...dashboard.records, ...dashboard.shortageRecords, ...(dashboard.companyProductRecords || [])];\n  const pricingPromise = dashboard.scope === \"single\"\n    ? measure(\"sap_pricing\", async () => {\n      if (pricingRecords.some(record => record.customerCode !== activeCustomer.code)) throw new Error(\"定价商品客户范围不匹配\");\n      return loadDealerSapPrices(activeCustomer.code, pricingRecords.map(record => record.materialCode), { signal: options.signal, traceId: options.actionId });\n    }) : Promise.resolve(undefined);\n\n  const [promotionResult, { customerCars, customerCarsStatus }, { customerReceives, customerReceivesStatus }, pricing, companyProductTotal, { customerPickupPoints, customerPickupPointsStatus }] = await Promise.all([promotionPromise, carsPromise, receivesPromise, pricingPromise, catalogTotalPromise, pickupsPromise]);\n  sapPrices = new Map(pricing?.data?.prices.map(item => [item.materialCode, item.price]) ?? []);\n\n  const skus = dashboard.records.map(record => liveSkuFor(record));\n  const shortageSkus = dashboard.shortageRecords.map(record => liveSkuFor(record, false));\n\n  return {\n    ...promotionResult,\n    pricing,\n    loadedStockTab: options.stockTab,\n    companyProductFacets: options.companyProductFacets && dashboard.scope === \"single\"\n      ? await measure(\"catalog_facets\", () => queryWorkbenchCompanyProductFacets(dashboard.snapshotDate!, dashboard.planMonth!, activeCustomer.code, options)) : undefined,\n    companyProductsSource: \"customer_saleable_material\",\n    companyProductTotal,\n    companyProducts: (options.companyProductsOnly ? dashboard.companyProductRecords || [] : []).map(record => ({\n      dealerCode: record.customerCode, code: record.materialCode, sku: record.materialName || record.materialCode,\n      category: record.productCategory || \"-\", productTag: record.productTag, materialSize: record.materialSize,\n      publishedSales30: record.sales30,\n      commerceFacts: {\n        stock: record.actualInventory ?? record.inventory,\n        transit: record.actualInTransit ?? record.publishedInTransit ?? 0,\n        recommendedQty: record.orderException || record.dataIssues.length ? null : record.publishedSuggestedQuantity ?? null,\n        nearExpiryStock: skuExpiryFacts(record.averageAge, record.actualInventory ?? record.inventory).near, price: orderPrice(record), warehouse: null,\n      },\n    })),\n    companyProductsStatus: dashboard.scope !== \"single\" ? \"select_customer\" : !options.companyProductsOnly ? companyProductTotal == null ? \"unavailable\" : companyProductTotal === 0 ? \"empty\" : \"partial\" : dashboard.recordTotal > (dashboard.companyProductRecords?.length ?? 0) ? \"partial\" : dashboard.companyProductRecords?.length ? \"available\" : \"empty\",\n    customerPickupPoints,\n    customerPickupPointsStatus,\n    customerCars,\n    customerCarsStatus,\n    customerReceives,\n    customerReceivesStatus,\n    customerName: activeCustomer.name,\n    customerCode: activeCustomer.code,\n    customerOptions: dashboard.customers,\n    customerCount: dashboard.customerTotal,\n    customerSummaries: dashboard.customerSummaries.map((customer) => ({\n      code: customer.code,\n      name: customer.name,\n      hasInventoryData: customer.hasInventoryData,\n      skuCount: customer.skuCount,\n      stock: customer.inventory,\n      transit: customer.inTransit ?? 0,\n      nearExpiryStock: 0, // 汇总源未提供临期数量，按用户约定取0。\n      normalStock: customer.normalInventory,\n      stockAmount: customer.stockAmount,\n      dailyRowCount: customer.dailyRowCount,\n      normalStockCoverage: customer.normalStockCoverage,\n      stockAmountCoverage: customer.stockAmountCoverage,\n      targetInventory: customer.targetInventory,\n      suggestedQuantity: customer.suggestedQuantity,\n    })),\n    categorySummaries: dashboard.categorySummaries.map((category) => ({\n      category: category.category,\n      skuCount: category.skuCount,\n      stock: category.inventory,\n      transit: category.inTransit ?? 0,\n      nearExpiryStock: 0, // 汇总源未提供临期数量，按用户约定取0。\n      normalStock: category.normalInventory,\n      sales30: category.sales30,\n      stockAmount: category.stockAmount,\n      dailyMatchedSkuCount: category.dailyMatchedSkuCount,\n      targetInventory: category.targetInventory,\n    })),\n    customerSummaryTotal: dashboard.customerSummaryTotal,\n    customerPage: dashboard.customerPage,\n    customerPageSize: dashboard.customerPageSize,\n    scope: dashboard.scope,\n    scopeCustomerCodes: dashboard.scopeCustomerCodes,\n    scopeLabel: dashboard.scope === \"sales\"\n      ? \"全部负责客户\"\n      : dashboard.scope === \"all\"\n        ? \"全部授权客户\"\n        : activeCustomer.name,\n    snapshotDate: dashboard.snapshotDate,\n    planMonth: dashboard.planMonth,\n    targetAmount: dashboard.summary?.budget ?? null,\n    completedAmount: dashboard.summary?.shipAmount ?? null,\n    totalInventory: overviewFacts.inventory ?? 0,\n    totalTransitInventory: overviewFacts.inTransit ?? 0,\n    totalTargetInventory: overviewFacts.targetInventory ?? 0,\n    totalNormalInventory: hasNormalInventory ? inventoryDailySummary?.normalInventory ?? null : null,\n    totalInventoryValue: hasInventoryValue ? inventoryDailySummary?.stockAmount ?? null : null,\n    inventoryDailyCustomerCount: inventoryDailySummary?.customerCount ?? 0,\n    inventoryDailyExpectedCustomerCount: dashboard.scopeCustomerCodes.length || dashboard.customerTotal,\n    normalStockCoverage: inventoryDailySummary?.normalStockCoverage ?? null,\n    stockAmountCoverage: inventoryDailySummary?.stockAmountCoverage ?? null,\n    totalSales7: inventoryDailySummary?.sales7Coverage\n      ? inventoryDailySummary.sales7\n      : null,\n    totalSales30: inventoryDailySummary?.sales30Coverage\n      ? inventoryDailySummary.sales30\n      : null,\n    totalSalesAmount30: inventoryDailySummary?.salesAmount30Coverage\n      ? inventoryDailySummary.salesAmount30\n      : null,\n    sales7Coverage: inventoryDailySummary?.sales7Coverage ?? null,\n    sales30Coverage: inventoryDailySummary?.sales30Coverage ?? null,\n    salesAmount30Coverage: inventoryDailySummary?.salesAmount30Coverage ?? null,\n    forecastSales: overviewFacts.forecastSales ?? 0,\n    inventoryDailyStatDate: inventoryDailySummary?.statDate ?? null,\n    inventoryDateLabel: inventoryDailySummary?.inventoryDateLabel ?? \"未提供\",\n    skuCount: dashboard.summary?.skuCount ?? dashboard.recordTotal ?? dashboard.records.length,\n    reasonableSkuCount: dashboard.summary?.reasonableSkuCount ?? 0,\n    unreasonableSkuCount: dashboard.summary?.unreasonableSkuCount ?? 0,\n    nearExpirySkuCount: dashboard.summary?.nearExpirySkuCount ?? 0,\n    noSalesSkuCount: inventoryDailySummary?.noSalesSkuCount ?? null,\n    abnormalCategoryCount: inventoryStructureRisk(dashboard.categorySummaries).count,\n    inventoryStructureRisks: inventoryStructureRisk(dashboard.categorySummaries).details,\n    shortageSkuCount: dashboard.summary?.shortageSkuCount ?? 0,\n    coveredSkuCount: dashboard.summary?.coveredSkuCount ?? 0,\n    loadedSkuCount: dashboard.records.length,\n    recordTotal: dashboard.recordTotal,\n    page: Math.max(0, Math.floor(options.detailPage ?? 0)),\n    pageSize: Math.max(1, Math.min(200, Math.floor(options.detailPageSize ?? 10))),\n    averageAge: dashboard.summary?.averageAge ?? null,\n    storeCount: null,\n    skus,\n    shortageTotal: dashboard.shortageTotal,\n    shortagePage: dashboard.shortagePage,\n    shortagePageSize: dashboard.shortagePageSize,\n    shortageSkus,\n    mockedFields: [],\n    pendingTaskCount: null,\n    pendingTasks: [],\n    capabilities: {\n      nearExpiry: true,\n      inventoryValue: hasInventoryValue,\n      normalInventory: hasNormalInventory,\n      skuLifecycle: false,\n      storeCount: false,\n    },\n  };\n}\n"},"source/dealer/web/src/lib/dealer-overview-facts.ts":{"blob":"4adb47b366d92c54ed5d4cb5d641155cdb3e05fe","sha256":"55db967b3a1e9f43c42801d0c5a498821595c8969ac9df4741d35b0d9bb052ee","text":"/** One selection policy for workbench cards and conversational overviews. */\nimport type { DealerDashboardSummary, DealerInventoryDailySummary } from \"@/lib/dealer-dashboard\";\n\nexport function dealerOverviewFacts(plan: DealerDashboardSummary | null, daily: DealerInventoryDailySummary | null) {\n  const inventory = daily?.coverageComplete && daily.stockQtyComplete ? daily.inventory : plan?.inventory ?? null;\n  const inTransit = daily?.coverageComplete && daily.inTransitQtyComplete ? daily.inTransit : plan?.inTransit ?? null;\n  const forecastSales = daily?.coverageComplete && daily.sales30DailyAverageComplete ? daily.sales30 : plan ? plan.dailySales * 30 : null;\n  const totalInventory = inventory !== null && inTransit !== null ? inventory + inTransit : null;\n  const shortage = plan?.shortageSkuCount ?? null;\n  return {\n    inventory, inTransit, totalInventory, forecastSales,\n    averageCover: totalInventory !== null && forecastSales !== null && forecastSales > 0 ? Math.round(totalInventory / (forecastSales / 30)) : null,\n    stockAmount: daily?.stockAmountCoverage ? daily.stockAmount : null,\n    targetInventory: plan?.targetInventory ?? null,\n    reasonableSkuCount: plan?.reasonableSkuCount ?? null,\n    unreasonableSkuCount: plan?.unreasonableSkuCount ?? null,\n    shortageSkuCount: shortage, coveredSkuCount: plan?.coveredSkuCount ?? null,\n    skuCount: plan?.skuCount ?? null,\n    // 批次临期、无动销和异常品类计数尚未发布，按 v1.0.1 显示待完善分数。\n    healthScore: 0,\n    healthStatus: \"数据待完善\",\n    expirySkuCount: null,\n    inventorySource: daily?.coverageComplete && daily.stockQtyComplete ? \"库存日快照\" : \"预订单全范围汇总\",\n    transitSource: daily?.coverageComplete && daily.inTransitQtyComplete ? \"库存日快照\" : \"预订单全范围汇总\",\n    coverageSource: daily?.coverageComplete && daily.sales30DailyAverageComplete ? \"库存日快照近30日销量\" : \"预订单日均销量\",\n    dailyCustomerCount: daily?.customerCount ?? 0,\n    dailyCoverageComplete: daily?.coverageComplete ?? false,\n    stockAmountCoverage: daily?.stockAmountCoverage ?? 0,\n  };\n}\n"},"source/dealer/web/src/lib/dealer-promotion-policy.ts":{"blob":"7d0bdfdb1f3acca78128263795db32d979d608f9","sha256":"0f6e076d4e1c646757844423bde01b67172f811ca4f4c38a6382e134e05952f3","text":"import \"server-only\";\n\nimport { queryWorkbenchPromotionPolicies, queryWorkbenchCustomerPickupPoints } from \"@/lib/dealer-workbench-sql\";\nimport type { GeaSqlRequestOptions, GeaSqlRow } from \"@/lib/gea-sql-client\";\n\nexport type PromotionScope = {\n  id: string;\n  level: string;\n  productCode: string;\n  productName: string;\n  pickupCode: string;\n  pickupName: string;\n  verifiedPickupCodes?: string[];\n  start: string;\n  end: string | null;\n  conditions: string;\n};\n\nexport type DealerPromotionPolicy = {\n  id: string;\n  name: string;\n  customerCode: string;\n  type: string;\n  start: string;\n  end: string | null;\n  rule: string;\n  pickupPoint: string;\n  pickupCode: string;\n  pickupName: string;\n  limit: string | null;\n  verifiedDefaultPickupName?: string;\n  verifiedPickupCodes?: string[];\n  usableQuantity: string | null;\n  usedQuantity: string | null;\n  isCustomerExclusive: boolean | null;\n  scopes: PromotionScope[];\n  mock: false;\n};\n\nexport type DealerPromotionResult = {\n  policies: DealerPromotionPolicy[];\n  policiesStatus: \"available\" | \"empty\" | \"unavailable\" | \"select_customer\";\n  policiesError?: { stage: \"policy_query\" | \"pickup_query\" | \"scope_validation\"; code: string; message: string; requestId?: string };\n};\n\nconst text = (value: unknown) => value == null ? \"\" : String(value).trim();\nconst date = (value: unknown) => text(value).slice(0, 10);\nconst decimal = (value: unknown) => value == null ? null : text(value);\nconst period = (start: unknown, end: unknown) => `${date(start) || \"-\"} 至 ${date(end) || \"未设置结束日期\"}`;\n\nexport function promotionBusinessDate(now = new Date()) {\n  return new Intl.DateTimeFormat(\"en-CA\", { timeZone: \"Asia/Shanghai\", year: \"numeric\", month: \"2-digit\", day: \"2-digit\" }).format(now);\n}\n\n/** 保留源条件，不解析政策名称计算折扣，不将空商品范围解释为全部商品。 */\nexport function mapDealerPromotionPolicies(rows: GeaSqlRow[], customerCode: string, businessDate: string): DealerPromotionPolicy[] {\n  const policies = new Map<string, DealerPromotionPolicy>();\n  for (const row of rows) {\n    if (text(row.customer_code) !== customerCode || text(row.data_type) !== \"cust\") throw new Error(\"政策客户范围不匹配\");\n    const id = text(row.promotion_code);\n    if (!id || !text(row.range_record_id)) throw new Error(\"政策标识缺失\");\n    // 视图未发布独立范围周期/批次；商品范围沿用政策周期，空日期不限该侧。\n    const start = date(row.promotion_start_date);\n    const end = date(row.promotion_end_date) || null;\n    if ((start && start > businessDate) || (end && end < businessDate)) continue;\n    let policy = policies.get(id);\n    if (!policy) {\n      policy = {\n        id, name: text(row.promotion_name) || id, customerCode, type: text(row.promotion_type),\n        start, end,\n        rule: [text(row.remarks), text(row.policy_gift_remarks),\n          row.goods_age_range ? `货龄要求：${text(row.goods_age_range)}` : \"\",\n          row.policy_purchase_start_date || row.policy_purchase_end_date ? `采购批次：${period(row.policy_purchase_start_date, row.policy_purchase_end_date)}` : \"\",\n          row.policy_gift_start_date || row.policy_gift_end_date ? `赠品批次：${period(row.policy_gift_start_date, row.policy_gift_end_date)}` : \"\",\n        ].filter(Boolean).join(\"；\"),\n        pickupPoint: \"\", pickupCode: text(row.policy_pup_code), pickupName: text(row.policy_pup_name), limit: decimal(row.promotion_limit), usableQuantity: decimal(row.usable_quantity), usedQuantity: decimal(row.used_quantity),\n        isCustomerExclusive: typeof row.is_customer_exclusive === 'boolean' ? row.is_customer_exclusive : null,\n        scopes: [], mock: false,\n      };\n      policies.set(id, policy);\n    }\n    if (!policy.scopes.some(scope => scope.id === text(row.range_record_id))) policy.scopes.push({\n      id: text(row.range_record_id), level: text(row.scope_level), productCode: text(row.product_code), productName: text(row.product_name),\n      pickupCode: text(row.pup_code) || text(row.policy_pup_code), pickupName: text(row.pup_name) || text(row.policy_pup_name),\n      start, end, conditions: \"\",\n    });\n  }\n  for (const policy of policies.values()) policy.pickupPoint = [...new Set(policy.scopes.map(scope => scope.pickupName || scope.pickupCode || \"未指定提货点\"))].join(\"、\");\n  return [...policies.values()];\n}\n\n/** 仅读取已授权单客户。失败时保持真实错误态，不补造活动。 */\nexport async function loadDealerPromotionPolicies(customerCode: string, options: GeaSqlRequestOptions = {}): Promise<DealerPromotionResult> {\n  if (!customerCode.trim()) return { policies: [], policiesStatus: \"select_customer\" };\n  let policies: DealerPromotionPolicy[] = [];\n  let stage: \"policy_query\" | \"pickup_query\" | \"scope_validation\" = \"policy_query\";\n  try {\n    const businessDate = promotionBusinessDate();\n    const rows = await queryWorkbenchPromotionPolicies(customerCode, businessDate, options);\n    if (!rows.length) return {policies:[], policiesStatus:\"empty\"};\n    stage = \"scope_validation\";\n    policies = mapDealerPromotionPolicies(rows, customerCode, businessDate)\n      .map(policy => ({...policy, verifiedPickupCodes: [],\n        scopes: policy.scopes.map(scope => ({...scope, verifiedPickupCodes: []}))}));\n    if (!policies.length) return {policies: [], policiesStatus: \"empty\"};\n    stage = \"pickup_query\";\n    const pickupRows = await queryWorkbenchCustomerPickupPoints(customerCode, options);\n    const pickups = pickupRows.filter(point => point.available);\n    // 源范围用于展示；核验结果只决定优惠是否可用，不删除或补造源范围。\n    policies = policies.map(policy => {\n      const scopes = policy.scopes.map(scope => {\n        const matches = !scope.pickupCode && !scope.pickupName ? pickups\n          : scope.pickupCode ? pickups.filter(point => point.code === scope.pickupCode)\n          : pickups.filter(point => point.name && point.name === scope.pickupName);\n        const verified = !scope.pickupCode && scope.pickupName && matches.length !== 1 ? [] : matches;\n        return {...scope, verifiedPickupCodes: verified.map(point => point.code)};\n      });\n      return {...policy, scopes, verifiedPickupCodes: [...new Set(scopes.flatMap(scope => scope.verifiedPickupCodes))]};\n    });\n    return { policies, policiesStatus: policies.length ? \"available\" : \"empty\" };\n  } catch (error) {\n    if (options.signal?.aborted) throw options.signal.reason;\n    const rawCode = error && typeof error === \"object\" && \"code\" in error ? String(error.code) : \"QUERY_FAILED\";\n    const code = /^[A-Z0-9_]{1,64}$/.test(rawCode) ? rawCode : \"QUERY_FAILED\";\n    const message = {policy_query:\"政策查询失败\", pickup_query:\"客户提货点查询失败\", scope_validation:\"政策或客户提货点范围校验失败\"}[stage];\n    const details = error && typeof error === \"object\" && \"details\" in error ? error.details : null;\n    const candidate = details && typeof details === \"object\"\n      ? (\"gatewayRequestId\" in details ? details.gatewayRequestId : \"traceId\" in details ? details.traceId : null) : null;\n    const requestId = typeof candidate === \"string\" && /^[A-Za-z0-9_.:-]{1,128}$/.test(candidate) ? candidate : undefined;\n    return { policies: stage === \"pickup_query\" ? policies : [], policiesStatus: stage === \"pickup_query\" ? \"available\" : \"unavailable\", policiesError: {stage, code, message, ...(requestId ? {requestId} : {})} };\n  }\n}\n"},"source/dealer/web/src/lib/dealer-status-filters.ts":{"blob":"1928f810695d0dd3a96661fa875a86eab268d5b2","sha256":"cbf3022fe0bf52c26b1a33c415dc69aeedca6611af31b739b3118a69cd812344","text":"/** Read-only business predicates. Unknown facts remain unknown under exclusion. */\nexport const statusLabels = {\n  fuse_normal: \"货龄正常\", fuse_low: \"低风险\", fuse_high: \"高风险\", fuse_fused: \"已熔断\", fuse_attention: \"货龄风险\",\n  health_urgent: \"告急\", health_healthy: \"库存健康\", health_high: \"库存偏高\", health_slow: \"滞销\",\n  supply_short: \"缺货\", supply_enough: \"保障充足\", stock_reasonable: \"合理备货\", stock_unreasonable: \"不合理备货\",\n  action_attention: \"需关注/暂缓\", action_deferred: \"暂缓补货\", action_cautious: \"谨慎补货\",\n  action_suggested: \"有建议补货量\", action_none: \"无建议补货量\", action_blocked: \"不可下单或需确认\", data_abnormal: \"数据异常\",\n  age_new: \"新近货龄\", age_regular: \"常规货龄\", age_attention: \"关注货龄\", age_old: \"长货龄\", sales_zero: \"无动销\", expiry: \"临期/过期\",\n} as const;\nexport type DealerStatusFilter = {code: keyof typeof statusLabels; exclude: boolean};\ntype Row = Record<string, string | number | null | undefined>;\ntype Tri = boolean | null;\nexport type StatusContext = {\n  fuse: (row: Row) => string;\n  health: (days: number | null) => string;\n  ageBand: (days: number | null) => string;\n  dataIssues: (row: Row) => boolean;\n  exception: (row: Row) => boolean;\n};\nexport function validStatusFilters(value: unknown): value is DealerStatusFilter[] | undefined {\n  return value === undefined || (Array.isArray(value) && value.length <= 24 && value.every(item => item && typeof item.code === \"string\" && Object.hasOwn(statusLabels, item.code) && typeof item.exclude === \"boolean\"));\n}\nexport function statusDimension(code: string) { return code === \"action_blocked\" ? \"eligibility\" : code.split(\"_\")[0]; }\nexport function statusNumber(value: unknown) {\n  if (value === null || value === undefined || typeof value === \"boolean\" || String(value).trim() === \"\") return null;\n  const number = Number(value);\n  return Number.isFinite(number) ? number : null;\n}\nexport function statusMatches(row: Row, code: DealerStatusFilter[\"code\"], context: StatusContext): Tri {\n  if (code === \"action_attention\") return [\"需核查\", \"暂缓补货\"].includes(rowActionStatus(row, context));\n  const value = (key: string) => statusNumber(row[`dealer_plan_order.${key}`]);\n  if (code.startsWith(\"fuse_\")) {\n    const level = context.fuse(row);\n    if (![\"normal\", \"low\", \"high\", \"fused\"].includes(level)) return null;\n    return code === \"fuse_attention\" ? [\"low\", \"high\", \"fused\"].includes(level) : code === `fuse_${level}`;\n  }\n  if (code.startsWith(\"health_\")) {\n    const level = context.health(value(\"average_turnover_days\"));\n    if (![\"告急\", \"健康\", \"偏高\", \"滞销\"].includes(level)) return null;\n    return level === ({health_urgent: \"告急\", health_healthy: \"健康\", health_high: \"偏高\", health_slow: \"滞销\"} as Record<string, string>)[code];\n  }\n  if (code.startsWith(\"supply_\") || code.startsWith(\"stock_\")) {\n    const stock = value(\"stock_qty\"), transit = value(\"in_transit_qty\");\n    if (stock === null || stock < 0 || transit === null || transit < 0) return null;\n    const available = stock + transit;\n    if (code.startsWith(\"supply_\")) {\n      const sales = value(\"daily_sales\");\n      if (sales === null || sales <= 0) return null;\n      return code === \"supply_short\" ? available / sales < 13 : available / sales >= 13;\n    }\n    const target = value(\"target_inventory\");\n    if (target === null || target < 0) return null;\n    return code === \"stock_reasonable\" ? available >= target : available < target;\n  }\n  if (code === \"action_deferred\" || code === \"action_cautious\") {\n    const blocked = statusMatches(row, \"action_blocked\", context);\n    if (blocked === null) return null;\n    if (blocked) return false;\n    const stock = value(\"stock_qty\"), target = value(\"target_inventory\"), qty = value(\"pre_order_qty\");\n    if (stock === null || target === null || qty === null) return null;\n    const aging = String(row[\"dealer_plan_order.stock_age_turnover_status\"] ?? \"\").trim();\n    if (/风险|异常/.test(aging)) return false;\n    const deferred = qty <= 0 && stock >= target;\n    return code === \"action_deferred\" ? deferred : !aging && !deferred && !(qty > 0 && stock < target);\n  }\n  if (code === \"action_suggested\" || code === \"action_none\") {\n    const qty = value(\"pre_order_qty\");\n    return qty === null || qty < 0 ? null : code === \"action_suggested\" ? qty > 0 : qty === 0;\n  }\n  if (code === \"data_abnormal\") return context.dataIssues(row);\n  if (code === \"action_blocked\") {\n    if (context.dataIssues(row) || context.exception(row)) return true;\n    const fuse = context.fuse(row);\n    return fuse === \"unknown\" ? null : [\"high\", \"fused\"].includes(fuse);\n  }\n  if (code.startsWith(\"age_\")) {\n    const band = context.ageBand(value(\"average_stock_age\"));\n    if (![\"新近\", \"常规\", \"关注\", \"长货龄\"].includes(band)) return null;\n    return band === ({age_new: \"新近\", age_regular: \"常规\", age_attention: \"关注\", age_old: \"长货龄\"} as Record<string, string>)[code];\n  }\n  if (code === \"sales_zero\") { const sales = value(\"daily_sales\"); return sales === null || sales < 0 ? null : sales === 0; }\n  return null;\n}\n/** Shared with the answer summary: review-needed OR deferred, with guard priority. */\nexport function rowActionStatus(row: Row, context: StatusContext): string {\n  const value = (key: string) => statusNumber(row[`dealer_plan_order.${key}`]) ?? 0;\n  if (context.dataIssues(row)) return \"需核查\";\n  if (context.exception(row)) return \"不可下单\";\n  const level = context.fuse(row);\n  const qty = value(\"pre_order_qty\");\n  if (level === \"fused\") return \"熔断暂停建议\";\n  if (level === \"high\") return qty > 0 ? \"高风险需确认\" : \"需核查\";\n  const aging = String(row[\"dealer_plan_order.stock_age_turnover_status\"] ?? \"\").trim();\n  if (/风险|异常/.test(aging)) return \"需核查\";\n  if (qty > 0 && value(\"stock_qty\") < value(\"target_inventory\")) return \"建议补货\";\n  if (qty <= 0 && value(\"stock_qty\") >= value(\"target_inventory\")) return \"暂缓补货\";\n  return aging || \"谨慎补货\";\n}\nexport function evaluateStatusFilters(row: Row, filters: DealerStatusFilter[], context: StatusContext): Tri {\n  const groups = new Map<string, Tri[]>();\n  for (const item of filters) {\n    const key = item.exclude ? `exclude:${item.code}` : statusDimension(item.code);\n    const value = statusMatches(row, item.code, context);\n    groups.set(key, [...(groups.get(key) ?? []), item.exclude && value !== null ? !value : value]);\n  }\n  const results = [...groups.values()].map(values => values.includes(true) ? true : values.includes(null) ? null : false);\n  return results.includes(false) ? false : results.includes(null) ? null : true;\n}\nexport function statusFilterLabel(filters: DealerStatusFilter[]) {\n  const groups = new Map<string, string[]>();\n  for (const item of filters) {\n    const key = item.exclude ? `exclude:${item.code}` : statusDimension(item.code);\n    groups.set(key, [...(groups.get(key) ?? []), `${item.exclude ? \"排除\" : \"\"}${statusLabels[item.code]}`]);\n  }\n  return [...groups.values()].map(labels => labels.length > 1 ? `（${labels.join(\"或\")}）` : labels[0]).join(\"且\");\n}\n"},"source/dealer/web/src/lib/dealer-workbench-sql.ts":{"blob":"7999338ac9739d37d420228959322642391b4adc","sha256":"51fe1dfa68d6870044124196debf59fc6c80e3112a545cde396334069ee45830","text":"import \"server-only\";\n\nimport {\n  executeAllGeaSqlPages,\n  executeGeaSql,\n  executeGeaSqlPage,\n  type GeaSqlParameters,\n  type GeaSqlRequestOptions,\n  type GeaSqlRow,\n} from \"@/lib/gea-sql-client\";\nimport {\n  executeAllDirectSqlPages,\n  executeDirectSql,\n  executeDirectSqlPage,\n} from \"@/lib/dealer-direct-sql-client\";\n\n// GEA 的 SQL 重写器只接受已发布资源名。生产数据源需将 currentSchema\n// 配为 data_service，因此目录内不携带 PostgreSQL schema 前缀。\nfunction configuredResourceName(name: string, fallback: string) {\n  const value = process.env[name]?.trim() || fallback;\n  if (!/^[A-Za-z_][A-Za-z0-9_$]*$/.test(value)) {\n    throw new Error(`${name} 只能配置 GEA 已发布的无 schema 资源名`);\n  }\n  return value;\n}\n\nfunction saleableMaterialTable() {\n  return configuredResourceName(\"DEALER_WORKBENCH_SQL_SALEABLE_MATERIAL_TABLE\", \"agents_scm_customer_saleable_material\");\n}\n\nfunction promotionScopeView() {\n  return configuredResourceName(\"DEALER_WORKBENCH_SQL_PROMOTION_SCOPE_VIEW\", \"agents_scm_promotion_policy_scope_view\");\n}\n\n/** 展示仅约束客户、政策状态和周期，提货点在使用优惠时独立核验。 */\nfunction promotionScopeConditions(dateParameter: \"businessDate\" | \"catalogToday\") {\n  return `s.scope_status = 1 AND s.scope_delete_status = 1 AND s.policy_status = 1 AND s.policy_delete_status = 1\n       AND (s.promotion_start_date IS NULL OR s.promotion_start_date <= CAST(:${dateParameter} AS DATE))\n       AND (s.promotion_end_date IS NULL OR s.promotion_end_date >= CAST(:${dateParameter} AS DATE))`;\n}\n\n// 默认沿用已发布的受控资源；若 GEA 管理端使用其它资源名，只改部署配置，\n// 不需要重新修改或构建工作台代码。\nconst MAIN_TABLE = configuredResourceName(\n  \"DEALER_WORKBENCH_SQL_MAIN_TABLE\",\n  \"agents_scm_cust_plan_order_analysis_governed\",\n);\nconst WL_AGE_TABLE = configuredResourceName(\n  \"DEALER_WORKBENCH_SQL_WL_AGE_TABLE\",\n  \"agents_scm_wl_cust_stock_age_governed\",\n);\nconst SIMULATED_AGE_TABLE = configuredResourceName(\n  \"DEALER_WORKBENCH_SQL_SIMULATED_AGE_TABLE\",\n  \"agents_scm_cust_stock_age_governed\",\n);\nconst INVENTORY_DAILY_TABLE = configuredResourceName(\n  \"DEALER_WORKBENCH_SQL_INVENTORY_DAILY_TABLE\",\n  \"agents_scm_cust_inventory_daily\",\n);\n\ntype WorkbenchRow = Record<string, string | number | null | undefined>;\ntype SqlQuery = { sql: string; parameters: GeaSqlParameters };\nexport type CompanyProductFilters = {\n  search?: string;\n  category?: string;\n  productTag?: string;\n  policyCode?: string;\n  policySearch?: string;\n  materialCodes?: string[];\n  download?: boolean;\n};\nexport type InventoryDailyKey = { customerCode: string; materialCode: string };\n\nfunction useDirectDatabase() {\n  const transport = process.env.DEALER_WORKBENCH_DATA_TRANSPORT?.trim().toLowerCase();\n  return transport === \"direct\" || transport === \"postgres\";\n}\n\nfunction executeWorkbenchSql(sql: string, options: GeaSqlRequestOptions) {\n  return useDirectDatabase() ? executeDirectSql(sql, options) : executeGeaSql(sql, options);\n}\n\nfunction executeWorkbenchSqlPage(sql: string, pageNo: number, pageSize: number, options: GeaSqlRequestOptions) {\n  return useDirectDatabase()\n    ? executeDirectSqlPage(sql, pageNo, pageSize, options)\n    : executeGeaSqlPage(sql, pageNo, pageSize, options);\n}\n\nfunction executeAllWorkbenchSqlPages(sql: string, options: GeaSqlRequestOptions) {\n  return useDirectDatabase()\n    ? executeAllDirectSqlPages(sql, options)\n    : executeAllGeaSqlPages(sql, options);\n}\n\nexport type WorkbenchResultSqlScope = {\n  snapshotDate: string;\n  planMonth?: string;\n  customerCodes: string[];\n  materialCode: string;\n  mode: \"detail\" | \"aggregate\";\n  groupBy: string;\n  orderColumn: string;\n};\n\nconst mainColumnToCubeMember: Record<string, string> = {\n  record_count: \"dealer_plan_order.record_count\",\n  snapshot_date: \"dealer_plan_order.snapshot_date\",\n  plan_month: \"dealer_plan_order.plan_month\",\n  cust_code: \"dealer_plan_order.cust_code\",\n  cust_name: \"dealer_plan_order.cust_name\",\n  material_code: \"dealer_plan_order.material_code\",\n  material_name: \"dealer_plan_order.material_name\",\n  product_categ_name: \"dealer_plan_order.product_categ_name\",\n  inventory_source: \"dealer_plan_order.inventory_source\",\n  stock_age_turnover_status: \"dealer_plan_order.stock_age_turnover_status\",\n  source_load_time: \"dealer_plan_order.source_load_time\",\n  updated_time: \"dealer_plan_order.updated_time\",\n  budget_amount: \"dealer_plan_order.budget_amount\",\n  shipped_qty: \"dealer_plan_order.shipped_qty\",\n  ship_amount: \"dealer_plan_order.ship_amount\",\n  unship_qty: \"dealer_plan_order.unship_qty\",\n  unship_amount: \"dealer_plan_order.unship_amount\",\n  total_qty: \"dealer_plan_order.total_qty\",\n  total_amount: \"dealer_plan_order.total_amount\",\n  planned_qty: \"dealer_plan_order.planned_qty\",\n  daily_sales: \"dealer_plan_order.daily_sales\",\n  in_transit_qty: \"dealer_plan_order.in_transit_qty\",\n  stock_qty: \"dealer_plan_order.stock_qty\",\n  target_inventory: \"dealer_plan_order.target_inventory\",\n  pre_order_qty: \"dealer_plan_order.pre_order_qty\",\n  average_turnover_days: \"dealer_plan_order.average_turnover_days\",\n  label_turnover_days: \"dealer_plan_order.label_turnover_days\",\n  average_stock_age: \"dealer_plan_order.average_stock_age\",\n  average_budget_rate: \"dealer_plan_order.average_budget_rate\",\n  average_planned_qty_rate: \"dealer_plan_order.average_planned_qty_rate\",\n};\n\nconst inventoryDailyColumnToCubeMember: Record<string, string> = {\n  stat_date: \"dealer_inventory_daily.stat_date\",\n  inventory_snapshot_date: \"dealer_inventory_daily.inventory_snapshot_date\",\n  cust_code: \"dealer_inventory_daily.cust_code\",\n  cust_name: \"dealer_inventory_daily.cust_name\",\n  material_code: \"dealer_inventory_daily.material_code\",\n  material_name: \"dealer_inventory_daily.material_name\",\n  product_range_name: \"dealer_inventory_daily.product_range_name\",\n  product_tag: \"dealer_inventory_daily.product_tag\",\n  material_size: \"dealer_inventory_daily.material_size\",\n  measure_unit: \"dealer_inventory_daily.measure_unit\",\n  cif_price: \"dealer_inventory_daily.cif_price\",\n  stock_qty: \"dealer_inventory_daily.stock_qty\",\n  in_transit_qty: \"dealer_inventory_daily.in_transit_qty\",\n  normal_stock_qty: \"dealer_inventory_daily.normal_stock_qty\",\n  stock_amount: \"dealer_inventory_daily.stock_amount\",\n  sales_qty_7days_avg: \"dealer_inventory_daily.sales_qty_7days_avg\",\n  sales_qty_7days: \"dealer_inventory_daily.sales_qty_7days\",\n  sales_qty_30days_avg: \"dealer_inventory_daily.sales_qty_30days_avg\",\n  sales_qty_30days: \"dealer_inventory_daily.sales_qty_30days\",\n  sales_amount_30days: \"dealer_inventory_daily.sales_amount_30days\",\n  sales_amount_30days_avg: \"dealer_inventory_daily.sales_amount_30days_avg\",\n  source_load_time: \"dealer_inventory_daily.source_load_time\",\n  inventory_source: \"dealer_inventory_daily.inventory_source\",\n  updated_time: \"dealer_inventory_daily.updated_time\",\n};\n\nconst MAIN_SELECT = `\n  1 AS record_count,\n  snapshot_date,\n  plan_month,\n  cust_code,\n  cust_name,\n  material_code,\n  material_name,\n  product_categ_name,\n  inventory_source,\n  stock_age_turnover_status,\n  source_load_time,\n  updated_time,\n  simulation_need_amount AS budget_amount,\n  ship_qty AS shipped_qty,\n  ship_amount,\n  unship_qty,\n  unship_amount,\n  total_qty,\n  total_amount,\n  planned_qty,\n  daily_sales,\n  in_transit_qty,\n  stock_qty,\n  target_inventory,\n  pre_order_qty,\n  turnover_days AS average_turnover_days,\n  label_turnover_days,\n  avg_stock_age AS average_stock_age,\n  budget_rate AS average_budget_rate,\n  planned_qty_rate AS average_planned_qty_rate`;\n\nfunction assertIdentifier(value: string, label: string) {\n  const normalized = value.trim();\n  if (!/^[A-Za-z0-9_-]{1,64}$/.test(normalized)) throw new Error(`${label}格式无效`);\n  return normalized;\n}\n\nfunction assertDate(value: string, label: string, pattern: RegExp) {\n  const normalized = value.trim();\n  if (!pattern.test(normalized)) throw new Error(`${label}格式无效`);\n  return normalized;\n}\n\nfunction customerPredicate(customerCodes: string[], parameters: GeaSqlParameters, column = \"cust_code\") {\n  if (!customerCodes.length) return \"\";\n  const placeholders = customerCodes.map((code, index) => {\n    const name = `customerCode${index}`;\n    parameters[name] = assertIdentifier(code, \"客户编码\");\n    return `:${name}`;\n  });\n  return ` AND ${column} IN (${placeholders.join(\", \")})`;\n}\n\nfunction inventoryDailyKeyPredicate(keys: InventoryDailyKey[], parameters: GeaSqlParameters) {\n  if (!keys.length) return \" AND 1 = 0\";\n  if (keys.length > 200) throw new Error(\"库存日快照单次最多查询200个客户-SKU键\");\n  return ` AND (${keys.map((key, index) => {\n    const customerName = `dailyCustomerCode${index}`;\n    const materialName = `dailyMaterialCode${index}`;\n    parameters[customerName] = assertIdentifier(key.customerCode, \"客户编码\");\n    parameters[materialName] = assertIdentifier(key.materialCode, \"SKU编码\");\n    return `(cust_code = :${customerName} AND material_code = :${materialName})`;\n  }).join(\" OR \")})`;\n}\n\nfunction scopedWhere(snapshotDate: string, planMonth: string | undefined, customerCodes: string[], materialCode = \"\") {\n  const parameters: GeaSqlParameters = {\n    snapshotDate: assertDate(snapshotDate, \"快照日期\", /^20\\d{2}-\\d{2}-\\d{2}$/),\n  };\n  // GEA/JDBC binds JSON dates as VARCHAR; cast parameters, keeping date columns indexable.\n  let where = \"snapshot_date = CAST(:snapshotDate AS DATE)\";\n  if (planMonth) {\n    parameters.planMonth = `${assertDate(planMonth, \"计划月份\", /^20\\d{2}-\\d{2}$/)}-01`;\n    where += \" AND plan_month = CAST(:planMonth AS DATE)\";\n  }\n  where += customerPredicate(customerCodes, parameters);\n  if (materialCode) {\n    parameters.materialCode = assertIdentifier(materialCode, \"SKU编码\");\n    where += \" AND material_code = :materialCode\";\n  }\n  return { where, parameters };\n}\n\nfunction toCubeRows(rows: GeaSqlRow[]): WorkbenchRow[] {\n  return rows.map((row) => Object.fromEntries(\n    Object.entries(row).map(([key, value]) => [mainColumnToCubeMember[key] ?? key, value]),\n  ));\n}\n\nfunction toInventoryDailyCubeRows(rows: GeaSqlRow[]): WorkbenchRow[] {\n  return rows.map((row) => Object.fromEntries(\n    Object.entries(row).map(([key, value]) => [inventoryDailyColumnToCubeMember[key] ?? key, value]),\n  ));\n}\n\nexport const dealerWorkbenchSql = {\n  latestSnapshot(customerCodes: string[] = []): SqlQuery {\n    const parameters: GeaSqlParameters = {};\n    return {\n      sql: `SELECT (SELECT snapshot_date FROM ${MAIN_TABLE}\nWHERE snapshot_date IS NOT NULL${customerPredicate(customerCodes, parameters)}\nORDER BY snapshot_date DESC LIMIT 1) AS snapshot_date`,\n      parameters,\n    };\n  },\n\n  latestInventoryDailySnapshot(customerCodes: string[] = []): SqlQuery {\n    const parameters: GeaSqlParameters = {};\n    return {\n      sql: `SELECT MAX(stat_date) AS stat_date\nFROM ${INVENTORY_DAILY_TABLE}\nWHERE 1 = 1${customerPredicate(customerCodes, parameters)}`,\n      parameters,\n    };\n  },\n\n  inventoryDailyDetails(statDate: string, keys: InventoryDailyKey[], exportCustomerCodes?: string[]): SqlQuery {\n    const parameters: GeaSqlParameters = {\n      statDate: assertDate(statDate, \"库存统计日期\", /^20\\d{2}-\\d{2}-\\d{2}$/),\n    };\n    const keyFilter = exportCustomerCodes === undefined ? inventoryDailyKeyPredicate(keys, parameters) : customerPredicate(exportCustomerCodes, parameters);\n    return {\n      sql: `SELECT\n  stat_date,\n  inventory_snapshot_date,\n  cust_code,\n  cust_name,\n  material_code,\n  material_name,\n  product_range_name,\n  product_tag,\n  material_size,\n  measure_unit,\n  cif_price,\n  stock_qty,\n  in_transit_qty,\n  normal_stock_qty,\n  stock_amt AS stock_amount,\n  sales_qty_7days_avg,\n  sales_qty_7days,\n  sales_qty_30days_avg,\n  sales_qty_30days,\n  sales_amt_30days AS sales_amount_30days,\n  sales_amt_30days_avg AS sales_amount_30days_avg,\n  source_load_time,\n  inventory_source,\n  updated_time\nFROM ${INVENTORY_DAILY_TABLE}\nWHERE stat_date = CAST(:statDate AS DATE)${keyFilter}\nORDER BY cust_code ASC, material_code ASC`,\n      parameters,\n    };\n  },\n\n  inventoryDailySummary(statDate: string, customerCodes: string[]): SqlQuery {\n    const parameters: GeaSqlParameters = {\n      statDate: assertDate(statDate, \"库存统计日期\", /^20\\d{2}-\\d{2}-\\d{2}$/),\n    };\n    return {\n      sql: `SELECT\n  COUNT(*) AS row_count,\n  CASE WHEN COUNT(*) = COUNT(CASE WHEN stock_qty >= 0 AND sales_qty_30days >= 0 THEN 1 END)\n    THEN COUNT(DISTINCT CASE WHEN stock_qty > 0 AND sales_qty_30days = 0 THEN (TRIM(cust_code), TRIM(material_code)) END)\n    ELSE NULL END AS no_sales_sku_count,\n  MIN(inventory_snapshot_date) AS earliest_inventory_date,\n  MAX(inventory_snapshot_date) AS latest_inventory_date,\n  COUNT(*) - COUNT(inventory_snapshot_date) AS missing_inventory_date_count,\n  COUNT(DISTINCT cust_code) AS customer_count,\n  COUNT(stock_qty) AS stock_qty_present,\n  COUNT(in_transit_qty) AS in_transit_qty_present,\n  COUNT(normal_stock_qty) AS normal_stock_qty_present,\n  COUNT(stock_amt) AS stock_amount_present,\n  COUNT(sales_qty_7days) AS sales_qty_7days_present,\n  COUNT(sales_qty_7days_avg) AS sales_qty_7days_avg_present,\n  COUNT(sales_qty_30days) AS sales_qty_30days_present,\n  COUNT(sales_qty_30days_avg) AS sales_qty_30days_avg_present,\n  COUNT(sales_amt_30days) AS sales_amount_30days_present,\n  SUM(stock_qty) AS stock_qty,\n  SUM(in_transit_qty) AS in_transit_qty,\n  SUM(normal_stock_qty) AS normal_stock_qty,\n  SUM(stock_amt) AS stock_amount,\n  SUM(sales_qty_7days) AS sales_qty_7days,\n  SUM(sales_qty_7days_avg) AS sales_qty_7days_avg,\n  SUM(sales_qty_30days) AS sales_qty_30days,\n  SUM(sales_qty_30days_avg) AS sales_qty_30days_avg,\n  SUM(sales_amt_30days) AS sales_amount_30days,\n  SUM(sales_amt_30days_avg) AS sales_amount_30days_avg\nFROM ${INVENTORY_DAILY_TABLE}\nWHERE stat_date = CAST(:statDate AS DATE)${customerPredicate(customerCodes, parameters)}`,\n      parameters,\n    };\n  },\n\n  inventoryDailyCustomerSummaries(statDate: string, customerCodes: string[]): SqlQuery {\n    const parameters: GeaSqlParameters = {\n      statDate: assertDate(statDate, \"库存统计日期\", /^20\\d{2}-\\d{2}-\\d{2}$/),\n    };\n    return {\n      sql: `SELECT\n  cust_code,\n  COALESCE(NULLIF(MAX(cust_name), ''), cust_code) AS cust_name,\n  COUNT(*) AS row_count,\n  COUNT(stock_qty) AS stock_qty_present,\n  COUNT(in_transit_qty) AS in_transit_qty_present,\n  COUNT(normal_stock_qty) AS normal_stock_qty_present,\n  COUNT(stock_amt) AS stock_amount_present,\n  SUM(stock_qty) AS stock_qty,\n  SUM(in_transit_qty) AS in_transit_qty,\n  SUM(normal_stock_qty) AS normal_stock_qty,\n  SUM(stock_amt) AS stock_amount\nFROM ${INVENTORY_DAILY_TABLE}\nWHERE stat_date = CAST(:statDate AS DATE)${customerPredicate(customerCodes, parameters)}\nGROUP BY cust_code\nORDER BY cust_code ASC`,\n      parameters,\n    };\n  },\n\n  snapshotMonths(customerCodes: string[]): SqlQuery {\n    const parameters: GeaSqlParameters = {};\n    // Only months belonging to the latest authorized snapshot are used by the page.\n    const scope = customerPredicate(customerCodes, parameters);\n    return { sql: `WITH latest AS (\n  SELECT snapshot_date FROM ${MAIN_TABLE}\n  WHERE snapshot_date IS NOT NULL${scope}\n  ORDER BY snapshot_date DESC LIMIT 1\n)\nSELECT snapshot_date, plan_month FROM ${MAIN_TABLE}\nWHERE snapshot_date = (SELECT snapshot_date FROM latest)${scope}\nGROUP BY snapshot_date, plan_month\nORDER BY snapshot_date DESC, plan_month DESC`, parameters };\n  },\n\n  customers(snapshotDate: string, search = \"\", exactCode = \"\"): SqlQuery {\n    const parameters: GeaSqlParameters = {\n      snapshotDate: assertDate(snapshotDate, \"快照日期\", /^20\\d{2}-\\d{2}-\\d{2}$/),\n    };\n    let filters = \"\";\n    if (exactCode) {\n      parameters.exactCustomerCode = assertIdentifier(exactCode, \"客户编码\");\n      filters += \" AND cust_code = :exactCustomerCode\";\n    }\n    if (search.trim()) {\n      parameters.customerSearch = `%${search.trim().slice(0, 100).toLocaleLowerCase(\"zh-CN\")}%`;\n      filters += \" AND (LOWER(cust_code) LIKE :customerSearch OR LOWER(cust_name) LIKE :customerSearch)\";\n    }\n    return {\n      sql: `SELECT cust_code, COALESCE(NULLIF(MAX(cust_name), ''), cust_code) AS cust_name\nFROM ${MAIN_TABLE}\nWHERE snapshot_date = CAST(:snapshotDate AS DATE)${filters}\nGROUP BY cust_code\nORDER BY cust_code ASC`,\n      parameters,\n    };\n  },\n\n  planMonths(snapshotDate: string, customerCodes: string[]): SqlQuery {\n    const { where, parameters } = scopedWhere(snapshotDate, undefined, customerCodes);\n    return {\n      sql: `SELECT plan_month\nFROM ${MAIN_TABLE}\nWHERE ${where}\nGROUP BY plan_month\nORDER BY plan_month DESC`,\n      parameters,\n    };\n  },\n\n  dashboard(snapshotDate: string, planMonth: string, customerCodes: string[], inventoryStatDate?: string): SqlQuery {\n    const { where, parameters } = scopedWhere(snapshotDate, planMonth, customerCodes);\n    if (inventoryStatDate) parameters.inventoryStatDate = assertDate(inventoryStatDate, \"库存统计日期\", /^20\\d{2}-\\d{2}-\\d{2}$/);\n    return {\n      sql: inventoryStatDate ? `SELECT ${MAIN_SELECT.replace(/\\n  ([a-z_]+)/g, \"\\n  plan.$1\")}\nFROM ${MAIN_TABLE} plan\nLEFT JOIN agents_scm_cust_inventory_daily_keys daily\n  ON daily.stat_date = CAST(:inventoryStatDate AS DATE) AND daily.cust_code = plan.cust_code AND daily.material_code = plan.material_code\nWHERE ${where.replace(/\\b(snapshot_date|plan_month|cust_code)\\b/g, \"plan.$1\")}\nORDER BY CASE WHEN daily.cust_code IS NULL THEN 1 ELSE 0 END, plan.pre_order_qty DESC NULLS LAST, plan.cust_code ASC, plan.material_code ASC, plan.plan_month ASC`\n        : `SELECT ${MAIN_SELECT}\nFROM ${MAIN_TABLE}\nWHERE ${where}\nORDER BY pre_order_qty DESC NULLS LAST, cust_code ASC, material_code ASC, plan_month ASC`,\n      parameters,\n    };\n  },\n\n  companyProducts(snapshotDate: string, planMonth: string, customerCodes: string[], inventoryStatDate: string | undefined, filters: CompanyProductFilters = {}, facets = false): SqlQuery {\n    if (customerCodes.length !== 1) throw new Error(\"公司商品必须限定单个授权客户\");\n    const { parameters } = scopedWhere(snapshotDate, planMonth, customerCodes);\n    if (inventoryStatDate) parameters.inventoryStatDate = assertDate(inventoryStatDate, \"库存统计日期\", /^20\\d{2}-\\d{2}-\\d{2}$/);\n    const tagExpression = \"catalog.material_sales_status\";\n    const conditions = [\"catalog.cust_code = :customerCode0\", \"catalog.material_code IS NOT NULL\", \"TRIM(catalog.material_code) <> ''\"];\n    // Business-confirmed delisting; historical customer stock remains visible.\n    conditions.push(\"catalog.material_code <> '10005290'\");\n    const joins = [`LEFT JOIN ${MAIN_TABLE} plan ON plan.snapshot_date = CAST(:snapshotDate AS DATE) AND plan.plan_month = CAST(:planMonth AS DATE) AND plan.cust_code = catalog.cust_code AND plan.material_code = catalog.material_code`];\n    if (filters.search?.trim()) {\n      parameters.catalogSearch = `%${filters.search.trim().toLowerCase().replace(/[\\\\%_]/g, \"\\\\$&\")}%`;\n      conditions.push(\"(LOWER(catalog.material_name) LIKE :catalogSearch OR LOWER(catalog.material_code) LIKE :catalogSearch)\");\n    }\n    if (filters.category) {\n      parameters.catalogCategory = filters.category;\n      conditions.push(\"COALESCE(NULLIF(plan.product_categ_name, ''), '-') = :catalogCategory\");\n    }\n    if (filters.productTag) {\n      parameters.catalogTag = filters.productTag;\n      conditions.push(`COALESCE(NULLIF(${tagExpression}, ''), '-') = :catalogTag`);\n    }\n    if (filters.materialCodes) {\n      if (!filters.materialCodes.length || filters.materialCodes.length > 100) throw new Error(\"商品核验每次需提供 1 至 100 个 SKU\");\n      const names = [...new Set(filters.materialCodes)].map((code, index) => {\n        const name = `catalogCode${index}`;\n        parameters[name] = assertIdentifier(code, \"商品编码\");\n        return `:${name}`;\n      });\n      conditions.push(`catalog.material_code IN (${names.join(\", \")})`);\n    }\n    if (filters.policyCode || filters.policySearch?.trim()) {\n      if (filters.policyCode) {\n        parameters.catalogPolicy = filters.policyCode;\n        conditions.push(\"s.promotion_code = :catalogPolicy\");\n      }\n      if (filters.policySearch?.trim()) {\n        parameters.catalogPolicySearch = `%${filters.policySearch.trim().toLowerCase().replace(/[\\\\%_]/g, \"\\\\$&\")}%`;\n        conditions.push(\"(LOWER(s.promotion_name) LIKE :catalogPolicySearch OR LOWER(s.promotion_code) LIKE :catalogPolicySearch)\");\n      }\n      parameters.catalogToday = new Intl.DateTimeFormat(\"en-CA\", { timeZone: \"Asia/Shanghai\", year: \"numeric\", month: \"2-digit\", day: \"2-digit\" }).format(new Date());\n      const scope = promotionScopeView();\n      joins.push(`JOIN ${scope} s ON s.customer_code = catalog.cust_code AND s.product_code = catalog.material_code`);\n      conditions.push(\"s.data_type = 'cust'\", promotionScopeConditions(\"catalogToday\"));\n    }\n    const catalogValues: Record<string, string> = {\n      snapshot_date: \"CAST(:snapshotDate AS DATE)\", plan_month: \"CAST(:planMonth AS DATE)\",\n      cust_code: \"catalog.cust_code\", cust_name: \"MAX(catalog.cust_name)\",\n      material_code: \"catalog.material_code\", material_name: \"MAX(catalog.material_name)\",\n    };\n    // Aggregate duplicate cooperation/policy rows without multiplying stock or quantities.\n    const columns = MAIN_SELECT.split(\",\").slice(1).map(column => {\n      const [name, , alias] = column.trim().split(/\\s+/);\n      return `${catalogValues[name] || \"MAX(plan.\" + name + \")\"} AS ${alias || name}`;\n    }).join(\", \");\n    const from = `FROM ${saleableMaterialTable()} catalog\n${joins.join(\"\\n\")}\nWHERE ${conditions.join(\" AND \")}`;\n    return { sql: facets\n      ? `SELECT plan.product_categ_name, ${tagExpression} AS product_tag\n${from}\nGROUP BY plan.product_categ_name, ${tagExpression}\nORDER BY product_categ_name, product_tag`\n      : `SELECT 1 AS record_count, ${columns},\nSTRING_AGG(DISTINCT NULLIF(${tagExpression}, ''), '、' ORDER BY NULLIF(${tagExpression}, '')) AS catalog_product_tag,\nMIN(CASE WHEN ${tagExpression} = '新品' THEN 0 ELSE 1 END) AS catalog_new_rank\n${from}\nGROUP BY catalog.cust_code, catalog.material_code\nORDER BY catalog_new_rank, pre_order_qty DESC NULLS LAST, material_code ASC`, parameters };\n  },\n\n  summary(snapshotDate: string, planMonth: string, customerCodes: string[]): SqlQuery {\n    const { where, parameters } = scopedWhere(snapshotDate, planMonth, customerCodes);\n    return {\n      sql: `SELECT\n  COUNT(*) AS sku_count,\n  SUM(simulation_need_amount) AS budget_amount,\n  SUM(ship_amount) AS ship_amount,\n  SUM(ship_qty) AS shipped_qty,\n  SUM(in_transit_qty) AS in_transit_qty,\n  SUM(stock_qty) AS stock_qty,\n  SUM(target_inventory) AS target_inventory,\n  SUM(pre_order_qty) AS pre_order_qty,\n  SUM(daily_sales) AS daily_sales,\n  CASE WHEN COUNT(*) = COUNT(CASE WHEN avg_stock_age >= 0 AND stock_qty >= 0 THEN 1 END)\n    THEN SUM(CASE WHEN avg_stock_age >= 365.0 * 2 / 3 AND avg_stock_age <= 365 AND stock_qty > 0 THEN 1 ELSE 0 END) ELSE NULL END AS near_expiry_sku_count,\n  SUM(CASE WHEN target_inventory IS NOT NULL AND COALESCE(stock_qty, 0) + COALESCE(in_transit_qty, 0) >= target_inventory THEN 1 ELSE 0 END) AS reasonable_sku_count,\n  SUM(CASE WHEN target_inventory IS NULL OR COALESCE(stock_qty, 0) + COALESCE(in_transit_qty, 0) < target_inventory THEN 1 ELSE 0 END) AS unreasonable_sku_count,\n  SUM(CASE WHEN daily_sales > 0 AND (COALESCE(stock_qty, 0) + COALESCE(in_transit_qty, 0)) / daily_sales < 20 THEN 1 ELSE 0 END) AS shortage_sku_count,\n  SUM(CASE WHEN daily_sales <= 0 OR daily_sales IS NULL OR (COALESCE(stock_qty, 0) + COALESCE(in_transit_qty, 0)) / daily_sales >= 20 THEN 1 ELSE 0 END) AS covered_sku_count,\n  SUM(CASE WHEN avg_stock_age IS NOT NULL AND stock_qty > 0 THEN avg_stock_age * stock_qty ELSE 0 END) AS stock_age_weighted_sum,\n  SUM(CASE WHEN avg_stock_age IS NOT NULL AND stock_qty > 0 THEN stock_qty ELSE 0 END) AS stock_age_weight\nFROM ${MAIN_TABLE}\nWHERE ${where}`,\n      parameters,\n    };\n  },\n\n  customerSummaries(snapshotDate: string, planMonth: string, customerCodes: string[]): SqlQuery {\n    const { where, parameters } = scopedWhere(snapshotDate, planMonth, customerCodes);\n    return {\n      sql: `SELECT\n  cust_code,\n  COALESCE(NULLIF(MAX(cust_name), ''), cust_code) AS cust_name,\n  COUNT(*) AS sku_count,\n  SUM(stock_qty) AS stock_qty,\n  SUM(in_transit_qty) AS in_transit_qty,\n  SUM(target_inventory) AS target_inventory,\n  SUM(pre_order_qty) AS pre_order_qty\nFROM ${MAIN_TABLE}\nWHERE ${where}\nGROUP BY cust_code\nORDER BY cust_code ASC`,\n      parameters,\n    };\n  },\n\n  categorySummaries(snapshotDate: string, planMonth: string, inventoryDailyStatDate: string, customerCodes: string[]): SqlQuery {\n    const { where, parameters } = scopedWhere(snapshotDate, planMonth, customerCodes);\n    parameters.inventoryDailyStatDate = assertDate(inventoryDailyStatDate, \"库存统计日期\", /^20\\d{2}-\\d{2}-\\d{2}$/);\n    const qualifiedWhere = where\n      .replace(/\\bsnapshot_date\\b/g, \"plan.snapshot_date\")\n      .replace(/\\bplan_month\\b/g, \"plan.plan_month\")\n      .replace(/\\bcust_code\\b/g, \"plan.cust_code\");\n    return {\n      sql: `SELECT\n  COALESCE(NULLIF(plan.product_categ_name, ''), '未分类') AS product_categ_name,\n  COUNT(*) AS sku_count,\n  SUM(plan.stock_qty) AS stock_qty,\n  SUM(plan.in_transit_qty) AS in_transit_qty,\n  SUM(plan.target_inventory) AS target_inventory,\n  SUM(daily.normal_stock_qty) AS category_normal_stock_qty,\n  SUM(daily.stock_qty) AS category_actual_stock_qty,\n  SUM(daily.in_transit_qty) AS category_actual_transit_qty,\n  COUNT(CASE WHEN daily.stock_qty >= 0 AND daily.in_transit_qty >= 0 AND daily.sales_qty_30days >= 0 THEN 1 END) AS category_risk_valid_count,\n  SUM(daily.sales_qty_30days) AS category_sales_qty_30days,\n  SUM(daily.stock_amt) AS category_stock_amount,\n  COUNT(daily.material_code) AS daily_matched_sku_count\nFROM ${MAIN_TABLE} plan\nLEFT JOIN ${INVENTORY_DAILY_TABLE} daily\n  ON daily.stat_date = CAST(:inventoryDailyStatDate AS DATE)\n AND TRIM(daily.cust_code) = TRIM(plan.cust_code)\n AND TRIM(daily.material_code) = TRIM(plan.material_code)\nWHERE ${qualifiedWhere}\nGROUP BY COALESCE(NULLIF(plan.product_categ_name, ''), '未分类')\nORDER BY SUM(COALESCE(plan.stock_qty, 0) + COALESCE(plan.in_transit_qty, 0)) DESC, product_categ_name ASC`,\n      parameters,\n    };\n  },\n\n  shortageDetails(snapshotDate: string, planMonth: string, customerCodes: string[]): SqlQuery {\n    const { where, parameters } = scopedWhere(snapshotDate, planMonth, customerCodes);\n    return {\n      sql: `SELECT ${MAIN_SELECT}\nFROM ${MAIN_TABLE}\nWHERE ${where}\n  AND daily_sales > 0 AND (COALESCE(stock_qty, 0) + COALESCE(in_transit_qty, 0)) / daily_sales < 20\nORDER BY (COALESCE(stock_qty, 0) + COALESCE(in_transit_qty, 0)) / daily_sales ASC, pre_order_qty DESC, cust_code ASC, material_code ASC`,\n      parameters,\n    };\n  },\n\n  result(scope: WorkbenchResultSqlScope): SqlQuery {\n    const { where, parameters } = scopedWhere(scope.snapshotDate, scope.planMonth, scope.customerCodes, scope.materialCode);\n    const allowedOrderColumns = new Set([\n      \"pre_order_qty\", \"avg_stock_age\", \"simulation_need_amount\", \"budget_rate\", \"planned_qty_rate\",\n      \"ship_qty\", \"in_transit_qty\", \"stock_qty\", \"target_inventory\", \"turnover_days\",\n    ]);\n    if (!allowedOrderColumns.has(scope.orderColumn)) throw new Error(\"结果排序字段无效\");\n    if (scope.mode === \"detail\") {\n      return {\n        sql: `SELECT ${MAIN_SELECT}\nFROM ${MAIN_TABLE}\nWHERE ${where}\nORDER BY ${scope.orderColumn} DESC, cust_code ASC, material_code ASC`,\n        parameters,\n      };\n    }\n\n    const byCustomer = scope.groupBy === \"客户\";\n    const groupColumns = byCustomer ? \"snapshot_date, cust_code, cust_name\" : \"snapshot_date, material_code, material_name\";\n    const identityColumns = byCustomer\n      ? \"cust_code, cust_name, '' AS material_code, '' AS material_name\"\n      : \"'' AS cust_code, '' AS cust_name, material_code, material_name\";\n    const aggregateOrder = [\"avg_stock_age\", \"turnover_days\", \"budget_rate\", \"planned_qty_rate\"].includes(scope.orderColumn)\n      ? `AVG(${scope.orderColumn})`\n      : `SUM(${scope.orderColumn})`;\n    return {\n      sql: `SELECT\n  COUNT(*) AS record_count,\n  snapshot_date,\n  MIN(plan_month) AS plan_month,\n  ${identityColumns},\n  '' AS product_categ_name,\n  '' AS inventory_source,\n  '' AS stock_age_turnover_status,\n  MAX(source_load_time) AS source_load_time,\n  MAX(updated_time) AS updated_time,\n  SUM(simulation_need_amount) AS budget_amount,\n  SUM(ship_qty) AS shipped_qty,\n  SUM(ship_amount) AS ship_amount,\n  SUM(unship_qty) AS unship_qty,\n  SUM(unship_amount) AS unship_amount,\n  SUM(total_qty) AS total_qty,\n  SUM(total_amount) AS total_amount,\n  SUM(planned_qty) AS planned_qty,\n  AVG(daily_sales) AS daily_sales,\n  SUM(in_transit_qty) AS in_transit_qty,\n  SUM(stock_qty) AS stock_qty,\n  SUM(target_inventory) AS target_inventory,\n  SUM(pre_order_qty) AS pre_order_qty,\n  AVG(turnover_days) AS average_turnover_days,\n  AVG(label_turnover_days) AS label_turnover_days,\n  AVG(avg_stock_age) AS average_stock_age,\n  AVG(budget_rate) AS average_budget_rate,\n  AVG(planned_qty_rate) AS average_planned_qty_rate\nFROM ${MAIN_TABLE}\nWHERE ${where}\nGROUP BY ${groupColumns}\nORDER BY ${aggregateOrder} DESC`,\n      parameters,\n    };\n  },\n\n  aging(table: typeof WL_AGE_TABLE | typeof SIMULATED_AGE_TABLE, customerCode: string, materialCode: string): SqlQuery {\n    return {\n      sql: `SELECT stat_date, produce_date, batch_no, ship_type, stock_qty, final_qty\nFROM ${table}\nWHERE cust_code = :customerCode AND material_code = :materialCode\nORDER BY produce_date ASC, batch_no ASC`,\n      parameters: {\n        customerCode: assertIdentifier(customerCode, \"客户编码\"),\n        materialCode: assertIdentifier(materialCode, \"SKU编码\"),\n      },\n    };\n  },\n};\n\nfunction queryOptions(options: GeaSqlRequestOptions, query: SqlQuery): GeaSqlRequestOptions {\n  return { ...options, parameters: query.parameters };\n}\n\nexport async function queryWorkbenchLatestSnapshot(customerCodes: string[] = [], options: GeaSqlRequestOptions = {}) {\n  const query = dealerWorkbenchSql.latestSnapshot(customerCodes);\n  return toCubeRows(await executeWorkbenchSql(query.sql, queryOptions(options, query)));\n}\n\nexport async function queryWorkbenchSnapshotMonths(customerCodes: string[], options: GeaSqlRequestOptions = {}) {\n  const query = dealerWorkbenchSql.snapshotMonths(customerCodes);\n  return toCubeRows(await executeWorkbenchSql(query.sql, queryOptions(options, query)));\n}\n\nexport async function queryWorkbenchLatestInventoryDailySnapshot(customerCodes: string[] = [], options: GeaSqlRequestOptions = {}) {\n  const query = dealerWorkbenchSql.latestInventoryDailySnapshot(customerCodes);\n  return toInventoryDailyCubeRows(await executeWorkbenchSql(query.sql, queryOptions(options, query)));\n}\n\nexport async function queryWorkbenchInventoryDailyDetails(\n  statDate: string,\n  keys: InventoryDailyKey[],\n  options: GeaSqlRequestOptions = {},\n  exportCustomerCodes?: string[],\n) {\n  const query = dealerWorkbenchSql.inventoryDailyDetails(statDate, keys, exportCustomerCodes);\n  const rows = !useDirectDatabase()\n    ? await executeAllWorkbenchSqlPages(query.sql, queryOptions(options, query))\n    : await executeWorkbenchSql(query.sql, queryOptions(options, query));\n  return toInventoryDailyCubeRows(rows);\n}\n\nexport async function queryWorkbenchInventoryDailySummary(\n  statDate: string,\n  customerCodes: string[],\n  options: GeaSqlRequestOptions = {},\n) {\n  const query = dealerWorkbenchSql.inventoryDailySummary(statDate, customerCodes);\n  return (await executeWorkbenchSql(query.sql, queryOptions(options, query)))[0] ?? {};\n}\n\nexport async function queryWorkbenchInventoryDailyCustomerSummaries(\n  statDate: string,\n  customerCodes: string[],\n  options: GeaSqlRequestOptions = {},\n) {\n  const query = dealerWorkbenchSql.inventoryDailyCustomerSummaries(statDate, customerCodes);\n  return toInventoryDailyCubeRows(await executeWorkbenchSql(query.sql, queryOptions(options, query)));\n}\n\nexport async function queryWorkbenchCustomers(\n  snapshotDate: string,\n  search: string,\n  exactCode: string,\n  page: number,\n  pageSize: number,\n  options: GeaSqlRequestOptions = {},\n) {\n  const query = dealerWorkbenchSql.customers(snapshotDate, search, exactCode);\n  const result = await executeWorkbenchSqlPage(query.sql, page + 1, pageSize, queryOptions(options, query));\n  return { records: toCubeRows(result.records), total: result.total };\n}\n\nexport async function queryWorkbenchPlanMonths(snapshotDate: string, customerCodes: string[], options: GeaSqlRequestOptions = {}) {\n  const query = dealerWorkbenchSql.planMonths(snapshotDate, customerCodes);\n  return toCubeRows(await executeWorkbenchSql(query.sql, queryOptions(options, query)));\n}\n\nexport async function queryWorkbenchDashboard(\n  snapshotDate: string,\n  planMonth: string,\n  customerCodes: string[],\n  page: number,\n  pageSize: number,\n  options: GeaSqlRequestOptions = {},\n  inventoryDailySnapshotDate?: string | null,\n  companyFilters?: CompanyProductFilters,\n) {\n  const dailyDate = inventoryDailySnapshotDate === undefined\n    ? (await queryWorkbenchLatestInventoryDailySnapshot(customerCodes, options))[0]?.[\"dealer_inventory_daily.stat_date\"]\n    : inventoryDailySnapshotDate;\n  const date = dailyDate ? String(dailyDate).slice(0, 10) : undefined;\n  const query = companyFilters\n    ? dealerWorkbenchSql.companyProducts(snapshotDate, planMonth, customerCodes, date, companyFilters)\n    : dealerWorkbenchSql.dashboard(snapshotDate, planMonth, customerCodes, date);\n  if (options.exportTab === \"sku\" || options.exportTab === \"expiry\" || companyFilters?.download) {\n    const records = toCubeRows(await (useDirectDatabase() ? executeDirectSql(query.sql, queryOptions(options, query)) : executeAllWorkbenchSqlPages(query.sql, queryOptions(options, query))));\n    return { records, total: records.length };\n  }\n  const result = await executeWorkbenchSqlPage(query.sql, page + 1, pageSize, queryOptions(options, query));\n  return { records: toCubeRows(result.records), total: result.total };\n}\n\nexport async function queryWorkbenchSummary(snapshotDate: string, planMonth: string, customerCodes: string[], options: GeaSqlRequestOptions = {}) {\n  const query = dealerWorkbenchSql.summary(snapshotDate, planMonth, customerCodes);\n  return (await executeWorkbenchSql(query.sql, queryOptions(options, query)))[0] ?? {};\n}\n\nexport async function queryWorkbenchCustomerSummaries(\n  snapshotDate: string,\n  planMonth: string,\n  customerCodes: string[],\n  page: number,\n  pageSize: number,\n  options: GeaSqlRequestOptions = {},\n) {\n  const query = dealerWorkbenchSql.customerSummaries(snapshotDate, planMonth, customerCodes);\n  if (options.exportTab === \"customer\") {\n    const records = toCubeRows(await (useDirectDatabase() ? executeDirectSql(query.sql, queryOptions(options, query)) : executeAllWorkbenchSqlPages(query.sql, queryOptions(options, query))));\n    return { records, total: records.length };\n  }\n  const result = await executeWorkbenchSqlPage(query.sql, page + 1, pageSize, queryOptions(options, query));\n  return { records: toCubeRows(result.records), total: result.total };\n}\n\nexport async function queryWorkbenchCategorySummaries(\n  snapshotDate: string,\n  planMonth: string,\n  inventoryDailyStatDate: string,\n  customerCodes: string[],\n  options: GeaSqlRequestOptions = {},\n) {\n  const query = dealerWorkbenchSql.categorySummaries(snapshotDate, planMonth, inventoryDailyStatDate, customerCodes);\n  return toCubeRows(await executeAllWorkbenchSqlPages(query.sql, queryOptions(options, query)));\n}\n\nexport async function queryWorkbenchShortageDetails(\n  snapshotDate: string,\n  planMonth: string,\n  customerCodes: string[],\n  page: number,\n  pageSize: number,\n  options: GeaSqlRequestOptions = {},\n) {\n  const query = dealerWorkbenchSql.shortageDetails(snapshotDate, planMonth, customerCodes);\n  if (options.exportTab === \"shortage\") {\n    const records = toCubeRows(await (useDirectDatabase() ? executeDirectSql(query.sql, queryOptions(options, query)) : executeAllWorkbenchSqlPages(query.sql, queryOptions(options, query))));\n    return { records, total: records.length };\n  }\n  const result = await executeWorkbenchSqlPage(query.sql, page + 1, pageSize, queryOptions(options, query));\n  return { records: toCubeRows(result.records), total: result.total };\n}\n\nexport async function queryWorkbenchAging(\n  source: \"wl\" | \"simulated\",\n  customerCode: string,\n  materialCode: string,\n  options: GeaSqlRequestOptions = {},\n) {\n  const table = source === \"wl\" ? WL_AGE_TABLE : SIMULATED_AGE_TABLE;\n  const prefix = source === \"wl\" ? \"dealer_wl_stock_age\" : \"dealer_simulated_stock_age\";\n  const query = dealerWorkbenchSql.aging(table, customerCode, materialCode);\n  const rows = await executeAllWorkbenchSqlPages(query.sql, queryOptions(options, query));\n  return rows.map((row) => Object.fromEntries(\n    Object.entries(row).map(([key, value]) => [`${prefix}.${key}`, value]),\n  ));\n}\n\nexport async function queryWorkbenchSqlPage(query: SqlQuery, page: number, pageSize: number, options: GeaSqlRequestOptions = {}) {\n  const result = await executeWorkbenchSqlPage(query.sql, page + 1, pageSize, queryOptions(options, query));\n  return { ...result, records: toCubeRows(result.records) };\n}\n\nexport async function queryAllWorkbenchSqlRows(query: SqlQuery, options: GeaSqlRequestOptions = {}) {\n  return toCubeRows(await executeAllWorkbenchSqlPages(query.sql, queryOptions(options, query)));\n}\n\n// 客户编码必须来自已经完成权限校验的工作台范围。\nexport async function queryWorkbenchCustomerCars(customerCode: string, options: GeaSqlRequestOptions = {}) {\n  if (!customerCode.trim()) return [];\n  const table = configuredResourceName(\"DEALER_WORKBENCH_SQL_CUSTOMER_CAR_TABLE\", \"agents_scm_customer_car_current\");\n  return executeAllWorkbenchSqlPages(\n    `SELECT source_record_id, organization_id, cust_code, warehouse_group_id,\n            car_type, car_code, car_name, min_discount_num, max_discount_num\n     FROM ${table}\n     WHERE cust_code = :customerCode\n     ORDER BY organization_id, warehouse_group_id, car_code, source_record_id`,\n    { ...options, parameters: { customerCode } },\n  );\n}\n\n/** 读取已授权客户的收货地；不读取联系人及电话，不将其当作提货点。 */\nexport async function queryWorkbenchCustomerReceives(customerCode: string, options: GeaSqlRequestOptions = {}) {\n  if (!customerCode.trim()) return [];\n  const table = configuredResourceName(\"DEALER_WORKBENCH_SQL_CUSTOMER_RECEIVE_TABLE\", \"agents_scm_customer_receive\");\n  return executeAllWorkbenchSqlPages(\n    `SELECT source_record_id, cust_code, receive_cust_code, receive_cust_name,\n            goods_address, main_drivertype, max_drivertype\n     FROM ${table} WHERE cust_code = :customerCode\n     ORDER BY receive_cust_code, source_record_id`,\n    { ...options, parameters: { customerCode } },\n  );\n}\n\n/** Exact SKU authorization before a DMS read; use the same GEA row-level scope as the catalog. */\nexport async function queryWorkbenchFulfillmentMaterials(customerCode: string, materialCodes: string[], options: GeaSqlRequestOptions = {}) {\n  if (!materialCodes.length || materialCodes.length > 500) throw new Error(\"商品范围无效\");\n  const parameters: GeaSqlParameters = { customerCode: assertIdentifier(customerCode, \"客户编码\") };\n  const names = materialCodes.map((code, i) => {\n    parameters[`material${i}`] = assertIdentifier(code, \"商品编码\");\n    return `:material${i}`;\n  });\n  return executeAllWorkbenchSqlPages(`SELECT DISTINCT cust_code, material_code FROM ${saleableMaterialTable()}\n    WHERE cust_code = :customerCode AND material_code IN (${names.join(\",\")}) AND material_code <> '10005290'`, { ...options, parameters });\n}\n\nexport type CustomerPickupPoint = {\n  code: string; name: string; isDefault: boolean; isSecondary: boolean;\n  matched: boolean; activeFlag: string; available: boolean; factoryCode: string; companyCode: string; type: string; baseName: string;\n};\n\n/** Read only within the already authorized customer. Preserve unavailable records for UI explanations. */\nexport async function queryWorkbenchCustomerPickupPoints(customerCode: string, options: GeaSqlRequestOptions = {}): Promise<CustomerPickupPoint[]> {\n  if (!customerCode.trim()) return [];\n  const table = configuredResourceName(\"DEALER_WORKBENCH_SQL_CUSTOMER_PICKUP_TABLE\", \"agents_scm_cust_pickup_point\");\n  const rows = await executeAllWorkbenchSqlPages(\n    `SELECT cust_code, warehouse_group_id, warehousegroup_name, CAST(is_default_shipping AS TEXT) AS is_default_shipping,\n            CAST(is_secondary_shipping AS TEXT) AS is_secondary_shipping, CAST(is_pickup_point_matched AS TEXT) AS is_pickup_point_matched, active_flag, factory_code,\n            warehouse_group_type, base_name, company_code\n     FROM ${table} WHERE cust_code = :customerCode\n     ORDER BY is_default_shipping DESC, warehouse_group_id`,\n    { ...options, parameters: { customerCode } },\n  );\n  const seen = new Set<string>();\n  return rows.map(row => {\n    const text = (value: unknown) => value == null ? \"\" : String(value).trim();\n    const code = text(row.warehouse_group_id);\n    const flag = (value: unknown) => value === true || value === \"true\" ? true : value === false || value === \"false\" ? false : null;\n    if (text(row.cust_code) !== customerCode || !code || seen.has(code)\n      || [row.is_default_shipping, row.is_secondary_shipping, row.is_pickup_point_matched].some(value => flag(value) === null)) {\n      throw new Error(\"提货点客户范围、编码或状态异常\");\n    }\n    seen.add(code);\n    const matched = flag(row.is_pickup_point_matched) === true, activeFlag = text(row.active_flag);\n    return { code, name: text(row.warehousegroup_name), isDefault: flag(row.is_default_shipping) === true,\n      isSecondary: flag(row.is_secondary_shipping) === true, matched, activeFlag, available: matched && activeFlag === \"Y\",\n      factoryCode: text(row.factory_code), companyCode: text(row.company_code), type: text(row.warehouse_group_type), baseName: text(row.base_name) };\n  });\n}\n\n/** Compatibility entry point: defaults now come from customer master data, never order history. */\nexport async function queryWorkbenchDefaultPickup(customerCode: string, options: GeaSqlRequestOptions = {}) {\n  const points = await queryWorkbenchCustomerPickupPoints(customerCode, options);\n  return points.filter(point => point.available && point.isDefault).map(point => ({ pickup_point_default: point.name, pickup_code: point.code }));\n}\n\n/** Customer company code supplies SAP VKORG; pickup/factory stay paired with that source row. */\nexport async function queryWorkbenchSapSalesArea(customerCode: string, docType: string, options: GeaSqlRequestOptions = {}) {\n  if (!customerCode.trim() || !docType.trim()) return [];\n  const points = await queryWorkbenchCustomerPickupPoints(customerCode, options);\n  return points.filter(point => point.available).map(point => ({cust_code: customerCode, vsbed: point.code,\n    werks: point.factoryCode, vkorg: point.companyCode, vtweg: \"\", spart: \"\", doc_type: docType }));\n}\n\n/** customerCode 必须来自已授权的单客户工作台；不能查询全库政策。 */\nexport async function queryWorkbenchPromotionPolicies(customerCode: string, businessDate: string, options: GeaSqlRequestOptions = {}) {\n  if (!customerCode.trim()) return [];\n  const scope = promotionScopeView();\n  return executeAllWorkbenchSqlPages(\n    `SELECT DISTINCT s.range_record_id, s.customer_code, s.data_type, s.scope_level,\n            s.product_code, s.product_name, s.scope_pup_code AS pup_code, s.scope_pup_name AS pup_name,\n            s.promotion_code, s.promotion_name, s.promotion_type, CAST(s.promotion_limit AS TEXT) AS promotion_limit,\n            CAST(s.promotion_start_date AS TEXT) AS promotion_start_date, CAST(s.promotion_end_date AS TEXT) AS promotion_end_date,\n            CAST(s.usable_quantity AS TEXT) AS usable_quantity, CAST(s.used_quantity AS TEXT) AS used_quantity,\n            s.policy_pup_code, s.policy_pup_name,\n            CAST(s.purchase_batch_start_date AS TEXT) AS policy_purchase_start_date,\n            CAST(s.purchase_batch_end_date AS TEXT) AS policy_purchase_end_date,\n            CAST(s.gift_batch_start_date AS TEXT) AS policy_gift_start_date,\n            CAST(s.gift_batch_end_date AS TEXT) AS policy_gift_end_date,\n            s.gift_batch_remarks AS policy_gift_remarks,\n            s.policy_remarks AS remarks, s.goods_age_range, s.goods_dimension${process.env.DEALER_WORKBENCH_POLICY_EXCLUSIVE_ENABLED === \"true\" ? \", s.is_customer_exclusive\" : \"\"}\n     FROM ${scope} s\n     WHERE s.customer_code = :customerCode AND s.data_type = :scopeType\n       AND ${promotionScopeConditions(\"businessDate\")}\n     ORDER BY s.promotion_code, s.range_record_id`,\n    { ...options, parameters: { customerCode, businessDate, scopeType: \"cust\" } },\n  );\n}\n\n/** Resolve the chat allowlist using GEA row permissions, even when Cube is direct. */\nexport async function queryAuthorizedDealerChatCustomers(exactCode = \"\", options: GeaSqlRequestOptions = {}): Promise<string[]> {\n  const parameters: GeaSqlParameters = {};\n  const predicate = exactCode ? customerPredicate([exactCode], parameters) : \"\";\n  const rows = await executeAllGeaSqlPages(\n    `SELECT DISTINCT cust_code FROM ${MAIN_TABLE} WHERE cust_code IS NOT NULL${predicate} ORDER BY cust_code ASC`,\n    { ...options, parameters, pageConcurrency: 3 },\n  );\n  // GEA owns the business identifiers, including virtual dealers. Validate the\n  // response shape only; never infer account permissions from an identifier's format.\n  const codes = rows.map((row) => {\n    if (typeof row.cust_code !== \"string\" || !row.cust_code.trim()) {\n      throw new Error(\"GEA 返回的客户编码字段缺失或为空，无法确认对话权限范围\");\n    }\n    return row.cust_code;\n  });\n  return [...new Set(codes)];\n}\n\nexport async function queryWorkbenchCompanyProductFacets(snapshotDate: string, planMonth: string, customerCode: string, options: GeaSqlRequestOptions = {}) {\n  const dailyDate = (await queryWorkbenchLatestInventoryDailySnapshot([customerCode], options))[0]?.[\"dealer_inventory_daily.stat_date\"];\n  const query = dealerWorkbenchSql.companyProducts(snapshotDate, planMonth, [customerCode], dailyDate ? String(dailyDate).slice(0, 10) : undefined, {}, true);\n  const rows = await executeAllWorkbenchSqlPages(query.sql, queryOptions(options, query));\n  return { categories: [...new Set(rows.map(row => String(row.product_categ_name || \"-\")))], tags: [...new Set(rows.map(row => String(row.product_tag || \"-\")))] };\n}\n\n/** Count the same customer-saleable set used by catalog queries, without reading inventory as a catalog. */\nexport async function queryWorkbenchCompanyProductTotal(customerCode: string, options: GeaSqlRequestOptions = {}) {\n  const rows = await executeWorkbenchSql(`SELECT COUNT(DISTINCT material_code) AS product_total\nFROM ${saleableMaterialTable()}\nWHERE cust_code = :customerCode AND material_code IS NOT NULL AND TRIM(material_code) <> '' AND material_code <> '10005290'`,\n    {...options, parameters: {customerCode: assertIdentifier(customerCode, \"客户编码\")}});\n  const raw = rows[0]?.product_total;\n  const total = raw == null ? NaN : Number(raw);\n  if (!Number.isSafeInteger(total) || total < 0) throw new Error(\"可售商品总数无效\");\n  return total;\n}\n"},"source/dealer/web/src/lib/inventory-date-label.ts":{"blob":"41f9f79476703d487850fbd58261e974fd8edbcb","sha256":"4cfa757a73339ec1899d04a2dbebe378623b66b955f0ec61bb45721af82facd7","text":"/** Display actual stock dates only; statistical/sync dates are not fallbacks. */\nexport function inventoryDateLabel(earliest: string | null, latest: string | null, missing = 0): string {\n  if (!earliest || !latest) return \"未提供\";\n  const label = earliest === latest ? earliest : `${earliest} 至 ${latest}`;\n  return missing > 0 ? `${label}（部分未提供）` : label;\n}\n"},"source/inventory-light-plugins/DELIVERY.md":{"blob":"73f36fbb2440a313555dfefbc59a28c80194f2ee","sha256":"4e2b4faa489f75edcca6503c758afd540b02b2f39ba6897e7246fcccbc7d1e5e","text":"# 库存插件交付说明\n\n版本：0.2.6-preview.1（集成预览版，未认证为正式市场发行版）。\n\n## 交付清单\n\n| ZIP / 插件 ID | 名称 | GEA consumerCode |\n|---|---|---|\n| inventory-aqkc | 安全库存 | base-safety-stock |\n| inventory-dealer | 经销商库存 | dealer-inventory-replenishment |\n| inventory-fc | 分仓库存 | branch-inventory |\n| inventory-qll | 全链路库存 | full-chain-inventory |\n| inventory-personal | 库存管理工作台 | inventory-personal-workbench |\n\n文件名为 `<插件 ID>-<版本>.zip`。五个插件独立解压和加载，可单独升级。包内包含内嵌 JS/CSS 的 index.html、plugin.json、mcp.json、Skill、delivery.json 和本文档。运行不需要原 Agent 代码、Node 前端构建环境或独立 Agent 后端。这里的独立运行指在满足契约的 DSH 宿主中运行，不是双击 HTML 脱离登录和宿主使用。\n\n## 客户端接入约定\n\n1. 核对 SHA256SUMS 或 manifest.json 中的 ZIP 校验值，解压到客户端管理的版本目录，禁止路径穿越。\n2. 宿主须实现当前 `gea-html-v1`：插件注册、受控 HTML 页面、身份与会话、GEA SQL、context/filter/refresh/draft 及 DSH 对话桥接。仅有通用 HTML 展示能力的旧客户端不满足要求。\n3. 将解压目录注册为 HTML 插件根目录；开发宿主对应 GEA_HTML_PLUGIN_ROOTS（插件绝对目录组成的 JSON 数组），具体读取方式以宿主配置为准。不要把开发机绝对路径写入发行配置。\n4. GEA 为各 consumerCode 配置对应用户授权和数据/工具范围。库存管理工作台先前独立身份返回 AGENT_ACCESS_DENIED，仍需授权后验收。\n5. 登录、按权限菜单、自动下载、更新回退、换账号清理由客户端公共层负责。该包不实现安装器，不声称这些功能已完成。\n6. HTML React 18 / CSS / Web API；构建目标 Chromium 110、Safari 16。原生 Windows/macOS 正式安装包验收待客户端团队完成。\n\n## 全链路直连（本阶段保留）\n\n额外交付 `inventory-qll-host-<版本>.zip`，由可信客户端 Node 宿主加载，不能放入 HTML 沙箱。该包包含编译后的 provider.mjs、pg 驱动及依赖/许可证，不依赖原始全链路工程。要求 Node >=22（含 parseEnv）。无需现场安装 npm/pnpm 依赖。\n\n部署步骤：\n\n1. 将宿主适配包解压到固定版本目录。\n2. 在包外创建私有 qll.env，填写 `FULL_CHAIN_DATABASE_URL`；使用只读数据库账号，主机必须能访问该数据库。示例文件只有占位符。\n3. 复制 local-query.example.json，module 指向 provider.mjs，driverPackage 指向适配包 package.json，envFile 指向私有 qll.env；三项均为部署机器的绝对路径。\n4. 启动宿主时设置 `GEA_HTML_LOCAL_QUERY_CONFIG` 为此配置文件路径，注册 inventory-qll 插件。\n5. 连接配置不提交 Git、不放入前端包。查询通过固定参数化 SQL 白名单及只读事务执行。此模式以配置的数据库账号决定数据可见范围，不等同于 GEA 行权限；客户端仍须处理入口授权。\n\n## 源码构建与版本维护\n\n开发工作区仍复用 agent-plugin-trials 内的 Agent 副本、DSH ui-primitives 和构建依赖；这次交付的是独立运行包，不是已经拆成五个独立源码仓库。原桌面 Agent 不修改。\n\n在 inventory-light-plugins 目录运行：\n\n```sh\npnpm run package\npnpm run verify:packages\n```\n\n构建依赖由现有 pnpm 工作区准备；构建本身使用 esbuild，不触发安装器构建。统一版本来源是 package.json，构建会同步写入各 plugin.json。更新时修改该版本后重新打包；不得在相同版本下对外覆盖已发布文件。dist/<版本>/manifest.json 为离线交付索引，不代替公司发行库协议。\n\n## 本次变更及验收边界\n\n- 五个插件统一到 0.2.6-preview.1；补齐全链路和库存管理工作台打包。\n- 增加文件校验、ZIP 校验、全链路宿主独立适配包、离线解压验证。\n- 插件业务能力沿用当前实现；未提供的保存/提交接口不会因打包而补齐。\n- 独立解压验证检查无外部前端资源、清单和 Skill 完整、版本一致、全链路驱动可在脱离源码目录后加载。不会连接真实数据库，不代表全链路业务权限、数据或双平台客户端验收通过。\n"},"source/inventory-light-plugins/README.md":{"blob":"ae5da5469a380b15974799d7d3874da7732f5338","sha256":"a9a127a7ecdea37bf262fd71717e082b1a2a407248a301dfdeb9c56333a1be47","text":"# 库存 Agent：HTML + Skill + GEA\n\n安全库存、经销商库存、分仓库存、全链路库存、库存管理工作台五个独立插件。当前交付预览版本 `0.2.6-preview.1`。\n运行资源为 `index.html`（内嵌 JS/CSS）、`skills/`、`mcp.json` 与 `plugin.json`。不带独立 Agent 后端；不涉及需求预测。\n\n## 前端\n\n读取 DSH 客户端源码后，五个插件统一使用 React 18、TypeScript、CSS Modules / CSS 和浏览器原生能力。\n没有 CopilotKit 聊天兼容层；分析、模型调用和会话历史使用 DSH 原生 Session。\n按钮复用 DSH ui-primitives，表格、筛选、对话框、SVG 图表为插件自有 React 组件。\n详情、验证范围与 Excel 兼容边界见 [前端迁移记录](FRONTEND-MIGRATION-20260918.md)。\n\n## 数据与业务边界\n\n- 登录、授权、受控 SQL 和对话桥接由 GEA 公共插件提供。HTML 不持有委托令牌，不直连数据库。全链路本阶段通过独立宿主适配包直连 PostgreSQL，配置和驱动均在宿主侧。\n- 原 `/api/...` 路由由 HTML 内的函数适配层消费，不请求独立 Agent 服务。\n- 数据错误不能回退为演示数据；正式写回尚缺的接口仍明确不可用。\n- `context`、`filter`、`refresh`、`draft` 对接 DSH 原生会话；补货、计划和周期预览仅在页面内存中。\n- 原桌面 Agent 源码未修改，DSH 核心未添加库存业务逻辑。\n\n## 安装构建依赖与构建\n\n在 `agent-plugin-trials` 目录执行：\n\n```sh\npnpm --dir inventory-light-plugins install --ignore-workspace --frozen-lockfile --ignore-scripts --store-dir ../../.pnpm-store\npnpm light:build aqkc dealer fc qll personal\npnpm --dir inventory-light-plugins typecheck:pages\nnode --experimental-strip-types --test inventory-light-plugins/tests/*.test.mjs\n```\n\n安装依赖是显式步骤；日常 `light:build` 仅增量构建 HTML。产物在 `plugins/<id>/`。\n构建器检查实际依赖是否属于 DSH 客户端技术范围；旧聊天框架或外来 UI 库会导致构建失败。\n\n## 当前联调\n\n3311 使用 `scripts/light/start-aqkc-latest.mjs`，挂载安全库存与当前共享 GEA 宿主。\n更新 HTML 后重新打开业务页即可生效，不必重启或重新登录。\n分仓、经销商、全链路的隔离交互测试可运行 `node inventory-light-plugins/tests/build-ui-fixture.mjs` 生成静态测试页；这些测试页标注固定测试数据，不进入插件产物。\n\n五个本地 HTML 构建通过不代表已在公司 DSH 客户端完成安装或正式发布。\n真实业务缺口见 [BUSINESS-GAPS.md](BUSINESS-GAPS.md)；历史联调记录不等于本轮验收结果。\n\n## 独立运行包交付\n\n在本目录执行 `pnpm run package` 构建全部插件并打包，`pnpm run verify:packages` 在独立临时目录校验产物。\n产物：`dist/0.2.6-preview.1/`，包含五个插件 ZIP、全链路宿主直连适配 ZIP、manifest.json、SHA256SUMS 和交付说明。\n详见 [交付说明](DELIVERY.md)。预览包未上传发行仓库；源码构建仍依赖开发工作区，交付运行包不依赖原 Agent 目录。\n"},"source/inventory-light-plugins/package.json":{"blob":"f80e37c9909e9b53f56d78126cf538864b665e3a","sha256":"70501fccc61ea28053f47e994da28cfa5fd80679b728b794710f5fb166032e9f","text":"{\n  \"name\": \"inventory-light-plugins\",\n  \"version\": \"0.2.6-preview.1\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"node build/build.mjs\",\n    \"test\": \"node --experimental-strip-types --test tests/*.test.mjs\",\n    \"typecheck:pages\": \"node build/typecheck-pages.mjs\",\n    \"package\": \"node build/build.mjs && node build/package.mjs\",\n    \"verify:packages\": \"node build/verify-packages.mjs\"\n  },\n  \"dependencies\": {\n    \"react\": \"18.3.1\",\n    \"react-dom\": \"18.3.1\",\n    \"clsx\": \"2.1.1\",\n    \"zod\": \"4.4.3\"\n  },\n  \"pluginVersions\": {\n    \"personal\": \"0.2.7-preview.1\",\n    \"dealer\": \"0.2.6-preview.4\"\n  }\n}\n"},"source/inventory-light-plugins/pnpm-lock.yaml":{"blob":"2c5a4eefd140f6e0d0f19c8bb48cb14dafc5398c","sha256":"03f31afab0b1bb07d95136aa3fa088a2b09400643b051146de9c8e2f5b53b906","text":"lockfileVersion: '9.0'\n\nsettings:\n  autoInstallPeers: true\n  excludeLinksFromLockfile: false\n\nimporters:\n\n  .:\n    dependencies:\n      clsx:\n        specifier: 2.1.1\n        version: 2.1.1\n      react:\n        specifier: 18.3.1\n        version: 18.3.1\n      react-dom:\n        specifier: 18.3.1\n        version: 18.3.1(react@18.3.1)\n      zod:\n        specifier: 4.4.3\n        version: 4.4.3\n\npackages:\n\n  clsx@2.1.1:\n    resolution: {integrity: sha512-eYm0QWBtUrBWZWG0d386OGAw16Z995PiOVo2B7bjWSbHedGl5e0ZWaq65kOGgUSNesEIDkB9ISbTg/JK9dhCZA==}\n    engines: {node: '>=6'}\n\n  js-tokens@3.0.0:\n    resolution: {integrity: sha512-poXEQHPMmTrYZuJgNRll2sbc3kJsSU1m/g1Q93IE6txNj3p6xOOOmdj1G/zCVGawYSPzTkSoWGg1otqbeqKJeg==}\n\n  loose-envify@1.4.0:\n    resolution: {integrity: sha512-lyuxPGr/Wfhrlem2CL/UcnUc1zcqKAImBDzukY7Y5F/yQiNdko6+fRLevlw1HgMySw7f611UIY408EtxRSoK3Q==}\n    hasBin: true\n\n  react-dom@18.3.1:\n    resolution: {integrity: sha512-5m4nQKp+rZRb09LNH59GM4BxTh9251/ylbKIbpe7TpGxfJ+9kv6BLkLBXIjjspbgbnIBNqlI23tRnTWT0snUIw==}\n    peerDependencies:\n      react: ^18.3.1\n\n  react@18.3.1:\n    resolution: {integrity: sha512-wS+hAgJShR0KhEvPJArfuPVN1+Hz1t0Y6n5jLrGQbkb4urgPE/0Rve+1kMB1v/oWgHgm4WIcV+i7F2pTVj+2iQ==}\n    engines: {node: '>=0.10.0'}\n\n  scheduler@0.23.2:\n    resolution: {integrity: sha512-UOShsPwz7NrMUqhR6t0hWjFduvOzbtv7toDH1/hIrfRNIDBnnBWd0CwJTGvTpngVlmwGCdP9/Zl/tVrDqcuYzQ==}\n\n  zod@4.4.3:\n    resolution: {integrity: sha512-ytENFjIJFl2UwYglde2jchW2Hwm4GJFLDiSXWdTrJQBIN9Fcyp7n4DhxJEiWNAJMV1/BqWfW/kkg71UDcHJyTQ==}\n\nsnapshots:\n\n  clsx@2.1.1: {}\n\n  js-tokens@3.0.0: {}\n\n  loose-envify@1.4.0:\n    dependencies:\n      js-tokens: 3.0.0\n\n  react-dom@18.3.1(react@18.3.1):\n    dependencies:\n      loose-envify: 1.4.0\n      react: 18.3.1\n      scheduler: 0.23.2\n\n  react@18.3.1:\n    dependencies:\n      loose-envify: 1.4.0\n\n  scheduler@0.23.2:\n    dependencies:\n      loose-envify: 1.4.0\n\n  zod@4.4.3: {}\n"},"source/inventory-light-plugins/src/aqkc-transfer.ts":{"blob":"a42e926c8f9248c876f672a81aeeb1a81557e1f3","sha256":"e7391c65cacb999fd387b4ca6e89b5c9994b19c68e40ad68d3b913029b952edc","text":"// Transport only: preserve every authorized row and let the existing business\n// engine select the month/version. Each result cell contains at most 100 rows.\nconst orders: Record<string, string[]> = {\n  'workbench-safety-stock-rows': ['safety_stock.base_name','safety_stock.material_code','safety_stock.inventory_version','safety_stock.id'],\n  'workbench-order-structure': ['workbench.base','workbench.category','workbench.material_code','workbench.material_name'],\n  'workbench-age-structure': ['inventory_age.base_name','inventory_age.product_categ_name','inventory_age.material_code','inventory_age.material_name'],\n  'workbench-current-order-skus': ['workbench.domain','workbench.base','workbench.material_code'],\n  'daily-report-current-orders': ['workbench.domain','workbench.base','workbench.material_code'],\n  'daily-report-age-skus': ['base','material'],\n  'daily-report-fulfillment': ['base','material'],\n};\nexport function supportsPackedTransfer(name: string) { return Object.hasOwn(orders, name); }\nexport function packedSafetyStockSql(sql: string, name = 'workbench-safety-stock-rows') {\n  if (!supportsPackedTransfer(name)) throw Error('未知安全库存查询');\n  const order = orders[name].map(key => `\"${key}\" NULLS FIRST`).join(', ');\n  // The large safety-stock query has a fixed schema. Send field names once per\n  // packet rather than repeating 22 long names in every SKU row.\n  const columns = name === 'workbench-safety-stock-rows'\n    ? [...sql.matchAll(/AS \"(safety_stock\\.[a-z0-9_]+)\"/g)].map(match => match[1]) : [];\n  const compact = columns.length > 0 && new Set(columns).size === columns.length;\n  const row = compact ? `JSONB_BUILD_ARRAY(${columns.map(key => `s.\"${key}\"`).join(',')})` : \"TO_JSONB(s) - 'dsh_transfer_row'\";\n  const schema = compact ? `'${JSON.stringify(columns)}'::text AS dsh_columns,` : '';\n  return `WITH dsh_stock_source AS (${sql}), dsh_stock_numbered AS (\n    SELECT s.*, ROW_NUMBER() OVER (ORDER BY ${order}) AS dsh_transfer_row\n    FROM dsh_stock_source s\n  ) SELECT FLOOR((dsh_transfer_row - 1) / 100) AS dsh_group,\n    COUNT(*) AS dsh_count,\n    ${schema}\n    JSONB_AGG(${row} ORDER BY dsh_transfer_row)::text AS dsh_rows\n    FROM dsh_stock_numbered s GROUP BY FLOOR((dsh_transfer_row - 1) / 100)\n    ORDER BY dsh_group`;\n}\n\nexport function unpackSafetyStock(groups: Record<string, unknown>[], maxRows: number) {\n  const rows: Record<string, unknown>[] = [];\n  for (let index = 0; index < groups.length; index++) {\n    const group = groups[index];\n    if (Number(group.dsh_group) !== index) throw Error(\"安全库存传输分组不连续\");\n    let packed = typeof group.dsh_rows === \"string\" ? JSON.parse(group.dsh_rows) : group.dsh_rows;\n    if (group.dsh_columns !== undefined) {\n      const columns = typeof group.dsh_columns === 'string' ? JSON.parse(group.dsh_columns) : group.dsh_columns;\n      if (!Array.isArray(columns) || !columns.length || new Set(columns).size !== columns.length ||\n          columns.some(key => typeof key !== 'string' || !/^safety_stock\\.[a-z0-9_]+$/.test(key)) ||\n          !Array.isArray(packed) || packed.some(row => !Array.isArray(row) || row.length !== columns.length))\n        throw Error(\"安全库存传输字段不完整\");\n      packed = packed.map(row => Object.fromEntries(columns.map((key, i) => [key, row[i]])));\n    }\n    if (!Array.isArray(packed) || !packed.length || packed.length > 100 ||\n        packed.length !== Number(group.dsh_count) ||\n        (index < groups.length - 1 && packed.length !== 100) ||\n        packed.some(row => !row || typeof row !== \"object\" || Array.isArray(row)))\n      throw Error(\"安全库存传输明细不完整\");\n    rows.push(...packed);\n    if (rows.length > maxRows) throw Error(\"安全库存完整数据超过读取上限\");\n  }\n  return rows;\n}\n"},"source/inventory-light-plugins/src/channel.js":{"blob":"975678b282e6a219688f889b4696edf1b8dea61e","sha256":"41ec894972f85b02b1dadec5b24c15c99e93f07341a3a320666dc44b27f34bed","text":"import { sqlQueryError } from \"./query-error.js\";\nlet channel,\n  sequence = 0;\nconst pending = new Map(),\n  handlers = new Map();\nlet readyResolve;\nexport const ready = new Promise((resolve) => {\n  readyResolve = resolve;\n});\nwindow.addEventListener(\"message\", (event) => {\n  if (\n    event.source !== window.parent ||\n    event.data?.protocol !== \"gea-html-v1\" ||\n    event.data?.type !== \"connect\" ||\n    !event.ports[0] ||\n    channel\n  )\n    return;\n  channel = event.ports[0];\n  channel.onmessage = (event) => {\n    const message = event.data;\n    if (message.type === \"response\") {\n      const item = pending.get(message.id);\n      if (!item) return;\n      pending.delete(message.id);\n      clearTimeout(item.timer);\n      item.cleanup?.();\n      if (message.error) {\n        const error = item.method === \"sql\" ? sqlQueryError(Error(message.error)) : Error(message.error);\n        if (item.method === \"sql\" || item.method === \"workspace\")\n          window.dispatchEvent(\n            new CustomEvent(\"gea-query-warning\", {\n              detail: { message: error.message.slice(0, 600) },\n            }),\n          );\n        item.reject(error);\n      } else item.resolve(message.result);\n    }\n    if (message.type === \"invoke\") {\n      const handler = handlers.get(message.name);\n      Promise.resolve()\n        .then(() => {\n          if (!handler) throw Error(\"页面未注册该操作\");\n          return handler(message.arguments);\n        })\n        .then(\n          (result) =>\n            channel.postMessage({ type: \"invoked\", id: message.id, result }),\n          (error) =>\n            channel.postMessage({\n              type: \"invoked\",\n              id: message.id,\n              error: error.message,\n            }),\n        );\n    }\n    if (message.type === \"identity-changed\") {\n      for (const item of pending.values()) {\n        clearTimeout(item.timer);\n        item.cleanup?.();\n        item.reject(Error(\"登录身份已变化，请重新加载\"));\n      }\n      pending.clear();\n      window.dispatchEvent(new Event(\"gea-identity-changed\"));\n    }\n  };\n  channel.start();\n  readyResolve(event.data.context);\n});\nwindow.parent.postMessage({ protocol: \"gea-html-v1\", type: \"ready\" }, \"*\");\nexport async function call(method, parameters = {}, options = {}) {\n  await ready;\n  options.signal?.throwIfAborted();\n  const id = String(++sequence);\n  return new Promise((resolve, reject) => {\n    const cleanup = () => options.signal?.removeEventListener(\"abort\", abort);\n    const abort = () => {\n      if (!pending.delete(id)) return;\n      clearTimeout(timer);\n      cleanup();\n      channel.postMessage({ type: \"cancel\", id });\n      reject(options.signal.reason ?? Error(\"请求已取消\"));\n    };\n    const timer = setTimeout(() => {\n      pending.delete(id);\n      cleanup();\n      channel.postMessage({ type: \"cancel\", id });\n      const error = Error(\"业务请求超时\");\n      reject(method === \"sql\" ? sqlQueryError(error) : error);\n    }, 120000);\n    pending.set(id, { resolve, reject, timer, method, cleanup });\n    options.signal?.addEventListener(\"abort\", abort, {once: true});\n    channel.postMessage({ type: \"request\", id, method, parameters });\n  });\n}\nexport function action(name, description, handler) {\n  handlers.set(name, handler);\n  void ready.then(() =>\n    channel.postMessage({ type: \"register\", name, description }),\n  );\n}\nexport function ask(text, context) {\n  return call(\"conversation\", { text, context });\n}\nexport function publish(context) {\n  return call(\"context\", context);\n}\n"},"source/inventory-light-plugins/src/data.ts":{"blob":"50a0fdc278cd37ba99820d688eaf5c7acd2032f1","sha256":"bd0a4db6d10ae45f812552e9253a3664fe4a76a14a82b4ddf8f9188a0c6d58d1","text":"import { call } from \"./channel.js\";\nimport { DATA_PERMISSION_MESSAGE, sqlQueryError } from \"./query-error.js\";\nimport { bindGovernedSql } from \"./governed/parameters\";\nimport {columnarQuery, unpackColumns} from \"./governed/columnar\";\nimport {createQueryBatch} from \"./governed/batch\";\nconst batchRead = createQueryBatch(call);\ndeclare const DSH_COLUMNAR_SQL: boolean;\ndeclare const DSH_GOVERNED_SQL: boolean;\nconst governed = typeof DSH_GOVERNED_SQL !== \"undefined\" && DSH_GOVERNED_SQL;\nimport { packedSafetyStockSql, unpackSafetyStock, supportsPackedTransfer } from \"./aqkc-transfer\";\n// Isolated per iframe/identity; only pending reads and a short-lived directory are shared.\nconst pendingReads = new Map<string, Promise<any>>();\nconst catalogs = new Map<string, { expires: number; value: any }>();\nexport function clearReadCache() {\n  pendingReads.clear();\n  catalogs.clear();\n}\nif (typeof window !== \"undefined\") {\n  window.addEventListener(\"gea-identity-changed\", clearReadCache);\n  window.addEventListener(\"light-refresh\", clearReadCache);\n}\nasync function read(parameters: any, options: {signal?: AbortSignal} = {}) {\n  try { return await readSql(parameters, options); }\n  catch (error) {\n    if (options.signal?.aborted || (error as Error)?.name === \"AbortError\") throw error;\n    throw sqlQueryError(error);\n  }\n}\nasync function readSql(parameters: any, options: {signal?: AbortSignal} = {}) {\n  if (governed && parameters.values !== undefined) {\n    const {values, ...rest} = parameters;\n    parameters = {...rest, ...bindGovernedSql(parameters.sql, values)};\n  }\n  const isCatalog = /^\\/\\* warehouse_catalog:(plans|inventory) \\*\\//.test(parameters.sql);\n  const columnSql = parameters.pageNo === undefined && typeof DSH_COLUMNAR_SQL !== \"undefined\" && DSH_COLUMNAR_SQL\n    ? columnarQuery(parameters.sql) : null;\n  if (columnSql) parameters = {...parameters, sql: columnSql};\n  const key = JSON.stringify(parameters);\n  const cached = catalogs.get(key);\n  if (!options.signal && cached && cached.expires > Date.now()) return structuredClone(cached.value);\n  // Scoped requests must remain cancellable independently of shared reads.\n  let request = options.signal ? call(\"sql\", parameters, options) : pendingReads.get(key);\n  if (!request) {\n    request = typeof DSH_COLUMNAR_SQL !== \"undefined\" && DSH_COLUMNAR_SQL\n      ? batchRead(parameters) : call(\"sql\", parameters);\n    pendingReads.set(key, request);\n  }\n  try {\n    const raw = await request;\n    const value = columnSql ? unpackColumns(raw) : raw;\n    if (parameters.maxRows && value.rows.length > parameters.maxRows)\n      throw Error(\"QUERY_RESULT_EXCEEDS_LIMIT\");\n    if (governed && value.rejectedColumns?.length && typeof window !== \"undefined\") {\n      window.dispatchEvent(new CustomEvent(\"gea-query-warning\", {detail: {\n        message: DATA_PERMISSION_MESSAGE,\n      }}));\n    }\n    if (isCatalog && pendingReads.get(key) === request)\n      catalogs.set(key, { expires: Date.now() + 30000, value });\n    // Business loaders mutate rows while normalizing; give each caller its own copy.\n    return structuredClone(value);\n  } finally {\n    if (pendingReads.get(key) === request) pendingReads.delete(key);\n  }\n}\nexport const database = {\n  queryNamed: async (sql: string, parameters: Record<string, unknown>, options: {signal?: AbortSignal; pageNo?: number; pageSize?: number} = {}) =>\n    read({sql, parameters, ...(options.pageNo !== undefined ? {pageNo: options.pageNo, pageSize: options.pageSize ?? 10} : {})}, options),\n  query: async (sql: string, values: unknown[] = [], options: {signal?: AbortSignal; pageSize?: number} = {}) =>\n    read({ sql, values, ...(options.pageSize ? {pageSize: options.pageSize} : {}) }, options),\n};\nexport function getDatabase() {\n  return database;\n}\nexport function getBusinessDatabase() {\n  return database;\n}\nexport function getReadOnlyPool() {\n  return database;\n}\nexport function usesGeaSql() {\n  return true;\n}\nexport async function queryBusinessDatabase(\n  db: any,\n  sql: string,\n  values: unknown[],\n  options: any,\n) {\n  if (!governed && options?.groupBy?.length && options?.orderBy?.length) {\n    const packing = {keys:options.groupBy,order:options.orderBy,timestamps:[\"updated_time\"]};\n    if(db.queryPackedRows) return db.queryPackedRows(sql,values,packing);\n    return read({sql,values,packing});\n  }\n  return db.query(sql, values, options);\n}\nexport async function queryPackedBusinessRows(\n  db: any,\n  sql: string,\n  values: unknown[],\n  packing: any,\n) {\n  if (governed) return db.query(sql, values);\n  return read({ sql, values, packing });\n}\nexport async function executeWorkbenchSqlQuery(_ref: any, query: any) {\n  if (!governed && supportsPackedTransfer(query.name)) {\n    const result = await read({\n      sql: packedSafetyStockSql(query.sql, query.name),\n      parameters: query.parameters ?? {},\n      maxRows: Math.ceil(query.maxRows / 100),\n    });\n    return unpackSafetyStock(result.rows, query.maxRows);\n  }\n  const result = await read({\n      sql: query.sql,\n      parameters: query.parameters ?? {},\n      maxRows: query.maxRows,\n    });\n  const rows = result.rows;\n  const decoded = query.outputAliases ? rows.map((row: any) => Object.fromEntries(\n    Object.entries(row).map(([key, value]) => [query.outputAliases[key] ?? key, value]),\n  )) : rows;\n  if (result.rejectedColumns?.length) Object.defineProperty(decoded, 'rejectedColumns', {value: result.rejectedColumns});\n  return decoded;\n}\nexport class GeaSqlApiError extends Error {\n  code: string;\n  constructor(message: string, code = \"GEA_QUERY_FAILED\") {\n    super(message);\n    this.code = code;\n  }\n}\nexport async function executeGeaSql(sql: string, options: any = {}) {\n  return (\n    await read({\n      sql,\n      parameters: options.parameters ?? {},\n      pageNo: 1,\n      pageSize: 200,\n    })\n  ).rows;\n}\nexport async function executeGeaSqlPage(\n  sql: string,\n  pageNo = 1,\n  pageSize = 200,\n  options: any = {},\n) {\n  return read({\n    sql,\n    parameters: options.parameters ?? {},\n    pageNo,\n    pageSize,\n  });\n}\nexport async function executeAllGeaSqlPages(sql: string, options: any = {}) {\n  return (await read({ sql, parameters: options.parameters ?? {} }))\n    .rows;\n}\nexport const executeDirectSql = executeGeaSql;\nexport const executeDirectSqlPage = executeGeaSqlPage;\nexport const executeAllDirectSqlPages = executeAllGeaSqlPages;\nexport function createGeaSqlExecutor() {\n  return database;\n}\nexport const EMPTY_PLANNING = {\n  imports: [],\n  rules: [],\n  revision: \"browser-draft\",\n  available: false,\n};\nexport async function readPlanningState() {\n  return EMPTY_PLANNING;\n}\nexport async function geaSqlSession() {\n  throw Error(\"由 GEA 公共插件管理会话\");\n}\n\n// Original Agent's GEA-only query path uses the same governed host bridge.\nexport const executeGeaSqlQuery = executeWorkbenchSqlQuery;\n"},"source/inventory-light-plugins/src/dealer-draft.ts":{"blob":"3a1be36a4ca902ad29576567cd54f02deb7a53b4","sha256":"5b60dc7a1678d14a0ae073e6450b2d73f7392c0172de08b88ca2d7bc44a648a8","text":"export function draftProblems(rows: any[]) {\n  return rows.flatMap((row) => {\n    const prefix = `${row.customerCode}/${row.code}`;\n    if (\n      !Number.isFinite(row.quantity) ||\n      row.quantity <= 0 ||\n      row.quantity > 1e9\n    )\n      return [prefix + \"：数量须大于 0 且不超过 10 亿\"];\n    if (\n      (row.source === \"manual\" || row.quantity < row.suggestedQuantity) &&\n      !row.reason?.trim()\n    )\n      return [prefix + \"：人工选品或调减建议量必须填写理由\"];\n    return [];\n  });\n}\nexport function makeDraft(\n  row: any,\n  customerCode: string,\n  manual: boolean,\n  now = new Date(),\n) {\n  if (\n    !customerCode ||\n    !row.code ||\n    (row.dealerCode && row.dealerCode !== customerCode)\n  )\n    throw Error(\"请在对应客户明细中选品\");\n  if (\n    !manual &&\n    (!Number.isFinite(row.suggestedStockQty) || row.suggestedStockQty <= 0)\n  )\n    throw Error(\"建议量未核实，不能采纳\");\n  return {\n    key: customerCode + \":\" + row.code,\n    customerCode,\n    code: row.code,\n    name: row.sku,\n    quantity: manual ? 1 : row.suggestedStockQty,\n    suggestedQuantity: row.suggestedStockQty ?? null,\n    reason: \"\",\n    evidence: row.liveReason,\n    source: manual ? \"manual\" : \"suggestion\",\n    status: \"local-only\",\n    selectedAt: now.toISOString(),\n  };\n}\n"},"source/inventory-light-plugins/src/dealer-engine.ts":{"blob":"411cf4088a2f3ee284167ba4516bd411e812b11b","sha256":"dcdd73a3c146a8ecc021583ba400164aea19efb63d2b8092cd49cef937ab9031","text":"export {\n  loadDealerDashboard as load,\n  loadDealerCustomers,\n  loadDealerResultPage,\n  loadDealerAging,\n} from \"../../dealer/web/src/lib/dealer-dashboard.ts\";\n\nexport { loadDealerDemoPayload } from \"../../dealer/web/src/lib/dealer-demo-live-data.ts\";\n"},"source/inventory-light-plugins/src/dealer-order.ts":{"blob":"d0fd6d602c047064aa60369edf0922e187d6f353","sha256":"046d227ee59030da760de7d075c605b5891ccf3e071bf40caff8aed530cd1fd0","text":"/** Browser-only counterpart of the original commerce policy guard. No inferred discounts. */\nexport function applicablePolicies(policies:any[],customerCode:string,sku:string,pickupCode:string,now=new Date()) {\n const date=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit'}).format(now);\n const active=(p:any)=>(!p.start||p.start<=date)&&(!p.end||p.end>=date);\n return policies.filter(p=>!p.mock&&p.customerCode===customerCode&&active(p)&&pickupCode&&\n   Array.isArray(p.verifiedPickupCodes)&&p.verifiedPickupCodes.includes(pickupCode)&&\n   p.scopes?.some((scope:any)=>scope.productCode===sku&&active(scope)&&\n     (Array.isArray(scope.verifiedPickupCodes)?scope.verifiedPickupCodes.includes(pickupCode):scope.pickupCode===pickupCode)));\n}\nexport function orderTotals(rows:any[]) {\n const quantity=rows.reduce((total,r)=>total+(Number.isFinite(r.quantity)?r.quantity:0),0);\n const priceComplete=rows.length>0&&rows.every(r=>typeof r.unitPrice==='number'&&Number.isFinite(r.unitPrice)&&r.unitPrice>=0);\n return {count:rows.length,quantity,amount:priceComplete?rows.reduce((sum,r)=>sum+r.unitPrice*r.quantity,0):null};\n}\n"},"source/inventory-light-plugins/src/dsh-ui/Button.module.css":{"blob":"b85494af3fdda8b7d435b09c949f482f2cbd4a5e","sha256":"0b6fc685b366edacbb549dbac46601534c4b86902377ccb56d7fda43737272c9","text":"/* DSH button behavior and dimensions; inventory plugins share 6px corners. */\n.button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 11px;\n  line-height: 1.4;\n  color: var(--dsw-alias-label-primary);\n  background: transparent;\n  padding: 0 14px;\n}\n\n.button:disabled {\n  cursor: not-allowed;\n  opacity: 0.4;\n}\n\n.md {\n  height: 36px;\n}\n\n/* Compact height for dense rows; no dedicated figma node (Icon_container\n * 28x28 is the icon-only form) — geometry is ours. */\n.sm {\n  height: 28px;\n  font-size: 11px;\n  line-height: 18px;\n  padding: 0 10px;\n  border-radius: 6px;\n}\n\n.primary {\n  background: var(--dsw-alias-button-primary-fill);\n  color: var(--dsw-alias-label-primary-foreground);\n}\n\n.primary:hover:not(:disabled) {\n  background: var(--dsw-alias-button-primary-hover);\n}\n\n.ghost:hover:not(:disabled) {\n  background: var(--dsw-alias-interactive-bg-hover);\n}\n\n.ghost:active:not(:disabled) {\n  background: var(--dsw-alias-interactive-bg-active);\n}\n\n/* Dialog Cancel (figma 451:18655): bordered capsule on transparent fill. */\n.outline {\n  border: 1px solid var(--dsw-alias-border-l3);\n  background: transparent;\n}\n\n.outline:hover:not(:disabled) {\n  background: var(--dsw-alias-interactive-bg-hover);\n}\n\n.toolbar {\n  background: var(--dsw-alias-button-tool-bar-fill);\n}\n\n.toolbar:hover:not(:disabled) {\n  background: var(--dsw-alias-button-tool-bar-hover);\n}\n\n.icon {\n  display: inline-flex;\n  width: 16px;\n  height: 16px;\n  align-items: center;\n  justify-content: center;\n}\n\n.md { border-radius: 8px; font-weight: 600; }\n.outline:hover:not(:disabled) { border-color: var(--ui-accent-line); }\n"},"source/inventory-light-plugins/src/dsh-ui/DshButton.tsx":{"blob":"1a4c6365281b4ee2443ae015037e87417d714601","sha256":"fb45bad260a59a51359a80262abd619d44d439f0825230f157303eb1cf391a18","text":"/*!\nMIT License\n\nCopyright (c) 2026 DeepSeek\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n\n*/\n// Button: token-styled button atom. Variants map to the --dsw-alias-button-*\n// fill families; no framework imports, all behavior via props.\n\nimport type { ButtonHTMLAttributes, ReactNode } from \"react\";\nimport clsx from \"clsx\";\nimport css from \"./Button.module.css\";\n\n/** Visual variant, each backed by its --dsw-alias-button-* token family. */\nexport type ButtonVariant = \"primary\" | \"ghost\" | \"outline\" | \"toolbar\";\n\n/**\n * Render a button.\n * @param props.variant - visual family (default 'ghost').\n * @param props.size - 'md' 36px capsule (figma Button) or 'sm' 28px compact.\n * @param props.icon - optional leading 16px icon node.\n * @returns the button element; native button attributes pass through.\n */\nexport function Button({\n  variant = \"ghost\",\n  size = \"md\",\n  icon,\n  className,\n  children,\n  ...rest\n}: {\n  variant?: ButtonVariant;\n  size?: \"md\" | \"sm\";\n  icon?: ReactNode;\n  className?: string | undefined;\n  children?: ReactNode;\n} & ButtonHTMLAttributes<HTMLButtonElement>) {\n  return (\n    <button\n      type=\"button\"\n      className={clsx(css.button, css[variant], css[size], className)}\n      {...rest}\n    >\n      {icon != null && <span className={css.icon}>{icon}</span>}\n      {children}\n    </button>\n  );\n}\n"},"source/inventory-light-plugins/src/dsh-ui/base.css":{"blob":"c889b4ef2292341a2537a72b6ce3d04de2652831","sha256":"e834b61874dc4b2dcbd671323fd6ff00ba3d7fc81d8d4270d4fa5b295fa939d2","text":"/* Shared paint tokens; geometry remains owned by each business page. */\n:root {\n  --ui-font: \"Microsoft YaHei UI\", \"PingFang SC\", \"Noto Sans CJK SC\", Arial, sans-serif;\n  --ui-ink: #20232a;\n  --ui-secondary: #555d68;\n  --ui-muted: #858c96;\n  --ui-faint: #a0a4ac;\n  --ui-border: #e3e6ea;\n  --ui-border-strong: #d9dde3;\n  --ui-divider: #eceef1;\n  --ui-canvas: #f7f8fa;\n  --ui-surface: #fff;\n  --ui-subtle: #fafafa;\n  --ui-soft: #f5f6f8;\n  --ui-accent: #df1732;\n  --ui-accent-hover: #c91029;\n  --ui-accent-ink: #df1732;\n  --ui-accent-soft: #fff0f2;\n  --ui-accent-line: #efabb4;\n  --ui-hover: #fffafb;\n  --ui-selected: #fff2f4;\n  --ui-help-line: #efcdd2;\n  --ui-success: #168e58;\n  --ui-success-soft: #eaf7ef;\n  --ui-warning: #956900;\n  --ui-warning-soft: #fff4d9;\n  --ui-risk: #c8112a;\n  --ui-risk-soft: #ffe9ec;\n  --ui-neutral: #667085;\n  --ui-neutral-soft: #eef1f5;\n  --ui-shadow: 0 2px 10px #20273308;\n  --ui-shadow-hover: 0 8px 20px #20273312;\n  --ui-shadow-floating: 0 12px 32px #1d20281a;\n  --ui-focus: 0 0 0 3px #df173226;\n}\n/* Isolated HTML pages supply fallbacks for the same token names used by DSH. */\n:root {\n  color-scheme: light;\n  --dsw-alias-label-primary: var(--ui-ink);\n  --dsw-alias-label-secondary: var(--ui-secondary);\n  --dsw-alias-label-primary-foreground: #fff;\n  --dsw-alias-bg-base: #fff;\n  --dsw-alias-border-l3: var(--ui-border);\n  --dsw-alias-button-primary-fill: var(--ui-accent);\n  --dsw-alias-button-primary-hover: var(--ui-accent-hover);\n  --dsw-alias-button-tool-bar-fill: var(--ui-soft);\n  --dsw-alias-button-tool-bar-hover: var(--ui-hover);\n  --dsw-alias-interactive-bg-hover: var(--ui-hover);\n  --dsw-alias-interactive-bg-active: var(--ui-border);\n  font-family: var(--ui-font);\n  font-size: 12px;\n  line-height: 1.7;\n  color: var(--dsw-alias-label-primary);\n  background: var(--dsw-alias-bg-base);\n}\n* {\n  box-sizing: border-box;\n}\nhtml,\nbody {\n  margin: 0;\n  min-width: 0;\n  width: 100%;\n  height: 100%;\n}\n#app {\n  height: 100%;\n  min-width: 0;\n}\nbutton,\ninput,\nselect,\ntextarea {\n  font: inherit;\n}\nbutton {\n  cursor: pointer;\n}\nbutton:disabled {\n  cursor: not-allowed;\n  opacity: 0.5;\n}\ninput,\nselect,\ntextarea {\n  border: 1px solid var(--dsw-alias-border-l3);\n  border-radius: 8px;\n  padding: 6px 8px;\n  color: inherit;\n  background: var(--dsw-alias-bg-base);\n}\nbutton:focus-visible,\ninput:focus-visible,\nselect:focus-visible,\ntextarea:focus-visible {\n  outline: 2px solid var(--dsw-alias-button-primary-fill);\n  outline-offset: 2px;\n}\ntable {\n  border-collapse: collapse;\n}\nbutton {\n  color: inherit;\n}\ndetails summary {\n  cursor: pointer;\n}\na {\n  color: var(--dsw-alias-button-primary-fill);\n}\n.dsh-modal-content {\n  max-height: 75vh;\n  overflow: auto;\n}\n.dsh-business-page {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n.dsh-business-page > section {\n  flex: 1;\n  min-height: 0;\n  width: 100%;\n}\n\n/* Shared control states, without changing widths, spacing, or table density. */\nbutton, input, select, textarea { transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease; }\ninput::placeholder, textarea::placeholder { color: var(--ui-faint); opacity: 1; }\ninput:hover:not(:disabled), select:hover:not(:disabled), textarea:hover:not(:disabled) { border-color: var(--ui-accent-line); }\ninput:focus-visible, select:focus-visible, textarea:focus-visible { border-color: var(--ui-accent); }\ninput[type=\"checkbox\"], input[type=\"radio\"] { accent-color: var(--ui-accent); }\ntable { font-variant-numeric: tabular-nums; }\nth { color: var(--ui-secondary); }\n::selection { background: var(--ui-accent-line); color: var(--ui-ink); }\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }\n}\n\n/* Workbench visual contract. Business layout remains in each page module. */\na:focus-visible, summary:focus-visible, [tabindex]:focus-visible {\n  outline: 2px solid var(--ui-accent); outline-offset: 2px;\n}\ninput:focus-visible, select:focus-visible, textarea:focus-visible { box-shadow: var(--ui-focus); }\nbutton:disabled:hover { transform: none; box-shadow: none; }\n"},"source/inventory-light-plugins/src/dsh-ui/controls.module.css":{"blob":"207e9c1b224f0df61662ed44d6f0d9cdfe92d918","sha256":"d41567d543907b929f6f4e108ec36a6991d73a764458988a34a8156d2e460864","text":".input {\n  border: 1px solid var(--dsw-alias-border-l3);\n  border-radius: 6px;\n  background: var(--dsw-alias-bg-base);\n  color: inherit;\n  padding: 7px 10px;\n  font: inherit;\n  max-width: 100%;\n  min-width: 0;\n}\n.inline,\n.space,\n.heading,\n.footer,\n.pagination {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.space {\n  flex-wrap: wrap;\n}\n.heading {\n  justify-content: space-between;\n  margin-bottom: 12px;\n}\n.heading h2 {\n  font-size: 18px;\n  margin: 0;\n}\n.card {\n  border: 1px solid var(--dsw-alias-border-l3);\n  padding: 16px;\n  border-radius: 10px;\n  background: var(--dsw-alias-bg-base);\n}\n.alert {\n  padding: 12px 16px;\n  border: 1px solid var(--ui-accent-line);\n  border-radius: 6px;\n  margin: 8px 0;\n  background: var(--dsw-alias-interactive-bg-hover);\n}\n.error {\n  border-color: #b42318;\n  color: #b42318;\n}\n.tag {\n  display: inline-block;\n  border-radius: 6px;\n  padding: 2px 6px;\n  background: var(--dsw-alias-interactive-bg-hover);\n  font-size: 12px;\n}\n.skeleton {\n  padding: 28px;\n  color: var(--dsw-alias-label-secondary);\n}\n.modal {\n  border: 1px solid var(--dsw-alias-border-l3);\n  border-radius: 10px;\n  padding: 20px;\n  width: min(900px, calc(100vw - 32px));\n  max-height: 90vh;\n  color: var(--dsw-alias-label-primary);\n  background: var(--dsw-alias-bg-base);\n}\n.modal::backdrop {\n  background: #0006;\n}\n.footer {\n  justify-content: flex-end;\n  margin-top: 16px;\n}\n.tabs {\n  display: flex;\n  gap: 4px;\n  overflow-x: auto;\n  border-bottom: 1px solid var(--dsw-alias-border-l3);\n  margin-bottom: 12px;\n}\n.tabs button {\n  white-space: nowrap;\n  background: transparent;\n  color: inherit;\n  border: 0;\n  padding: 10px 14px;\n  cursor: pointer;\n}\n.tabs button[aria-selected=\"true\"],\n.tabs button[aria-checked=\"true\"] {\n  color: var(--dsw-alias-button-primary-fill);\n  border-bottom: 2px solid currentColor;\n}\n.dropdown {\n  position: relative;\n  display: inline-block;\n}\n.menu {\n  position: absolute;\n  right: 0;\n  top: 100%;\n  z-index: 30;\n  background: var(--dsw-alias-bg-base);\n  border: 1px solid var(--dsw-alias-border-l3);\n  border-radius: 10px;\n  box-shadow: 0 2px 8px #17203314;\n  min-width: 220px;\n  padding: 6px;\n}\n.menuItem {\n  display: block;\n  width: 100%;\n  padding: 10px;\n  text-align: left;\n  border: 0;\n  color: inherit;\n  background: none;\n  cursor: pointer;\n}\n.menuItem:hover {\n  background: var(--dsw-alias-interactive-bg-hover);\n}\n.tableScroll {\n  overflow: auto;\n  max-width: 100%;\n}\n.table {\n  border-collapse: collapse;\n  min-width: 100%;\n  font-size: 13px;\n}\n.table th,\n.table td {\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--dsw-alias-border-l3);\n  white-space: nowrap;\n}\n.table th {\n  position: sticky;\n  top: 0;\n  text-align: left;\n  background: var(--dsw-alias-interactive-bg-hover);\n}\n.table tbody tr:hover {\n  background: var(--dsw-alias-interactive-bg-hover);\n}\n.pagination {\n  justify-content: flex-end;\n  padding: 12px 0;\n  flex-wrap: wrap;\n}\n\n/* Shared compact workbench components (workbench-ui-style). */\n.input { min-height:36px; border-radius:8px; font-size:11px; line-height:1.4; }\n.card { box-shadow:var(--ui-shadow); }\n.alert { border-radius:8px; font-size:12px; }\n.error { color:var(--ui-risk); border-color:var(--ui-risk); background:var(--ui-risk-soft); }\n.tag { border-radius:999px; font-size:8px; font-weight:700; line-height:1.25; padding:3px 6px; }\n.modal { border-radius:10px; padding:16px; box-shadow:var(--ui-shadow-floating); }\n.menu { border-radius:8px; box-shadow:var(--ui-shadow-floating); }\n.tabs { gap:0; scrollbar-width:none; }\n.tabs::-webkit-scrollbar { display:none; }\n.tabs button { flex:none; height:42px; min-width:100px; padding:0 14px; border-bottom:2px solid transparent; border-radius:0; font-size:10px; font-weight:600; color:var(--ui-secondary); }\n.tabs button:hover:not(:disabled) { background:var(--ui-hover); color:var(--ui-accent); }\n.tabs button[aria-selected=\"true\"], .tabs button[aria-checked=\"true\"] { background:var(--ui-surface); font-weight:800; }\n.table { font-size:10px; }\n.table th, .table td { padding:8px 14px; border-color:var(--ui-divider); }\n.table th { height:38px; font-size:9px; font-weight:800; line-height:1.35; background:var(--ui-soft); }\n.table td { height:44px; color:var(--ui-secondary); }\n.table tbody tr:hover { background:var(--ui-hover); }\n@media(max-width:720px) { .heading { flex-wrap:wrap; } }\n\n.table { background:var(--ui-surface); }\n.table th > button, .table td > button[aria-expanded] { border:0; border-radius:6px; background:transparent; font:inherit; color:inherit; padding:4px 6px; }\n.table th > button:hover, .table td > button[aria-expanded]:hover { background:var(--ui-hover); color:var(--ui-accent); }\n.table td > button[aria-expanded] { min-width:24px; min-height:24px; margin-right:4px; }\n\n.tableRegion { position: relative; }\n.tableLoading {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  display: flex;\n  align-items: flex-start;\n  justify-content: center;\n  padding-top: 48px;\n  background: rgb(255 255 255 / 72%);\n  color: #858c96;\n  font-size: 11px;\n}\n"},"source/inventory-light-plugins/src/dsh-ui/controls.tsx":{"blob":"1d6ae4293660daeb3e641418bbb6b41fe0b66d53","sha256":"49318b6eb3bd1718fde4c8734400bc60654243a2634a966f0c621ad86023caa5","text":"import {queryErrorText} from '../query-error.js';\nimport React, {\n  Children,\n  cloneElement,\n  createContext,\n  useContext,\n  useEffect,\n  useId,\n  useRef,\n  useState,\n} from \"react\";\nimport { createPortal } from \"react-dom\";\nimport { Button as DshButton } from \"./DshButton\";\nimport css from \"./controls.module.css\";\n// Business controls use the same React + native HTML + CSS Modules boundary as DSH.\nexport function Button({\n  type,\n  htmlType = \"button\",\n  size,\n  loading,\n  icon,\n  children,\n  variant,\n  ...props\n}: any) {\n  return (\n    <DshButton\n      {...props}\n      type={htmlType}\n      variant={\n        variant ??\n        (type === \"primary\" ? \"primary\" : type === \"text\" ? \"ghost\" : \"outline\")\n      }\n      size={size === \"small\" || size === \"mini\" ? \"sm\" : \"md\"}\n      disabled={props.disabled || loading}\n      icon={icon}\n    >\n      {loading ? \"处理中…\" : children}\n    </DshButton>\n  );\n}\nexport function Input({\n  onChange,\n  allowClear,\n  prefix,\n  suffix,\n  autoSize,\n  showWordLimit,\n  children,\n  ...p\n}: any) {\n  return (\n    <input\n      {...p}\n      className={`${css.input} ${p.className ?? \"\"}`}\n      onChange={(e) => onChange?.(e.target.value, e)}\n    />\n  );\n}\nInput.TextArea = ({ onChange, autoSize, showWordLimit, ...p }: any) => (\n  <textarea\n    {...p}\n    rows={autoSize?.minRows ?? 4}\n    className={css.input}\n    onChange={(e) => onChange?.(e.target.value, e)}\n  />\n);\nexport function InputNumber({ onChange, precision, ...p }: any) {\n  return (\n    <input\n      {...p}\n      type=\"number\"\n      className={css.input}\n      onChange={(e) =>\n        onChange?.(e.target.value === \"\" ? undefined : Number(e.target.value))\n      }\n    />\n  );\n}\nexport function Select({\n  options,\n  children,\n  onChange,\n  showSearch,\n  allowSearch,\n  onSearch,\n  filterOption,\n  allowClear,\n  placeholder,\n  value,\n  mode,\n  size,\n  style,\n  ...p\n}: any) {\n  const [search, setSearch] = useState(\"\");\n  const optionsAll =\n    options ??\n    Children.toArray(children).map((c: any) => ({\n      value: c.props.value,\n      label: c.props.children,\n    }));\n  const opts =\n    onSearch || !search\n      ? optionsAll\n      : optionsAll.filter((o: any) =>\n          String(o.label ?? o)\n            .toLowerCase()\n            .includes(search.toLowerCase()),\n        );\n  const label = p[\"aria-label\"] ?? placeholder ?? \"选项\";\n  return (\n    <span\n      style={{\n        display: \"inline-flex\",\n        flexDirection: \"column\",\n        gap: 4,\n        ...style,\n      }}\n    >\n      {(showSearch || allowSearch) && (\n        <input\n          className={css.input}\n          aria-label={label + \"搜索\"}\n          type=\"search\"\n          value={search}\n          placeholder=\"输入名称搜索\"\n          disabled={p.disabled}\n          onChange={(e) => {\n            setSearch(e.target.value);\n            onSearch?.(e.target.value);\n          }}\n        />\n      )}\n      <select\n        {...p}\n        aria-label={label}\n        className={`${css.input} ${p.className ?? \"\"}`}\n        multiple={mode === \"multiple\"}\n        value={value ?? \"\"}\n        onChange={(e) => {\n          onChange?.(\n            mode === \"multiple\"\n              ? Array.from(e.target.selectedOptions).map((o) => o.value)\n              : (optionsAll.find(\n                  (o: any) => String(o.value ?? o) === e.target.value,\n                )?.value ?? e.target.value),\n          );\n        }}\n      >\n        {(allowClear || placeholder) && (\n          <option value=\"\">{placeholder ?? \"全部\"}</option>\n        )}\n        {value &&\n          mode !== \"multiple\" &&\n          !opts.some((o: any) => String(o.value ?? o) === String(value)) && (\n            <option value={value}>\n              {optionsAll.find(\n                (o: any) => String(o.value ?? o) === String(value),\n              )?.label ?? value}\n            </option>\n          )}\n        {opts.map((o: any) => (\n          <option key={o.value ?? o} value={o.value ?? o} disabled={o.disabled}>\n            {o.label ?? o}\n          </option>\n        ))}\n      </select>\n    </span>\n  );\n}\nSelect.Option = ({ children }: any) => <>{children}</>;\nexport function Checkbox({ onChange, children, indeterminate, ...p }: any) {\n  return (\n    <label className={css.inline}>\n      <input\n        {...p}\n        type=\"checkbox\"\n        onChange={(e) => onChange?.(e.target.checked, e)}\n      />\n      {children}\n    </label>\n  );\n}\nexport function Space({ children, direction, size, style, ...p }: any) {\n  return (\n    <div\n      className={css.space}\n      style={{\n        flexDirection: direction === \"vertical\" ? \"column\" : \"row\",\n        gap: typeof size === \"number\" ? size : 8,\n        ...style,\n      }}\n    >\n      {children}\n    </div>\n  );\n}\nexport function Card({ children, title, extra, style, className }: any) {\n  return (\n    <section className={`${css.card} ${className ?? \"\"}`} style={style}>\n      {(title || extra) && (\n        <header className={css.heading}>\n          <strong>{title}</strong>\n          {extra}\n        </header>\n      )}\n      {children}\n    </section>\n  );\n}\nexport function Alert({\n  type = \"info\",\n  content,\n  title,\n  action,\n  children,\n}: any) {\n  return (\n    <div\n      className={`${css.alert} ${type === \"error\" ? css.error : \"\"}`}\n      role={type === \"error\" ? \"alert\" : \"status\"}\n    >\n      {title && <strong>{title}</strong>}\n      {queryErrorText(content)}\n      {children}\n      {action}\n    </div>\n  );\n}\nexport function Tag({ children }: any) {\n  return <span className={css.tag}>{children}</span>;\n}\nexport function Tooltip({ children, content }: any) {\n  return (\n    <span title={typeof content === \"string\" ? content : undefined}>\n      {children}\n    </span>\n  );\n}\nexport function Spin({ children, loading = true }: any) {\n  return (\n    <div aria-busy={loading}>\n      {loading && <span role=\"status\">正在读取…</span>}\n      {children}\n    </div>\n  );\n}\nexport function Skeleton({ loading = true, children }: any) {\n  if (!loading) return <>{children}</>;\n  return (\n    <div className={css.skeleton} role=\"status\">\n      正在读取业务数据…\n    </div>\n  );\n}\nexport const Typography = {\n  Text: ({ children, type, ellipsis, ...p }: any) => (\n    <span {...p}>{children}</span>\n  ),\n};\nexport function Modal({\n  visible,\n  children,\n  title,\n  onCancel,\n  onOk,\n  footer,\n  okText = \"确定\",\n  cancelText = \"取消\",\n  okButtonProps,\n  confirmLoading,\n  closable = true,\n  escToExit = true,\n  style,\n  maskClosable = true,\n}: any) {\n  const ref = useRef<HTMLDialogElement>(null),\n    label = useId();\n  useEffect(() => {\n    if (visible) {\n      ref.current?.showModal();\n      return () => ref.current?.close();\n    }\n  }, [visible]);\n  if (!visible) return null;\n  return createPortal(\n    <dialog\n      ref={ref}\n      className={`${css.modal} dsh-modal dsh-modal-wrapper`}\n      style={style}\n      aria-labelledby={label}\n      onCancel={(e) => {\n        e.preventDefault();\n        if (escToExit) onCancel?.();\n      }}\n      onClick={(e) => {\n        if (maskClosable && e.target === e.currentTarget) onCancel?.();\n      }}\n    >\n      <header className={css.heading}>\n        <h2 id={label}>{title}</h2>\n        {closable && (\n          <Button aria-label=\"关闭\" onClick={onCancel}>\n            ×\n          </Button>\n        )}\n      </header>\n      <div className=\"dsh-modal-content\">{children}</div>\n      {footer === null ? null : (\n        <footer className={css.footer}>\n          {footer ?? (\n            <>\n              <Button onClick={onCancel}>{cancelText}</Button>\n              <Button\n                type=\"primary\"\n                {...okButtonProps}\n                loading={confirmLoading}\n                onClick={onOk}\n              >\n                {okText}\n              </Button>\n            </>\n          )}\n        </footer>\n      )}\n    </dialog>,\n    document.body,\n  );\n}\nexport const Drawer = Modal;\nexport function Tabs({ activeTab, defaultActiveTab, onChange, children }: any) {\n  const items = Children.toArray(children) as any[],\n    [local, setLocal] = useState(\n      defaultActiveTab ?? String(items[0]?.key ?? \"\").replace(/^\\.\\$/, \"\"),\n    );\n  const key = activeTab ?? local;\n  return (\n    <>\n      <div className={css.tabs} role=\"tablist\">\n        {items.map((c) => {\n          const id = String(c.key).replace(/^\\.\\$/, \"\");\n          return (\n            <button\n              type=\"button\"\n              role=\"tab\"\n              key={id}\n              aria-selected={key === id}\n              onClick={() => {\n                setLocal(id);\n                onChange?.(id);\n              }}\n            >\n              {c.props.title}\n            </button>\n          );\n        })}\n      </div>\n      {items\n        .filter((c) => String(c.key).replace(/^\\.\\$/, \"\") === key)\n        .map((c) => (\n          <div key={c.key} role=\"tabpanel\">\n            {c.props.children}\n          </div>\n        ))}\n    </>\n  );\n}\nTabs.TabPane = ({ children }: any) => <>{children}</>;\nexport function Radio({ children }: any) {\n  return <>{children}</>;\n}\nRadio.Group = ({ value, onChange, options, children }: any) => (\n  <div className={css.tabs} role=\"radiogroup\">\n    {(\n      options ??\n      Children.toArray(children).map((c: any) => ({\n        value: c.props.value,\n        label: c.props.children,\n      }))\n    ).map((o: any) => (\n      <button\n        type=\"button\"\n        role=\"radio\"\n        key={o.value ?? o}\n        aria-checked={value === (o.value ?? o)}\n        onClick={() => onChange(o.value ?? o)}\n      >\n        {o.label ?? o}\n      </button>\n    ))}\n  </div>\n);\nexport const DatePicker = {\n  MonthPicker: ({ onChange, allowClear, ...p }: any) => (\n    <input\n      {...p}\n      type=\"month\"\n      className={css.input}\n      onChange={(e) => onChange?.(e.target.value)}\n    />\n  ),\n};\nconst MenuContext = createContext<any>(null);\nexport function Menu({ children, onClickMenuItem, selectedKeys, ...p }: any) {\n  return (\n    <MenuContext.Provider value={{ onClickMenuItem, selectedKeys }}>\n      <div role=\"menu\" {...p}>\n        {Children.map(children, (c: any) =>\n          cloneElement(c, { itemKey: c.key }),\n        )}\n      </div>\n    </MenuContext.Provider>\n  );\n}\nMenu.Item = ({ children, itemKey }: any) => {\n  const c = useContext(MenuContext);\n  return (\n    <button\n      className={css.menuItem}\n      role=\"menuitemcheckbox\"\n      aria-checked={c?.selectedKeys?.includes(itemKey)}\n      onClick={() => c?.onClickMenuItem(itemKey)}\n    >\n      {children}\n    </button>\n  );\n};\nexport function Dropdown({ children, droplist }: any) {\n  const [open, setOpen] = useState(false),\n    ref = useRef<HTMLDivElement>(null);\n  useEffect(() => {\n    const close = (e: Event) => {\n      if (!ref.current?.contains(e.target as Node)) setOpen(false);\n    };\n    document.addEventListener(\"pointerdown\", close);\n    return () => document.removeEventListener(\"pointerdown\", close);\n  }, []);\n  return (\n    <div\n      className={css.dropdown}\n      ref={ref}\n      onKeyDown={(e) => {\n        if (e.key === \"Escape\") setOpen(false);\n      }}\n    >\n      {cloneElement(children, {\n        \"aria-expanded\": open,\n        onClick: () => setOpen(!open),\n      })}\n      {open && <div className={css.menu}>{droplist}</div>}\n    </div>\n  );\n}\nexport type TableProps<T = any> = { columns?: any[]; [key: string]: any };\nexport function Table<T = any>({\n  columns = [],\n  data = [],\n  rowKey = \"key\",\n  pagination = false,\n  loading,\n  onRow,\n  rowClassName,\n  expandedRowKeys,\n  defaultExpandedRowKeys = [],\n  onExpandedRowsChange,\n  onExpand,\n  renderChildFooter,\n  scroll,\n}: TableProps<T>) {\n  const [page, setPage] = useState(1),\n    [localPageSize, setLocalPageSize] = useState(10),\n    [sort, setSort] = useState<any>(null),\n    [localExpanded, setLocalExpanded] = useState(defaultExpandedRowKeys);\n  const expandedKeys = expandedRowKeys ?? localExpanded;\n  const changeExpanded = (keys: any[]) => {\n    setLocalExpanded(keys);\n    onExpandedRowsChange?.(keys);\n  };\n  const count = pagination?.pageSize ?? localPageSize,\n    current = pagination?.current ?? page;\n  useEffect(() => setPage(1), [data]);\n  let records = sort\n    ? [...data].sort((a, b) => {\n        const c = columns[sort.index],\n          v = c.sorter(a, b);\n        return sort.desc ? -v : v;\n      })\n    : data;\n  const rows =\n    pagination && pagination.total === undefined\n      ? records.slice((current - 1) * count, current * count)\n      : records;\n  const render = (r: any, i: number, depth = 0): React.ReactNode => {\n    const k = typeof rowKey === \"function\" ? rowKey(r) : (r[rowKey] ?? i);\n    const open = expandedKeys.includes(k),\n      has = Array.isArray(r.children);\n    const childFooter = open ? renderChildFooter?.(r) : null;\n    return (\n      <React.Fragment key={k}>\n        <tr className={rowClassName?.(r, i)} {...onRow?.(r, i)}>\n          {columns.map((c, j) => (\n            <td\n              key={c.key ?? c.dataIndex ?? j}\n              style={{\n                textAlign: c.align,\n                width: c.width,\n                paddingLeft: j === 0 ? 12 + depth * 18 : undefined,\n              }}\n            >\n              {j === 0 && has && (\n                <button\n                  type=\"button\"\n                  aria-label={`${open ? \"收起\" : \"展开\"} ${r.objectName ?? r.label ?? k}`}\n                  aria-expanded={open}\n                  onClick={(e) => {\n                    e.stopPropagation();\n                    changeExpanded(\n                      open\n                        ? expandedKeys.filter((x: any) => x !== k)\n                        : [...expandedKeys, k],\n                    );\n                    onExpand?.(r, !open);\n                  }}\n                >\n                  {open ? \"▾\" : \"▸\"}\n                </button>\n              )}\n              {c.render\n                ? c.render(r[c.dataIndex], r, i)\n                : (r[c.dataIndex] ?? \"—\")}\n            </td>\n          ))}\n        </tr>\n        {open &&\n          r.children?.map((ch: any, n: number) => render(ch, n, depth + 1))}\n        {childFooter && <tr><td colSpan={columns.length}>{childFooter}</td></tr>}\n      </React.Fragment>\n    );\n  };\n  return (\n    <div aria-busy={loading}>\n      <div className={css.tableRegion}>\n      {loading && <div className={css.tableLoading} role=\"status\">正在读取…</div>}\n      <div\n        className={`${css.tableScroll} dsh-table-body`}\n        style={{ maxHeight: scroll?.y }}\n      >\n        <table className={css.table} style={{ minWidth: scroll?.x }}>\n          <thead>\n            <tr>\n              {columns.map((c, i) => (\n                <th\n                  key={c.key ?? c.dataIndex ?? i}\n                  style={{ textAlign: c.align, width: c.width }}\n                >\n                  {typeof c.sorter === \"function\" ? (\n                    <button\n                      onClick={() =>\n                        setSort({\n                          index: i,\n                          desc: sort?.index === i ? !sort.desc : false,\n                        })\n                      }\n                    >\n                      {c.title} ↕\n                    </button>\n                  ) : (\n                    c.title\n                  )}\n                </th>\n              ))}\n            </tr>\n          </thead>\n          <tbody>{rows.map((r: any, i: number) => render(r, i))}</tbody>\n        </table>\n        {!rows.length && !loading && <p>暂无符合条件的数据</p>}\n      </div>\n      </div>\n      {pagination && (\n        <DataPagination\n          pageNumber={current}\n          pageSize={count}\n          totalCount={pagination.total ?? data.length}\n          onPageChange={(p: number) => {\n            setPage(p);\n            pagination.onChange?.(p, count);\n          }}\n          disabled={loading}\n          pageSizeOptions={pagination.pageSizeOptions}\n          onPageSizeChange={(size: number) => {\n            setPage(1);\n            setLocalPageSize(size);\n            pagination.onPageSizeChange?.(size);\n            pagination.onChange?.(1, size);\n          }}\n        />\n      )}\n    </div>\n  );\n}\nexport function DataPagination({\n  pageNumber = 1,\n  pageSize = 10,\n  totalCount = 0,\n  onPageChange,\n  onPageSizeChange,\n  pageSizeOptions = [10, 20, 50, 100],\n  disabled,\n  ariaLabel = \"数据分页\",\n}: any) {\n  const max = Math.max(1, Math.ceil(totalCount / pageSize));\n  return (\n    <nav className={css.pagination} aria-label={ariaLabel}>\n      <span>共 {totalCount} 条</span>\n      <select\n        aria-label=\"每页条数\"\n        disabled={disabled}\n        value={pageSize}\n        onChange={(e) => onPageSizeChange?.(+e.target.value)}\n      >\n        {pageSizeOptions.map((n: number) => (\n          <option key={n} value={n}>\n            {n} 条/页\n          </option>\n        ))}\n      </select>\n      <Button\n        disabled={disabled || pageNumber <= 1}\n        onClick={() => onPageChange(pageNumber - 1)}\n      >\n        上一页\n      </Button>\n      <span>\n        {pageNumber} / {max}\n      </span>\n      <Button\n        disabled={disabled || pageNumber >= max}\n        onClick={() => onPageChange(pageNumber + 1)}\n      >\n        下一页\n      </Button>\n    </nav>\n  );\n}\nexport const Message = {\n  warning: (text: string) =>\n    window.dispatchEvent(\n      new CustomEvent(\"gea-query-warning\", { detail: { message: text } }),\n    ),\n  error: (text: string) =>\n    window.dispatchEvent(\n      new CustomEvent(\"gea-query-warning\", { detail: { message: text } }),\n    ),\n};\n"},"source/inventory-light-plugins/src/dsh-ui/workbench-loading.module.css":{"blob":"51ac7dde9676dfda85401c4448a059eac220d122","sha256":"5d0d3a34ccc20bc6e81d6ebd3514d73d5f836abaadf178f3d4cf80b1c3d16c11","text":".dashboardSkeleton {\n  margin-bottom: 0;\n}\n.loadingStatus {\n  display: flex;\n  min-height: 32px;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 8px;\n  color: var(--ui-secondary);\n  font-size: 12px;\n  font-weight: 700;\n}\n.loadingDot {\n  width: 7px;\n  height: 7px;\n  flex: none;\n  border-radius: 50%;\n  background: var(--ui-accent);\n  animation: loadingPulse 1.4s ease-in-out infinite;\n}\n.skeletonBlock {\n  display: block;\n  height: 8px;\n  border-radius: 6px;\n  background: #e8edf3;\n  animation: skeletonPulse 1.4s ease-in-out infinite;\n}\n.skeletonCard {\n  min-height: 119px;\n}\n.skeletonLabel {\n  width: 58%;\n}\n.skeletonPill {\n  width: 45px;\n  height: 18px;\n  border-radius: 999px;\n}\n.skeletonValue {\n  width: 48%;\n  height: 25px;\n  margin: 14px 0 12px;\n}\n.skeletonHelpers {\n  display: grid;\n  gap: 7px;\n  padding-top: 9px;\n  border-top: 1px solid #edf0f4;\n}\n.skeletonHelpers .skeletonBlock:first-child {\n  width: 82%;\n}\n.skeletonHelpers .skeletonBlock:last-child {\n  width: 68%;\n}\n.skeletonSummary {\n  display: grid;\n  gap: 9px;\n  min-height: 86px;\n}\n.skeletonSummaryTitle {\n  width: 92px;\n  height: 13px;\n}\n.skeletonSummary > .skeletonBlock:not(.skeletonSummaryTitle) {\n  width: 92%;\n}\n.skeletonSummaryLine {\n  width: 67% !important;\n}\n.tableSkeleton {\n  margin-bottom: 12px;\n}\n.tableSkeleton .loadingStatus {\n  margin: 0;\n  padding: 9px 12px;\n  border-bottom: 1px solid #edf0f4;\n  background: #fff;\n}\n.skeletonTableHeading {\n  width: 64px;\n}\n.skeletonTablePrimary {\n  width: 74px;\n  height: 11px;\n}\n.skeletonTableCell {\n  width: 58px;\n}\n@keyframes skeletonPulse {\n  0%,\n  100% {\n    opacity: 0.52;\n  }\n  50% {\n    opacity: 1;\n  }\n}\n@keyframes loadingPulse {\n  0%,\n  100% {\n    opacity: 0.45;\n    transform: scale(0.82);\n  }\n  50% {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n.workbench { min-width:0; width:100%; background:var(--ui-canvas); color:var(--ui-ink); }\n.header { min-height:56px; display:flex; align-items:center; padding:12px 16px; background:var(--ui-surface); border-bottom:1px solid var(--ui-border); }\n.header h2 { margin:0; font-size:18px; line-height:1.35; }\n.content { padding:16px; min-width:0; }\n.kpiGrid { display:grid; grid-template-columns:repeat(auto-fit,minmax(154px,1fr)); gap:12px; margin-bottom:12px; }\n.kpiCard { min-width:0; border:1px solid var(--ui-border); border-radius:10px; background:var(--ui-surface); padding:12px; box-shadow:var(--ui-shadow); }\n.kpiCard > div:first-child { display:flex; align-items:center; justify-content:space-between; gap:4px; }\n.summaryBox { margin-bottom:12px; padding:16px; border:1px solid var(--ui-border); border-radius:10px; background:var(--ui-surface); box-shadow:var(--ui-shadow); }\n.tableCard { max-width:100%; overflow:auto; border:1px solid var(--ui-border); border-radius:10px; background:var(--ui-surface); }\n.tableCard table { width:100%; min-width:950px; border-collapse:collapse; }\n.tableCard th { height:38px; padding:0 14px; background:var(--ui-soft); }\n.tableCard td { height:44px; padding:0 14px; border-bottom:1px solid var(--ui-divider); }\n.wideMetrics { grid-template-columns:repeat(auto-fit,minmax(112px,1fr)); }\n.compactMetrics { grid-template-columns:repeat(auto-fit,minmax(min(140px,100%),1fr)); }\n.compactMetrics.wideMetrics { grid-template-columns:repeat(auto-fit,minmax(min(112px,100%),1fr)); }\n.compactMetrics .skeletonPill { max-width:30%; }\n@media(max-width:520px) { .kpiGrid, .compactMetrics.wideMetrics { grid-template-columns:1fr; } .content { padding:12px; } }\n@media(prefers-reduced-motion:reduce) { .loadingDot, .skeletonBlock { animation:none; } }\n\n/* Embedded panels already provide the same padding as their loaded cards. */\n.embedded .content { padding:0; }\n"},"source/inventory-light-plugins/src/dsh-ui/workbench-loading.tsx":{"blob":"9c41f5f9992b03beddffd93e41a3e4c47b6f5102","sha256":"d94c28fcfdbf295b7c10957f7a086e32eddb2083f51f03b830cb1eb401af6899","text":"import styles from \"./workbench-loading.module.css\";\nconst SKELETON_TABLE_COLUMNS = [\n  \"base\",\n  \"warning\",\n  \"current\",\n  \"target\",\n  \"gap\",\n  \"turnover\",\n  \"age\",\n  \"orders\",\n] as const;\n\nconst SKELETON_TABLE_ROWS = [\n  \"row-1\",\n  \"row-2\",\n  \"row-3\",\n  \"row-4\",\n  \"row-5\",\n] as const;\n\nexport function DashboardOverviewSkeleton({ cards = 5, compact = false }: { cards?: number; compact?: boolean } = {}) {\n  return (\n    <section\n      className={styles.dashboardSkeleton}\n      role=\"status\"\n      aria-live=\"polite\"\n      aria-label=\"工作台加载中\"\n    >\n      <div className={styles.loadingStatus}>\n        <span className={styles.loadingDot} aria-hidden=\"true\" />\n        工作台加载中\n      </div>\n      <div className={`${styles.kpiGrid} ${cards === 8 ? styles.wideMetrics : \"\"} ${compact ? styles.compactMetrics : \"\"}`} aria-hidden=\"true\">\n        {Array.from({ length: cards }, (_, key) => key).map((key) => (\n          <article\n            className={`${styles.kpiCard} ${styles.skeletonCard}`}\n            key={key}\n          >\n            <div>\n              <span\n                className={`${styles.skeletonBlock} ${styles.skeletonLabel}`}\n              />\n              <span\n                className={`${styles.skeletonBlock} ${styles.skeletonPill}`}\n              />\n            </div>\n            <span\n              className={`${styles.skeletonBlock} ${styles.skeletonValue}`}\n            />\n            <div className={styles.skeletonHelpers}>\n              <span className={styles.skeletonBlock} />\n              <span className={styles.skeletonBlock} />\n            </div>\n          </article>\n        ))}\n      </div>\n      <div\n        className={`${styles.summaryBox} ${styles.skeletonSummary}`}\n        aria-hidden=\"true\"\n      >\n        <span\n          className={`${styles.skeletonBlock} ${styles.skeletonSummaryTitle}`}\n        />\n        <span className={styles.skeletonBlock} />\n        <span\n          className={`${styles.skeletonBlock} ${styles.skeletonSummaryLine}`}\n        />\n      </div>\n    </section>\n  );\n}\n\nexport function DashboardTableSkeleton({ label }: { label: string }) {\n  return (\n    <div\n      className={`${styles.tableCard} ${styles.tableSkeleton}`}\n      role=\"status\"\n      aria-live=\"polite\"\n      aria-label={label}\n    >\n      <div className={styles.loadingStatus}>\n        <span className={styles.loadingDot} aria-hidden=\"true\" />\n        {label}\n      </div>\n      <table aria-hidden=\"true\">\n        <thead>\n          <tr>\n            {SKELETON_TABLE_COLUMNS.map((column) => (\n              <th key={column}>\n                <span\n                  className={`${styles.skeletonBlock} ${styles.skeletonTableHeading}`}\n                />\n              </th>\n            ))}\n          </tr>\n        </thead>\n        <tbody>\n          {SKELETON_TABLE_ROWS.map((row) => (\n            <tr key={row}>\n              {SKELETON_TABLE_COLUMNS.map((column, index) => (\n                <td key={column}>\n                  <span\n                    className={`${styles.skeletonBlock} ${index === 0 ? styles.skeletonTablePrimary : styles.skeletonTableCell}`}\n                  />\n                </td>\n              ))}\n            </tr>\n          ))}\n        </tbody>\n      </table>\n    </div>\n  );\n}\n\n\n/** Shared safety-stock loading treatment; owns presentation only. */\nexport function WorkbenchLoading({ title, cards = 5, compact = false, embedded = false }: { title?: string; cards?: number; compact?: boolean; embedded?: boolean }) {\n  return <section className={`${styles.workbench} ${embedded ? styles.embedded : \"\"}`} aria-busy=\"true\">\n    {title && <header className={styles.header}><h2>{title}</h2></header>}\n    <div className={styles.content}>\n      <DashboardOverviewSkeleton cards={cards} compact={compact} />\n      <DashboardTableSkeleton label=\"正在读取明细\" />\n    </div>\n  </section>;\n}\n"},"source/inventory-light-plugins/src/governed/batch.ts":{"blob":"f59ce8d6ba9c960580a1264cb665f63e7289f239","sha256":"ae81797a3c464262c3f601eb85d8b11c2bfdb956a19cece174ceb1ccfbd375f1","text":"/** One local HTTP envelope; each query retains its own GEA authorization/result. */\nexport function createQueryBatch(transport: (method: string, parameters: any) => Promise<any>) {\n  let pending: Array<{parameters:any;resolve:(v:any)=>void;reject:(e:any)=>void}> = [];\n  let timer: ReturnType<typeof setTimeout> | undefined;\n  const flush = () => {\n    timer = undefined;\n    let count = 0, bytes = 0;\n    while (count < Math.min(8, pending.length)) {\n      const size = JSON.stringify(pending[count].parameters).length;\n      if (count && bytes + size > 450000) break;\n      bytes += size; count++;\n    }\n    const items = pending.splice(0, count);\n    if (pending.length) timer = setTimeout(flush, 0);\n    void transport('sql', {queries: items.map(i=>i.parameters), responseFormat:'rows'}).then(response=>{\n      if (!Array.isArray(response.results) || response.results.length !== items.length)\n        throw Error('GEA_SQL_BATCH_INVALID');\n      response.results.forEach((result:any,index:number)=>{\n        if (!result.ok) { items[index].reject(Error(result.error)); return; }\n        const value = result.value;\n        // Older hosts may still return both aliases; preserve their exact response.\n        if (value && Array.isArray(value.rows) && !('records' in value)) value.records = value.rows;\n        items[index].resolve(value);\n      });\n    }).catch(error=>items.forEach(i=>i.reject(error)));\n  };\n  return (parameters:any) => new Promise((resolve,reject)=>{\n    pending.push({parameters,resolve,reject});\n    timer ??= setTimeout(flush,0);\n  });\n}\n"},"source/inventory-light-plugins/src/governed/columnar.ts":{"blob":"e9a0e77bd60b8c9b795c5cda768492a1617c94c1","sha256":"81c248c74238004ede74b1ab17319f31323c2c2556b2a9291d104704d0efbb52","text":"/** Preserve field-level RETURN lineage: each output aggregates only that same field.\n * No whole-row JSON, synthetic values, windows or hidden permission fields.\n */\nexport function columnarQuery(sql: string): string | null {\n  const tokens = [...sql.matchAll(/'(?:''|[^'])*'|\"(?:\"\"|[^\"])*\"|--[^\\r\\n]*|\\/\\*[\\s\\S]*?\\*\\/|[A-Za-z_][A-Za-z0-9_$]*|[(),]/g)];\n  let depth = 0, start = -1;\n  const columns: string[] = [];\n  const add = (end: number) => {\n    const expression = sql.slice(start, end).trim();\n    const match = expression.match(/\\bAS\\s+(?:\"([A-Za-z_][A-Za-z0-9_$]*)\"|([A-Za-z_][A-Za-z0-9_$]*))\\s*$/i);\n    if (!match) return false;\n    columns.push(match[1] ?? match[2]);\n    return true;\n  };\n  for (const token of tokens) {\n    const word = token[0].toUpperCase();\n    if (word === '(') depth++;\n    else if (word === ')') depth--;\n    else if (depth === 0 && word === 'SELECT' && start < 0) start = token.index! + word.length;\n    else if (depth === 0 && start >= 0 && word === ',') {\n      if (!add(token.index!)) return null;\n      start = token.index! + 1;\n    } else if (depth === 0 && start >= 0 && word === 'FROM') {\n      if (!add(token.index!) || new Set(columns).size !== columns.length) return null;\n      const projection = columns.map(c => `CAST(JSON_AGG(\"dsh_columns\".\"${c}\") AS TEXT) AS \"${c}\"`).join(',\\n');\n      return `SELECT ${projection}\\nFROM (\\n${sql.replace(/;\\s*$/, '')}\\n) AS \"dsh_columns\"`;\n    }\n  }\n  return null;\n}\n\nexport function unpackColumns(result: any) {\n  if (result.rows.length !== 1) throw Error('GEA_COLUMNAR_RESULT_INVALID');\n  const entries = Object.entries(result.rows[0]).map(([key, value]) => [key, typeof value === 'string' ? JSON.parse(value) : value] as const);\n  const length = entries.find(([,v]) => Array.isArray(v))?.[1].length ?? 0;\n  if (length > 200000 || entries.some(([,v]) => v !== null && (!Array.isArray(v) || v.length !== length)) || (length && entries.some(([,v])=>v === null)))\n    throw Error('GEA_COLUMNAR_RESULT_INVALID');\n  const rows = Array.from({length}, (_,i) => Object.fromEntries(entries.map(([key,value])=>[key,value[i]])));\n  return {...result, rows, records: rows, total: length};\n}\n"},"source/inventory-light-plugins/src/governed/modules/aqkc-report.ts":{"blob":"940c8c557e0f74bdcd792ead57d37b322e0bfa43","sha256":"f3a743d05e70fb48c2303927026d65654d10e831bb34485add51c8c6d848917c","text":"import { executeGeaSqlQuery } from \"./data\";\nimport { selectWorkbenchTargetRows, targetInventoryOutput } from \"../../aqkc/web/src/lib/cube-dashboard\";\nimport { dailyReportSql } from \"../../aqkc/web/src/lib/daily-report-sql\";\nimport { buildDailyReport, reportNumber, type DailySource, type DailyReportInput } from \"../../aqkc/web/src/lib/daily-report\";\nimport type { WorkbenchSqlRow } from \"../../aqkc/web/src/lib/workbench-sql-types\";\nconst text = (value: unknown) => typeof value === \"string\" || typeof value === \"number\" ? String(value).trim() : \"\";\nconst nonnegative = (value: unknown) => { const n = reportNumber(value); return n !== null && n >= 0 ? n : null; };\nexport async function loadDailyReportInput(): Promise<DailyReportInput> {\n  const sources = Object.keys(dailyReportSql) as DailySource[];\n  const results = await Promise.allSettled(sources.map(source => executeGeaSqlQuery(undefined, dailyReportSql[source])));\n  const rows = results.map(result => result.status === \"fulfilled\" ? result.value : []);\n  const data = Object.fromEntries(sources.map((source,index) => [source,rows[index]])) as Record<DailySource,WorkbenchSqlRow[]>;\n  const failedSources: DailySource[] = sources.filter((_,index) => results[index].status === \"rejected\");\n  const generatedAt = new Date().toISOString();\n  const selected = selectWorkbenchTargetRows(data.stock, new Date(generatedAt));\n  return {\n    generatedAt,localPreview:false,failedSources,...({permissionGaps:sources.filter((_,index)=>(rows[index] as any).rejectedColumns?.length)} as {}),\n    targetMonth:selected.scope.targetMonthLabel,targetVersion:selected.scope.versionLabel,targetRule:selected.scope.selectionRule,\n    stock:selected.rows.map(row => {\n      const seasonal = [\"safety_stock.product_categ_name\",\"safety_stock.product_label\",\"safety_stock.material_name\"].some(field=>text(row[field]).includes(\"粽子\"));\n      const demand = nonnegative(row[\"safety_stock.planned_daily_demand\"]);\n      // Do not let the legacy numeric fallback turn missing seasonal facts into zero.\n      const target = seasonal && (demand === null || (demand > 0 && nonnegative(row[\"safety_stock.turnover_inventory\"]) === null))\n        ? null : nonnegative(targetInventoryOutput(row));\n      return {base:text(row[\"safety_stock.base_name\"]),material:text(row[\"safety_stock.material_code\"]),\n        name:text(row[\"safety_stock.material_name\"]),category:text(row[\"safety_stock.product_categ_name\"]),\n        inventory:nonnegative(row[\"safety_stock.current_inventory\"]),target,demand,\n        shipment30:nonnegative(row[\"safety_stock.last_30d_shipment_quantity\"]),snapshot:text(row[\"safety_stock.snapshot_time\"])};\n    }),\n    age:data.age.map(row => ({base:text(row.base),material:text(row.material),name:text(row.material_name),category:text(row.category),\n      inventory:nonnegative(row.inventory),bands:[row.age_0,row.age_30,row.age_40,row.age_60,row.age_unknown].map(nonnegative),\n      natural7:nonnegative(row.natural_7),natural14:nonnegative(row.natural_14),weightedAge:nonnegative(row.weighted_age),invalidQuantity:reportNumber(row.invalid_quantity)!==0,snapshot:text(row.snapshot)})),\n    pendingSnapshot:text(data.pending[0]?.[\"report.order_snapshot\"]),\n    pending:data.pending.filter(row=>row[\"workbench.domain\"]===\"pending_sku\").map(row=>({\n      base:text(row[\"workbench.base\"]),material:text(row[\"workbench.material_code\"]),quantity:nonnegative(row[\"workbench.order_quantity\"]),\n      shortage:nonnegative(row[\"workbench.shortage_quantity\"]),allocated:nonnegative(row[\"workbench.allocated_quantity\"]),\n      snapshot:text(row[\"report.order_snapshot\"]),inventorySnapshot:text(row[\"report.inventory_snapshot\"]),\n    })),\n    fulfillment:data.fulfillment.map(row=>({base:text(row.base),material:text(row.material),need:nonnegative(row.need),\n      shortage:nonnegative(row.shortage),invalidQuantity:reportNumber(row.invalid_quantity)!==0,snapshot:text(row.snapshot)})),\n  };\n}\nexport async function loadDailyReport(selectedBases?: string[]) {\n  return buildDailyReport({...await loadDailyReportInput(), selectedBases});\n}\n"},"source/inventory-light-plugins/src/governed/modules/fc-engine.ts":{"blob":"cc9e57cbba198a37867f1e8d5e56fc7a4c05e4e5","sha256":"4cf94a45d6c52698d490f7f6553543320bbd4a639b752d0f5079a9e7d6204cd6","text":"import { database as sourceDatabase, EMPTY_PLANNING } from \"./data.ts\";\nimport { loadWarehouseCatalog } from \"../../fc/src/lib/server/warehouse-catalog.ts\";\nimport { loadWarehouseSnapshot } from \"../../fc/src/lib/server/warehouse-snapshot.ts\";\nimport { loadBaseResourceSnapshot } from \"../../fc/src/lib/server/base-resources.ts\";\nimport { projectWarehousePage } from \"../../fc/src/lib/workbench-page.ts\";\nimport { summarizeSnapshot } from \"../../fc/src/lib/domain.ts\";\nimport {\n  buildPlanTemplateRows,\n  parseImportedPlans,\n  applyBusinessPlanning,\n} from \"../../fc/src/lib/planning.ts\";\nimport { LocalPlanning } from \"./local-planning.ts\";\nimport {createFcDatabase} from \"./fc-transfer.ts\";\nconst database = sourceDatabase;\nconst previews = new LocalPlanning();\nconst facts = new Map<string, Promise<any>>();\nexport function clearFacts() {\n  facts.clear();\n}\nexport function clearPreviews() {\n  previews.clear();\n}\nexport const catalog = () => loadWarehouseCatalog(database);\nconst planning = {\n  query: async (sql: string) => {\n    if (sql.includes(\"to_regclass\"))\n      return {\n        rows: [\n          { order_fulfillment: true, imported_plans: null, cycle_config: null },\n        ],\n      };\n    throw Error(\"此能力需要 GEA 持久化支持，可交给对话区继续处理\");\n  },\n};\nconst loadFacts = async (filters: any) => {\n  const now = new Date(),\n    calculationDate = new Intl.DateTimeFormat(\"en-CA\", {\n      timeZone: \"Asia/Shanghai\",\n      year: \"numeric\",\n      month: \"2-digit\",\n      day: \"2-digit\",\n    }).format(now);\n  const catalogPromise = catalog();\n  const shippedPromise = catalogPromise.then(async (directory) => {\n    const warehouse = directory.warehouses.find(row => row.id === filters.warehouseId);\n    if (!warehouse) throw Error(\"GEA 未返回该分仓映射\");\n    const shipped = await database.query(\n      `SELECT\n  \"agents_scm_branch_operation_fact\".\"material_code\" AS \"sku\",\n  CASE\n    WHEN COUNT(*) FILTER(WHERE\n      \"agents_scm_branch_operation_fact\".\"metric_value\" IS NULL) > 0\n    THEN NULL\n    ELSE SUM(\"agents_scm_branch_operation_fact\".\"metric_value\")\n  END AS \"shipped_qty\"\nFROM \"agents_scm_branch_operation_fact\" AS \"agents_scm_branch_operation_fact\"\nWHERE\n  \"agents_scm_branch_operation_fact\".\"pickup_point\" = $1\n  AND \"agents_scm_branch_operation_fact\".\"metric_group\" = 'branch_activity'\n  AND \"agents_scm_branch_operation_fact\".\"metric_name\" = 'actual_shipped_qty'\n  AND \"agents_scm_branch_operation_fact\".\"period_month\" = CAST($2 AS DATE)\nGROUP BY\n  \"agents_scm_branch_operation_fact\".\"material_code\"\nORDER BY\n  \"sku\",\n  \"agents_scm_branch_operation_fact\".\"material_code\"`,\n      [warehouse.pickupPointCode, calculationDate.slice(0, 7) + \"-01\"],\n    );\n    return { warehouse, shipped };\n  });\n  const [base, {warehouse, shipped}] = await Promise.all([\n    loadWarehouseSnapshot(filters.warehouseId, database, now, planning),\n    shippedPromise,\n  ]);\n  return {\n    base,\n    warehouse,\n    calculationDate,\n    shipped: new Map(\n      shipped.rows.map((row: any) => [\n        String(row.sku),\n        row.shipped_qty == null ? null : Number(row.shipped_qty),\n      ]),\n    ),\n  };\n};\nasync function source(warehouseId: string) {\n  let value = facts.get(warehouseId);\n  if (!value) {\n    value = loadFacts({ warehouseId });\n    facts.set(warehouseId, value);\n    value.catch(() => {\n      if (facts.get(warehouseId) === value) facts.delete(warehouseId);\n    });\n  }\n  return value;\n}\nexport async function applyLocalPreview(input: any) {\n  const { warehouse } = await source(input.warehouseId);\n  previews.update(warehouse, input);\n  return {\n    previewApplied: true,\n    status: \"local-only\",\n    warehouseId: warehouse.id,\n  };\n}\nexport const load = async ({ warehouseId }: any) => {\n  const { base, shipped, calculationDate } = await source(warehouseId);\n  const preview = previews.get(warehouseId);\n  const result = applyBusinessPlanning(\n    base,\n    preview ?? {\n      ...EMPTY_PLANNING,\n      revision: base.ruleTrace.planVersion || base.version,\n    },\n    shipped,\n    calculationDate,\n  );\n  return {\n    ...result,\n    permissionGaps: (base as any).permissionGaps ?? [],\n    dataSource: \"GEA SQL data_service 分仓库存标准表\",\n    localPreview: preview\n      ? {\n          status: \"local-only\",\n          revision: preview.revision,\n          importCount: preview.imports.length,\n          ruleCount: preview.rules.length,\n        }\n      : null,\n    migrationCapabilities: {\n      localPlanningImported: false,\n      cycleConfigurationImported: false,\n    },\n  };\n};\nexport {\n  loadBaseResourceSnapshot,\n  projectWarehousePage,\n  summarizeSnapshot,\n  buildPlanTemplateRows,\n  parseImportedPlans,\n  applyBusinessPlanning,\n};\n\nexport { database };\n\nexport {loadReplenishmentDetail} from \"../../fc/src/lib/server/replenishment-detail.ts\";\nexport {mergeDmsAdjustments} from \"../../fc/src/lib/dms-export.ts\";\n"},"source/inventory-light-plugins/src/governed/modules/personal-daily.json":{"blob":"c307fcc4c59505e4d4e8ff0818b9c07a3f7d5fd0","sha256":"11b02c4f96fe3a923e475f31b811704d3783c4badce726696cb186bb710a8441","text":"{\n  \"stock\": {\n    \"name\": \"personal-governed-stock\",\n    \"maxRows\": 50000,\n    \"sql\": \"WITH \\\"latest_safety_stock\\\" AS (\\n  SELECT\\n    \\\"agents_scm_safety_stock\\\".\\\"id\\\" AS \\\"id\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"inventory_snapshot_time\\\" AS \\\"inventory_snapshot_time\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"target_month\\\" AS \\\"target_month\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"base_name\\\" AS \\\"base_name\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"material_code\\\" AS \\\"material_code\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"material_name\\\" AS \\\"material_name\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"product_categ_name\\\" AS \\\"product_categ_name\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"product_label\\\" AS \\\"product_label\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"inventory_version\\\" AS \\\"inventory_version\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"current_inventory\\\" AS \\\"current_inventory\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"target_inventory\\\" AS \\\"target_inventory\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"management_target_inventory\\\" AS \\\"management_target_inventory\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"final_target_inventory\\\" AS \\\"final_target_inventory\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"safety_stock\\\" AS \\\"safety_stock\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"turnover_inventory\\\" AS \\\"turnover_inventory\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"avg_daily_planned_demand\\\" AS \\\"avg_daily_planned_demand\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"current_turnover_days\\\" AS \\\"current_turnover_days\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"target_fill_rate\\\" AS \\\"target_fill_rate\\\",\\n    \\\"agents_scm_safety_stock\\\".\\\"avg_30d_sale\\\" AS \\\"avg_30d_sale\\\"\\n  FROM \\\"agents_scm_safety_stock\\\" AS \\\"agents_scm_safety_stock\\\"\\n  WHERE\\n    \\\"agents_scm_safety_stock\\\".\\\"inventory_snapshot_time\\\" = (\\n      SELECT\\n        MAX(\\\"agents_scm_safety_stock\\\".\\\"inventory_snapshot_time\\\") AS \\\"_col_0\\\"\\n      FROM \\\"agents_scm_safety_stock\\\" AS \\\"agents_scm_safety_stock\\\"\\n    )\\n), \\\"shipment_totals\\\" AS (\\n  SELECT\\n    \\\"latest_safety_stock\\\".\\\"target_month\\\" AS \\\"target_month\\\",\\n    \\\"latest_safety_stock\\\".\\\"inventory_version\\\" AS \\\"inventory_version\\\",\\n    \\\"latest_safety_stock\\\".\\\"base_name\\\" AS \\\"base_name\\\",\\n    SUM(\\\"latest_safety_stock\\\".\\\"avg_30d_sale\\\" * 30) AS \\\"shipment_volume\\\"\\n  FROM \\\"latest_safety_stock\\\" AS \\\"latest_safety_stock\\\"\\n  GROUP BY\\n    \\\"latest_safety_stock\\\".\\\"target_month\\\",\\n    \\\"latest_safety_stock\\\".\\\"inventory_version\\\",\\n    \\\"latest_safety_stock\\\".\\\"base_name\\\"\\n)\\nSELECT\\n  \\\"stock\\\".\\\"id\\\" AS \\\"safety_stock__id\\\",\\n  CAST(\\\"stock\\\".\\\"inventory_snapshot_time\\\" AS TEXT) AS \\\"safety_stock__snapshot_time\\\",\\n  \\\"stock\\\".\\\"target_month\\\" AS \\\"safety_stock__target_month\\\",\\n  \\\"stock\\\".\\\"base_name\\\" AS \\\"safety_stock__base_name\\\",\\n  \\\"stock\\\".\\\"material_code\\\" AS \\\"safety_stock__material_code\\\",\\n  \\\"stock\\\".\\\"material_name\\\" AS \\\"safety_stock__material_name\\\",\\n  \\\"stock\\\".\\\"product_categ_name\\\" AS \\\"safety_stock__product_categ_name\\\",\\n  \\\"stock\\\".\\\"product_label\\\" AS \\\"safety_stock__product_label\\\",\\n  \\\"stock\\\".\\\"inventory_version\\\" AS \\\"safety_stock__inventory_version\\\",\\n  1 AS \\\"safety_stock__record_count\\\",\\n  \\\"stock\\\".\\\"current_inventory\\\" AS \\\"safety_stock__current_inventory\\\",\\n  \\\"stock\\\".\\\"target_inventory\\\" AS \\\"safety_stock__target_inventory\\\",\\n  \\\"stock\\\".\\\"management_target_inventory\\\" AS \\\"safety_stock__management_target_inventory\\\",\\n  \\\"stock\\\".\\\"final_target_inventory\\\" AS \\\"safety_stock__final_target_inventory\\\",\\n  \\\"stock\\\".\\\"safety_stock\\\" AS \\\"safety_stock__safety_stock_amount\\\",\\n  \\\"stock\\\".\\\"turnover_inventory\\\" AS \\\"safety_stock__turnover_inventory\\\",\\n  \\\"stock\\\".\\\"current_inventory\\\" - COALESCE(\\\"stock\\\".\\\"final_target_inventory\\\", 0) AS \\\"safety_stock__inventory_gap_to_final_target\\\",\\n  \\\"stock\\\".\\\"avg_daily_planned_demand\\\" AS \\\"safety_stock__planned_daily_demand\\\",\\n  \\\"stock\\\".\\\"current_turnover_days\\\" AS \\\"safety_stock__average_current_turnover_days\\\",\\n  \\\"stock\\\".\\\"target_fill_rate\\\" AS \\\"safety_stock__average_target_fill_rate\\\",\\n  \\\"stock\\\".\\\"avg_30d_sale\\\" * 30 AS \\\"safety_stock__last_30d_shipment_quantity\\\",\\n  \\\"totals\\\".\\\"shipment_volume\\\" AS \\\"safety_stock__last_30d_shipment_volume\\\"\\nFROM \\\"latest_safety_stock\\\" AS \\\"stock\\\"\\nLEFT JOIN \\\"shipment_totals\\\" AS \\\"totals\\\"\\n  ON (\\n    \\\"stock\\\".\\\"target_month\\\" = \\\"totals\\\".\\\"target_month\\\"\\n    OR (\\n      \\\"stock\\\".\\\"target_month\\\" IS NULL AND \\\"totals\\\".\\\"target_month\\\" IS NULL\\n    )\\n  )\\n  AND (\\n    \\\"stock\\\".\\\"inventory_version\\\" = \\\"totals\\\".\\\"inventory_version\\\"\\n    OR (\\n      \\\"stock\\\".\\\"inventory_version\\\" IS NULL AND \\\"totals\\\".\\\"inventory_version\\\" IS NULL\\n    )\\n  )\\n  AND (\\n    \\\"stock\\\".\\\"base_name\\\" = \\\"totals\\\".\\\"base_name\\\"\\n    OR (\\n      \\\"stock\\\".\\\"base_name\\\" IS NULL AND \\\"totals\\\".\\\"base_name\\\" IS NULL\\n    )\\n  )\\nORDER BY\\n  \\\"stock\\\".\\\"base_name\\\",\\n  \\\"stock\\\".\\\"material_code\\\",\\n  \\\"stock\\\".\\\"inventory_version\\\",\\n  \\\"stock\\\".\\\"id\\\"\",\n    \"outputAliases\": {\n      \"safety_stock__id\": \"safety_stock.id\",\n      \"safety_stock__snapshot_time\": \"safety_stock.snapshot_time\",\n      \"safety_stock__target_month\": \"safety_stock.target_month\",\n      \"safety_stock__base_name\": \"safety_stock.base_name\",\n      \"safety_stock__material_code\": \"safety_stock.material_code\",\n      \"safety_stock__material_name\": \"safety_stock.material_name\",\n      \"safety_stock__product_categ_name\": \"safety_stock.product_categ_name\",\n      \"safety_stock__product_label\": \"safety_stock.product_label\",\n      \"safety_stock__inventory_version\": \"safety_stock.inventory_version\",\n      \"safety_stock__record_count\": \"safety_stock.record_count\",\n      \"safety_stock__current_inventory\": \"safety_stock.current_inventory\",\n      \"safety_stock__target_inventory\": \"safety_stock.target_inventory\",\n      \"safety_stock__management_target_inventory\": \"safety_stock.management_target_inventory\",\n      \"safety_stock__final_target_inventory\": \"safety_stock.final_target_inventory\",\n      \"safety_stock__safety_stock_amount\": \"safety_stock.safety_stock_amount\",\n      \"safety_stock__turnover_inventory\": \"safety_stock.turnover_inventory\",\n      \"safety_stock__inventory_gap_to_final_target\": \"safety_stock.inventory_gap_to_final_target\",\n      \"safety_stock__planned_daily_demand\": \"safety_stock.planned_daily_demand\",\n      \"safety_stock__average_current_turnover_days\": \"safety_stock.average_current_turnover_days\",\n      \"safety_stock__average_target_fill_rate\": \"safety_stock.average_target_fill_rate\",\n      \"safety_stock__last_30d_shipment_quantity\": \"safety_stock.last_30d_shipment_quantity\",\n      \"safety_stock__last_30d_shipment_volume\": \"safety_stock.last_30d_shipment_volume\"\n    }\n  },\n  \"age\": {\n    \"name\": \"personal-governed-age\",\n    \"maxRows\": 25000,\n    \"sql\": \"WITH \\\"latest_age\\\" AS (\\n  SELECT\\n    \\\"agents_scm_inventory_age\\\".\\\"base_name\\\" AS \\\"base_name\\\",\\n    \\\"agents_scm_inventory_age\\\".\\\"material_code\\\" AS \\\"material_code\\\",\\n    \\\"agents_scm_inventory_age\\\".\\\"material_name\\\" AS \\\"material_name\\\",\\n    \\\"agents_scm_inventory_age\\\".\\\"product_categ_name\\\" AS \\\"product_categ_name\\\",\\n    \\\"agents_scm_inventory_age\\\".\\\"snapshot_time\\\" AS \\\"snapshot_time\\\",\\n    \\\"agents_scm_inventory_age\\\".\\\"qty\\\" AS \\\"qty\\\",\\n    \\\"agents_scm_inventory_age\\\".\\\"productage\\\" AS \\\"productage\\\"\\n  FROM \\\"agents_scm_inventory_age\\\" AS \\\"agents_scm_inventory_age\\\"\\n  WHERE\\n    \\\"agents_scm_inventory_age\\\".\\\"snapshot_time\\\" = (\\n      SELECT\\n        MAX(\\\"agents_scm_inventory_age\\\".\\\"snapshot_time\\\") AS \\\"_col_0\\\"\\n      FROM \\\"agents_scm_inventory_age\\\" AS \\\"agents_scm_inventory_age\\\"\\n    )\\n    AND \\\"agents_scm_inventory_age\\\".\\\"base_name\\\" IN ('华东', '华南', '西南', '遂平', '郑州')\\n)\\nSELECT\\n  \\\"latest_age\\\".\\\"base_name\\\" AS \\\"base\\\",\\n  \\\"latest_age\\\".\\\"material_code\\\" AS \\\"material\\\",\\n  MAX(\\\"latest_age\\\".\\\"material_name\\\") AS \\\"material_name\\\",\\n  MAX(\\\"latest_age\\\".\\\"product_categ_name\\\") AS \\\"category\\\",\\n  CAST(MAX(\\\"latest_age\\\".\\\"snapshot_time\\\") AS TEXT) AS \\\"snapshot\\\",\\n  SUM(\\\"latest_age\\\".\\\"qty\\\") AS \\\"inventory\\\",\\n  SUM(\\n    CASE\\n      WHEN \\\"latest_age\\\".\\\"productage\\\" >= 0 AND \\\"latest_age\\\".\\\"productage\\\" <= 30\\n      THEN \\\"latest_age\\\".\\\"qty\\\"\\n      ELSE 0\\n    END\\n  ) AS \\\"age_0\\\",\\n  SUM(\\n    CASE\\n      WHEN \\\"latest_age\\\".\\\"productage\\\" > 30 AND \\\"latest_age\\\".\\\"productage\\\" <= 40\\n      THEN \\\"latest_age\\\".\\\"qty\\\"\\n      ELSE 0\\n    END\\n  ) AS \\\"age_30\\\",\\n  SUM(\\n    CASE\\n      WHEN \\\"latest_age\\\".\\\"productage\\\" > 40 AND \\\"latest_age\\\".\\\"productage\\\" <= 60\\n      THEN \\\"latest_age\\\".\\\"qty\\\"\\n      ELSE 0\\n    END\\n  ) AS \\\"age_40\\\",\\n  SUM(CASE WHEN \\\"latest_age\\\".\\\"productage\\\" > 60 THEN \\\"latest_age\\\".\\\"qty\\\" ELSE 0 END) AS \\\"age_60\\\",\\n  SUM(\\n    CASE\\n      WHEN \\\"latest_age\\\".\\\"productage\\\" >= 0 AND \\\"latest_age\\\".\\\"productage\\\" + 7 > 60\\n      THEN \\\"latest_age\\\".\\\"qty\\\"\\n      ELSE 0\\n    END\\n  ) AS \\\"natural_7\\\",\\n  SUM(\\n    CASE\\n      WHEN \\\"latest_age\\\".\\\"productage\\\" >= 0 AND \\\"latest_age\\\".\\\"productage\\\" + 14 > 60\\n      THEN \\\"latest_age\\\".\\\"qty\\\"\\n      ELSE 0\\n    END\\n  ) AS \\\"natural_14\\\",\\n  SUM(\\n    CASE\\n      WHEN \\\"latest_age\\\".\\\"productage\\\" IS NULL OR \\\"latest_age\\\".\\\"productage\\\" < 0\\n      THEN \\\"latest_age\\\".\\\"qty\\\"\\n      ELSE 0\\n    END\\n  ) AS \\\"age_unknown\\\",\\n  SUM(\\n    CASE\\n      WHEN \\\"latest_age\\\".\\\"productage\\\" >= 0\\n      THEN \\\"latest_age\\\".\\\"qty\\\" * \\\"latest_age\\\".\\\"productage\\\"\\n      ELSE 0\\n    END\\n  ) AS \\\"weighted_age\\\",\\n  COUNT(*) FILTER(WHERE\\n    \\\"latest_age\\\".\\\"qty\\\" IS NULL OR \\\"latest_age\\\".\\\"qty\\\" < 0) AS \\\"invalid_quantity\\\"\\nFROM \\\"latest_age\\\" AS \\\"latest_age\\\"\\nGROUP BY\\n  \\\"latest_age\\\".\\\"base_name\\\",\\n  \\\"latest_age\\\".\\\"material_code\\\"\\nORDER BY\\n  \\\"base\\\",\\n  \\\"material\\\",\\n  \\\"latest_age\\\".\\\"base_name\\\",\\n  \\\"latest_age\\\".\\\"material_code\\\"\",\n    \"outputAliases\": {}\n  },\n  \"pending\": {\n    \"name\": \"personal-governed-pending\",\n    \"maxRows\": 25000,\n    \"sql\": \"SELECT\\n  \\\"r\\\".\\\"workbench__domain\\\" AS \\\"workbench__domain\\\",\\n  \\\"r\\\".\\\"workbench__base\\\" AS \\\"workbench__base\\\",\\n  \\\"r\\\".\\\"workbench__material_code\\\" AS \\\"workbench__material_code\\\",\\n  \\\"r\\\".\\\"workbench__order_quantity\\\" AS \\\"workbench__order_quantity\\\",\\n  \\\"r\\\".\\\"workbench__allocated_quantity\\\" AS \\\"workbench__allocated_quantity\\\",\\n  \\\"r\\\".\\\"workbench__shortage_quantity\\\" AS \\\"workbench__shortage_quantity\\\",\\n  CAST((\\n    SELECT\\n      MAX(\\\"agents_scm_branch_pending_order\\\".\\\"source_snapshot_time\\\") AS \\\"_col_0\\\"\\n    FROM \\\"agents_scm_branch_pending_order\\\" AS \\\"agents_scm_branch_pending_order\\\"\\n  ) AS TEXT) AS \\\"report__order_snapshot\\\",\\n  CAST((\\n    SELECT\\n      MAX(\\\"agents_scm_inventory_age\\\".\\\"snapshot_time\\\") AS \\\"_col_0\\\"\\n    FROM \\\"agents_scm_inventory_age\\\" AS \\\"agents_scm_inventory_age\\\"\\n  ) AS TEXT) AS \\\"report__inventory_snapshot\\\"\\nFROM (\\n  WITH \\\"bases\\\" AS (\\n    SELECT\\n      '01' AS \\\"pickup_point\\\",\\n      '郑州' AS \\\"base\\\"\\n    UNION ALL\\n    SELECT\\n      '02' AS \\\"pickup_point\\\",\\n      '华东' AS \\\"base\\\"\\n    UNION ALL\\n    SELECT\\n      '03' AS \\\"pickup_point\\\",\\n      '西南' AS \\\"base\\\"\\n    UNION ALL\\n    SELECT\\n      '37' AS \\\"pickup_point\\\",\\n      '遂平' AS \\\"base\\\"\\n    UNION ALL\\n    SELECT\\n      '04' AS \\\"pickup_point\\\",\\n      '华南' AS \\\"base\\\"\\n  ), \\\"pending_snapshot\\\" AS (\\n    SELECT\\n      MAX(\\\"agents_scm_branch_pending_order\\\".\\\"source_snapshot_time\\\") AS \\\"snapshot\\\"\\n    FROM \\\"agents_scm_branch_pending_order\\\" AS \\\"agents_scm_branch_pending_order\\\"\\n  ), \\\"inventory_snapshot\\\" AS (\\n    SELECT\\n      MAX(\\\"agents_scm_inventory_age\\\".\\\"snapshot_time\\\") AS \\\"snapshot\\\"\\n    FROM \\\"agents_scm_inventory_age\\\" AS \\\"agents_scm_inventory_age\\\"\\n  ), \\\"active_orders\\\" AS (\\n    SELECT\\n      \\\"b\\\".\\\"base\\\" AS \\\"base\\\",\\n      NULLIF(TRIM(\\\"p\\\".\\\"material_code\\\"), '') AS \\\"material\\\",\\n      \\\"p\\\".\\\"order_qty\\\" AS \\\"order_qty\\\",\\n      \\\"p\\\".\\\"allocated_qty\\\" AS \\\"allocated_qty\\\",\\n      TRIM(\\\"p\\\".\\\"bizflowstatus\\\") <> 'OCP已下发' AS \\\"preparing\\\"\\n    FROM \\\"agents_scm_branch_pending_order\\\" AS \\\"p\\\"\\n    JOIN \\\"bases\\\" AS \\\"b\\\"\\n      ON \\\"b\\\".\\\"pickup_point\\\" = TRIM(\\\"p\\\".\\\"pickup_point\\\")\\n    WHERE\\n      \\\"p\\\".\\\"source_snapshot_time\\\" = (\\n        SELECT\\n          \\\"pending_snapshot\\\".\\\"snapshot\\\" AS \\\"snapshot\\\"\\n        FROM \\\"pending_snapshot\\\" AS \\\"pending_snapshot\\\"\\n      )\\n      AND NULLIF(TRIM(\\\"p\\\".\\\"bizflowstatus\\\"), '') IS NOT NULL\\n      AND (\\n        TRIM(\\\"p\\\".\\\"bizflowstatus\\\") <> 'OCP已下发' OR \\\"p\\\".\\\"order_stage\\\" = 'PREPARED_UNSHIPPED'\\n      )\\n  ), \\\"orders_by_base\\\" AS (\\n    SELECT\\n      \\\"active_orders\\\".\\\"base\\\" AS \\\"base\\\",\\n      SUM(\\\"active_orders\\\".\\\"order_qty\\\") AS \\\"quantity\\\",\\n      SUM(\\\"active_orders\\\".\\\"allocated_qty\\\") AS \\\"allocated\\\",\\n      COUNT(*) FILTER(WHERE\\n        \\\"active_orders\\\".\\\"order_qty\\\" IS NULL) AS \\\"missing\\\",\\n      COUNT(*) FILTER(WHERE\\n        \\\"active_orders\\\".\\\"allocated_qty\\\" IS NULL) AS \\\"allocated_missing\\\"\\n    FROM \\\"active_orders\\\" AS \\\"active_orders\\\"\\n    GROUP BY\\n      \\\"active_orders\\\".\\\"base\\\"\\n  ), \\\"preparing_by_sku\\\" AS (\\n    SELECT\\n      \\\"active_orders\\\".\\\"base\\\" AS \\\"base\\\",\\n      \\\"active_orders\\\".\\\"material\\\" AS \\\"material\\\",\\n      SUM(\\\"active_orders\\\".\\\"order_qty\\\") AS \\\"quantity\\\",\\n      SUM(\\\"active_orders\\\".\\\"allocated_qty\\\") AS \\\"allocated\\\",\\n      COUNT(*) FILTER(WHERE\\n        \\\"active_orders\\\".\\\"order_qty\\\" IS NULL\\n        OR \\\"active_orders\\\".\\\"allocated_qty\\\" IS NULL\\n        OR \\\"active_orders\\\".\\\"material\\\" IS NULL) AS \\\"missing\\\"\\n    FROM \\\"active_orders\\\" AS \\\"active_orders\\\"\\n    WHERE\\n      \\\"active_orders\\\".\\\"preparing\\\"\\n    GROUP BY\\n      \\\"active_orders\\\".\\\"base\\\",\\n      \\\"active_orders\\\".\\\"material\\\"\\n  ), \\\"normalized_inventory\\\" AS (\\n    SELECT\\n      \\\"agents_scm_inventory_age\\\".\\\"base_name\\\" AS \\\"base\\\",\\n      NULLIF(TRIM(\\\"agents_scm_inventory_age\\\".\\\"material_code\\\"), '') AS \\\"material\\\",\\n      \\\"agents_scm_inventory_age\\\".\\\"qtylive\\\" AS \\\"qtylive\\\"\\n    FROM \\\"agents_scm_inventory_age\\\" AS \\\"agents_scm_inventory_age\\\"\\n    WHERE\\n      \\\"agents_scm_inventory_age\\\".\\\"snapshot_time\\\" = (\\n        SELECT\\n          \\\"inventory_snapshot\\\".\\\"snapshot\\\" AS \\\"snapshot\\\"\\n        FROM \\\"inventory_snapshot\\\" AS \\\"inventory_snapshot\\\"\\n      )\\n  ), \\\"inventory_by_sku\\\" AS (\\n    SELECT\\n      \\\"normalized_inventory\\\".\\\"base\\\" AS \\\"base\\\",\\n      \\\"normalized_inventory\\\".\\\"material\\\" AS \\\"material\\\",\\n      SUM(\\\"normalized_inventory\\\".\\\"qtylive\\\") AS \\\"available\\\",\\n      COUNT(*) FILTER(WHERE\\n        \\\"normalized_inventory\\\".\\\"qtylive\\\" IS NULL) AS \\\"missing\\\"\\n    FROM \\\"normalized_inventory\\\" AS \\\"normalized_inventory\\\"\\n    GROUP BY\\n      \\\"normalized_inventory\\\".\\\"base\\\",\\n      \\\"normalized_inventory\\\".\\\"material\\\"\\n  ), \\\"inventory_bases\\\" AS (\\n    SELECT DISTINCT\\n      \\\"inventory_by_sku\\\".\\\"base\\\" AS \\\"base\\\"\\n    FROM \\\"inventory_by_sku\\\" AS \\\"inventory_by_sku\\\"\\n  ), \\\"shortage_by_base\\\" AS (\\n    SELECT\\n      \\\"p\\\".\\\"base\\\" AS \\\"base\\\",\\n      SUM(\\n        GREATEST(\\n          0,\\n          -(\\n            COALESCE(\\\"i\\\".\\\"available\\\", 0) - (\\n              \\\"p\\\".\\\"quantity\\\" - \\\"p\\\".\\\"allocated\\\"\\n            )\\n          )\\n        )\\n      ) AS \\\"shortage\\\",\\n      SUM(\\n        CASE\\n          WHEN \\\"p\\\".\\\"missing\\\" > 0 OR \\\"i\\\".\\\"missing\\\" > 0 OR \\\"ib\\\".\\\"base\\\" IS NULL\\n          THEN 1\\n          ELSE 0\\n        END\\n      ) AS \\\"missing\\\"\\n    FROM \\\"preparing_by_sku\\\" AS \\\"p\\\"\\n    LEFT JOIN \\\"inventory_by_sku\\\" AS \\\"i\\\"\\n      ON \\\"i\\\".\\\"base\\\" = \\\"p\\\".\\\"base\\\" AND \\\"i\\\".\\\"material\\\" = \\\"p\\\".\\\"material\\\"\\n    LEFT JOIN \\\"inventory_bases\\\" AS \\\"ib\\\"\\n      ON \\\"ib\\\".\\\"base\\\" = \\\"p\\\".\\\"base\\\"\\n    GROUP BY\\n      \\\"p\\\".\\\"base\\\"\\n  ), \\\"orders_by_sku\\\" AS (\\n    SELECT\\n      \\\"active_orders\\\".\\\"base\\\" AS \\\"base\\\",\\n      \\\"active_orders\\\".\\\"material\\\" AS \\\"material\\\",\\n      SUM(\\\"active_orders\\\".\\\"order_qty\\\") AS \\\"quantity\\\",\\n      SUM(\\\"active_orders\\\".\\\"allocated_qty\\\") AS \\\"allocated\\\",\\n      COUNT(*) FILTER(WHERE\\n        \\\"active_orders\\\".\\\"order_qty\\\" IS NULL) AS \\\"missing\\\",\\n      COUNT(*) FILTER(WHERE\\n        \\\"active_orders\\\".\\\"allocated_qty\\\" IS NULL) AS \\\"allocated_missing\\\"\\n    FROM \\\"active_orders\\\" AS \\\"active_orders\\\"\\n    GROUP BY\\n      \\\"active_orders\\\".\\\"base\\\",\\n      \\\"active_orders\\\".\\\"material\\\"\\n  )\\n  SELECT\\n    'pending_base' AS \\\"workbench__domain\\\",\\n    \\\"b\\\".\\\"base\\\" AS \\\"workbench__base\\\",\\n    CAST(NULL AS TEXT) AS \\\"workbench__material_code\\\",\\n    CASE WHEN \\\"ps\\\".\\\"snapshot\\\" IS NULL THEN NULL ELSE 0 END AS \\\"workbench__order_quantity\\\",\\n    CASE WHEN \\\"ps\\\".\\\"snapshot\\\" IS NULL THEN NULL ELSE 0 END AS \\\"workbench__allocated_quantity\\\",\\n    CASE WHEN \\\"ps\\\".\\\"snapshot\\\" IS NULL THEN NULL ELSE 0 END AS \\\"workbench__shortage_quantity\\\"\\n  FROM \\\"bases\\\" AS \\\"b\\\"\\n  CROSS JOIN \\\"pending_snapshot\\\" AS \\\"ps\\\"\\n  UNION ALL\\n  SELECT\\n    'pending_sku' AS \\\"workbench__domain\\\",\\n    \\\"o\\\".\\\"base\\\" AS \\\"workbench__base\\\",\\n    \\\"o\\\".\\\"material\\\" AS \\\"workbench__material_code\\\",\\n    CASE WHEN \\\"o\\\".\\\"missing\\\" > 0 THEN NULL ELSE \\\"o\\\".\\\"quantity\\\" END AS \\\"workbench__order_quantity\\\",\\n    CASE WHEN \\\"o\\\".\\\"allocated_missing\\\" > 0 THEN NULL ELSE \\\"o\\\".\\\"allocated\\\" END AS \\\"workbench__allocated_quantity\\\",\\n    CASE\\n      WHEN \\\"p\\\".\\\"base\\\" IS NULL\\n      THEN 0\\n      WHEN \\\"p\\\".\\\"missing\\\" > 0\\n      OR \\\"i\\\".\\\"missing\\\" > 0\\n      OR \\\"i\\\".\\\"material\\\" IS NULL\\n      OR \\\"ib\\\".\\\"base\\\" IS NULL\\n      OR \\\"p\\\".\\\"quantity\\\" < 0\\n      OR \\\"p\\\".\\\"allocated\\\" < 0\\n      OR \\\"i\\\".\\\"available\\\" < 0\\n      THEN NULL\\n      ELSE GREATEST(0, COALESCE(\\\"p\\\".\\\"quantity\\\" - \\\"p\\\".\\\"allocated\\\", 0) - COALESCE(\\\"i\\\".\\\"available\\\", 0))\\n    END AS \\\"workbench__shortage_quantity\\\"\\n  FROM \\\"orders_by_sku\\\" AS \\\"o\\\"\\n  LEFT JOIN \\\"preparing_by_sku\\\" AS \\\"p\\\"\\n    ON \\\"p\\\".\\\"base\\\" = \\\"o\\\".\\\"base\\\" AND \\\"p\\\".\\\"material\\\" IS NOT DISTINCT FROM \\\"o\\\".\\\"material\\\"\\n  LEFT JOIN \\\"inventory_by_sku\\\" AS \\\"i\\\"\\n    ON \\\"i\\\".\\\"base\\\" = \\\"o\\\".\\\"base\\\" AND \\\"i\\\".\\\"material\\\" = \\\"o\\\".\\\"material\\\"\\n  LEFT JOIN \\\"inventory_bases\\\" AS \\\"ib\\\"\\n    ON \\\"ib\\\".\\\"base\\\" = \\\"o\\\".\\\"base\\\"\\n) AS \\\"r\\\"\\nORDER BY\\n  \\\"workbench__domain\\\",\\n  \\\"workbench__base\\\",\\n  \\\"workbench__material_code\\\"\",\n    \"outputAliases\": {\n      \"workbench__domain\": \"workbench.domain\",\n      \"workbench__base\": \"workbench.base\",\n      \"workbench__material_code\": \"workbench.material_code\",\n      \"workbench__order_quantity\": \"workbench.order_quantity\",\n      \"workbench__allocated_quantity\": \"workbench.allocated_quantity\",\n      \"workbench__shortage_quantity\": \"workbench.shortage_quantity\",\n      \"report__order_snapshot\": \"report.order_snapshot\",\n      \"report__inventory_snapshot\": \"report.inventory_snapshot\"\n    }\n  },\n  \"fulfillment\": {\n    \"name\": \"personal-governed-fulfillment\",\n    \"maxRows\": 25000,\n    \"sql\": \"WITH \\\"latest_orders\\\" AS (\\n  SELECT\\n    \\\"agents_scm_order_fulfillment\\\".\\\"belong_base\\\" AS \\\"belong_base\\\",\\n    \\\"agents_scm_order_fulfillment\\\".\\\"new_material_code\\\" AS \\\"new_material_code\\\",\\n    \\\"agents_scm_order_fulfillment\\\".\\\"snapshot_time\\\" AS \\\"snapshot_time\\\",\\n    \\\"agents_scm_order_fulfillment\\\".\\\"need_qty_origin\\\" AS \\\"need_qty_origin\\\",\\n    \\\"agents_scm_order_fulfillment\\\".\\\"outqty\\\" AS \\\"outqty\\\"\\n  FROM \\\"agents_scm_order_fulfillment\\\" AS \\\"agents_scm_order_fulfillment\\\"\\n  WHERE\\n    \\\"agents_scm_order_fulfillment\\\".\\\"snapshot_date\\\" = (\\n      SELECT\\n        MAX(\\\"agents_scm_order_fulfillment\\\".\\\"snapshot_date\\\") AS \\\"_col_0\\\"\\n      FROM \\\"agents_scm_order_fulfillment\\\" AS \\\"agents_scm_order_fulfillment\\\"\\n    )\\n    AND (\\n      \\\"agents_scm_order_fulfillment\\\".\\\"order_qty_origin\\\" > 0\\n      OR \\\"agents_scm_order_fulfillment\\\".\\\"need_qty_origin\\\" > 0\\n    )\\n    AND \\\"agents_scm_order_fulfillment\\\".\\\"belong_base\\\" IN ('华东', '华南', '西南', '遂平', '郑州')\\n    AND \\\"agents_scm_order_fulfillment\\\".\\\"fromorderno_month\\\" >= DATE_TRUNC('MONTH', CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai')\\n    AND \\\"agents_scm_order_fulfillment\\\".\\\"fromorderno_month\\\" < DATE_TRUNC('MONTH', CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai') + INTERVAL '1 MONTH'\\n    AND \\\"agents_scm_order_fulfillment\\\".\\\"pick_point_type2\\\" = '工厂'\\n    AND \\\"agents_scm_order_fulfillment\\\".\\\"product_categ_name\\\" <> '饺鲜说'\\n)\\nSELECT\\n  \\\"latest_orders\\\".\\\"belong_base\\\" AS \\\"base\\\",\\n  \\\"latest_orders\\\".\\\"new_material_code\\\" AS \\\"material\\\",\\n  CAST(MAX(\\\"latest_orders\\\".\\\"snapshot_time\\\") AS TEXT) AS \\\"snapshot\\\",\\n  SUM(\\\"latest_orders\\\".\\\"need_qty_origin\\\") AS \\\"need\\\",\\n  SUM(\\\"latest_orders\\\".\\\"outqty\\\") AS \\\"shortage\\\",\\n  COUNT(*) FILTER(WHERE\\n    \\\"latest_orders\\\".\\\"need_qty_origin\\\" IS NULL\\n    OR \\\"latest_orders\\\".\\\"outqty\\\" IS NULL\\n    OR \\\"latest_orders\\\".\\\"need_qty_origin\\\" < 0\\n    OR \\\"latest_orders\\\".\\\"outqty\\\" < 0) AS \\\"invalid_quantity\\\"\\nFROM \\\"latest_orders\\\" AS \\\"latest_orders\\\"\\nGROUP BY\\n  \\\"latest_orders\\\".\\\"belong_base\\\",\\n  \\\"latest_orders\\\".\\\"new_material_code\\\"\\nORDER BY\\n  \\\"base\\\",\\n  \\\"material\\\",\\n  \\\"latest_orders\\\".\\\"belong_base\\\",\\n  \\\"latest_orders\\\".\\\"new_material_code\\\"\",\n    \"outputAliases\": {}\n  }\n}"},"source/inventory-light-plugins/src/governed/modules/plan-product-metadata.ts":{"blob":"872af773963d60cd16bb2ccb99d9d3dc55654c31","sha256":"fd6f35964d8e0672b84f35169bf713c90c2ef75c2a132393350c352176e4e09a","text":"import { fulfillmentWarehouseScope } from \"./warehouse-scope.ts\";\nimport type { CatalogDatabase } from \"./warehouse-catalog.ts\";\n\n/** Use synchronized, warehouse-scoped dimensions; never imported placeholders. */\nexport async function loadPlanProductMetadata(database: CatalogDatabase, pickupPoint: string, skus: string[], options: { onConflict?: \"error\" | \"omit\" } = {}) {\n  if (!skus.length) return new Map<string, { category: string; materialGroup: string; productName?: string }>();\n  const result = await database.query(`/* branch:product-metadata */\nSELECT DISTINCT\n  \"f\".\"new_material_code\" AS \"sku\",\n  TRIM(\"f\".\"new_material_name\") AS \"product_name\",\n  TRIM(\"f\".\"product_categ_name\") AS \"category\",\n  TRIM(\"f\".\"material_group_name\") AS \"material_group\"\nFROM \"agents_scm_order_fulfillment\" AS \"f\"\nWHERE\n  \"f\".\"snapshot_date\" = (\n    SELECT\n      MAX(\"agents_scm_order_fulfillment\".\"snapshot_date\") AS \"_col_0\"\n    FROM \"agents_scm_order_fulfillment\" AS \"agents_scm_order_fulfillment\"\n  )\n  AND \"f\".\"warehouseid\" IN (\n    SELECT DISTINCT\n      \"i\".\"warehouseid\" AS \"warehouseid\"\n    FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n    WHERE\n      \"i\".\"snapshot_date\" = (\n        SELECT\n          MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n        FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      )\n      AND COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), '')) = $1\n  )\n  AND \"f\".\"pick_point_type2\" = '分仓'\n  AND \"f\".\"new_material_code\" IN (:list_2)`, [pickupPoint, [...new Set(skus)]]);\n  const names = new Map<string, Set<string>>();\n  const bySku = new Map<string, Set<string>>();\n  for (const row of result.rows) {\n    const sku = String(row.sku ?? \"\");\n    const name = String(row.product_name ?? \"\").trim();\n    if (name) { const values = names.get(sku) ?? new Set<string>(); values.add(name); names.set(sku, values); }\n    const category = String(row.category ?? \"\").trim(), materialGroup = String(row.material_group ?? \"\").trim();\n    if (!category || !materialGroup || [category, materialGroup].some(value => [\"未提供\", \"未分类\", \"待核实\"].includes(value))) continue;\n    const pairs = bySku.get(sku) ?? new Set<string>();\n    pairs.add(JSON.stringify({ category, materialGroup })); bySku.set(sku, pairs);\n  }\n  const output = new Map<string, { category: string; materialGroup: string; productName?: string }>();\n  for (const sku of new Set(skus)) {\n    const pairs = bySku.get(sku);\n    if (!pairs?.size) continue;\n    if (pairs.size !== 1) {\n      if (options.onConflict === \"omit\") continue;\n      throw new Error(`SKU ${sku} 的大类或物料组映射不唯一，请核对源数据`);\n    }\n    const productNames = names.get(sku);\n    output.set(sku, { ...JSON.parse([...pairs][0]), ...(productNames?.size === 1 ? { productName: [...productNames][0] } : {}) });\n  }\n  return output;\n}\n"},"source/inventory-light-plugins/src/governed/modules/postgres-adapter.ts":{"blob":"b262dafe8e2156c7fe9ca7c154493500dde349b9","sha256":"c0508f19a782b9d4d37f35e6fba8e9fdf71bb19176a22fc23f2c3ed2c4a71122","text":"import type { QueryResultRow } from \"pg\";\n\nimport type {\n  AdapterRequest,\n  AgingBatchRow,\n  BaseInventoryRow,\n  BranchInventoryRow,\n  CustomerInventoryRow,\n  FullChainData,\n  FullChainDataAdapter,\n  InventoryTrendRow,\n  OrderRow,\n  PendingOrderRow,\n} from \"../full-chain/types\";\nimport { getReadOnlyPool } from \"./database\";\n\n\nexport type QueryExecutor = {\n  query<T extends QueryResultRow = QueryResultRow>(text: string, values?: unknown[]): Promise<{ rows: T[] }>;\n};\n\n// Same-month correction fields fall back only to positive month-start values.\nconst BASE_SQL = `WITH \"latest_snapshot\" AS (\n  SELECT\n    MAX(\"agents_scm_safety_stock\".\"inventory_snapshot_time\") AS \"value\"\n  FROM \"agents_scm_safety_stock\" AS \"agents_scm_safety_stock\"\n  WHERE\n    CAST(\"agents_scm_safety_stock\".\"inventory_snapshot_time\" AS DATE) <= CAST($1 AS DATE)\n), \"chosen_month\" AS (\n  SELECT\n    CASE\n      WHEN CAST($7 AS BOOLEAN)\n      AND EXTRACT(DAY FROM CAST($1 AS DATE)) >= 21\n      AND EXISTS(\n        SELECT\n          1 AS \"value_0\"\n        FROM \"agents_scm_safety_stock\" AS \"agents_scm_safety_stock\"\n        CROSS JOIN \"latest_snapshot\" AS \"latest_snapshot\"\n        WHERE\n          \"agents_scm_safety_stock\".\"inventory_snapshot_time\" = \"latest_snapshot\".\"value\"\n          AND \"agents_scm_safety_stock\".\"target_month\" = CAST((\n            CAST($2 AS DATE) + INTERVAL '1 MONTH'\n          ) AS DATE)\n      )\n      THEN CAST((\n        CAST($2 AS DATE) + INTERVAL '1 MONTH'\n      ) AS DATE)\n      ELSE CAST($2 AS DATE)\n    END AS \"value\"\n), \"versioned\" AS (\n  SELECT\n    \"s\".\"id\" AS \"id\",\n    \"s\".\"base_name\" AS \"base_name\",\n    \"s\".\"inventory_snapshot_time\" AS \"inventory_snapshot_time\",\n    \"s\".\"material_code\" AS \"material_code\",\n    \"s\".\"material_name\" AS \"material_name\",\n    \"s\".\"product_categ_name\" AS \"product_categ_name\",\n    \"s\".\"product_label\" AS \"product_label\",\n    \"s\".\"current_inventory\" AS \"current_inventory\",\n    \"s\".\"turnover_inventory\" AS \"turnover_inventory\",\n    \"s\".\"avg_daily_planned_demand\" AS \"avg_daily_planned_demand\",\n    \"s\".\"final_target_inventory\" AS \"final_target_inventory\",\n    \"s\".\"avg_30d_sale\" AS \"avg_30d_sale\",\n    \"s\".\"final_target_turnover_days\" AS \"final_target_turnover_days\",\n    CASE\n      WHEN \"s\".\"inventory_version\" LIKE '%纠偏%'\n      THEN 1\n      WHEN \"s\".\"inventory_version\" LIKE '%月初%'\n      THEN 2\n      WHEN \"s\".\"inventory_version\" LIKE '%滚动%'\n      THEN 3\n      ELSE 4\n    END AS \"priority\"\n  FROM \"agents_scm_safety_stock\" AS \"s\"\n  CROSS JOIN \"latest_snapshot\" AS \"latest_snapshot\"\n  CROSS JOIN \"chosen_month\" AS \"chosen_month\"\n  WHERE\n    \"s\".\"inventory_snapshot_time\" = \"latest_snapshot\".\"value\"\n    AND \"s\".\"target_month\" = \"chosen_month\".\"value\"\n    AND \"s\".\"base_name\" IN ('华东', '华南', '西南', '遂平', '郑州')\n), \"selected\" AS (\n  SELECT\n    MIN(\"versioned\".\"priority\") AS \"priority\"\n  FROM \"versioned\" AS \"versioned\"\n  WHERE\n    \"versioned\".\"priority\" < 4\n), \"ranked_ids\" AS (\n  SELECT\n    MAX(\"versioned\".\"id\") AS \"id\"\n  FROM \"versioned\" AS \"versioned\"\n  GROUP BY\n    \"versioned\".\"base_name\",\n    \"versioned\".\"material_code\",\n    \"versioned\".\"priority\"\n), \"ranked\" AS (\n  SELECT\n    \"v\".\"id\" AS \"id\",\n    \"v\".\"base_name\" AS \"base_name\",\n    \"v\".\"inventory_snapshot_time\" AS \"inventory_snapshot_time\",\n    \"v\".\"material_code\" AS \"material_code\",\n    \"v\".\"material_name\" AS \"material_name\",\n    \"v\".\"product_categ_name\" AS \"product_categ_name\",\n    \"v\".\"product_label\" AS \"product_label\",\n    \"v\".\"current_inventory\" AS \"current_inventory\",\n    \"v\".\"turnover_inventory\" AS \"turnover_inventory\",\n    \"v\".\"avg_daily_planned_demand\" AS \"avg_daily_planned_demand\",\n    \"v\".\"final_target_inventory\" AS \"final_target_inventory\",\n    \"v\".\"avg_30d_sale\" AS \"avg_30d_sale\",\n    \"v\".\"final_target_turnover_days\" AS \"final_target_turnover_days\",\n    \"v\".\"priority\" AS \"priority\"\n  FROM \"versioned\" AS \"v\"\n  INNER JOIN \"ranked_ids\" AS \"k\"\n    ON \"v\".\"id\" = \"k\".\"id\"\n), \"month_start_values\" AS (\n  SELECT\n    \"ranked\".\"base_name\" AS \"base_name\",\n    \"ranked\".\"material_code\" AS \"material_code\",\n    MAX(\"ranked\".\"final_target_inventory\") FILTER(WHERE\n      \"ranked\".\"priority\" = 2 AND \"ranked\".\"material_code\" IS NOT NULL) AS \"month_start_target\",\n    MAX(\"ranked\".\"avg_daily_planned_demand\") FILTER(WHERE\n      \"ranked\".\"priority\" = 2 AND \"ranked\".\"material_code\" IS NOT NULL) AS \"month_start_daily\",\n    MAX(\"ranked\".\"turnover_inventory\") FILTER(WHERE\n      \"ranked\".\"priority\" = 2 AND \"ranked\".\"material_code\" IS NOT NULL) AS \"month_start_turnover\"\n  FROM \"ranked\" AS \"ranked\"\n  GROUP BY\n    \"ranked\".\"base_name\",\n    \"ranked\".\"material_code\"\n), \"with_month_start\" AS (\n  SELECT\n    \"r\".\"id\" AS \"id\",\n    \"r\".\"base_name\" AS \"base_name\",\n    \"r\".\"inventory_snapshot_time\" AS \"inventory_snapshot_time\",\n    \"r\".\"material_code\" AS \"material_code\",\n    \"r\".\"material_name\" AS \"material_name\",\n    \"r\".\"product_categ_name\" AS \"product_categ_name\",\n    \"r\".\"product_label\" AS \"product_label\",\n    \"r\".\"current_inventory\" AS \"current_inventory\",\n    \"r\".\"turnover_inventory\" AS \"turnover_inventory\",\n    \"r\".\"avg_daily_planned_demand\" AS \"avg_daily_planned_demand\",\n    \"r\".\"final_target_inventory\" AS \"final_target_inventory\",\n    \"r\".\"avg_30d_sale\" AS \"avg_30d_sale\",\n    \"r\".\"final_target_turnover_days\" AS \"final_target_turnover_days\",\n    \"r\".\"priority\" AS \"priority\",\n    \"m\".\"month_start_target\" AS \"month_start_target\",\n    \"m\".\"month_start_daily\" AS \"month_start_daily\",\n    \"m\".\"month_start_turnover\" AS \"month_start_turnover\"\n  FROM \"ranked\" AS \"r\"\n  LEFT JOIN \"month_start_values\" AS \"m\"\n    ON COALESCE(\"r\".\"base_name\", '') = COALESCE(\"m\".\"base_name\", '')\n    AND (\n      \"r\".\"base_name\" IS NULL\n    ) = (\n      \"m\".\"base_name\" IS NULL\n    )\n    AND COALESCE(CAST(\"r\".\"material_code\" AS TEXT), '') = COALESCE(CAST(\"m\".\"material_code\" AS TEXT), '')\n    AND (\n      \"r\".\"material_code\" IS NULL\n    ) = (\n      \"m\".\"material_code\" IS NULL\n    )\n), \"resolved_ids\" AS (\n  SELECT\n    COALESCE(\n      MAX(\"r\".\"id\") FILTER(WHERE\n        \"r\".\"priority\" = \"s\".\"priority\"),\n      MAX(\"r\".\"id\") FILTER(WHERE\n        \"s\".\"priority\" = 1 AND \"r\".\"priority\" = 2)\n    ) AS \"id\"\n  FROM \"with_month_start\" AS \"r\"\n  CROSS JOIN \"selected\" AS \"s\"\n  GROUP BY\n    \"r\".\"base_name\",\n    \"r\".\"material_code\"\n), \"resolved\" AS (\n  SELECT\n    \"r\".\"base_name\" AS \"base_name\",\n    \"r\".\"inventory_snapshot_time\" AS \"inventory_snapshot_time\",\n    \"r\".\"material_code\" AS \"material_code\",\n    \"r\".\"material_name\" AS \"material_name\",\n    \"r\".\"product_categ_name\" AS \"product_categ_name\",\n    \"r\".\"product_label\" AS \"product_label\",\n    \"r\".\"current_inventory\" AS \"current_inventory\",\n    \"r\".\"avg_30d_sale\" AS \"avg_30d_sale\",\n    \"r\".\"final_target_turnover_days\" AS \"final_target_turnover_days\",\n    CASE\n      WHEN \"r\".\"priority\" = 1\n      AND COALESCE(\"r\".\"final_target_inventory\", 0) <= 0\n      AND \"r\".\"month_start_target\" > 0\n      THEN \"r\".\"month_start_target\"\n      ELSE \"r\".\"final_target_inventory\"\n    END AS \"resolved_target\",\n    CASE\n      WHEN \"r\".\"priority\" = 1\n      AND COALESCE(\"r\".\"avg_daily_planned_demand\", 0) <= 0\n      AND \"r\".\"month_start_daily\" > 0\n      THEN \"r\".\"month_start_daily\"\n      ELSE \"r\".\"avg_daily_planned_demand\"\n    END AS \"resolved_daily\",\n    CASE\n      WHEN \"r\".\"priority\" = 1\n      AND COALESCE(\"r\".\"turnover_inventory\", 0) <= 0\n      AND \"r\".\"month_start_turnover\" > 0\n      THEN \"r\".\"month_start_turnover\"\n      ELSE \"r\".\"turnover_inventory\"\n    END AS \"resolved_turnover\"\n  FROM \"with_month_start\" AS \"r\"\n  INNER JOIN \"resolved_ids\" AS \"k\"\n    ON \"r\".\"id\" = \"k\".\"id\"\n)\nSELECT\n  CAST(\"resolved\".\"inventory_snapshot_time\" AS DATE) AS \"snapshot_date\",\n  \"resolved\".\"base_name\" AS \"base_name\",\n  COALESCE(\"resolved\".\"product_categ_name\", '未分类') AS \"category\",\n  CAST(\"resolved\".\"material_code\" AS TEXT) AS \"sku\",\n  \"resolved\".\"current_inventory\" AS \"current_qty\",\n  CASE\n    WHEN \"resolved\".\"product_categ_name\" = '粽子'\n    OR \"resolved\".\"product_label\" LIKE '%粽子%'\n    OR \"resolved\".\"material_name\" LIKE '%粽子%'\n    THEN CASE\n      WHEN \"resolved\".\"resolved_daily\" > 0\n      THEN \"resolved\".\"resolved_turnover\"\n      WHEN \"resolved\".\"resolved_daily\" = 0\n      THEN 0\n    END\n    ELSE \"resolved\".\"resolved_target\"\n  END AS \"target_qty\",\n  \"resolved\".\"resolved_daily\" AS \"planned_daily_qty\",\n  30 * \"resolved\".\"avg_30d_sale\" AS \"external_demand_30d\",\n  \"resolved\".\"final_target_turnover_days\" AS \"source_target_turnover_days\",\n  CAST(NULL AS DECIMAL) AS \"transfer_out_30d\"\nFROM \"resolved\" AS \"resolved\"\nWHERE\n  (\n    :scope_3 OR \"resolved\".\"base_name\" IN (:list_3)\n  )\n  AND (\n    CAST($4 AS TEXT) IS NULL OR \"resolved\".\"base_name\" = $4\n  )\n  AND (\n    CAST($5 AS TEXT) IS NULL OR \"resolved\".\"product_categ_name\" = $5\n  )\n  AND (\n    CAST($6 AS TEXT) IS NULL OR CAST(\"resolved\".\"material_code\" AS TEXT) = $6\n  )\nORDER BY\n  \"base_name\",\n  \"category\",\n  \"sku\",\n  \"snapshot_date\",\n  \"current_qty\",\n  \"target_qty\",\n  \"planned_daily_qty\",\n  \"external_demand_30d\",\n  \"transfer_out_30d\"`;\n\nconst BRANCH_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\",\n    COALESCE(\n      MIN(\n        CASE\n          WHEN \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n          THEN \"p\".\"source_branch_key\"\n        END\n      ),\n      MIN(\"p\".\"source_branch_key\"),\n      \"c\".\"pickup_code\"\n    ) AS \"source_branch_key\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"live_qty\" AS \"live_qty\",\n    \"i\".\"available_qty\" AS \"available_qty\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n), \"latest_plan\" AS (\n  SELECT\n    MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"value\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n), \"chosen_month\" AS (\n  SELECT\n    CAST($2 AS DATE) AS \"value\"\n), \"selected_versions\" AS (\n  SELECT\n    TRIM(\"pv\".\"branch_pickup_point\") AS \"branch_key\",\n    COALESCE(\n      MIN(\"pv\".\"plan_version\") FILTER(WHERE\n        \"pv\".\"plan_version\" = 'MONTH_START'),\n      MIN(\"pv\".\"plan_version\") FILTER(WHERE\n        \"pv\".\"plan_version\" = 'ROLLING'),\n      MIN(\"pv\".\"plan_version\")\n    ) AS \"plan_version\"\n  FROM \"agents_scm_branch_plan\" AS \"pv\"\n  CROSS JOIN \"latest_plan\" AS \"latest_plan\"\n  CROSS JOIN \"chosen_month\" AS \"chosen_month\"\n  WHERE\n    \"pv\".\"plan_snapshot_date\" = \"latest_plan\".\"value\"\n    AND \"pv\".\"target_month\" = \"chosen_month\".\"value\"\n  GROUP BY\n    TRIM(\"pv\".\"branch_pickup_point\")\n), \"plan_candidates\" AS (\n  SELECT\n    \"p\".\"id\" AS \"id\",\n    \"p\".\"updated_time\" AS \"updated_time\",\n    CASE WHEN \"p\".\"plan_status\" = 'READY' THEN 0 ELSE 1 END AS \"readiness\",\n    \"c\".\"branch_pickup_point\" AS \"source_branch_key\",\n    \"p\".\"material_code\" AS \"material_code\",\n    \"p\".\"product_categ_name\" AS \"product_categ_name\",\n    CASE\n      WHEN \"p\".\"plan_status\" = 'READY'\n      AND NOT COALESCE(\"p\".\"bi_target_status\", '') ~ 'MISSING|INVALID|INCOMPLETE|PENDING'\n      THEN \"p\".\"shipment_plan_qty\"\n    END AS \"shipment_plan_qty\",\n    CASE\n      WHEN \"p\".\"plan_status\" = 'READY'\n      AND NOT COALESCE(\"p\".\"bi_target_status\", '') ~ 'MISSING|INVALID|INCOMPLETE|PENDING'\n      THEN \"p\".\"expected_month_end_inventory_qty\"\n    END AS \"expected_month_end_inventory_qty\",\n    \"p\".\"replenishment_cycle_days\" AS \"replenishment_cycle_days\"\n  FROM \"agents_scm_branch_plan\" AS \"p\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"source_branch_key\" = TRIM(\"p\".\"branch_pickup_point\")\n  JOIN \"selected_versions\" AS \"v\"\n    ON \"v\".\"branch_key\" = TRIM(\"p\".\"branch_pickup_point\")\n    AND \"v\".\"plan_version\" = \"p\".\"plan_version\"\n  CROSS JOIN \"latest_plan\" AS \"latest_plan\"\n  CROSS JOIN \"chosen_month\" AS \"chosen_month\"\n  WHERE\n    \"p\".\"plan_snapshot_date\" = \"latest_plan\".\"value\"\n    AND \"p\".\"target_month\" = \"chosen_month\".\"value\"\n    AND (\n      CAST($5 AS TEXT) IS NULL OR \"p\".\"product_categ_name\" = $5\n    )\n    AND (\n      CAST($6 AS TEXT) IS NULL OR \"p\".\"material_code\" = $6\n    )\n), \"plan_rows\" AS (\n  SELECT\n    \"c\".\"source_branch_key\" AS \"branch_pickup_point\",\n    \"c\".\"material_code\" AS \"material_code\",\n    \"c\".\"product_categ_name\" AS \"product_categ_name\",\n    \"c\".\"shipment_plan_qty\" AS \"shipment_plan_qty\",\n    \"c\".\"expected_month_end_inventory_qty\" AS \"expected_month_end_inventory_qty\",\n    \"c\".\"replenishment_cycle_days\" AS \"replenishment_cycle_days\"\n  FROM \"plan_candidates\" AS \"c\"\n  LEFT JOIN \"plan_candidates\" AS \"better\"\n    ON \"c\".\"source_branch_key\" = \"better\".\"source_branch_key\"\n    AND \"c\".\"material_code\" = \"better\".\"material_code\"\n    AND (\n      \"better\".\"readiness\" < \"c\".\"readiness\"\n      OR (\n        \"better\".\"readiness\" = \"c\".\"readiness\"\n        AND (\n          (\n            \"better\".\"updated_time\" IS NULL AND \"c\".\"updated_time\" IS NOT NULL\n          )\n          OR \"better\".\"updated_time\" > \"c\".\"updated_time\"\n          OR (\n            (\n              \"better\".\"updated_time\" = \"c\".\"updated_time\"\n              OR (\n                \"better\".\"updated_time\" IS NULL AND \"c\".\"updated_time\" IS NULL\n              )\n            )\n            AND \"better\".\"id\" > \"c\".\"id\"\n          )\n        )\n      )\n    )\n  WHERE\n    \"better\".\"id\" IS NULL\n), \"latest_inventory\" AS (\n  SELECT\n    MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"value\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n), \"inventory_rows\" AS (\n  SELECT\n    \"mapped_branch_inventory\".\"snapshot_date\" AS \"snapshot_date\",\n    \"mapped_branch_inventory\".\"branch_pickup_point\" AS \"branch\",\n    \"mapped_branch_inventory\".\"material_code\" AS \"material_code\",\n    MAX(\"mapped_branch_inventory\".\"product_categ_name\") AS \"category\",\n    SUM(\"mapped_branch_inventory\".\"live_qty\") AS \"current_qty\",\n    CASE\n      WHEN BOOL_AND(\"mapped_branch_inventory\".\"available_qty\" IS NOT NULL)\n      THEN SUM(\"mapped_branch_inventory\".\"available_qty\")\n    END AS \"available_qty\"\n  FROM \"mapped_branch_inventory\" AS \"mapped_branch_inventory\"\n  CROSS JOIN \"latest_inventory\" AS \"latest_inventory\"\n  WHERE\n    \"mapped_branch_inventory\".\"snapshot_date\" = \"latest_inventory\".\"value\"\n    AND (\n      :scope_3 OR \"mapped_branch_inventory\".\"branch_pickup_point\" IN (:list_3)\n    )\n    AND (\n      CAST($4 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"branch_pickup_point\" = $4\n    )\n    AND (\n      CAST($5 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"product_categ_name\" = $5\n    )\n    AND (\n      CAST($6 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"material_code\" = $6\n    )\n  GROUP BY\n    \"mapped_branch_inventory\".\"snapshot_date\",\n    \"mapped_branch_inventory\".\"branch_pickup_point\",\n    \"mapped_branch_inventory\".\"material_code\"\n), \"branch_result\" AS (\n  SELECT\n    \"inventory_rows\".\"snapshot_date\" AS \"snapshot_date\",\n    \"inventory_rows\".\"branch\" AS \"branch\",\n    COALESCE(\"inventory_rows\".\"category\", \"plan_rows\".\"product_categ_name\", '未分类') AS \"category\",\n    \"inventory_rows\".\"material_code\" AS \"sku\",\n    \"inventory_rows\".\"current_qty\" AS \"current_qty\",\n    \"inventory_rows\".\"available_qty\" AS \"available_qty\",\n    \"plan_rows\".\"shipment_plan_qty\" / EXTRACT(DAY FROM (\n      DATE_TRUNC('MONTH', \"chosen_month\".\"value\") + INTERVAL '1 month - 1 day'\n    )) AS \"planned_daily_qty\",\n    \"plan_rows\".\"expected_month_end_inventory_qty\" AS \"forecast_inventory_qty\",\n    CASE\n      WHEN \"plan_rows\".\"replenishment_cycle_days\" >= 0\n      AND \"plan_rows\".\"shipment_plan_qty\" >= 0\n      THEN (\n        \"plan_rows\".\"replenishment_cycle_days\" + 3\n      ) * \"plan_rows\".\"shipment_plan_qty\" / EXTRACT(DAY FROM (\n        DATE_TRUNC('MONTH', \"chosen_month\".\"value\") + INTERVAL '1 month - 1 day'\n      ))\n    END AS \"target_qty\",\n    CAST(NULL AS DECIMAL) AS \"external_demand_30d\"\n  FROM \"inventory_rows\" AS \"inventory_rows\"\n  CROSS JOIN \"chosen_month\" AS \"chosen_month\"\n  LEFT JOIN \"plan_rows\" AS \"plan_rows\"\n    ON \"plan_rows\".\"branch_pickup_point\" = \"inventory_rows\".\"branch\"\n    AND \"plan_rows\".\"material_code\" = \"inventory_rows\".\"material_code\"\n)\nSELECT\n  \"branch_result\".\"snapshot_date\" AS \"snapshot_date\",\n  \"branch_result\".\"branch\" AS \"branch\",\n  \"branch_result\".\"category\" AS \"category\",\n  \"branch_result\".\"sku\" AS \"sku\",\n  \"branch_result\".\"current_qty\" AS \"current_qty\",\n  \"branch_result\".\"available_qty\" AS \"available_qty\",\n  \"branch_result\".\"planned_daily_qty\" AS \"planned_daily_qty\",\n  \"branch_result\".\"forecast_inventory_qty\" AS \"forecast_inventory_qty\",\n  \"branch_result\".\"target_qty\" AS \"target_qty\",\n  \"branch_result\".\"external_demand_30d\" AS \"external_demand_30d\",\n  (\n    SELECT\n      COUNT(*) AS \"total\"\n    FROM \"catalog_plans\" AS \"p\"\n    LEFT JOIN \"branch_catalog\" AS \"c\"\n      ON \"c\".\"branch_pickup_point\" = \"p\".\"branch_pickup_point\"\n    WHERE\n      \"c\".\"pickup_code\" IS NULL\n      AND (\n        :scope_3 OR \"p\".\"branch_pickup_point\" IN (:list_3)\n      )\n      AND (\n        CAST($4 AS TEXT) IS NULL OR \"p\".\"branch_pickup_point\" = $4\n      )\n  ) + (\n    SELECT\n      COUNT(*) AS \"total\"\n    FROM \"catalog_scopes\" AS \"s\"\n    LEFT JOIN \"branch_catalog\" AS \"c\"\n      ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n    WHERE\n      \"c\".\"pickup_code\" IS NULL\n      AND (\n        :scope_3 OR \"s\".\"warehouse_name\" IN (:list_3)\n      )\n      AND (\n        CAST($4 AS TEXT) IS NULL OR \"s\".\"warehouse_name\" = $4\n      )\n  ) AS \"mapping_issue_count\"\nFROM (\n  SELECT\n    1 AS _\n) AS \"probe\"\nLEFT JOIN \"branch_result\" AS \"branch_result\"\n  ON TRUE\nORDER BY\n  \"branch_result\".\"branch\",\n  \"branch_result\".\"category\",\n  \"branch_result\".\"sku\"`;\n\nconst CUSTOMER_SQL = `WITH \"latest_inv\" AS (\n  SELECT\n    MAX(\"agents_scm_cust_inventory_daily\".\"stat_date\") AS \"value\"\n  FROM \"agents_scm_cust_inventory_daily\" AS \"agents_scm_cust_inventory_daily\"\n  WHERE\n    \"agents_scm_cust_inventory_daily\".\"stat_date\" <= CAST($1 AS DATE)\n), \"latest_plan\" AS (\n  SELECT\n    MAX(\"agents_scm_cust_plan_order_analysis\".\"snapshot_date\") AS \"value\"\n  FROM \"agents_scm_cust_plan_order_analysis\" AS \"agents_scm_cust_plan_order_analysis\"\n  WHERE\n    \"agents_scm_cust_plan_order_analysis\".\"snapshot_date\" <= CAST($1 AS DATE)\n), \"inv\" AS (\n  SELECT\n    \"agents_scm_cust_inventory_daily\".\"inventory_snapshot_date\" AS \"snapshot_date\",\n    \"agents_scm_cust_inventory_daily\".\"stat_date\" AS \"stat_date\",\n    \"agents_scm_cust_inventory_daily\".\"cust_code\" AS \"cust_code\",\n    MAX(\"agents_scm_cust_inventory_daily\".\"cust_name\") AS \"cust_name\",\n    \"agents_scm_cust_inventory_daily\".\"material_code\" AS \"material_code\",\n    COALESCE(\"agents_scm_cust_inventory_daily\".\"product_range_name\", '未分类') AS \"category\",\n    SUM(\"agents_scm_cust_inventory_daily\".\"stock_qty\") AS \"current_qty\",\n    SUM(\"agents_scm_cust_inventory_daily\".\"sales_qty_30days\") AS \"sales_30d\"\n  FROM \"agents_scm_cust_inventory_daily\" AS \"agents_scm_cust_inventory_daily\"\n  CROSS JOIN \"latest_inv\" AS \"latest_inv\"\n  WHERE\n    \"agents_scm_cust_inventory_daily\".\"stat_date\" = \"latest_inv\".\"value\"\n    AND (\n      :scope_2 OR \"agents_scm_cust_inventory_daily\".\"cust_code\" IN (:list_2)\n    )\n    AND (\n      CAST($3 AS TEXT) IS NULL\n      OR \"agents_scm_cust_inventory_daily\".\"product_range_name\" = $3\n    )\n    AND (\n      CAST($4 AS TEXT) IS NULL\n      OR \"agents_scm_cust_inventory_daily\".\"material_code\" = $4\n    )\n    AND (\n      CAST($5 AS TEXT) IS NULL OR \"agents_scm_cust_inventory_daily\".\"cust_code\" = $5\n    )\n  GROUP BY\n    \"agents_scm_cust_inventory_daily\".\"inventory_snapshot_date\",\n    \"agents_scm_cust_inventory_daily\".\"stat_date\",\n    \"agents_scm_cust_inventory_daily\".\"cust_code\",\n    \"agents_scm_cust_inventory_daily\".\"material_code\",\n    \"agents_scm_cust_inventory_daily\".\"product_range_name\"\n), \"plan\" AS (\n  SELECT\n    \"agents_scm_cust_plan_order_analysis\".\"cust_code\" AS \"cust_code\",\n    \"agents_scm_cust_plan_order_analysis\".\"material_code\" AS \"material_code\",\n    SUM(\"agents_scm_cust_plan_order_analysis\".\"target_inventory\") AS \"target_qty\",\n    SUM(\"agents_scm_cust_plan_order_analysis\".\"stock_qty\") AS \"plan_stock_qty\"\n  FROM \"agents_scm_cust_plan_order_analysis\" AS \"agents_scm_cust_plan_order_analysis\"\n  CROSS JOIN \"latest_plan\" AS \"latest_plan\"\n  WHERE\n    \"agents_scm_cust_plan_order_analysis\".\"snapshot_date\" = \"latest_plan\".\"value\"\n    AND \"agents_scm_cust_plan_order_analysis\".\"plan_month\" = DATE_TRUNC('MONTH', CAST($1 AS DATE))\n    AND (\n      :scope_2 OR \"agents_scm_cust_plan_order_analysis\".\"cust_code\" IN (:list_2)\n    )\n    AND (\n      CAST($5 AS TEXT) IS NULL\n      OR \"agents_scm_cust_plan_order_analysis\".\"cust_code\" = $5\n    )\n  GROUP BY\n    \"agents_scm_cust_plan_order_analysis\".\"cust_code\",\n    \"agents_scm_cust_plan_order_analysis\".\"material_code\"\n)\nSELECT\n  \"inv\".\"snapshot_date\" AS \"snapshot_date\",\n  \"inv\".\"stat_date\" AS \"stat_date\",\n  \"inv\".\"cust_code\" AS \"cust_code\",\n  MAX(\"inv\".\"cust_name\") AS \"cust_name\",\n  \"inv\".\"category\" AS \"category\",\n  \"inv\".\"material_code\" AS \"material_code\",\n  SUM(\"inv\".\"current_qty\") AS \"current_qty\",\n  NULLIF(SUM(COALESCE(\"plan\".\"target_qty\", 0)), 0) AS \"target_qty\",\n  SUM(\"inv\".\"sales_30d\") AS \"sales_30d\",\n  CASE\n    WHEN COUNT(\"plan\".\"plan_stock_qty\") = 0\n    THEN FALSE\n    ELSE ABS(SUM(\"inv\".\"current_qty\") - SUM(COALESCE(\"plan\".\"plan_stock_qty\", 0))) > 1\n  END AS \"source_conflict\"\nFROM \"inv\" AS \"inv\"\nLEFT JOIN \"plan\" AS \"plan\"\n  ON \"inv\".\"cust_code\" = \"plan\".\"cust_code\"\n  AND \"inv\".\"material_code\" = \"plan\".\"material_code\"\nGROUP BY\n  \"inv\".\"snapshot_date\",\n  \"inv\".\"stat_date\",\n  \"inv\".\"cust_code\",\n  \"inv\".\"category\",\n  \"inv\".\"material_code\"\nORDER BY\n  \"current_qty\" DESC,\n  \"cust_code\",\n  \"category\",\n  \"material_code\",\n  \"inv\".\"snapshot_date\",\n  \"inv\".\"stat_date\",\n  \"inv\".\"cust_code\",\n  \"inv\".\"category\",\n  \"inv\".\"material_code\"`;\n\nconst BASE_AGE_SQL = `WITH \"latest_age\" AS (\n  SELECT\n    MAX(\"agents_scm_inventory_age\".\"snapshot_time\") AS \"value\"\n  FROM \"agents_scm_inventory_age\" AS \"agents_scm_inventory_age\"\n  WHERE\n    CAST(\"agents_scm_inventory_age\".\"snapshot_time\" AS DATE) <= CAST($1 AS DATE)\n)\nSELECT\n  \"agents_scm_inventory_age\".\"snapshot_date\" AS \"snapshot_date\",\n  \"agents_scm_inventory_age\".\"base_name\" AS \"object_name\",\n  COALESCE(\"agents_scm_inventory_age\".\"product_categ_name\", '未分类') AS \"category\",\n  \"agents_scm_inventory_age\".\"material_code\" AS \"sku\",\n  COALESCE(\"agents_scm_inventory_age\".\"warehouseid\", '-') || ':' || COALESCE(\n    \"agents_scm_inventory_age\".\"productdate\",\n    \"agents_scm_inventory_age\".\"create_date\",\n    '-'\n  ) AS \"batch\",\n  SUM(\"agents_scm_inventory_age\".\"qty\") AS \"qty\",\n  CASE\n    WHEN BOOL_AND(\"agents_scm_inventory_age\".\"productage\" IS NOT NULL)\n    THEN MAX(\"agents_scm_inventory_age\".\"productage\")\n  END AS \"age_days\"\nFROM \"agents_scm_inventory_age\" AS \"agents_scm_inventory_age\"\nCROSS JOIN \"latest_age\" AS \"latest_age\"\nWHERE\n  \"agents_scm_inventory_age\".\"snapshot_time\" = \"latest_age\".\"value\"\n  AND \"agents_scm_inventory_age\".\"base_name\" IN ('华东', '华南', '西南', '遂平', '郑州')\n  AND (\n    :scope_2 OR \"agents_scm_inventory_age\".\"base_name\" IN (:list_2)\n  )\n  AND (\n    CAST($3 AS TEXT) IS NULL OR \"agents_scm_inventory_age\".\"base_name\" = $3\n  )\n  AND (\n    CAST($4 AS TEXT) IS NULL OR \"agents_scm_inventory_age\".\"product_categ_name\" = $4\n  )\n  AND (\n    CAST($5 AS TEXT) IS NULL OR \"agents_scm_inventory_age\".\"material_code\" = $5\n  )\nGROUP BY\n  \"agents_scm_inventory_age\".\"snapshot_date\",\n  \"agents_scm_inventory_age\".\"base_name\",\n  \"agents_scm_inventory_age\".\"product_categ_name\",\n  \"agents_scm_inventory_age\".\"material_code\",\n  \"agents_scm_inventory_age\".\"warehouseid\",\n  \"agents_scm_inventory_age\".\"productdate\",\n  \"agents_scm_inventory_age\".\"create_date\"\nORDER BY\n  \"agents_scm_inventory_age\".\"snapshot_date\",\n  \"agents_scm_inventory_age\".\"base_name\",\n  \"agents_scm_inventory_age\".\"product_categ_name\",\n  \"agents_scm_inventory_age\".\"material_code\",\n  \"agents_scm_inventory_age\".\"warehouseid\",\n  \"agents_scm_inventory_age\".\"productdate\",\n  \"agents_scm_inventory_age\".\"create_date\"`;\n\nconst BRANCH_AGE_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    \"p\".\"source_branch_key\" AS \"source_branch_key\",\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"warehouseid\" AS \"warehouseid\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"prod_date\" AS \"prod_date\",\n    \"i\".\"live_qty\" AS \"live_qty\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n), \"latest_age\" AS (\n  SELECT\n    MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"value\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n)\nSELECT\n  \"mapped_branch_inventory\".\"snapshot_date\" AS \"snapshot_date\",\n  \"mapped_branch_inventory\".\"branch_pickup_point\" AS \"object_name\",\n  COALESCE(\"mapped_branch_inventory\".\"product_categ_name\", '未分类') AS \"category\",\n  \"mapped_branch_inventory\".\"material_code\" AS \"sku\",\n  \"mapped_branch_inventory\".\"warehouseid\" || ':' || COALESCE(CAST(\"mapped_branch_inventory\".\"prod_date\" AS TEXT), '-') AS \"batch\",\n  SUM(\"mapped_branch_inventory\".\"live_qty\") AS \"qty\",\n  CASE\n    WHEN \"mapped_branch_inventory\".\"prod_date\" IS NULL\n    THEN NULL\n    ELSE GREATEST(\n      0,\n      \"mapped_branch_inventory\".\"snapshot_date\" - \"mapped_branch_inventory\".\"prod_date\"\n    )\n  END AS \"age_days\"\nFROM \"mapped_branch_inventory\" AS \"mapped_branch_inventory\"\nCROSS JOIN \"latest_age\" AS \"latest_age\"\nWHERE\n  \"mapped_branch_inventory\".\"snapshot_date\" = \"latest_age\".\"value\"\n  AND (\n    :scope_2 OR \"mapped_branch_inventory\".\"branch_pickup_point\" IN (:list_2)\n  )\n  AND (\n    CAST($3 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"branch_pickup_point\" = $3\n  )\n  AND (\n    CAST($4 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"product_categ_name\" = $4\n  )\n  AND (\n    CAST($5 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"material_code\" = $5\n  )\nGROUP BY\n  \"mapped_branch_inventory\".\"snapshot_date\",\n  \"mapped_branch_inventory\".\"warehouseid\",\n  \"mapped_branch_inventory\".\"branch_pickup_point\",\n  \"mapped_branch_inventory\".\"product_categ_name\",\n  \"mapped_branch_inventory\".\"material_code\",\n  \"mapped_branch_inventory\".\"prod_date\"\nORDER BY\n  \"mapped_branch_inventory\".\"snapshot_date\",\n  \"mapped_branch_inventory\".\"warehouseid\",\n  \"mapped_branch_inventory\".\"branch_pickup_point\",\n  \"mapped_branch_inventory\".\"product_categ_name\",\n  \"mapped_branch_inventory\".\"material_code\",\n  \"mapped_branch_inventory\".\"prod_date\"`;\n\nconst CUSTOMER_AGE_SQL = `WITH \"latest_submitted\" AS (\n  SELECT\n    MAX(\"agents_scm_cust_stock_age\".\"stat_date\") AS \"value\"\n  FROM \"agents_scm_cust_stock_age\" AS \"agents_scm_cust_stock_age\"\n  WHERE\n    \"agents_scm_cust_stock_age\".\"stat_date\" <= CAST($1 AS DATE)\n), \"latest_wenli\" AS (\n  SELECT\n    MAX(\"agents_scm_wl_cust_stock_age\".\"stat_date\") AS \"value\"\n  FROM \"agents_scm_wl_cust_stock_age\" AS \"agents_scm_wl_cust_stock_age\"\n  WHERE\n    \"agents_scm_wl_cust_stock_age\".\"stat_date\" <= CAST($1 AS DATE)\n), \"latest_plan\" AS (\n  SELECT\n    MAX(\"agents_scm_cust_plan_order_analysis\".\"snapshot_date\") AS \"value\"\n  FROM \"agents_scm_cust_plan_order_analysis\" AS \"agents_scm_cust_plan_order_analysis\"\n  WHERE\n    \"agents_scm_cust_plan_order_analysis\".\"snapshot_date\" <= CAST($1 AS DATE)\n), \"choices\" AS (\n  WITH governed_choice_4 AS (\n    SELECT\n      \"agents_scm_cust_plan_order_analysis\".\"cust_code\" AS \"cust_code\",\n      \"agents_scm_cust_plan_order_analysis\".\"material_code\" AS \"material_code\",\n      COALESCE(\"agents_scm_cust_plan_order_analysis\".\"inventory_source\", '提报') AS \"inventory_source\",\n      \"agents_scm_cust_plan_order_analysis\".\"id\" AS \"choice_record_id\",\n      \"cust_code\" AS \"choice_key_0\",\n      \"material_code\" AS \"choice_key_1\",\n      \"cust_code\" AS \"choice_order_0\",\n      \"material_code\" AS \"choice_order_1\",\n      \"agents_scm_cust_plan_order_analysis\".\"source_load_time\" AS \"choice_order_2\",\n      \"agents_scm_cust_plan_order_analysis\".\"updated_time\" AS \"choice_order_3\",\n      1 AS choice_present\n    FROM \"agents_scm_cust_plan_order_analysis\" AS \"agents_scm_cust_plan_order_analysis\"\n    CROSS JOIN \"latest_plan\" AS \"latest_plan\"\n    WHERE\n      \"agents_scm_cust_plan_order_analysis\".\"snapshot_date\" = \"latest_plan\".\"value\"\n  ), governed_choice_4_group_2 AS (\n    SELECT\n      c.\"choice_key_0\" AS \"choice_key_0\",\n      c.\"choice_key_1\" AS \"choice_key_1\",\n      MAX(c.\"choice_order_2\") AS choice_value\n    FROM governed_choice_4 AS c\n    GROUP BY\n      c.\"choice_key_0\",\n      c.\"choice_key_1\"\n  ), governed_choice_4_selected_2 AS (\n    SELECT\n      c.\"cust_code\" AS \"cust_code\",\n      c.\"material_code\" AS \"material_code\",\n      c.\"inventory_source\" AS \"inventory_source\",\n      c.\"choice_record_id\" AS \"choice_record_id\",\n      c.\"choice_key_0\" AS \"choice_key_0\",\n      c.\"choice_key_1\" AS \"choice_key_1\",\n      c.\"choice_order_0\" AS \"choice_order_0\",\n      c.\"choice_order_1\" AS \"choice_order_1\",\n      c.\"choice_order_2\" AS \"choice_order_2\",\n      c.\"choice_order_3\" AS \"choice_order_3\",\n      c.\"choice_present\" AS \"choice_present\"\n    FROM governed_choice_4 AS c\n    INNER JOIN governed_choice_4_group_2 AS g\n      ON (\n        COALESCE(CAST(c.\"choice_key_0\" AS TEXT), '') = COALESCE(CAST(g.\"choice_key_0\" AS TEXT), '')\n        AND (\n          c.\"choice_key_0\" IS NULL\n        ) = (\n          g.\"choice_key_0\" IS NULL\n        )\n      )\n      AND (\n        COALESCE(CAST(c.\"choice_key_1\" AS TEXT), '') = COALESCE(CAST(g.\"choice_key_1\" AS TEXT), '')\n        AND (\n          c.\"choice_key_1\" IS NULL\n        ) = (\n          g.\"choice_key_1\" IS NULL\n        )\n      )\n      AND (\n        c.\"choice_order_2\" = g.choice_value\n        OR (\n          c.\"choice_order_2\" IS NULL AND g.choice_value IS NULL\n        )\n      )\n  ), governed_choice_4_group_3 AS (\n    SELECT\n      c.\"choice_key_0\" AS \"choice_key_0\",\n      c.\"choice_key_1\" AS \"choice_key_1\",\n      MAX(c.\"choice_order_3\") AS choice_value\n    FROM governed_choice_4_selected_2 AS c\n    GROUP BY\n      c.\"choice_key_0\",\n      c.\"choice_key_1\"\n  ), governed_choice_4_selected_3 AS (\n    SELECT\n      c.\"cust_code\" AS \"cust_code\",\n      c.\"material_code\" AS \"material_code\",\n      c.\"inventory_source\" AS \"inventory_source\",\n      c.\"choice_record_id\" AS \"choice_record_id\",\n      c.\"choice_key_0\" AS \"choice_key_0\",\n      c.\"choice_key_1\" AS \"choice_key_1\",\n      c.\"choice_order_0\" AS \"choice_order_0\",\n      c.\"choice_order_1\" AS \"choice_order_1\",\n      c.\"choice_order_2\" AS \"choice_order_2\",\n      c.\"choice_order_3\" AS \"choice_order_3\",\n      c.\"choice_present\" AS \"choice_present\"\n    FROM governed_choice_4_selected_2 AS c\n    INNER JOIN governed_choice_4_group_3 AS g\n      ON (\n        COALESCE(CAST(c.\"choice_key_0\" AS TEXT), '') = COALESCE(CAST(g.\"choice_key_0\" AS TEXT), '')\n        AND (\n          c.\"choice_key_0\" IS NULL\n        ) = (\n          g.\"choice_key_0\" IS NULL\n        )\n      )\n      AND (\n        COALESCE(CAST(c.\"choice_key_1\" AS TEXT), '') = COALESCE(CAST(g.\"choice_key_1\" AS TEXT), '')\n        AND (\n          c.\"choice_key_1\" IS NULL\n        ) = (\n          g.\"choice_key_1\" IS NULL\n        )\n      )\n      AND (\n        c.\"choice_order_3\" = g.choice_value\n        OR (\n          c.\"choice_order_3\" IS NULL AND g.choice_value IS NULL\n        )\n      )\n  ), governed_choice_4_tie AS (\n    SELECT\n      MAX(t.choice_record_id) AS selected_id\n    FROM governed_choice_4_selected_3 AS t\n    GROUP BY\n      t.\"choice_key_0\",\n      t.\"choice_key_1\"\n  )\n  SELECT DISTINCT\n    c.\"cust_code\" AS \"cust_code\",\n    c.\"material_code\" AS \"material_code\",\n    c.\"inventory_source\" AS \"inventory_source\"\n  FROM governed_choice_4 AS c\n  INNER JOIN governed_choice_4_tie AS t\n    ON c.choice_record_id = t.selected_id\n), \"age_rows\" AS (\n  SELECT\n    \"age\".\"cust_code\" AS \"cust_code\",\n    \"age\".\"material_code\" AS \"material_code\",\n    \"age\".\"stat_date\" AS \"stat_date\",\n    \"age\".\"stock_qty\" AS \"stock_qty\",\n    \"age\".\"batch_no\" AS \"batch_no\",\n    \"age\".\"produce_date\" AS \"produce_date\",\n    \"age\".\"final_qty\" AS \"final_qty\",\n    CAST('提报' AS TEXT) AS \"source_kind\"\n  FROM \"agents_scm_cust_stock_age\" AS \"age\"\n  CROSS JOIN \"latest_submitted\" AS \"latest_submitted\"\n  WHERE\n    \"age\".\"stat_date\" = \"latest_submitted\".\"value\"\n  UNION ALL\n  SELECT\n    \"age\".\"cust_code\" AS \"cust_code\",\n    \"age\".\"material_code\" AS \"material_code\",\n    \"age\".\"stat_date\" AS \"stat_date\",\n    \"age\".\"stock_qty\" AS \"stock_qty\",\n    \"age\".\"batch_no\" AS \"batch_no\",\n    \"age\".\"produce_date\" AS \"produce_date\",\n    \"age\".\"final_qty\" AS \"final_qty\",\n    CAST('文沥' AS TEXT) AS \"source_kind\"\n  FROM \"agents_scm_wl_cust_stock_age\" AS \"age\"\n  CROSS JOIN \"latest_wenli\" AS \"latest_wenli\"\n  WHERE\n    \"age\".\"stat_date\" = \"latest_wenli\".\"value\"\n), \"names\" AS (\n  WITH governed_choice_3 AS (\n    SELECT\n      \"agents_scm_cust_inventory_daily\".\"cust_code\" AS \"cust_code\",\n      \"agents_scm_cust_inventory_daily\".\"material_code\" AS \"material_code\",\n      \"agents_scm_cust_inventory_daily\".\"cust_name\" AS \"cust_name\",\n      COALESCE(\"agents_scm_cust_inventory_daily\".\"product_range_name\", '未分类') AS \"category\",\n      \"agents_scm_cust_inventory_daily\".\"sales_qty_30days\" AS \"sales_qty_30days\",\n      \"agents_scm_cust_inventory_daily\".\"id\" AS \"choice_record_id\",\n      \"cust_code\" AS \"choice_key_0\",\n      \"material_code\" AS \"choice_key_1\",\n      \"cust_code\" AS \"choice_order_0\",\n      \"material_code\" AS \"choice_order_1\",\n      \"agents_scm_cust_inventory_daily\".\"source_load_time\" AS \"choice_order_2\",\n      1 AS choice_present\n    FROM \"agents_scm_cust_inventory_daily\" AS \"agents_scm_cust_inventory_daily\"\n    WHERE\n      \"agents_scm_cust_inventory_daily\".\"stat_date\" = (\n        SELECT\n          MAX(\"agents_scm_cust_inventory_daily\".\"stat_date\") AS \"_col_0\"\n        FROM \"agents_scm_cust_inventory_daily\" AS \"agents_scm_cust_inventory_daily\"\n        WHERE\n          \"agents_scm_cust_inventory_daily\".\"stat_date\" <= CAST($1 AS DATE)\n      )\n  ), governed_choice_3_group_2 AS (\n    SELECT\n      c.\"choice_key_0\" AS \"choice_key_0\",\n      c.\"choice_key_1\" AS \"choice_key_1\",\n      CASE\n        WHEN COUNT(c.\"choice_order_2\") < COUNT(*)\n        THEN NULL\n        ELSE MAX(c.\"choice_order_2\")\n      END AS choice_value\n    FROM governed_choice_3 AS c\n    GROUP BY\n      c.\"choice_key_0\",\n      c.\"choice_key_1\"\n  ), governed_choice_3_selected_2 AS (\n    SELECT\n      c.\"cust_code\" AS \"cust_code\",\n      c.\"material_code\" AS \"material_code\",\n      c.\"cust_name\" AS \"cust_name\",\n      c.\"category\" AS \"category\",\n      c.\"sales_qty_30days\" AS \"sales_qty_30days\",\n      c.\"choice_record_id\" AS \"choice_record_id\",\n      c.\"choice_key_0\" AS \"choice_key_0\",\n      c.\"choice_key_1\" AS \"choice_key_1\",\n      c.\"choice_order_0\" AS \"choice_order_0\",\n      c.\"choice_order_1\" AS \"choice_order_1\",\n      c.\"choice_order_2\" AS \"choice_order_2\",\n      c.\"choice_present\" AS \"choice_present\"\n    FROM governed_choice_3 AS c\n    INNER JOIN governed_choice_3_group_2 AS g\n      ON (\n        COALESCE(CAST(c.\"choice_key_0\" AS TEXT), '') = COALESCE(CAST(g.\"choice_key_0\" AS TEXT), '')\n        AND (\n          c.\"choice_key_0\" IS NULL\n        ) = (\n          g.\"choice_key_0\" IS NULL\n        )\n      )\n      AND (\n        COALESCE(CAST(c.\"choice_key_1\" AS TEXT), '') = COALESCE(CAST(g.\"choice_key_1\" AS TEXT), '')\n        AND (\n          c.\"choice_key_1\" IS NULL\n        ) = (\n          g.\"choice_key_1\" IS NULL\n        )\n      )\n      AND (\n        c.\"choice_order_2\" = g.choice_value\n        OR (\n          c.\"choice_order_2\" IS NULL AND g.choice_value IS NULL\n        )\n      )\n  ), governed_choice_3_tie AS (\n    SELECT\n      MAX(t.choice_record_id) AS selected_id\n    FROM governed_choice_3_selected_2 AS t\n    GROUP BY\n      t.\"choice_key_0\",\n      t.\"choice_key_1\"\n  )\n  SELECT DISTINCT\n    c.\"cust_code\" AS \"cust_code\",\n    c.\"material_code\" AS \"material_code\",\n    c.\"cust_name\" AS \"cust_name\",\n    c.\"category\" AS \"category\",\n    c.\"sales_qty_30days\" AS \"sales_qty_30days\"\n  FROM governed_choice_3 AS c\n  INNER JOIN governed_choice_3_tie AS t\n    ON c.choice_record_id = t.selected_id\n)\nSELECT\n  \"age\".\"stat_date\" AS \"snapshot_date\",\n  \"age\".\"cust_code\" AS \"cust_code\",\n  COALESCE(\"names\".\"cust_name\", \"age\".\"cust_code\") AS \"object_name\",\n  COALESCE(\"names\".\"category\", '未分类') AS \"category\",\n  \"age\".\"material_code\" AS \"sku\",\n  COALESCE(\"age\".\"batch_no\", '-') || ':' || COALESCE(CAST(\"age\".\"produce_date\" AS TEXT), '-') AS \"batch\",\n  SUM(COALESCE(\"age\".\"final_qty\", \"age\".\"stock_qty\")) AS \"qty\",\n  CASE\n    WHEN \"age\".\"produce_date\" IS NULL\n    THEN NULL\n    ELSE GREATEST(0, \"age\".\"stat_date\" - \"age\".\"produce_date\")\n  END AS \"age_days\",\n  MAX(\"names\".\"sales_qty_30days\") / 30.0 AS \"daily_velocity\",\n  \"age\".\"source_kind\" AS \"source\"\nFROM \"age_rows\" AS \"age\"\nLEFT JOIN \"choices\" AS \"choices\"\n  ON \"age\".\"cust_code\" = \"choices\".\"cust_code\"\n  AND \"age\".\"material_code\" = \"choices\".\"material_code\"\nLEFT JOIN \"names\" AS \"names\"\n  ON COALESCE(\"age\".\"cust_code\", \"choices\".\"cust_code\") = \"names\".\"cust_code\"\n  AND COALESCE(\"age\".\"material_code\", \"choices\".\"material_code\") = \"names\".\"material_code\"\nWHERE\n  (\n    (\n      :scope_2 OR \"age\".\"cust_code\" IN (:list_2)\n    )\n    AND (\n      CAST($3 AS TEXT) IS NULL OR \"names\".\"category\" = $3\n    )\n    AND (\n      CAST($4 AS TEXT) IS NULL OR \"age\".\"material_code\" = $4\n    )\n    AND (\n      CAST($5 AS TEXT) IS NULL OR \"age\".\"cust_code\" = $5\n    )\n  )\n  AND (\n    (\n      COALESCE(\"choices\".\"inventory_source\", '提报') = '文沥'\n      AND \"age\".\"source_kind\" = '文沥'\n    )\n    OR (\n      COALESCE(\"choices\".\"inventory_source\", '提报') <> '文沥'\n      AND \"age\".\"source_kind\" = '提报'\n    )\n  )\nGROUP BY\n  \"age\".\"stat_date\",\n  \"age\".\"cust_code\",\n  \"names\".\"cust_name\",\n  \"names\".\"category\",\n  \"age\".\"material_code\",\n  \"age\".\"batch_no\",\n  \"age\".\"produce_date\",\n  \"age\".\"source_kind\"\nORDER BY\n  \"age\".\"stat_date\",\n  \"age\".\"cust_code\",\n  \"names\".\"cust_name\",\n  \"names\".\"category\",\n  \"age\".\"material_code\",\n  \"age\".\"batch_no\",\n  \"age\".\"produce_date\",\n  \"age\".\"source_kind\"`;\n\nconst ORDER_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    \"p\".\"source_branch_key\" AS \"source_branch_key\",\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"id\" AS \"id\",\n    \"i\".\"source_record_id\" AS \"source_record_id\",\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"warehouseid\" AS \"warehouseid\",\n    \"i\".\"warehouse_name\" AS \"warehouse_name\",\n    \"i\".\"self_pickup_point\" AS \"self_pickup_point\",\n    \"i\".\"pickup_point\" AS \"pickup_point\",\n    \"i\".\"base_name\" AS \"base_name\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"material_name\" AS \"material_name\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"prod_date\" AS \"prod_date\",\n    \"i\".\"live_qty\" AS \"live_qty\",\n    \"i\".\"available_qty\" AS \"available_qty\",\n    \"i\".\"warehouse_classify\" AS \"warehouse_classify\",\n    \"i\".\"created_time\" AS \"created_time\",\n    \"i\".\"updated_time\" AS \"updated_time\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n), \"latest_order\" AS (\n  SELECT\n    MAX(\"agents_scm_order_fulfillment\".\"snapshot_date\") AS \"value\"\n  FROM \"agents_scm_order_fulfillment\" AS \"agents_scm_order_fulfillment\"\n  WHERE\n    \"agents_scm_order_fulfillment\".\"snapshot_date\" <= CAST($1 AS DATE)\n)\nSELECT\n  \"f\".\"snapshot_date\" AS \"snapshot_date\",\n  TO_CHAR(\"f\".\"fromorderno_month\", 'YYYY-MM') AS \"month\",\n  CASE WHEN \"f\".\"pick_point_type2\" = '工厂' THEN 'factory' ELSE 'branch' END AS \"pickup_type\",\n  CASE\n    WHEN \"f\".\"pick_point_type2\" = '工厂'\n    THEN \"f\".\"belong_base\"\n    ELSE \"c\".\"branch_pickup_point\"\n  END AS \"object_name\",\n  COALESCE(\"f\".\"product_categ_name\", '未分类') AS \"category\",\n  \"f\".\"new_material_code\" AS \"sku\",\n  CASE\n    WHEN BOOL_AND(\"f\".\"order_qty_origin\" IS NOT NULL)\n    THEN SUM(\"f\".\"order_qty_origin\")\n  END AS \"order_qty\",\n  CAST(JSON_AGG(DISTINCT \"f\".\"fromorderno\") FILTER(WHERE \"f\".\"fromorderno\" IS NOT NULL) AS TEXT) AS \"order_ids\",\n  CAST(JSON_AGG(DISTINCT \"f\".\"fromorderno\") FILTER(WHERE COALESCE(\"f\".\"outqty\", 0) > 0 AND \"f\".\"fromorderno\" IS NOT NULL) AS TEXT) AS \"affected_order_ids\",\n  SUM(\"f\".\"need_qty_origin\") AS \"demand_qty\",\n  SUM(\"f\".\"outqty\") AS \"shortage_qty\",\n  SUM(\"f\".\"qtyshipped\") AS \"shipped_qty\",\n  COUNT(DISTINCT \"f\".\"fromorderno\") FILTER(WHERE\n    COALESCE(\"f\".\"outqty\", 0) > 0) AS \"affected_orders\"\nFROM \"agents_scm_order_fulfillment\" AS \"f\"\nLEFT JOIN \"catalog_warehouse_links\" AS \"c\"\n  ON \"c\".\"warehouseid\" = \"f\".\"warehouseid\"\nCROSS JOIN \"latest_order\" AS \"latest_order\"\nWHERE\n  \"f\".\"snapshot_date\" = \"latest_order\".\"value\"\n  AND DATE_TRUNC('MONTH', \"f\".\"fromorderno_month\") = CAST($2 AS DATE)\n  AND (\n    (\n      \"f\".\"pick_point_type2\" = '工厂'\n      AND \"f\".\"belong_base\" IN ('华东', '华南', '西南', '遂平', '郑州')\n    )\n    OR (\n      \"f\".\"pick_point_type2\" = '分仓' AND \"c\".\"pickup_code\" IS NOT NULL\n    )\n  )\n  AND (\n    \"f\".\"order_qty_origin\" > 0 OR \"f\".\"need_qty_origin\" > 0\n  )\n  AND \"f\".\"product_categ_name\" <> '饺鲜说'\n  AND (\n    (\n      \"f\".\"pick_point_type2\" = '工厂'\n      AND (\n        :scope_3 OR \"f\".\"belong_base\" IN (:list_3)\n      )\n    )\n    OR (\n      \"f\".\"pick_point_type2\" = '分仓'\n      AND (\n        :scope_8 OR \"c\".\"branch_pickup_point\" IN (:list_8)\n      )\n    )\n  )\n  AND (\n    CAST($4 AS TEXT) IS NULL OR \"f\".\"belong_base\" = $4\n  )\n  AND (\n    CAST($5 AS TEXT) IS NULL OR \"c\".\"branch_pickup_point\" = $5\n  )\n  AND (\n    CAST($6 AS TEXT) IS NULL OR \"f\".\"product_categ_name\" = $6\n  )\n  AND (\n    CAST($7 AS TEXT) IS NULL OR \"f\".\"new_material_code\" = $7\n  )\nGROUP BY\n  \"f\".\"snapshot_date\",\n  \"f\".\"fromorderno_month\",\n  CASE WHEN \"f\".\"pick_point_type2\" = '工厂' THEN 'factory' ELSE 'branch' END,\n  CASE\n    WHEN \"f\".\"pick_point_type2\" = '工厂'\n    THEN \"f\".\"belong_base\"\n    ELSE \"c\".\"branch_pickup_point\"\n  END,\n  \"f\".\"product_categ_name\",\n  \"f\".\"new_material_code\"\nORDER BY\n  \"snapshot_date\",\n  \"pickup_type\",\n  \"f\".\"snapshot_date\",\n  \"f\".\"fromorderno_month\",\n  CASE WHEN \"f\".\"pick_point_type2\" = '工厂' THEN 'factory' ELSE 'branch' END,\n  CASE\n    WHEN \"f\".\"pick_point_type2\" = '工厂'\n    THEN \"f\".\"belong_base\"\n    ELSE \"c\".\"branch_pickup_point\"\n  END,\n  \"f\".\"product_categ_name\",\n  \"f\".\"new_material_code\"`;\n\n// A second fixed query: seven-day orders cross month boundaries, unlike monthly fulfillment.\nconst ORDER_7D_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    \"p\".\"source_branch_key\" AS \"source_branch_key\",\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"id\" AS \"id\",\n    \"i\".\"source_record_id\" AS \"source_record_id\",\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"warehouseid\" AS \"warehouseid\",\n    \"i\".\"warehouse_name\" AS \"warehouse_name\",\n    \"i\".\"self_pickup_point\" AS \"self_pickup_point\",\n    \"i\".\"pickup_point\" AS \"pickup_point\",\n    \"i\".\"base_name\" AS \"base_name\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"material_name\" AS \"material_name\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"prod_date\" AS \"prod_date\",\n    \"i\".\"live_qty\" AS \"live_qty\",\n    \"i\".\"available_qty\" AS \"available_qty\",\n    \"i\".\"warehouse_classify\" AS \"warehouse_classify\",\n    \"i\".\"created_time\" AS \"created_time\",\n    \"i\".\"updated_time\" AS \"updated_time\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n), \"latest_order\" AS (\n  SELECT\n    MAX(\"agents_scm_order_fulfillment\".\"snapshot_date\") AS \"value\"\n  FROM \"agents_scm_order_fulfillment\" AS \"agents_scm_order_fulfillment\"\n  WHERE\n    \"agents_scm_order_fulfillment\".\"snapshot_date\" <= CAST($1 AS DATE)\n)\nSELECT\n  \"f\".\"snapshot_date\" AS \"snapshot_date\",\n  TO_CHAR(\"f\".\"fromorderno_month\", 'YYYY-MM') AS \"month\",\n  CASE WHEN \"f\".\"pick_point_type2\" = '工厂' THEN 'factory' ELSE 'branch' END AS \"pickup_type\",\n  CASE\n    WHEN \"f\".\"pick_point_type2\" = '工厂'\n    THEN \"f\".\"belong_base\"\n    ELSE \"c\".\"branch_pickup_point\"\n  END AS \"object_name\",\n  COALESCE(\"f\".\"product_categ_name\", '未分类') AS \"category\",\n  \"f\".\"new_material_code\" AS \"sku\",\n  CASE\n    WHEN BOOL_AND(\"f\".\"order_qty_origin\" IS NOT NULL)\n    THEN SUM(\"f\".\"order_qty_origin\")\n  END AS \"order_qty\",\n  CAST(JSON_AGG(DISTINCT \"f\".\"fromorderno\") FILTER(WHERE \"f\".\"fromorderno\" IS NOT NULL) AS TEXT) AS \"order_ids\",\n  CAST(JSON_AGG(DISTINCT \"f\".\"fromorderno\") FILTER(WHERE COALESCE(\"f\".\"outqty\", 0) > 0 AND \"f\".\"fromorderno\" IS NOT NULL) AS TEXT) AS \"affected_order_ids\",\n  SUM(\"f\".\"need_qty_origin\") AS \"demand_qty\",\n  SUM(\"f\".\"outqty\") AS \"shortage_qty\",\n  SUM(\"f\".\"qtyshipped\") AS \"shipped_qty\",\n  COUNT(DISTINCT \"f\".\"fromorderno\") FILTER(WHERE\n    COALESCE(\"f\".\"outqty\", 0) > 0) AS \"affected_orders\"\nFROM \"agents_scm_order_fulfillment\" AS \"f\"\nLEFT JOIN \"catalog_warehouse_links\" AS \"c\"\n  ON \"c\".\"warehouseid\" = \"f\".\"warehouseid\"\nCROSS JOIN \"latest_order\" AS \"latest_order\"\nWHERE\n  \"f\".\"snapshot_date\" = \"latest_order\".\"value\"\n  AND \"f\".\"header_addtime\" >= LEAST(\n    CAST($1 AS DATE),\n    CAST((\n      CAST($2 AS DATE) + INTERVAL '1 month - 1 day'\n    ) AS DATE)\n  ) - INTERVAL '6 DAYS'\n  AND \"f\".\"header_addtime\" < LEAST(\n    CAST($1 AS DATE),\n    CAST((\n      CAST($2 AS DATE) + INTERVAL '1 month - 1 day'\n    ) AS DATE)\n  ) + INTERVAL '1 DAY'\n  AND (\n    (\n      \"f\".\"pick_point_type2\" = '工厂'\n      AND \"f\".\"belong_base\" IN ('华东', '华南', '西南', '遂平', '郑州')\n    )\n    OR (\n      \"f\".\"pick_point_type2\" = '分仓' AND \"c\".\"pickup_code\" IS NOT NULL\n    )\n  )\n  AND (\n    \"f\".\"order_qty_origin\" > 0 OR \"f\".\"need_qty_origin\" > 0\n  )\n  AND \"f\".\"product_categ_name\" <> '饺鲜说'\n  AND (\n    (\n      \"f\".\"pick_point_type2\" = '工厂'\n      AND (\n        :scope_3 OR \"f\".\"belong_base\" IN (:list_3)\n      )\n    )\n    OR (\n      \"f\".\"pick_point_type2\" = '分仓'\n      AND (\n        :scope_8 OR \"c\".\"branch_pickup_point\" IN (:list_8)\n      )\n    )\n  )\n  AND (\n    CAST($4 AS TEXT) IS NULL OR \"f\".\"belong_base\" = $4\n  )\n  AND (\n    CAST($5 AS TEXT) IS NULL OR \"c\".\"branch_pickup_point\" = $5\n  )\n  AND (\n    CAST($6 AS TEXT) IS NULL OR \"f\".\"product_categ_name\" = $6\n  )\n  AND (\n    CAST($7 AS TEXT) IS NULL OR \"f\".\"new_material_code\" = $7\n  )\nGROUP BY\n  \"f\".\"snapshot_date\",\n  \"f\".\"fromorderno_month\",\n  CASE WHEN \"f\".\"pick_point_type2\" = '工厂' THEN 'factory' ELSE 'branch' END,\n  CASE\n    WHEN \"f\".\"pick_point_type2\" = '工厂'\n    THEN \"f\".\"belong_base\"\n    ELSE \"c\".\"branch_pickup_point\"\n  END,\n  \"f\".\"product_categ_name\",\n  \"f\".\"new_material_code\"\nORDER BY\n  \"snapshot_date\",\n  \"pickup_type\",\n  \"f\".\"snapshot_date\",\n  \"f\".\"fromorderno_month\",\n  CASE WHEN \"f\".\"pick_point_type2\" = '工厂' THEN 'factory' ELSE 'branch' END,\n  CASE\n    WHEN \"f\".\"pick_point_type2\" = '工厂'\n    THEN \"f\".\"belong_base\"\n    ELSE \"c\".\"branch_pickup_point\"\n  END,\n  \"f\".\"product_categ_name\",\n  \"f\".\"new_material_code\"`;\n\nconst PENDING_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    \"p\".\"source_branch_key\" AS \"source_branch_key\",\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"available_qty\" AS \"available_qty\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n), \"latest_pending\" AS (\n  SELECT\n    MAX(\"agents_scm_branch_pending_order\".\"source_snapshot_time\") AS \"value\"\n  FROM \"agents_scm_branch_pending_order\" AS \"agents_scm_branch_pending_order\"\n  WHERE\n    CAST(\"agents_scm_branch_pending_order\".\"source_snapshot_time\" AS DATE) <= CAST($1 AS DATE)\n)\nSELECT\n  CAST(\"p\".\"source_snapshot_time\" AS DATE) AS \"snapshot_date\",\n  \"c\".\"branch_pickup_point\" AS \"branch\",\n  \"p\".\"material_code\" AS \"sku\",\n  CASE\n    WHEN COUNT(*) FILTER(WHERE\n      \"p\".\"order_stage\" IS NULL\n      OR (\n        \"p\".\"order_stage\" = 'PREPARING'\n        AND (\n          \"p\".\"order_qty\" IS NULL\n          OR \"p\".\"allocated_qty\" IS NULL\n          OR \"p\".\"allocated_qty\" < 0\n          OR \"p\".\"order_qty\" < \"p\".\"allocated_qty\"\n        )\n      )) > 0\n    OR MAX(\"i\".\"available_qty\") IS NULL\n    THEN NULL\n    ELSE GREATEST(\n      0,\n      SUM(\n        CASE\n          WHEN \"p\".\"order_stage\" = 'PREPARING'\n          THEN \"p\".\"order_qty\" - \"p\".\"allocated_qty\"\n          ELSE 0\n        END\n      ) - MAX(\"i\".\"available_qty\")\n    )\n  END AS \"shortage_qty\",\n  SUM(\n    CASE\n      WHEN \"p\".\"order_stage\" = 'PREPARED_UNSHIPPED'\n      THEN \"p\".\"allocated_qty\"\n      ELSE \"p\".\"order_qty\"\n    END\n  ) AS \"demand_qty\",\n  SUM(\"p\".\"allocated_qty\") AS \"allocated_qty\",\n  SUM(\n    CASE\n      WHEN \"p\".\"order_stage\" = 'PREPARED_UNSHIPPED'\n      THEN \"p\".\"allocated_qty\"\n      ELSE 0\n    END\n  ) AS \"prepared_qty\",\n  COUNT(*) FILTER(WHERE\n    \"p\".\"order_stage\" IS NULL) AS \"legacy_count\"\nFROM \"agents_scm_branch_pending_order\" AS \"p\"\nJOIN \"branch_catalog\" AS \"c\"\n  ON \"c\".\"pickup_code\" = TRIM(\"p\".\"pickup_point\")\nLEFT JOIN (\n  SELECT\n    \"mapped_branch_inventory\".\"branch_pickup_point\" AS \"branch_pickup_point\",\n    \"mapped_branch_inventory\".\"material_code\" AS \"material_code\",\n    MAX(\"mapped_branch_inventory\".\"product_categ_name\") AS \"category\",\n    CASE\n      WHEN BOOL_AND(\"mapped_branch_inventory\".\"available_qty\" IS NOT NULL)\n      THEN SUM(\"mapped_branch_inventory\".\"available_qty\")\n    END AS \"available_qty\"\n  FROM \"mapped_branch_inventory\" AS \"mapped_branch_inventory\"\n  WHERE\n    \"mapped_branch_inventory\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n  GROUP BY\n    \"mapped_branch_inventory\".\"branch_pickup_point\",\n    \"mapped_branch_inventory\".\"material_code\"\n) AS \"i\"\n  ON \"i\".\"branch_pickup_point\" = \"c\".\"branch_pickup_point\"\n  AND \"i\".\"material_code\" = \"p\".\"material_code\"\nCROSS JOIN \"latest_pending\" AS \"latest_pending\"\nWHERE\n  \"p\".\"source_snapshot_time\" = \"latest_pending\".\"value\"\n  AND (\n    \"p\".\"order_stage\" IN ('PREPARING', 'PREPARED_UNSHIPPED')\n    OR \"p\".\"order_stage\" IS NULL\n  )\n  AND (\n    :scope_2 OR \"c\".\"branch_pickup_point\" IN (:list_2)\n  )\n  AND (\n    CAST($3 AS TEXT) IS NULL OR \"c\".\"branch_pickup_point\" = $3\n  )\n  AND (\n    CAST($4 AS TEXT) IS NULL OR \"p\".\"material_code\" = $4\n  )\n  AND (\n    CAST($5 AS TEXT) IS NULL OR \"i\".\"category\" = $5\n  )\nGROUP BY\n  CAST(\"p\".\"source_snapshot_time\" AS DATE),\n  \"c\".\"branch_pickup_point\",\n  \"p\".\"material_code\"\nORDER BY\n  CAST(\"p\".\"source_snapshot_time\" AS DATE),\n  \"c\".\"branch_pickup_point\",\n  \"p\".\"material_code\"`;\n\nconst ACTIVE_CUSTOMERS_SQL = `WITH \"latest_order\" AS (\n  SELECT\n    MAX(\"agents_scm_order_fulfillment\".\"snapshot_date\") AS \"value\"\n  FROM \"agents_scm_order_fulfillment\" AS \"agents_scm_order_fulfillment\"\n  WHERE\n    \"agents_scm_order_fulfillment\".\"snapshot_date\" <= CAST($1 AS DATE)\n)\nSELECT DISTINCT\n  \"agents_scm_order_fulfillment\".\"cust_code\" AS \"cust_code\"\nFROM \"agents_scm_order_fulfillment\" AS \"agents_scm_order_fulfillment\"\nCROSS JOIN \"latest_order\" AS \"latest_order\"\nWHERE\n  \"agents_scm_order_fulfillment\".\"snapshot_date\" = \"latest_order\".\"value\"\n  AND \"agents_scm_order_fulfillment\".\"cust_code\" IS NOT NULL\n  AND \"agents_scm_order_fulfillment\".\"cust_code\" <> ''\n  AND COALESCE(\"agents_scm_order_fulfillment\".\"need_qty_origin\", 0) > 0\n  AND COALESCE(\n    \"agents_scm_order_fulfillment\".\"header_addtime\",\n    \"agents_scm_order_fulfillment\".\"fromorderno_month\"\n  ) >= CAST($1 AS DATE) - INTERVAL '29 DAYS'\n  AND COALESCE(\n    \"agents_scm_order_fulfillment\".\"header_addtime\",\n    \"agents_scm_order_fulfillment\".\"fromorderno_month\"\n  ) < CAST($1 AS DATE) + INTERVAL '1 DAY'\n  AND (\n    :scope_2 OR \"agents_scm_order_fulfillment\".\"cust_code\" IN (:list_2)\n  )\nORDER BY\n  \"cust_code\"`;\n\n// Each historical point uses that day's last published snapshot and the same\n// whole-month version choice as the safety-stock workbench.\n\n\nconst TREND_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    \"p\".\"source_branch_key\" AS \"source_branch_key\",\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"available_qty\" AS \"available_qty\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n), \"base_snapshots\" AS (\n  SELECT\n    CAST(\"agents_scm_safety_stock\".\"inventory_snapshot_time\" AS DATE) AS \"snapshot_date\",\n    MAX(\"agents_scm_safety_stock\".\"inventory_snapshot_time\") AS \"snapshot_time\"\n  FROM \"agents_scm_safety_stock\" AS \"agents_scm_safety_stock\"\n  WHERE\n    CAST(\"agents_scm_safety_stock\".\"inventory_snapshot_time\" AS DATE) BETWEEN CAST($1 AS DATE) - INTERVAL '29 DAYS' AND CAST($1 AS DATE)\n  GROUP BY\n    CAST(\"agents_scm_safety_stock\".\"inventory_snapshot_time\" AS DATE)\n), \"base_history\" AS (\n  SELECT\n    \"s\".\"id\" AS \"id\",\n    \"s\".\"base_name\" AS \"base_name\",\n    \"s\".\"target_month\" AS \"target_month\",\n    \"s\".\"material_code\" AS \"material_code\",\n    \"s\".\"product_categ_name\" AS \"product_categ_name\",\n    \"s\".\"current_inventory\" AS \"current_inventory\",\n    \"d\".\"snapshot_date\" AS \"snapshot_date\",\n    CASE\n      WHEN \"s\".\"inventory_version\" LIKE '%纠偏%'\n      THEN 1\n      WHEN \"s\".\"inventory_version\" LIKE '%月初%'\n      THEN 2\n      WHEN \"s\".\"inventory_version\" LIKE '%滚动%'\n      THEN 3\n      ELSE 4\n    END AS \"priority\"\n  FROM \"agents_scm_safety_stock\" AS \"s\"\n  JOIN \"base_snapshots\" AS \"d\"\n    ON \"s\".\"inventory_snapshot_time\" = \"d\".\"snapshot_time\"\n  WHERE\n    \"s\".\"base_name\" IN ('华东', '华南', '西南', '遂平', '郑州')\n), \"base_months\" AS (\n  SELECT\n    \"base_history\".\"snapshot_date\" AS \"snapshot_date\",\n    CASE\n      WHEN EXTRACT(DAY FROM \"base_history\".\"snapshot_date\") >= 21\n      AND BOOL_OR(\n        \"base_history\".\"target_month\" = CAST((\n          DATE_TRUNC('MONTH', \"base_history\".\"snapshot_date\") + INTERVAL '1 MONTH'\n        ) AS DATE)\n      )\n      THEN CAST((\n        DATE_TRUNC('MONTH', \"base_history\".\"snapshot_date\") + INTERVAL '1 MONTH'\n      ) AS DATE)\n      ELSE CAST(DATE_TRUNC('MONTH', \"base_history\".\"snapshot_date\") AS DATE)\n    END AS \"target_month\"\n  FROM \"base_history\" AS \"base_history\"\n  GROUP BY\n    \"base_history\".\"snapshot_date\"\n), \"base_versions\" AS (\n  SELECT\n    \"h\".\"snapshot_date\" AS \"snapshot_date\",\n    MIN(\"h\".\"priority\") AS \"priority\"\n  FROM \"base_history\" AS \"h\"\n  JOIN \"base_months\" AS \"m\"\n    ON \"h\".\"snapshot_date\" = \"m\".\"snapshot_date\"\n    AND \"h\".\"target_month\" = \"m\".\"target_month\"\n  WHERE\n    \"h\".\"priority\" < 4\n  GROUP BY\n    \"h\".\"snapshot_date\"\n), \"base_candidates\" AS (\n  SELECT\n    \"h\".\"id\" AS \"id\",\n    \"h\".\"snapshot_date\" AS \"snapshot_date\",\n    \"h\".\"base_name\" AS \"base_name\",\n    \"h\".\"material_code\" AS \"material_code\",\n    \"h\".\"current_inventory\" AS \"current_inventory\",\n    \"h\".\"priority\" AS \"priority\"\n  FROM \"base_history\" AS \"h\"\n  JOIN \"base_months\" AS \"m\"\n    ON \"h\".\"snapshot_date\" = \"m\".\"snapshot_date\"\n    AND \"h\".\"target_month\" = \"m\".\"target_month\"\n  JOIN \"base_versions\" AS \"v\"\n    ON \"h\".\"snapshot_date\" = \"v\".\"snapshot_date\"\n  WHERE\n    (\n      \"h\".\"priority\" = \"v\".\"priority\"\n      OR (\n        \"v\".\"priority\" = 1 AND \"h\".\"priority\" = 2\n      )\n    )\n    AND (\n      :scope_2 OR \"h\".\"base_name\" IN (:list_2)\n    )\n    AND (\n      CAST($5 AS TEXT) IS NULL OR \"h\".\"base_name\" = $5\n    )\n    AND (\n      CAST($7 AS TEXT) IS NULL OR \"h\".\"product_categ_name\" = $7\n    )\n    AND (\n      CAST($8 AS TEXT) IS NULL OR CAST(\"h\".\"material_code\" AS TEXT) = $8\n    )\n), \"base_chosen_ids\" AS (\n  SELECT\n    COALESCE(\n      MAX(\"base_candidates\".\"id\") FILTER(WHERE\n        \"base_candidates\".\"priority\" = 1),\n      MAX(\"base_candidates\".\"id\") FILTER(WHERE\n        \"base_candidates\".\"priority\" = 2),\n      MAX(\"base_candidates\".\"id\") FILTER(WHERE\n        \"base_candidates\".\"priority\" = 3)\n    ) AS \"id\"\n  FROM \"base_candidates\" AS \"base_candidates\"\n  GROUP BY\n    \"base_candidates\".\"snapshot_date\",\n    \"base_candidates\".\"base_name\",\n    \"base_candidates\".\"material_code\"\n), \"base_ranked\" AS (\n  SELECT\n    \"h\".\"snapshot_date\" AS \"snapshot_date\",\n    \"h\".\"current_inventory\" AS \"current_inventory\",\n    1 AS \"rn\"\n  FROM \"base_candidates\" AS \"h\"\n  INNER JOIN \"base_chosen_ids\" AS \"c\"\n    ON \"c\".\"id\" = \"h\".\"id\"\n), \"branch\" AS (\n  SELECT\n    \"mapped_branch_inventory\".\"snapshot_date\" AS \"snapshot_date\",\n    CASE\n      WHEN BOOL_AND(\"mapped_branch_inventory\".\"available_qty\" IS NOT NULL)\n      THEN SUM(\"mapped_branch_inventory\".\"available_qty\")\n    END AS \"qty\"\n  FROM \"mapped_branch_inventory\" AS \"mapped_branch_inventory\"\n  WHERE\n    \"mapped_branch_inventory\".\"snapshot_date\" BETWEEN CAST($1 AS DATE) - INTERVAL '29 DAYS' AND CAST($1 AS DATE)\n    AND (\n      :scope_3 OR \"mapped_branch_inventory\".\"branch_pickup_point\" IN (:list_3)\n    )\n    AND (\n      CAST($6 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"branch_pickup_point\" = $6\n    )\n    AND (\n      CAST($7 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"product_categ_name\" = $7\n    )\n    AND (\n      CAST($8 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"material_code\" = $8\n    )\n  GROUP BY\n    \"mapped_branch_inventory\".\"snapshot_date\"\n), \"customer\" AS (\n  SELECT\n    \"agents_scm_cust_inventory_daily\".\"stat_date\" AS \"snapshot_date\",\n    SUM(\"agents_scm_cust_inventory_daily\".\"stock_qty\") AS \"qty\"\n  FROM \"agents_scm_cust_inventory_daily\" AS \"agents_scm_cust_inventory_daily\"\n  WHERE\n    \"agents_scm_cust_inventory_daily\".\"stat_date\" BETWEEN CAST($1 AS DATE) - INTERVAL '29 DAYS' AND CAST($1 AS DATE)\n    AND (\n      :scope_4 OR \"agents_scm_cust_inventory_daily\".\"cust_code\" IN (:list_4)\n    )\n    AND (\n      CAST($9 AS TEXT) IS NULL OR \"agents_scm_cust_inventory_daily\".\"cust_code\" = $9\n    )\n    AND (\n      CAST($7 AS TEXT) IS NULL\n      OR \"agents_scm_cust_inventory_daily\".\"product_range_name\" = $7\n    )\n    AND (\n      CAST($8 AS TEXT) IS NULL\n      OR \"agents_scm_cust_inventory_daily\".\"material_code\" = $8\n    )\n  GROUP BY\n    \"agents_scm_cust_inventory_daily\".\"stat_date\"\n)\nSELECT\n  \"combined\".\"snapshot_date\" AS \"snapshot_date\",\n  \"combined\".\"layer\" AS \"layer\",\n  \"combined\".\"qty\" AS \"qty\"\nFROM (\n  SELECT\n    \"base_ranked\".\"snapshot_date\" AS \"snapshot_date\",\n    'base' AS \"layer\",\n    SUM(\"base_ranked\".\"current_inventory\") AS \"qty\"\n  FROM \"base_ranked\" AS \"base_ranked\"\n  WHERE\n    \"base_ranked\".\"rn\" = 1\n  GROUP BY\n    \"base_ranked\".\"snapshot_date\"\n  UNION ALL\n  SELECT\n    \"branch\".\"snapshot_date\" AS \"snapshot_date\",\n    'branch' AS \"branch\",\n    \"branch\".\"qty\" AS \"qty\"\n  FROM \"branch\" AS \"branch\"\n  UNION ALL\n  SELECT\n    \"customer\".\"snapshot_date\" AS \"snapshot_date\",\n    'customer' AS \"customer\",\n    \"customer\".\"qty\" AS \"qty\"\n  FROM \"customer\" AS \"customer\"\n) AS combined\nORDER BY\n  \"snapshot_date\",\n  \"layer\",\n  \"qty\"`;\n\nconst COMPANY_TREND_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    \"p\".\"source_branch_key\" AS \"source_branch_key\",\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"available_qty\" AS \"available_qty\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n), \"base_snapshots\" AS (\n  SELECT\n    CAST(\"agents_scm_safety_stock\".\"inventory_snapshot_time\" AS DATE) AS \"snapshot_date\",\n    MAX(\"agents_scm_safety_stock\".\"inventory_snapshot_time\") AS \"snapshot_time\"\n  FROM \"agents_scm_safety_stock\" AS \"agents_scm_safety_stock\"\n  WHERE\n    CAST(\"agents_scm_safety_stock\".\"inventory_snapshot_time\" AS DATE) BETWEEN CAST($1 AS DATE) - INTERVAL '29 DAYS' AND CAST($1 AS DATE)\n  GROUP BY\n    CAST(\"agents_scm_safety_stock\".\"inventory_snapshot_time\" AS DATE)\n), \"base_history\" AS (\n  SELECT\n    \"s\".\"id\" AS \"id\",\n    \"s\".\"base_name\" AS \"base_name\",\n    \"s\".\"target_month\" AS \"target_month\",\n    \"s\".\"material_code\" AS \"material_code\",\n    \"s\".\"product_categ_name\" AS \"product_categ_name\",\n    \"s\".\"current_inventory\" AS \"current_inventory\",\n    \"d\".\"snapshot_date\" AS \"snapshot_date\",\n    CASE\n      WHEN \"s\".\"inventory_version\" LIKE '%纠偏%'\n      THEN 1\n      WHEN \"s\".\"inventory_version\" LIKE '%月初%'\n      THEN 2\n      WHEN \"s\".\"inventory_version\" LIKE '%滚动%'\n      THEN 3\n      ELSE 4\n    END AS \"priority\"\n  FROM \"agents_scm_safety_stock\" AS \"s\"\n  JOIN \"base_snapshots\" AS \"d\"\n    ON \"s\".\"inventory_snapshot_time\" = \"d\".\"snapshot_time\"\n  WHERE\n    \"s\".\"base_name\" IN ('华东', '华南', '西南', '遂平', '郑州')\n), \"base_months\" AS (\n  SELECT\n    \"base_history\".\"snapshot_date\" AS \"snapshot_date\",\n    CASE\n      WHEN EXTRACT(DAY FROM \"base_history\".\"snapshot_date\") >= 21\n      AND BOOL_OR(\n        \"base_history\".\"target_month\" = CAST((\n          DATE_TRUNC('MONTH', \"base_history\".\"snapshot_date\") + INTERVAL '1 MONTH'\n        ) AS DATE)\n      )\n      THEN CAST((\n        DATE_TRUNC('MONTH', \"base_history\".\"snapshot_date\") + INTERVAL '1 MONTH'\n      ) AS DATE)\n      ELSE CAST(DATE_TRUNC('MONTH', \"base_history\".\"snapshot_date\") AS DATE)\n    END AS \"target_month\"\n  FROM \"base_history\" AS \"base_history\"\n  GROUP BY\n    \"base_history\".\"snapshot_date\"\n), \"base_versions\" AS (\n  SELECT\n    \"h\".\"snapshot_date\" AS \"snapshot_date\",\n    MIN(\"h\".\"priority\") AS \"priority\"\n  FROM \"base_history\" AS \"h\"\n  JOIN \"base_months\" AS \"m\"\n    ON \"h\".\"snapshot_date\" = \"m\".\"snapshot_date\"\n    AND \"h\".\"target_month\" = \"m\".\"target_month\"\n  WHERE\n    \"h\".\"priority\" < 4\n  GROUP BY\n    \"h\".\"snapshot_date\"\n), \"base_candidates\" AS (\n  SELECT\n    \"h\".\"id\" AS \"id\",\n    \"h\".\"snapshot_date\" AS \"snapshot_date\",\n    \"h\".\"base_name\" AS \"base_name\",\n    \"h\".\"material_code\" AS \"material_code\",\n    \"h\".\"current_inventory\" AS \"current_inventory\",\n    \"h\".\"priority\" AS \"priority\"\n  FROM \"base_history\" AS \"h\"\n  JOIN \"base_months\" AS \"m\"\n    ON \"h\".\"snapshot_date\" = \"m\".\"snapshot_date\"\n    AND \"h\".\"target_month\" = \"m\".\"target_month\"\n  JOIN \"base_versions\" AS \"v\"\n    ON \"h\".\"snapshot_date\" = \"v\".\"snapshot_date\"\n  WHERE\n    (\n      \"h\".\"priority\" = \"v\".\"priority\"\n      OR (\n        \"v\".\"priority\" = 1 AND \"h\".\"priority\" = 2\n      )\n    )\n    AND (\n      :scope_2 OR \"h\".\"base_name\" IN (:list_2)\n    )\n    AND (\n      CAST($4 AS TEXT) IS NULL OR \"h\".\"base_name\" = $4\n    )\n    AND (\n      CAST($6 AS TEXT) IS NULL OR \"h\".\"product_categ_name\" = $6\n    )\n    AND (\n      CAST($7 AS TEXT) IS NULL OR CAST(\"h\".\"material_code\" AS TEXT) = $7\n    )\n), \"base_chosen_ids\" AS (\n  SELECT\n    COALESCE(\n      MAX(\"base_candidates\".\"id\") FILTER(WHERE\n        \"base_candidates\".\"priority\" = 1),\n      MAX(\"base_candidates\".\"id\") FILTER(WHERE\n        \"base_candidates\".\"priority\" = 2),\n      MAX(\"base_candidates\".\"id\") FILTER(WHERE\n        \"base_candidates\".\"priority\" = 3)\n    ) AS \"id\"\n  FROM \"base_candidates\" AS \"base_candidates\"\n  GROUP BY\n    \"base_candidates\".\"snapshot_date\",\n    \"base_candidates\".\"base_name\",\n    \"base_candidates\".\"material_code\"\n), \"base_ranked\" AS (\n  SELECT\n    \"h\".\"snapshot_date\" AS \"snapshot_date\",\n    \"h\".\"current_inventory\" AS \"current_inventory\",\n    1 AS \"rn\"\n  FROM \"base_candidates\" AS \"h\"\n  INNER JOIN \"base_chosen_ids\" AS \"c\"\n    ON \"c\".\"id\" = \"h\".\"id\"\n), \"branch\" AS (\n  SELECT\n    \"mapped_branch_inventory\".\"snapshot_date\" AS \"snapshot_date\",\n    CASE\n      WHEN BOOL_AND(\"mapped_branch_inventory\".\"available_qty\" IS NOT NULL)\n      THEN SUM(\"mapped_branch_inventory\".\"available_qty\")\n    END AS \"qty\"\n  FROM \"mapped_branch_inventory\" AS \"mapped_branch_inventory\"\n  WHERE\n    \"mapped_branch_inventory\".\"snapshot_date\" BETWEEN CAST($1 AS DATE) - INTERVAL '29 DAYS' AND CAST($1 AS DATE)\n    AND (\n      :scope_3 OR \"mapped_branch_inventory\".\"branch_pickup_point\" IN (:list_3)\n    )\n    AND (\n      CAST($5 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"branch_pickup_point\" = $5\n    )\n    AND (\n      CAST($6 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"product_categ_name\" = $6\n    )\n    AND (\n      CAST($7 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"material_code\" = $7\n    )\n  GROUP BY\n    \"mapped_branch_inventory\".\"snapshot_date\"\n)\nSELECT\n  \"combined\".\"snapshot_date\" AS \"snapshot_date\",\n  \"combined\".\"layer\" AS \"layer\",\n  \"combined\".\"qty\" AS \"qty\"\nFROM (\n  SELECT\n    \"base_ranked\".\"snapshot_date\" AS \"snapshot_date\",\n    'base' AS \"layer\",\n    SUM(\"base_ranked\".\"current_inventory\") AS \"qty\"\n  FROM \"base_ranked\" AS \"base_ranked\"\n  WHERE\n    \"base_ranked\".\"rn\" = 1\n  GROUP BY\n    \"base_ranked\".\"snapshot_date\"\n  UNION ALL\n  SELECT\n    \"branch\".\"snapshot_date\" AS \"snapshot_date\",\n    'branch' AS \"branch\",\n    \"branch\".\"qty\" AS \"qty\"\n  FROM \"branch\" AS \"branch\"\n) AS combined\nORDER BY\n  \"snapshot_date\",\n  \"layer\",\n  \"qty\"`;\n\nconst ORDER_TREND_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    \"p\".\"source_branch_key\" AS \"source_branch_key\",\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"id\" AS \"id\",\n    \"i\".\"source_record_id\" AS \"source_record_id\",\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"warehouseid\" AS \"warehouseid\",\n    \"i\".\"warehouse_name\" AS \"warehouse_name\",\n    \"i\".\"self_pickup_point\" AS \"self_pickup_point\",\n    \"i\".\"pickup_point\" AS \"pickup_point\",\n    \"i\".\"base_name\" AS \"base_name\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"material_name\" AS \"material_name\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"prod_date\" AS \"prod_date\",\n    \"i\".\"live_qty\" AS \"live_qty\",\n    \"i\".\"available_qty\" AS \"available_qty\",\n    \"i\".\"warehouse_classify\" AS \"warehouse_classify\",\n    \"i\".\"created_time\" AS \"created_time\",\n    \"i\".\"updated_time\" AS \"updated_time\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n)\nSELECT\n  \"f\".\"snapshot_date\" AS \"snapshot_date\",\n  TO_CHAR(\"f\".\"fromorderno_month\", 'YYYY-MM') AS \"month\",\n  CASE WHEN \"f\".\"pick_point_type2\" = '工厂' THEN 'factory' ELSE 'branch' END AS \"pickup_type\",\n  CASE\n    WHEN BOOL_AND(\"f\".\"order_qty_origin\" IS NOT NULL)\n    THEN SUM(\"f\".\"order_qty_origin\")\n  END AS \"order_qty\",\n  SUM(\"f\".\"need_qty_origin\") AS \"demand_qty\",\n  SUM(\"f\".\"outqty\") AS \"shortage_qty\",\n  SUM(\"f\".\"qtyshipped\") AS \"shipped_qty\",\n  COUNT(DISTINCT \"f\".\"fromorderno\") FILTER(WHERE\n    COALESCE(\"f\".\"outqty\", 0) > 0) AS \"affected_orders\"\nFROM \"agents_scm_order_fulfillment\" AS \"f\"\nLEFT JOIN \"catalog_warehouse_links\" AS \"c\"\n  ON \"c\".\"warehouseid\" = \"f\".\"warehouseid\"\nWHERE\n  \"f\".\"snapshot_date\" BETWEEN CAST($1 AS DATE) - INTERVAL '29 DAYS' AND CAST($1 AS DATE)\n  AND DATE_TRUNC('MONTH', \"f\".\"fromorderno_month\") = CAST($2 AS DATE)\n  AND (\n    (\n      \"f\".\"pick_point_type2\" = '工厂'\n      AND \"f\".\"belong_base\" IN ('华东', '华南', '西南', '遂平', '郑州')\n    )\n    OR (\n      \"f\".\"pick_point_type2\" = '分仓' AND \"c\".\"pickup_code\" IS NOT NULL\n    )\n  )\n  AND (\n    \"f\".\"order_qty_origin\" > 0 OR \"f\".\"need_qty_origin\" > 0\n  )\n  AND \"f\".\"product_categ_name\" <> '饺鲜说'\n  AND (\n    (\n      \"f\".\"pick_point_type2\" = '工厂'\n      AND (\n        :scope_3 OR \"f\".\"belong_base\" IN (:list_3)\n      )\n    )\n    OR (\n      \"f\".\"pick_point_type2\" = '分仓'\n      AND (\n        :scope_8 OR \"c\".\"branch_pickup_point\" IN (:list_8)\n      )\n    )\n  )\n  AND (\n    CAST($4 AS TEXT) IS NULL OR \"f\".\"belong_base\" = $4\n  )\n  AND (\n    CAST($5 AS TEXT) IS NULL OR \"c\".\"branch_pickup_point\" = $5\n  )\n  AND (\n    CAST($6 AS TEXT) IS NULL OR \"f\".\"product_categ_name\" = $6\n  )\n  AND (\n    CAST($7 AS TEXT) IS NULL OR \"f\".\"new_material_code\" = $7\n  )\nGROUP BY\n  \"f\".\"snapshot_date\",\n  \"f\".\"fromorderno_month\",\n  CASE WHEN \"f\".\"pick_point_type2\" = '工厂' THEN 'factory' ELSE 'branch' END\nORDER BY\n  \"snapshot_date\",\n  \"pickup_type\",\n  \"f\".\"snapshot_date\",\n  \"f\".\"fromorderno_month\",\n  CASE WHEN \"f\".\"pick_point_type2\" = '工厂' THEN 'factory' ELSE 'branch' END`;\n\nconst AGING_TREND_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    \"p\".\"source_branch_key\" AS \"source_branch_key\",\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"prod_date\" AS \"prod_date\",\n    \"i\".\"live_qty\" AS \"live_qty\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n), \"aged\" AS (\n  SELECT\n    \"agents_scm_inventory_age\".\"snapshot_date\" AS \"snapshot_date\",\n    CAST('base' AS TEXT) AS \"layer\",\n    \"agents_scm_inventory_age\".\"qty\" AS \"qty\",\n    CAST(\"agents_scm_inventory_age\".\"productage\" AS DECIMAL) AS \"age_days\"\n  FROM \"agents_scm_inventory_age\" AS \"agents_scm_inventory_age\"\n  WHERE\n    \"agents_scm_inventory_age\".\"snapshot_date\" BETWEEN CAST($1 AS DATE) - INTERVAL '29 DAYS' AND CAST($1 AS DATE)\n    AND \"agents_scm_inventory_age\".\"snapshot_time\" IN (\n      SELECT\n        MAX(\"a\".\"snapshot_time\") AS \"_col_0\"\n      FROM \"agents_scm_inventory_age\" AS \"a\"\n      WHERE\n        \"a\".\"snapshot_date\" BETWEEN CAST($1 AS DATE) - INTERVAL '29 DAYS' AND CAST($1 AS DATE)\n      GROUP BY\n        \"a\".\"snapshot_date\"\n    )\n    AND \"agents_scm_inventory_age\".\"base_name\" IN ('华东', '华南', '西南', '遂平', '郑州')\n    AND (\n      :scope_2 OR \"agents_scm_inventory_age\".\"base_name\" IN (:list_2)\n    )\n    AND (\n      CAST($4 AS TEXT) IS NULL OR \"agents_scm_inventory_age\".\"base_name\" = $4\n    )\n    AND (\n      CAST($6 AS TEXT) IS NULL OR \"agents_scm_inventory_age\".\"product_categ_name\" = $6\n    )\n    AND (\n      CAST($7 AS TEXT) IS NULL OR \"agents_scm_inventory_age\".\"material_code\" = $7\n    )\n  UNION ALL\n  SELECT\n    \"mapped_branch_inventory\".\"snapshot_date\" AS \"snapshot_date\",\n    CAST('branch' AS TEXT) AS \"layer\",\n    \"mapped_branch_inventory\".\"live_qty\" AS \"qty\",\n    CASE\n      WHEN \"mapped_branch_inventory\".\"prod_date\" IS NULL\n      THEN NULL\n      ELSE CAST(GREATEST(\n        0,\n        \"mapped_branch_inventory\".\"snapshot_date\" - \"mapped_branch_inventory\".\"prod_date\"\n      ) AS DECIMAL)\n    END AS \"age_days\"\n  FROM \"mapped_branch_inventory\" AS \"mapped_branch_inventory\"\n  WHERE\n    \"mapped_branch_inventory\".\"snapshot_date\" BETWEEN CAST($1 AS DATE) - INTERVAL '29 DAYS' AND CAST($1 AS DATE)\n    AND (\n      :scope_3 OR \"mapped_branch_inventory\".\"branch_pickup_point\" IN (:list_3)\n    )\n    AND (\n      CAST($5 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"branch_pickup_point\" = $5\n    )\n    AND (\n      CAST($6 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"product_categ_name\" = $6\n    )\n    AND (\n      CAST($7 AS TEXT) IS NULL OR \"mapped_branch_inventory\".\"material_code\" = $7\n    )\n)\nSELECT\n  \"aged\".\"snapshot_date\" AS \"snapshot_date\",\n  \"aged\".\"layer\" AS \"layer\",\n  CASE\n    WHEN BOOL_OR(\"aged\".\"qty\" > 0 AND \"aged\".\"age_days\" IS NULL)\n    OR COALESCE(\n      SUM(\"aged\".\"qty\") FILTER(WHERE\n        (\n          \"aged\".\"layer\" = 'base' OR \"aged\".\"qty\" >= 0\n        )),\n      0\n    ) <= 0\n    THEN NULL\n    ELSE ROUND(\n      SUM(\"aged\".\"qty\" * COALESCE(\"aged\".\"age_days\", 0)) FILTER(WHERE\n        (\n          \"aged\".\"layer\" = 'base' OR \"aged\".\"qty\" >= 0\n        )) / NULLIF(\n        SUM(\"aged\".\"qty\") FILTER(WHERE\n          (\n            \"aged\".\"layer\" = 'base' OR \"aged\".\"qty\" >= 0\n          )),\n        0\n      ),\n      1\n    )\n  END AS \"average_age\"\nFROM \"aged\" AS \"aged\"\nGROUP BY\n  \"aged\".\"snapshot_date\",\n  \"aged\".\"layer\"\nORDER BY\n  \"snapshot_date\",\n  \"layer\",\n  \"aged\".\"snapshot_date\",\n  \"aged\".\"layer\"`;\n\nconst BASE_CURRENT_ORDER_SQL = `WITH \"bases\" AS (\n  SELECT\n    '01' AS \"pickup_code\",\n    '郑州' AS \"base_name\"\n  UNION ALL\n  SELECT\n    '02' AS \"pickup_code\",\n    '华东' AS \"base_name\"\n  UNION ALL\n  SELECT\n    '03' AS \"pickup_code\",\n    '西南' AS \"base_name\"\n  UNION ALL\n  SELECT\n    '37' AS \"pickup_code\",\n    '遂平' AS \"base_name\"\n  UNION ALL\n  SELECT\n    '04' AS \"pickup_code\",\n    '华南' AS \"base_name\"\n), \"latest_pending\" AS (\n  SELECT\n    MAX(\"agents_scm_branch_pending_order\".\"source_snapshot_time\") AS \"value\"\n  FROM \"agents_scm_branch_pending_order\" AS \"agents_scm_branch_pending_order\"\n  WHERE\n    CAST(\"agents_scm_branch_pending_order\".\"source_snapshot_time\" AS DATE) <= CAST($1 AS DATE)\n), \"stock\" AS (\n  SELECT\n    \"agents_scm_inventory_age\".\"base_name\" AS \"base_name\",\n    TRIM(\"agents_scm_inventory_age\".\"material_code\") AS \"sku\",\n    MAX(\"agents_scm_inventory_age\".\"product_categ_name\") AS \"category\",\n    CASE\n      WHEN BOOL_AND(\"agents_scm_inventory_age\".\"qtylive\" IS NOT NULL)\n      THEN SUM(\"agents_scm_inventory_age\".\"qtylive\")\n    END AS \"available_qty\"\n  FROM \"agents_scm_inventory_age\" AS \"agents_scm_inventory_age\"\n  WHERE\n    \"agents_scm_inventory_age\".\"snapshot_time\" = (\n      SELECT\n        MAX(\"agents_scm_inventory_age\".\"snapshot_time\") AS \"_col_0\"\n      FROM \"agents_scm_inventory_age\" AS \"agents_scm_inventory_age\"\n      WHERE\n        CAST(\"agents_scm_inventory_age\".\"snapshot_time\" AS DATE) <= CAST($1 AS DATE)\n    )\n  GROUP BY\n    \"agents_scm_inventory_age\".\"base_name\",\n    TRIM(\"agents_scm_inventory_age\".\"material_code\")\n), \"orders\" AS (\n  SELECT\n    \"b\".\"base_name\" AS \"base_name\",\n    TRIM(\"p\".\"material_code\") AS \"sku\",\n    CASE WHEN BOOL_AND(\"p\".\"order_qty\" IS NOT NULL) THEN SUM(\"p\".\"order_qty\") END AS \"order_qty\",\n    CASE\n      WHEN BOOL_AND(\"p\".\"order_qty\" IS NOT NULL AND \"p\".\"allocated_qty\" IS NOT NULL) FILTER(WHERE\n        TRIM(\"p\".\"bizflowstatus\") <> 'OCP已下发')\n      THEN SUM(\"p\".\"order_qty\" - \"p\".\"allocated_qty\") FILTER(WHERE\n        TRIM(\"p\".\"bizflowstatus\") <> 'OCP已下发')\n      WHEN COUNT(*) FILTER(WHERE\n        TRIM(\"p\".\"bizflowstatus\") <> 'OCP已下发') = 0\n      THEN 0\n    END AS \"preparing_remaining\"\n  FROM \"agents_scm_branch_pending_order\" AS \"p\"\n  JOIN \"bases\" AS \"b\"\n    ON \"b\".\"pickup_code\" = TRIM(\"p\".\"pickup_point\")\n  CROSS JOIN \"latest_pending\" AS \"latest_pending\"\n  WHERE\n    \"p\".\"source_snapshot_time\" = \"latest_pending\".\"value\"\n    AND NULLIF(TRIM(\"p\".\"bizflowstatus\"), '') IS NOT NULL\n    AND (\n      TRIM(\"p\".\"bizflowstatus\") <> 'OCP已下发' OR \"p\".\"order_stage\" = 'PREPARED_UNSHIPPED'\n    )\n  GROUP BY\n    \"b\".\"base_name\",\n    TRIM(\"p\".\"material_code\")\n)\nSELECT\n  \"b\".\"base_name\" AS \"base_name\",\n  CAST(\"latest_pending\".\"value\" AS DATE) AS \"snapshot_date\",\n  CASE\n    WHEN \"latest_pending\".\"value\" IS NULL\n    OR COUNT(*) FILTER(WHERE\n      \"o\".\"base_name\" IS NOT NULL AND \"o\".\"order_qty\" IS NULL) > 0\n    THEN NULL\n    ELSE COALESCE(SUM(\"o\".\"order_qty\"), 0)\n  END AS \"order_qty\",\n  CASE\n    WHEN \"latest_pending\".\"value\" IS NULL\n    OR COUNT(\"i_all\".\"base_name\") = 0\n    OR COUNT(*) FILTER(WHERE\n      \"o\".\"base_name\" IS NOT NULL\n      AND (\n        \"o\".\"preparing_remaining\" IS NULL\n        OR (\n          \"i\".\"sku\" IS NOT NULL AND \"i\".\"available_qty\" IS NULL\n        )\n      )) > 0\n    THEN NULL\n    ELSE COALESCE(SUM(GREATEST(0, \"o\".\"preparing_remaining\" - COALESCE(\"i\".\"available_qty\", 0))), 0)\n  END AS \"shortage_qty\"\nFROM \"bases\" AS \"b\"\nCROSS JOIN \"latest_pending\" AS \"latest_pending\"\nLEFT JOIN (\n  SELECT\n    \"stock\".\"base_name\" AS \"base_name\"\n  FROM \"stock\" AS \"stock\"\n  GROUP BY\n    \"stock\".\"base_name\"\n) AS \"i_all\"\n  ON \"i_all\".\"base_name\" = \"b\".\"base_name\"\nLEFT JOIN \"orders\" AS \"o\"\n  ON \"o\".\"base_name\" = \"b\".\"base_name\"\nLEFT JOIN \"stock\" AS \"i\"\n  ON \"i\".\"base_name\" = \"o\".\"base_name\" AND \"i\".\"sku\" = \"o\".\"sku\"\nWHERE\n  (\n    :scope_2 OR \"b\".\"base_name\" IN (:list_2)\n  )\n  AND (\n    CAST($3 AS TEXT) IS NULL OR \"b\".\"base_name\" = $3\n  )\n  AND (\n    CAST($4 AS TEXT) IS NULL OR \"i\".\"category\" = $4\n  )\n  AND (\n    CAST($5 AS TEXT) IS NULL OR \"o\".\"sku\" = $5\n  )\nGROUP BY\n  \"b\".\"base_name\",\n  \"latest_pending\".\"value\"\nORDER BY\n  \"b\".\"base_name\",\n  \"latest_pending\".\"value\"`;\n\nconst BRANCH_OUTBOUND_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    \"p\".\"source_branch_key\" AS \"source_branch_key\",\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"id\" AS \"id\",\n    \"i\".\"source_record_id\" AS \"source_record_id\",\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"warehouseid\" AS \"warehouseid\",\n    \"i\".\"warehouse_name\" AS \"warehouse_name\",\n    \"i\".\"self_pickup_point\" AS \"self_pickup_point\",\n    \"i\".\"pickup_point\" AS \"pickup_point\",\n    \"i\".\"base_name\" AS \"base_name\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"material_name\" AS \"material_name\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"prod_date\" AS \"prod_date\",\n    \"i\".\"live_qty\" AS \"live_qty\",\n    \"i\".\"available_qty\" AS \"available_qty\",\n    \"i\".\"warehouse_classify\" AS \"warehouse_classify\",\n    \"i\".\"created_time\" AS \"created_time\",\n    \"i\".\"updated_time\" AS \"updated_time\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n), \"product_categories\" AS (\n  WITH governed_choice_5 AS (\n    SELECT\n      \"agents_scm_branch_inventory_snapshot\".\"material_code\" AS \"material_code\",\n      \"agents_scm_branch_inventory_snapshot\".\"product_categ_name\" AS \"product_categ_name\",\n      \"agents_scm_branch_inventory_snapshot\".\"id\" AS \"choice_record_id\",\n      \"material_code\" AS \"choice_key_0\",\n      \"material_code\" AS \"choice_order_0\",\n      \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" AS \"choice_order_1\",\n      \"agents_scm_branch_inventory_snapshot\".\"updated_time\" AS \"choice_order_2\",\n      1 AS choice_present\n    FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n    WHERE\n      \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n  ), governed_choice_5_group_1 AS (\n    SELECT\n      c.\"choice_key_0\" AS \"choice_key_0\",\n      CASE\n        WHEN COUNT(c.\"choice_order_1\") < COUNT(*)\n        THEN NULL\n        ELSE MAX(c.\"choice_order_1\")\n      END AS choice_value\n    FROM governed_choice_5 AS c\n    GROUP BY\n      c.\"choice_key_0\"\n  ), governed_choice_5_selected_1 AS (\n    SELECT\n      c.\"material_code\" AS \"material_code\",\n      c.\"product_categ_name\" AS \"product_categ_name\",\n      c.\"choice_record_id\" AS \"choice_record_id\",\n      c.\"choice_key_0\" AS \"choice_key_0\",\n      c.\"choice_order_0\" AS \"choice_order_0\",\n      c.\"choice_order_1\" AS \"choice_order_1\",\n      c.\"choice_order_2\" AS \"choice_order_2\",\n      c.\"choice_present\" AS \"choice_present\"\n    FROM governed_choice_5 AS c\n    INNER JOIN governed_choice_5_group_1 AS g\n      ON (\n        COALESCE(CAST(c.\"choice_key_0\" AS TEXT), '') = COALESCE(CAST(g.\"choice_key_0\" AS TEXT), '')\n        AND (\n          c.\"choice_key_0\" IS NULL\n        ) = (\n          g.\"choice_key_0\" IS NULL\n        )\n      )\n      AND (\n        c.\"choice_order_1\" = g.choice_value\n        OR (\n          c.\"choice_order_1\" IS NULL AND g.choice_value IS NULL\n        )\n      )\n  ), governed_choice_5_group_2 AS (\n    SELECT\n      c.\"choice_key_0\" AS \"choice_key_0\",\n      CASE\n        WHEN COUNT(c.\"choice_order_2\") < COUNT(*)\n        THEN NULL\n        ELSE MAX(c.\"choice_order_2\")\n      END AS choice_value\n    FROM governed_choice_5_selected_1 AS c\n    GROUP BY\n      c.\"choice_key_0\"\n  ), governed_choice_5_selected_2 AS (\n    SELECT\n      c.\"material_code\" AS \"material_code\",\n      c.\"product_categ_name\" AS \"product_categ_name\",\n      c.\"choice_record_id\" AS \"choice_record_id\",\n      c.\"choice_key_0\" AS \"choice_key_0\",\n      c.\"choice_order_0\" AS \"choice_order_0\",\n      c.\"choice_order_1\" AS \"choice_order_1\",\n      c.\"choice_order_2\" AS \"choice_order_2\",\n      c.\"choice_present\" AS \"choice_present\"\n    FROM governed_choice_5_selected_1 AS c\n    INNER JOIN governed_choice_5_group_2 AS g\n      ON (\n        COALESCE(CAST(c.\"choice_key_0\" AS TEXT), '') = COALESCE(CAST(g.\"choice_key_0\" AS TEXT), '')\n        AND (\n          c.\"choice_key_0\" IS NULL\n        ) = (\n          g.\"choice_key_0\" IS NULL\n        )\n      )\n      AND (\n        c.\"choice_order_2\" = g.choice_value\n        OR (\n          c.\"choice_order_2\" IS NULL AND g.choice_value IS NULL\n        )\n      )\n  ), governed_choice_5_tie AS (\n    SELECT\n      MAX(t.choice_record_id) AS selected_id\n    FROM governed_choice_5_selected_2 AS t\n    GROUP BY\n      t.\"choice_key_0\"\n  )\n  SELECT DISTINCT\n    c.\"material_code\" AS \"material_code\",\n    c.\"product_categ_name\" AS \"product_categ_name\"\n  FROM governed_choice_5 AS c\n  INNER JOIN governed_choice_5_tie AS t\n    ON c.choice_record_id = t.selected_id\n)\nSELECT\n  \"c\".\"branch_pickup_point\" AS \"branch\",\n  \"f\".\"material_code\" AS \"sku\",\n  \"p\".\"product_categ_name\" AS \"category\",\n  CAST(MAX(\"f\".\"business_date\") AS DATE) AS \"snapshot_date\",\n  CASE\n    WHEN BOOL_AND(\"f\".\"metric_value\" IS NOT NULL AND \"f\".\"metric_value\" >= 0)\n    THEN SUM(\"f\".\"metric_value\")\n  END AS \"outbound_qty\"\nFROM \"agents_scm_branch_operation_fact\" AS \"f\"\nJOIN \"branch_catalog\" AS \"c\"\n  ON \"c\".\"pickup_code\" = \"f\".\"pickup_point\"\nLEFT JOIN \"product_categories\" AS \"p\"\n  ON \"p\".\"material_code\" = \"f\".\"material_code\"\nWHERE\n  \"f\".\"metric_name\" = 'out_qty_daily'\n  AND \"f\".\"business_date\" BETWEEN CAST($1 AS DATE) - INTERVAL '30 DAYS' AND CAST($1 AS DATE) - INTERVAL '1 DAY'\n  AND (\n    :scope_2 OR \"c\".\"branch_pickup_point\" IN (:list_2)\n  )\n  AND (\n    CAST($3 AS TEXT) IS NULL OR \"c\".\"branch_pickup_point\" = $3\n  )\n  AND (\n    CAST($4 AS TEXT) IS NULL OR \"p\".\"product_categ_name\" = $4\n  )\n  AND (\n    CAST($5 AS TEXT) IS NULL OR \"f\".\"material_code\" = $5\n  )\nGROUP BY\n  \"c\".\"branch_pickup_point\",\n  \"f\".\"material_code\",\n  \"p\".\"product_categ_name\"\nORDER BY\n  \"c\".\"branch_pickup_point\",\n  \"f\".\"material_code\",\n  \"p\".\"product_categ_name\"`;\n\nconst BRANCH_FULFILLMENT_SQL = `WITH \"catalog_scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n      WHERE\n        \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n), \"catalog_plan_labels\" AS (\n  SELECT DISTINCT\n    TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\") AS \"source_branch_key\",\n    CASE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n      WHEN '上海配送中心'\n      THEN '上海分仓'\n      WHEN '武汉配送中心'\n      THEN '武汉分仓'\n      ELSE REGEXP_REPLACE(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '提货点$', '')\n    END AS \"warehouse_name\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  WHERE\n    \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n      WHERE\n        \"agents_scm_branch_plan\".\"plan_snapshot_date\" <= CAST($1 AS DATE)\n    )\n    AND NULLIF(TRIM(\"agents_scm_branch_plan\".\"branch_pickup_point\"), '') IS NOT NULL\n), \"catalog_name_codes\" AS (\n  SELECT\n    \"catalog_scopes\".\"warehouse_name\" AS \"warehouse_name\",\n    COUNT(DISTINCT \"catalog_scopes\".\"pickup_code\") AS \"code_count\"\n  FROM \"catalog_scopes\" AS \"catalog_scopes\"\n  GROUP BY\n    \"catalog_scopes\".\"warehouse_name\"\n), \"catalog_candidates\" AS (\n  SELECT\n    \"s\".\"pickup_code\" AS \"pickup_code\",\n    MIN(\"s\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  WHERE\n    \"s\".\"pickup_code\" ~ '^[A-Z0-9]{1,16}$' AND \"s\".\"warehouse_name\" IS NOT NULL\n  GROUP BY\n    \"s\".\"pickup_code\"\n  HAVING\n    COUNT(DISTINCT \"s\".\"warehouse_name\") = 1\n), \"catalog_unique\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_candidates\" AS \"c\"\n  INNER JOIN \"catalog_name_codes\" AS \"n\"\n    ON \"n\".\"warehouse_name\" = \"c\".\"branch_pickup_point\" AND \"n\".\"code_count\" = 1\n), \"branch_catalog\" AS (\n  SELECT\n    \"c\".\"pickup_code\" AS \"pickup_code\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"catalog_unique\" AS \"c\"\n  LEFT JOIN \"catalog_plan_labels\" AS \"p\"\n    ON \"p\".\"source_branch_key\" = \"c\".\"pickup_code\"\n    OR \"p\".\"warehouse_name\" = \"c\".\"branch_pickup_point\"\n  GROUP BY\n    \"c\".\"pickup_code\",\n    \"c\".\"branch_pickup_point\"\n), \"catalog_plans\" AS (\n  SELECT\n    \"p\".\"source_branch_key\" AS \"source_branch_key\",\n    COALESCE(\"c\".\"branch_pickup_point\", \"p\".\"warehouse_name\") AS \"branch_pickup_point\"\n  FROM \"catalog_plan_labels\" AS \"p\"\n  LEFT JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"p\".\"source_branch_key\"\n    OR \"c\".\"branch_pickup_point\" = \"p\".\"warehouse_name\"\n), \"catalog_warehouse_links\" AS (\n  SELECT\n    \"s\".\"warehouseid\" AS \"warehouseid\",\n    MIN(\"c\".\"pickup_code\") AS \"pickup_code\",\n    MIN(\"c\".\"branch_pickup_point\") AS \"branch_pickup_point\"\n  FROM \"catalog_scopes\" AS \"s\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = \"s\".\"pickup_code\"\n  GROUP BY\n    \"s\".\"warehouseid\"\n  HAVING\n    COUNT(DISTINCT \"c\".\"pickup_code\") = 1\n), \"mapped_branch_inventory\" AS (\n  SELECT\n    \"i\".\"id\" AS \"id\",\n    \"i\".\"source_record_id\" AS \"source_record_id\",\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"warehouseid\" AS \"warehouseid\",\n    \"i\".\"warehouse_name\" AS \"warehouse_name\",\n    \"i\".\"self_pickup_point\" AS \"self_pickup_point\",\n    \"i\".\"pickup_point\" AS \"pickup_point\",\n    \"i\".\"base_name\" AS \"base_name\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"material_name\" AS \"material_name\",\n    \"i\".\"product_categ_name\" AS \"product_categ_name\",\n    \"i\".\"prod_date\" AS \"prod_date\",\n    \"i\".\"live_qty\" AS \"live_qty\",\n    \"i\".\"available_qty\" AS \"available_qty\",\n    \"i\".\"warehouse_classify\" AS \"warehouse_classify\",\n    \"i\".\"created_time\" AS \"created_time\",\n    \"i\".\"updated_time\" AS \"updated_time\",\n    \"c\".\"branch_pickup_point\" AS \"branch_pickup_point\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"branch_catalog\" AS \"c\"\n    ON \"c\".\"pickup_code\" = COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), ''))\n  WHERE\n    \"i\".\"snapshot_date\" <= CAST($1 AS DATE) AND \"i\".\"warehouse_classify\" = '20'\n)\nSELECT\n  \"c\".\"branch_pickup_point\" AS \"branch\",\n  MAX(\"f\".\"snapshot_date\") AS \"snapshot_date\",\n  CASE\n    WHEN BOOL_AND(\"f\".\"metric_value\" IS NOT NULL) FILTER(WHERE\n      \"f\".\"metric_name\" = 'order_qty')\n    THEN SUM(\"f\".\"metric_value\") FILTER(WHERE\n      \"f\".\"metric_name\" = 'order_qty')\n  END AS \"order_qty\",\n  CASE\n    WHEN BOOL_AND(\"f\".\"metric_value\" IS NOT NULL) FILTER(WHERE\n      \"f\".\"metric_name\" = 'shipped_qty')\n    THEN SUM(\"f\".\"metric_value\") FILTER(WHERE\n      \"f\".\"metric_name\" = 'shipped_qty')\n  END AS \"shipped_qty\"\nFROM \"agents_scm_branch_operation_fact\" AS \"f\"\nJOIN \"branch_catalog\" AS \"c\"\n  ON \"c\".\"pickup_code\" = \"f\".\"pickup_point\"\nWHERE\n  \"f\".\"metric_group\" = 'branch_fulfillment'\n  AND \"f\".\"period_month\" = CAST($2 AS DATE)\n  AND (\n    :scope_3 OR \"c\".\"branch_pickup_point\" IN (:list_3)\n  )\n  AND (\n    CAST($4 AS TEXT) IS NULL OR \"c\".\"branch_pickup_point\" = $4\n  )\n  AND /* This source has no published SKU/category fulfillment contract. */ CAST($5 AS TEXT) IS NULL\n  AND CAST($6 AS TEXT) IS NULL\nGROUP BY\n  \"c\".\"branch_pickup_point\"\nORDER BY\n  \"c\".\"branch_pickup_point\"`;\n\n// Return plain text through JDBC, then restore the existing domain array contract.\nfunction decodeOrderIds(value: unknown): string[] {\n  if (value == null) return [];\n  const items = typeof value === \"string\" ? JSON.parse(value) : value;\n  if (!Array.isArray(items) || items.some(item => typeof item !== \"string\"))\n    throw new Error(\"订单编号列表返回格式无效\");\n  return items;\n}\n\nfunction number(value: unknown): number {\n  if (value == null || value === \"\") throw new Error(\"Required numeric source value is missing\");\n  const parsed = typeof value === \"number\" ? value : Number(value);\n  if (!Number.isFinite(parsed)) throw new Error(\"Required numeric source value is invalid\");\n  return parsed;\n}\n\nfunction nullableNumber(value: unknown): number | null {\n  return value == null || value === \"\" ? null : number(value);\n}\n\nfunction date(value: unknown): string {\n  if (value instanceof Date) {\n    const year = value.getFullYear();\n    const month = String(value.getMonth() + 1).padStart(2, \"0\");\n    const day = String(value.getDate()).padStart(2, \"0\");\n    return `${year}-${month}-${day}`;\n  }\n  return String(value ?? \"\").slice(0, 10);\n}\n\nexport class PostgresFullChainAdapter implements FullChainDataAdapter {\n  constructor(private readonly executor: QueryExecutor = getReadOnlyPool()) {}\n\n  async load(request: AdapterRequest, part: \"all\" | \"current\" | \"history\" = \"all\"): Promise<FullChainData> {\n    const asOf = request.now.toLocaleDateString(\"en-CA\", { timeZone: \"Asia/Shanghai\" });\n    const month = `${request.filters.month ?? asOf.slice(0, 7)}-01`;\n    const baseScope = request.access.allowedBases ?? null;\n    const branchScope = request.access.allowedBranches ?? null;\n    const customerScope = request.access.allowedCustomerIds ?? null;\n    const noRows = Promise.resolve({ rows: [] as QueryResultRow[] });\n    const includeCustomer = request.scope === \"all-channel\";\n    const current = part !== \"history\";\n    const history = part !== \"current\";\n    const [base, branch, customer, baseAge, branchAge, customerAge, orders, pending, active, trend, orderHistory, agingHistory, orders7d, outbound, branchFulfillment, baseCurrentOrders] = await Promise.all([\n      current ? this.executor.query(BASE_SQL, [asOf, month, baseScope, request.filters.base ?? null, request.filters.category ?? null, request.filters.sku ?? null, !request.filters.month]) : noRows,\n      current ? this.executor.query(BRANCH_SQL, [asOf, month, branchScope, request.filters.branch ?? null, request.filters.category ?? null, request.filters.sku ?? null]) : noRows,\n      current && includeCustomer ? this.executor.query(CUSTOMER_SQL, [asOf, customerScope, request.filters.category ?? null, request.filters.sku ?? null, request.filters.customerId ?? null]) : noRows,\n      current ? this.executor.query(BASE_AGE_SQL, [asOf, baseScope, request.filters.base ?? null, request.filters.category ?? null, request.filters.sku ?? null]) : noRows,\n      current ? this.executor.query(BRANCH_AGE_SQL, [asOf, branchScope, request.filters.branch ?? null, request.filters.category ?? null, request.filters.sku ?? null]) : noRows,\n      current && includeCustomer ? this.executor.query(CUSTOMER_AGE_SQL, [asOf, customerScope, request.filters.category ?? null, request.filters.sku ?? null, request.filters.customerId ?? null]) : noRows,\n      current ? this.executor.query(ORDER_SQL, [asOf, month, baseScope, request.filters.base ?? null, request.filters.branch ?? null, request.filters.category ?? null, request.filters.sku ?? null, branchScope]) : noRows,\n      current ? this.executor.query(PENDING_SQL, [asOf, branchScope, request.filters.branch ?? null, request.filters.sku ?? null, request.filters.category ?? null]) : noRows,\n      current && includeCustomer ? this.executor.query(ACTIVE_CUSTOMERS_SQL, [asOf, customerScope]) : noRows,\n      !history ? noRows : includeCustomer\n        ? this.executor.query(TREND_SQL, [asOf, baseScope, branchScope, customerScope, request.filters.base ?? null, request.filters.branch ?? null, request.filters.category ?? null, request.filters.sku ?? null, request.filters.customerId ?? null])\n        : this.executor.query(COMPANY_TREND_SQL, [asOf, baseScope, branchScope, request.filters.base ?? null, request.filters.branch ?? null, request.filters.category ?? null, request.filters.sku ?? null]),\n      history ? this.executor.query(ORDER_TREND_SQL, [asOf, month, baseScope, request.filters.base ?? null, request.filters.branch ?? null, request.filters.category ?? null, request.filters.sku ?? null, branchScope]) : noRows,\n      history ? this.executor.query(AGING_TREND_SQL, [asOf, baseScope, branchScope, request.filters.base ?? null, request.filters.branch ?? null, request.filters.category ?? null, request.filters.sku ?? null]) : noRows,\n      current ? this.executor.query(ORDER_7D_SQL, [asOf, month, baseScope, request.filters.base ?? null, request.filters.branch ?? null, request.filters.category ?? null, request.filters.sku ?? null, branchScope]) : noRows,\n      current ? this.executor.query(BRANCH_OUTBOUND_SQL, [asOf, branchScope, request.filters.branch ?? null, request.filters.category ?? null, request.filters.sku ?? null]) : noRows,\n      current ? this.executor.query(BRANCH_FULFILLMENT_SQL, [asOf, request.filters.month ? month : `${new Date(request.now.getTime() - 86_400_000).toLocaleDateString(\"en-CA\", { timeZone: \"Asia/Shanghai\" }).slice(0, 7)}-01`, branchScope, request.filters.branch ?? null, request.filters.category ?? null, request.filters.sku ?? null]) : noRows,\n      current ? this.executor.query(BASE_CURRENT_ORDER_SQL, [asOf, baseScope, request.filters.base ?? null, request.filters.category ?? null, request.filters.sku ?? null]) : noRows,\n    ]);\n    if (branch.rows.some((row) => Number(row.mapping_issue_count ?? 0) > 0)) {\n      throw new Error(\"分仓目录映射缺失或存在编码/名称冲突，请核对计划、库存与货龄快照；未展示不完整的分仓汇总\");\n    }\n    const baseInventory: BaseInventoryRow[] = base.rows.map((row) => ({ snapshotDate: date(row.snapshot_date), base: String(row.base_name), category: String(row.category), sku: String(row.sku), currentQty: number(row.current_qty), targetQty: nullableNumber(row.target_qty), sourceTargetTurnoverDays: nullableNumber(row.source_target_turnover_days), plannedDailyQty: nullableNumber(row.planned_daily_qty), externalDemand30d: nullableNumber(row.external_demand_30d), confirmedTransferOut30d: nullableNumber(row.transfer_out_30d) }));\n    const branchInventory: BranchInventoryRow[] = branch.rows.filter((row) => row.sku != null).map((row) => ({ snapshotDate: date(row.snapshot_date), base: null, branch: String(row.branch), category: String(row.category), sku: String(row.sku), currentQty: number(row.current_qty), availableQty: nullableNumber(row.available_qty), targetQty: nullableNumber(row.target_qty), plannedDailyQty: nullableNumber(row.planned_daily_qty), forecastInventoryQty: nullableNumber(row.forecast_inventory_qty), externalDemand30d: nullableNumber(row.external_demand_30d) }));\n    const branchOutbound = outbound.rows.map(row => ({ branch: String(row.branch), sku: String(row.sku), category: row.category == null ? undefined : String(row.category), snapshotDate: date(row.snapshot_date), qty: nullableNumber(row.outbound_qty) }));\n    const outboundBySku = new Map(branchOutbound.map(row => [`${row.branch}\\u0000${row.sku}`, row.qty]));\n    for (const row of branchInventory) row.externalDemand30d = outboundBySku.get(`${row.branch}\\u0000${row.sku}`) ?? null;\n    const customerInventory: CustomerInventoryRow[] = customer.rows.filter(row => row.current_qty != null).map((row) => ({ snapshotDate: date(row.snapshot_date), statisticDate: date(row.stat_date), customerId: String(row.cust_code), customer: String(row.cust_name), branch: null, category: String(row.category), sku: String(row.material_code), currentQty: number(row.current_qty), targetQty: nullableNumber(row.target_qty), sales30d: nullableNumber(row.sales_30d), sourceConflict: Boolean(row.source_conflict) }));\n    const baseVelocity = new Map(baseInventory.map((row) => [`${row.base}\\u0000${row.sku}`, row.externalDemand30d == null ? null : row.externalDemand30d / 30]));\n    const branchVelocity = new Map(branchInventory.map((row) => [`${row.branch}\\u0000${row.sku}`, row.plannedDailyQty ?? null]));\n    const agingBatches: AgingBatchRow[] = [\n      ...baseAge.rows.map((row) => ({ snapshotDate: date(row.snapshot_date), layer: \"base\" as const, objectName: String(row.object_name), category: String(row.category), sku: String(row.sku), batch: String(row.batch), qty: number(row.qty), ageDays: nullableNumber(row.age_days), dailyVelocity: baseVelocity.get(`${row.object_name}\\u0000${row.sku}`) ?? null, source: \"基地库龄\" })),\n      ...branchAge.rows.map((row) => ({ snapshotDate: date(row.snapshot_date), layer: \"branch\" as const, objectName: String(row.object_name), category: String(row.category), sku: String(row.sku), batch: String(row.batch), qty: number(row.qty), ageDays: nullableNumber(row.age_days), dailyVelocity: branchVelocity.get(`${row.object_name}\\u0000${row.sku}`) ?? null, source: \"分仓批次\" })),\n      ...customerAge.rows.map((row) => ({ snapshotDate: date(row.snapshot_date), layer: \"customer\" as const, objectId: String(row.cust_code), objectName: String(row.object_name), category: String(row.category), sku: String(row.sku), batch: String(row.batch), qty: number(row.qty), ageDays: nullableNumber(row.age_days), dailyVelocity: nullableNumber(row.daily_velocity), source: String(row.source) })),\n    ];\n    const mapOrder = (row: QueryResultRow): OrderRow => ({ snapshotDate: date(row.snapshot_date), month: String(row.month), pickupType: String(row.pickup_type) === \"factory\" ? \"factory\" : \"branch\", objectName: row.object_name == null ? undefined : String(row.object_name), category: row.category == null ? undefined : String(row.category), sku: row.sku == null ? undefined : String(row.sku), orderQty: nullableNumber(row.order_qty), orderIds: decodeOrderIds(row.order_ids), affectedOrderIds: decodeOrderIds(row.affected_order_ids), demandQty: number(row.demand_qty), shortageQty: number(row.shortage_qty), shippedQty: number(row.shipped_qty), affectedOrders: number(row.affected_orders) });\n    const mappedOrders = orders.rows.map(mapOrder);\n    const mappedOrderHistory: OrderRow[] = orderHistory.rows.map((row) => ({ snapshotDate: date(row.snapshot_date), month: String(row.month), pickupType: String(row.pickup_type) === \"factory\" ? \"factory\" : \"branch\", orderQty: nullableNumber(row.order_qty), demandQty: number(row.demand_qty), shortageQty: number(row.shortage_qty), shippedQty: number(row.shipped_qty), affectedOrders: number(row.affected_orders) }));\n    const pendingOrders: PendingOrderRow[] = pending.rows.map((row) => ({ snapshotDate: date(row.snapshot_date), shortageQty: nullableNumber(row.shortage_qty), stageVerified: row.legacy_count != null && Number(row.legacy_count) === 0, branch: String(row.branch), sku: row.sku == null ? undefined : String(row.sku), demandQty: number(row.demand_qty), allocatedQty: number(row.allocated_qty), preparedQty: nullableNumber(row.prepared_qty) }));\n    const inventoryTrend: InventoryTrendRow[] = trend.rows.filter(row => row.qty != null).map((row) => ({ snapshotDate: date(row.snapshot_date), layer: String(row.layer) as InventoryTrendRow[\"layer\"], qty: number(row.qty) }));\n    return {\n      baseCurrentOrders: baseCurrentOrders.rows.map(row => ({ base: String(row.base_name), snapshotDate: date(row.snapshot_date), orderQty: nullableNumber(row.order_qty), shortageQty: nullableNumber(row.shortage_qty) })),\n      branchOutbound,\n      branchFulfillment: branchFulfillment.rows.map(row => ({ branch: String(row.branch), snapshotDate: date(row.snapshot_date), orderQty: nullableNumber(row.order_qty), shippedQty: nullableNumber(row.shipped_qty) })),\n      baseInventory, branchInventory, customerInventory, agingBatches, orders: mappedOrders, orders7d: orders7d.rows.map(mapOrder), pendingOrders,\n      customerQuantityGaps: customer.rows.filter(row => row.current_qty == null).map(row => ({ customerId: String(row.cust_code), sku: String(row.material_code), category: String(row.category) })),\n      activeCustomerIds30d: active.rows.map((row) => String(row.cust_code)), inventoryTrend,\n      orderHistory: mappedOrderHistory,\n      agingHistory: agingHistory.rows.map((row) => ({ snapshotDate: date(row.snapshot_date), layer: String(row.layer) === \"base\" ? \"base\" as const : \"branch\" as const, averageAge: nullableNumber(row.average_age) })),\n    };\n  }\n}\n\nexport const FULL_CHAIN_QUERY_NAMES = Object.freeze([\n  \"base-inventory\", \"branch-inventory\", \"customer-inventory\", \"base-age\", \"branch-age\",\n  \"customer-age\", \"order-fulfillment\", \"pending-order\", \"active-customers\", \"inventory-trend\",\n  \"order-trend\", \"aging-trend\", \"orders-seven-day\", \"branch-outbound\", \"branch-fulfillment\", \"base-current-orders\",\n]);\n\nconst fixedQueries = new Set([BASE_SQL, BRANCH_SQL, CUSTOMER_SQL, BASE_AGE_SQL, BRANCH_AGE_SQL,\n  CUSTOMER_AGE_SQL, ORDER_SQL, PENDING_SQL, ACTIVE_CUSTOMERS_SQL, TREND_SQL, COMPANY_TREND_SQL,\n  ORDER_TREND_SQL, AGING_TREND_SQL, ORDER_7D_SQL, BRANCH_OUTBOUND_SQL, BRANCH_FULFILLMENT_SQL, BASE_CURRENT_ORDER_SQL]);\n\nexport function isFixedFullChainQuery(sql: string) { return fixedQueries.has(sql); }\n\nexport const fullChainSqlTemplates = { BASE_SQL, BRANCH_SQL, CUSTOMER_SQL, BASE_AGE_SQL, BRANCH_AGE_SQL, CUSTOMER_AGE_SQL, ORDER_SQL, ORDER_7D_SQL, PENDING_SQL, ACTIVE_CUSTOMERS_SQL, TREND_SQL, COMPANY_TREND_SQL, ORDER_TREND_SQL, AGING_TREND_SQL, BASE_CURRENT_ORDER_SQL, BRANCH_OUTBOUND_SQL, BRANCH_FULFILLMENT_SQL };\n"},"source/inventory-light-plugins/src/governed/modules/warehouse-catalog.ts":{"blob":"04c9ac6ef50ea3fc69b34f4cc5befddd68ec1537","sha256":"48dba514a39a30c79d94ca46462f73f1e2a93c3b0d2eaa49de0fbf4a01001d67","text":"import { warehouseIdFromPickupCode, type WarehouseOption } from \"../warehouse.ts\";\nimport { getDatabase } from \"./database.ts\";\n\nexport type CatalogDatabase = { query(sql: string, values?: unknown[]): Promise<{ rows: Array<Record<string, unknown>> }> };\nexport type WarehouseSource = WarehouseOption & { warehouseName: string; region: string; pickupPointCode: string; branchPickupPoint: string };\nexport type WarehouseCatalog = { warehouses: WarehouseSource[]; issues: Array<{ name: string; reason: string }> };\n\n// Verified naming differences between the plan pickup-point and stock warehouse.\n// These are name aliases, not a fixed list of branches or guessed code mappings.\nconst STOCK_NAME_ALIASES: Record<string, string> = {\n  \"上海配送中心\": \"上海分仓\",\n  \"武汉配送中心\": \"武汉分仓\",\n};\nconst clean = (value: unknown) => typeof value === \"string\" ? value.trim() : \"\";\n\nexport async function loadWarehouseCatalog(database: CatalogDatabase = getDatabase()): Promise<WarehouseCatalog> {\n  const [plans, inventory] = await Promise.all([\n    database.query(`/* warehouse_catalog:plans */\nSELECT DISTINCT\n  \"agents_scm_branch_plan\".\"branch_pickup_point\" AS \"branch_pickup_point\",\n  \"agents_scm_branch_plan\".\"branch_name\" AS \"branch_name\"\nFROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\nWHERE\n  \"agents_scm_branch_plan\".\"plan_snapshot_date\" = (\n    SELECT\n      MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"_col_0\"\n    FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n  )\nORDER BY\n  \"branch_pickup_point\",\n  \"branch_name\"`),\n    database.query(`/* warehouse_catalog:inventory */\nWITH \"scopes\" AS (\n  SELECT DISTINCT\n    COALESCE(\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"pickup_point\"), ''),\n      NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"self_pickup_point\"), '')\n    ) AS \"pickup_code\",\n    \"agents_scm_branch_inventory_snapshot\".\"warehouseid\" AS \"warehouseid\",\n    NULLIF(TRIM(\"agents_scm_branch_inventory_snapshot\".\"warehouse_name\"), '') AS \"warehouse_name\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n  WHERE\n    \"agents_scm_branch_inventory_snapshot\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n    )\n    AND \"agents_scm_branch_inventory_snapshot\".\"warehouse_classify\" = '20'\n)\nSELECT DISTINCT\n  \"scopes\".\"pickup_code\" AS \"pickup_code\",\n  \"scopes\".\"warehouseid\" AS \"warehouseid\",\n  \"scopes\".\"warehouse_name\" AS \"warehouse_name\"\nFROM \"scopes\" AS \"scopes\"\nWHERE\n  \"scopes\".\"pickup_code\" IS NOT NULL AND \"scopes\".\"warehouse_name\" IS NOT NULL\nORDER BY\n  \"pickup_code\",\n  \"warehouse_name\"`),\n  ]);\n  const codesByName = new Map<string, Set<string>>();\n  const namesByCode = new Map<string, Set<string>>();\n  for (const row of inventory.rows) {\n    const name = clean(row.warehouse_name);\n    const code = clean(row.pickup_code);\n    if (!name || !/^[A-Z0-9]{1,16}$/.test(code)) continue;\n    const codes = codesByName.get(name) ?? new Set<string>();\n    codes.add(code);\n    codesByName.set(name, codes);\n    const names = namesByCode.get(code) ?? new Set<string>();\n    names.add(name);\n    namesByCode.set(code, names);\n  }\n  const issues: WarehouseCatalog[\"issues\"] = [];\n  const candidates: WarehouseSource[] = [];\n  const seen = new Set<string>();\n  const seenPickupCodes = new Set<string>();\n  const conflictingPickupCodes = new Set<string>();\n  const addCandidate = (candidate: WarehouseSource) => {\n    // A source can publish both its code and its display-name form. They are the\n    // same physical branch; keep the first (code form is ordered first) instead\n    // of later discarding both as a duplicate warehouse ID.\n    if (conflictingPickupCodes.has(candidate.pickupPointCode)) return;\n    if (seenPickupCodes.has(candidate.pickupPointCode)) {\n      const existing = candidates.find((item) => item.pickupPointCode === candidate.pickupPointCode);\n      const aliasesSamePhysicalWarehouse = existing && (\n        existing.warehouseName === candidate.warehouseName\n        || STOCK_NAME_ALIASES[candidate.warehouseName] === existing.warehouseName\n        || STOCK_NAME_ALIASES[existing.warehouseName] === candidate.warehouseName\n      );\n      if (aliasesSamePhysicalWarehouse) return;\n      const index = candidates.findIndex((item) => item.pickupPointCode === candidate.pickupPointCode);\n      if (index >= 0) candidates.splice(index, 1);\n      conflictingPickupCodes.add(candidate.pickupPointCode);\n      issues.push({ name: existing?.name ?? candidate.pickupPointCode, reason: \"多个计划分仓对应同一库存提货点，需核对映射\" });\n      issues.push({ name: candidate.name, reason: \"多个计划分仓对应同一库存提货点，需核对映射\" });\n      return;\n    }\n    seenPickupCodes.add(candidate.pickupPointCode);\n    candidates.push(candidate);\n  };\n  for (const row of plans.rows) {\n    const point = clean(row.branch_pickup_point);\n    if (!point || seen.has(point)) continue;\n    seen.add(point);\n    const name = point.replace(/提货点$/, \"\");\n    // Plans may use the physical pickup-point code directly. Prefer that exact,\n    // database-owned relation before applying the display-name compatibility map.\n    const directNames = [...(namesByCode.get(point) ?? [])];\n    if (directNames.length === 1) {\n      addCandidate({ id: warehouseIdFromPickupCode(point), name: directNames[0], warehouseName: directNames[0], region: \"—\", pickupPointCode: point, branchPickupPoint: point });\n      continue;\n    }\n    if (directNames.length > 1) {\n      issues.push({ name: point, reason: \"提货点编码对应多个库存仓库名称，需核对映射\" });\n      continue;\n    }\n    const codes = [...(codesByName.get(STOCK_NAME_ALIASES[name] ?? name) ?? [])];\n    if (codes.length !== 1) {\n      issues.push({ name, reason: codes.length ? \"名称对应多个库存提货点编码，需核对映射\" : \"最新分仓库存快照中未找到唯一编码映射\" });\n      continue;\n    }\n    addCandidate({ id: warehouseIdFromPickupCode(codes[0]), name, warehouseName: name, region: \"—\", pickupPointCode: codes[0], branchPickupPoint: point });\n  }\n  // Current inventory is independent of SKU-plan coverage. Add only an\n  // authoritative one-to-one pickup/name/warehouse mapping from class-20 stock.\n  const warehouseIdsByCode = new Map<string, Set<string>>();\n  const codesByWarehouseId = new Map<string, Set<string>>();\n  for (const row of inventory.rows) {\n    const code = clean(row.pickup_code), warehouseId = clean(row.warehouseid);\n    if (!warehouseId || !/^[A-Z0-9]{1,16}$/.test(code)) continue;\n    const ids = warehouseIdsByCode.get(code) ?? new Set<string>();\n    ids.add(warehouseId); warehouseIdsByCode.set(code, ids);\n    const codes = codesByWarehouseId.get(warehouseId) ?? new Set<string>();\n    codes.add(code); codesByWarehouseId.set(warehouseId, codes);\n  }\n  for (const [code, ids] of warehouseIdsByCode) {\n    if (seenPickupCodes.has(code) || conflictingPickupCodes.has(code)) continue;\n    const names = [...(namesByCode.get(code) ?? [])];\n    const id = [...ids][0];\n    if (ids.size !== 1 || names.length !== 1 || codesByWarehouseId.get(id)?.size !== 1 || codesByName.get(names[0])?.size !== 1) {\n      issues.push({ name: code, reason: \"无计划分仓的库存目录映射不唯一，需核对\" });\n      continue;\n    }\n    addCandidate({ id: warehouseIdFromPickupCode(code), name: names[0], warehouseName: names[0], region: \"—\", pickupPointCode: code, branchPickupPoint: code });\n  }\n  const warehouses = candidates.filter((source) => {\n    if (candidates.filter((item) => item.id === source.id).length === 1) return true;\n    issues.push({ name: source.name, reason: \"多个计划分仓对应同一库存提货点，需核对映射\" });\n    return false;\n  });\n  const legacyOrder = [\"changsha\", \"zhengzhou\", \"east-china\"];\n  warehouses.sort((a, b) => {\n    const rank = (id: string) => legacyOrder.includes(id) ? legacyOrder.indexOf(id) : 3;\n    return rank(a.id) - rank(b.id) || a.name.localeCompare(b.name, \"zh-CN\");\n  });\n  return { warehouses, issues };\n}\n"},"source/inventory-light-plugins/src/governed/modules/warehouse-snapshot.ts":{"blob":"a4991e57fdc564bc587205d5f5da4c05528aa48f","sha256":"7750435c48424dde829150d4fbc75baf01622b8b36220679aa0c50c62d204432","text":"import {\n  formatRatio,\n  sumKnownQuantities,\n  isWarehouseId,\n  type BaseResource,\n  type CustomerOrder,\n  type InventoryBatch,\n  type InventoryRow,\n  type OperationsObservation,\n  type PlanRow,\n  type ReplenishmentRow,\n  type WarehouseId,\n  type WarehouseSnapshot,\n} from \"../domain.ts\";\nimport { BRANCH_RULESET, calculateTargetInventory } from \"../rules.ts\";\nimport { getDatabase } from \"./database.ts\";\nimport { loadWarehouseCatalog } from \"./warehouse-catalog.ts\";\nimport { fulfillmentWarehouseScope } from \"./warehouse-scope.ts\";\nimport { loadPlanProductMetadata } from \"./plan-product-metadata.ts\";\nimport { readPlanningState } from \"./planning-store.ts\";\nimport { applyBusinessPlanning, nextMonth } from \"../planning.ts\";\nimport { getBusinessDatabase } from \"./business-database.ts\";\nimport { queryBusinessDatabase, usesGeaSql, type BusinessDatabase } from \"./gea-sql.ts\";\nimport type { TrustedIdentity } from \"./identity.ts\";\n\nexport type WarehouseSnapshotDatabase = BusinessDatabase;\n\nexport class WarehouseSnapshotDataError extends Error {}\n\n// 页面、AI、提交复核共用此入口；应用自己的计划配置仍在本地业务库。\nexport async function loadWarehouseSnapshotForIdentity(warehouseId: WarehouseId, identity: TrustedIdentity, inventoryDetail: \"full\" | \"summary\" = \"full\") {\n  const gea = usesGeaSql();\n  const snapshot = await loadWarehouseSnapshot(warehouseId, getBusinessDatabase(identity.gatewayContextRef), new Date(), gea ? getDatabase() : undefined, inventoryDetail);\n  return gea ? { ...snapshot, dataSource: \"GEA SQL data_service 分仓库存标准表\" } : snapshot;\n}\n\nfunction text(value: unknown, fallback = \"\"): string {\n  return value === null || value === undefined ? fallback : String(value);\n}\n\nfunction quantity(value: unknown): number {\n  const parsed = Number(value);\n  return Number.isFinite(parsed) ? Math.max(0, parsed) : 0;\n}\n\nfunction integerQuantity(value: unknown): number {\n  return Math.round(quantity(value));\n}\n\nfunction optionalNumber(value: unknown): number | null {\n  if (value === null || value === undefined || value === \"\") return null;\n  const parsed = Number(value);\n  return Number.isFinite(parsed) ? parsed : null;\n}\n\nfunction usableSourcePlan(row: Record<string, unknown> | undefined): boolean {\n  if (!row || optionalNumber(row.shipment_plan_qty) === null) return false;\n  // Upstream can publish numeric zero placeholders alongside BI_TARGET_MISSING.\n  // Only a ready plan is a business quantity, including an explicitly ready zero.\n  return text(row.plan_status).toUpperCase() === \"READY\"\n    && !/MISSING|INVALID|INCOMPLETE|PENDING/.test(text(row.bi_target_status).toUpperCase());\n}\n\nfunction daysInMonth(date: string): number {\n  const [year, month] = date.slice(0, 7).split(\"-\").map(Number);\n  return Number.isFinite(year) && Number.isFinite(month) ? new Date(Date.UTC(year, month, 0)).getUTCDate() : 30;\n}\n\nfunction monthLabel(date: string): string {\n  const [year, month] = date.slice(0, 7).split(\"-\");\n  return `${Number(year)}年${Number(month)}月`;\n}\n\nfunction monthValue(date: string): string {\n  return date.slice(0, 7);\n}\n\nfunction addDays(date: string, days: number): string {\n  const value = new Date(`${date}T00:00:00+08:00`);\n  value.setUTCDate(value.getUTCDate() + days);\n  return new Intl.DateTimeFormat(\"sv-SE\", { timeZone: \"Asia/Shanghai\" }).format(value);\n}\n\nfunction ageDays(snapshotDate: string, productionDate: string): number {\n  if (!productionDate) return 0;\n  const snapshot = Date.parse(`${snapshotDate}T00:00:00+08:00`);\n  const production = Date.parse(`${productionDate}T00:00:00+08:00`);\n  return Number.isFinite(snapshot) && Number.isFinite(production) ? Math.max(0, Math.floor((snapshot - production) / 86_400_000)) : 0;\n}\n\nfunction shanghaiTimestamp(value: string): string {\n  const date = new Date(value);\n  if (!Number.isFinite(date.getTime())) return value;\n  const parts = new Intl.DateTimeFormat(\"sv-SE\", {\n    timeZone: \"Asia/Shanghai\",\n    year: \"numeric\",\n    month: \"2-digit\",\n    day: \"2-digit\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    hourCycle: \"h23\",\n  }).format(date);\n  return `${parts} CST`;\n}\n\nfunction latestTimestamp(values: unknown[]): string {\n  return values.map((value) => text(value)).filter(Boolean).sort((left, right) => Date.parse(right) - Date.parse(left))[0] ?? \"\";\n}\n\nfunction freshness(timestamp: string, now: Date): \"fresh\" | \"stale\" {\n  const sourceTime = Date.parse(timestamp);\n  return Number.isFinite(sourceTime) && now.getTime() - sourceTime <= 2 * 60 * 60 * 1000 ? \"fresh\" : \"stale\";\n}\n\nfunction severityForShortage(shortage: number, ordered: number): \"正常\" | \"临期\" | \"缺口\" {\n  if (shortage <= 0) return \"正常\";\n  return ordered > 0 && shortage / ordered >= 0.2 ? \"缺口\" : \"临期\";\n}\n\nexport async function loadWarehouseSnapshot(\n  warehouseId: WarehouseId,\n  database: WarehouseSnapshotDatabase = getDatabase(),\n  now = new Date(),\n  planningDatabase: WarehouseSnapshotDatabase = database,\n  inventoryDetail: \"full\" | \"summary\" = \"full\",\n): Promise<WarehouseSnapshot> {\n  const calculationDate = new Intl.DateTimeFormat(\"en-CA\", { timeZone: \"Asia/Shanghai\", year: \"numeric\", month: \"2-digit\", day: \"2-digit\" }).format(now);\n  if (!isWarehouseId(warehouseId)) throw new WarehouseSnapshotDataError(\"不支持的分仓范围\");\n  const catalog = await loadWarehouseCatalog(database);\n  const source = catalog.warehouses.find((item) => item.id === warehouseId);\n  if (!source) throw new WarehouseSnapshotDataError(\"该分仓在最新数据库目录中不存在或库存映射尚未完成\");\n\n  const planPromise = Promise.all([\n    database.query(`WITH \"latest\" AS (\n  SELECT\n    MAX(\"agents_scm_branch_plan\".\"plan_snapshot_date\") AS \"snapshot_date\"\n  FROM \"agents_scm_branch_plan\" AS \"agents_scm_branch_plan\"\n)\nSELECT\n  CAST(\"p\".\"plan_snapshot_date\" AS TEXT) AS \"plan_snapshot_date\",\n  CAST(\"p\".\"target_month\" AS TEXT) AS \"target_month\",\n  \"p\".\"plan_version\" AS \"plan_version\",\n  \"p\".\"plan_source\" AS \"plan_source\",\n  \"p\".\"plan_status\" AS \"plan_status\",\n  \"p\".\"material_code\" AS \"material_code\",\n  \"p\".\"material_name\" AS \"material_name\",\n  \"p\".\"product_categ_name\" AS \"product_categ_name\",\n  \"p\".\"current_inventory_qty\" AS \"current_inventory_qty\",\n  \"p\".\"replenishment_cycle_days\" AS \"replenishment_cycle_days\",\n  \"p\".\"cycle_rule_source\" AS \"cycle_rule_source\",\n  \"p\".\"bi_target_amount\" AS \"bi_target_amount\",\n  \"p\".\"bi_target_status\" AS \"bi_target_status\",\n  CAST((\n    CAST(\"p\".\"target_growth_rate\" AS TEXT)\n  ) AS DECIMAL) AS \"target_growth_rate\",\n  \"p\".\"reference_shipment_qty\" AS \"reference_shipment_qty\",\n  \"p\".\"history_same_period_growth_rate\" AS \"history_same_period_growth_rate\",\n  \"p\".\"recent_three_month_growth_rate\" AS \"recent_three_month_growth_rate\",\n  \"p\".\"branch_growth_rate\" AS \"branch_growth_rate\",\n  \"p\".\"shipment_plan_qty\" AS \"shipment_plan_qty\",\n  \"p\".\"transfer_plan_qty\" AS \"transfer_plan_qty\",\n  \"p\".\"expected_month_end_inventory_qty\" AS \"expected_month_end_inventory_qty\",\n  \"p\".\"updated_time\" AS \"updated_time\"\nFROM \"agents_scm_branch_plan\" AS \"p\"\nJOIN \"latest\" AS \"latest\"\n  ON \"latest\".\"snapshot_date\" = \"p\".\"plan_snapshot_date\"\nWHERE\n  TRIM(\"p\".\"branch_pickup_point\") = $1\nORDER BY\n  \"p\".\"target_month\",\n  \"p\".\"material_code\"`, [source.branchPickupPoint]),\n    planningDatabase.query(`\n    SELECT\n      ${planningDatabase === database ? \"to_regclass('data_service.agents_scm_order_fulfillment')\" : \"'data_service.agents_scm_order_fulfillment'::text\"} AS order_fulfillment,\n      to_regclass('data_service.agent_branch_plan_import') AS imported_plans,\n      to_regclass('data_service.agent_branch_cycle_config') AS cycle_config\n  `),\n  ]);\n\n  const independentQueries = [\n    queryBusinessDatabase(database, inventoryDetail === \"summary\" ? `WITH \"latest\" AS (\n  SELECT\n    MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"snapshot_date\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n), \"inventory_batches\" AS (\n  SELECT\n    \"i\".\"snapshot_date\" AS \"snapshot_date\",\n    \"i\".\"material_code\" AS \"material_code\",\n    \"i\".\"prod_date\" AS \"prod_date\",\n    MAX(\"i\".\"material_name\") AS \"material_name\",\n    MAX(\"i\".\"product_categ_name\") AS \"product_categ_name\",\n    SUM(\"i\".\"live_qty\") AS \"live_qty\",\n    CASE WHEN COUNT(\"i\".\"available_qty\") = COUNT(*) THEN SUM(\"i\".\"available_qty\") END AS \"available_qty\",\n    MAX(\"i\".\"updated_time\") AS \"updated_time\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  JOIN \"latest\" AS \"latest\"\n    ON \"latest\".\"snapshot_date\" = \"i\".\"snapshot_date\"\n  WHERE\n    COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), '')) = $1\n  GROUP BY\n    \"i\".\"snapshot_date\",\n    \"i\".\"material_code\",\n    \"i\".\"prod_date\"\n)\nSELECT\n  CAST(\"inventory_batches\".\"snapshot_date\" AS TEXT) AS \"snapshot_date\",\n  \"inventory_batches\".\"material_code\" AS \"material_code\",\n  MAX(\"inventory_batches\".\"material_name\") AS \"material_name\",\n  MAX(\"inventory_batches\".\"product_categ_name\") AS \"product_categ_name\",\n  SUM(\"inventory_batches\".\"live_qty\") AS \"live_qty\",\n  CASE\n    WHEN COUNT(\"inventory_batches\".\"available_qty\") = COUNT(*)\n    THEN SUM(\"inventory_batches\".\"available_qty\")\n  END AS \"available_qty\",\n  MAX(\"inventory_batches\".\"updated_time\") AS \"updated_time\",\n  SUM(\n    CASE\n      WHEN \"inventory_batches\".\"live_qty\" > 0\n      THEN \"inventory_batches\".\"live_qty\"\n      ELSE 0\n    END\n  ) AS \"positive_qty\",\n  SUM(\n    CASE\n      WHEN \"inventory_batches\".\"live_qty\" > 0\n      AND \"inventory_batches\".\"prod_date\" IS NOT NULL\n      AND GREATEST(\n        0,\n        CAST(\"inventory_batches\".\"snapshot_date\" AS DATE) - CAST(\"inventory_batches\".\"prod_date\" AS DATE)\n      ) < 30\n      THEN \"inventory_batches\".\"live_qty\"\n      ELSE 0\n    END\n  ) AS \"age_0_30_qty\",\n  SUM(\n    CASE\n      WHEN \"inventory_batches\".\"live_qty\" > 0\n      AND CAST(\"inventory_batches\".\"snapshot_date\" AS DATE) - CAST(\"inventory_batches\".\"prod_date\" AS DATE) >= 30\n      AND CAST(\"inventory_batches\".\"snapshot_date\" AS DATE) - CAST(\"inventory_batches\".\"prod_date\" AS DATE) < 60\n      THEN \"inventory_batches\".\"live_qty\"\n      ELSE 0\n    END\n  ) AS \"age_30_60_qty\",\n  SUM(\n    CASE\n      WHEN \"inventory_batches\".\"live_qty\" > 0\n      AND CAST(\"inventory_batches\".\"snapshot_date\" AS DATE) - CAST(\"inventory_batches\".\"prod_date\" AS DATE) >= 60\n      AND CAST(\"inventory_batches\".\"snapshot_date\" AS DATE) - CAST(\"inventory_batches\".\"prod_date\" AS DATE) < 90\n      THEN \"inventory_batches\".\"live_qty\"\n      ELSE 0\n    END\n  ) AS \"age_60_90_qty\",\n  SUM(\n    CASE\n      WHEN \"inventory_batches\".\"live_qty\" > 0 AND \"inventory_batches\".\"prod_date\" IS NULL\n      THEN \"inventory_batches\".\"live_qty\"\n      ELSE 0\n    END\n  ) AS \"unknown_age_qty\",\n  SUM(\n    CASE\n      WHEN \"inventory_batches\".\"live_qty\" > 0\n      THEN \"inventory_batches\".\"live_qty\" * GREATEST(\n        0,\n        CAST(\"inventory_batches\".\"snapshot_date\" AS DATE) - CAST(\"inventory_batches\".\"prod_date\" AS DATE)\n      )\n      ELSE 0\n    END\n  ) AS \"weighted_age\",\n  SUM(\n    CASE\n      WHEN \"inventory_batches\".\"live_qty\" > 0\n      AND CAST(\"inventory_batches\".\"snapshot_date\" AS DATE) - CAST(\"inventory_batches\".\"prod_date\" AS DATE) >= 60\n      THEN \"inventory_batches\".\"live_qty\"\n      ELSE 0\n    END\n  ) AS \"big_date_qty\",\n  SUM(\n    CASE\n      WHEN \"inventory_batches\".\"live_qty\" > 0\n      AND CAST(\"inventory_batches\".\"snapshot_date\" AS DATE) - CAST(\"inventory_batches\".\"prod_date\" AS DATE) >= 90\n      THEN \"inventory_batches\".\"live_qty\"\n      ELSE 0\n    END\n  ) AS \"stagnant_qty\",\n  MAX(\n    CASE\n      WHEN \"inventory_batches\".\"live_qty\" > 0\n      THEN GREATEST(\n        0,\n        CAST(\"inventory_batches\".\"snapshot_date\" AS DATE) - CAST(\"inventory_batches\".\"prod_date\" AS DATE)\n      )\n      ELSE 0\n    END\n  ) AS \"max_age_days\",\n  COUNT(*) FILTER(WHERE\n    \"inventory_batches\".\"live_qty\" < 0) AS \"negative_batch_count\"\nFROM \"inventory_batches\" AS \"inventory_batches\"\nGROUP BY\n  \"inventory_batches\".\"snapshot_date\",\n  \"inventory_batches\".\"material_code\"\nORDER BY\n  \"material_code\",\n  \"inventory_batches\".\"snapshot_date\",\n  \"inventory_batches\".\"material_code\"` : `WITH \"latest\" AS (\n  SELECT\n    MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"snapshot_date\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n)\nSELECT\n  CAST(\"i\".\"snapshot_date\" AS TEXT) AS \"snapshot_date\",\n  \"i\".\"material_code\" AS \"material_code\",\n  MAX(\"i\".\"material_name\") AS \"material_name\",\n  MAX(\"i\".\"product_categ_name\") AS \"product_categ_name\",\n  CAST(\"i\".\"prod_date\" AS TEXT) AS \"prod_date\",\n  SUM(\"i\".\"live_qty\") AS \"live_qty\",\n  CASE WHEN COUNT(\"i\".\"available_qty\") = COUNT(*) THEN SUM(\"i\".\"available_qty\") END AS \"available_qty\",\n  MAX(\"i\".\"updated_time\") AS \"updated_time\"\nFROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\nJOIN \"latest\" AS \"latest\"\n  ON \"latest\".\"snapshot_date\" = \"i\".\"snapshot_date\"\nWHERE\n  COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), '')) = $1\nGROUP BY\n  \"i\".\"snapshot_date\",\n  \"i\".\"material_code\",\n  \"i\".\"prod_date\"\nORDER BY\n  \"material_code\",\n  \"i\".\"prod_date\",\n  \"i\".\"snapshot_date\",\n  \"i\".\"material_code\"`, [source.pickupPointCode], { pageSize: 100, groupBy: [\"material_code\"], orderBy: inventoryDetail === \"summary\" ? [\"material_code\"] : [\"material_code\", \"prod_date\"] }),\n    // Keep snapshot and warehouse scope as independent scalar/array subqueries:\n    // PostgreSQL can combine the two operation-scope indexes without scanning the whole snapshot.\n    queryBusinessDatabase(database, `WITH \"scope_warehouses\" AS (\n  SELECT DISTINCT\n    \"i\".\"warehouseid\" AS \"warehouseid\"\n  FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n  WHERE\n    \"i\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n    )\n    AND COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), '')) = $1\n)\nSELECT\n  CAST(\"o\".\"snapshot_date\" AS TEXT) AS \"snapshot_date\",\n  CAST(\"o\".\"period_month\" AS TEXT) AS \"period_month\",\n  CAST(\"o\".\"business_date\" AS TEXT) AS \"business_date\",\n  \"o\".\"metric_group\" AS \"metric_group\",\n  \"o\".\"metric_name\" AS \"metric_name\",\n  \"o\".\"material_code\" AS \"material_code\",\n  MAX(\"o\".\"material_name\") AS \"material_name\",\n  \"o\".\"base_group_id\" AS \"base_group_id\",\n  \"o\".\"base_group_name\" AS \"base_group_name\",\n  CASE\n    WHEN (\n      \"o\".\"metric_group\" = 'branch_activity'\n      OR \"o\".\"metric_name\" IN ('in_transit_qty', 'verified_in_transit_qty')\n    )\n    AND COUNT(*) FILTER(WHERE\n      \"o\".\"metric_value\" IS NULL OR \"o\".\"metric_value\" < 0) > 0\n    THEN NULL\n    WHEN \"o\".\"metric_group\" = 'warehouse_examine'\n    THEN AVG(\"o\".\"metric_value\")\n    ELSE SUM(\"o\".\"metric_value\")\n  END AS \"metric_value\",\n  MAX(\"o\".\"updated_time\") AS \"updated_time\"\nFROM \"agents_scm_branch_operation_fact\" AS \"o\"\nWHERE\n  (\n    COALESCE(NULLIF(TRIM(\"o\".\"pickup_point\"), ''), NULLIF(TRIM(\"o\".\"self_pickup_point\"), '')) = $1\n    OR \"o\".\"warehouseid\" IN (\n      SELECT\n        \"scope_warehouses\".\"warehouseid\" AS \"warehouseid\"\n      FROM \"scope_warehouses\" AS \"scope_warehouses\"\n    )\n  )\n  AND (\n    \"o\".\"metric_name\" IN ('in_transit_qty', 'verified_in_transit_qty')\n    OR (\n      \"o\".\"metric_group\" = 'branch_activity'\n      AND \"o\".\"period_month\" = CAST(DATE_TRUNC('MONTH', CAST($3 AS DATE)) AS DATE)\n    )\n    OR (\n      \"o\".\"metric_group\" = 'warehouse_cost'\n      AND \"o\".\"period_month\" = CAST(DATE_TRUNC('MONTH', CAST($2 AS DATE)) AS DATE)\n    )\n    OR (\n      NOT \"o\".\"metric_group\" IN ('warehouse_cost', 'branch_activity')\n      AND \"o\".\"period_month\" = CAST(DATE_TRUNC('MONTH', CAST($2 AS DATE)) AS DATE)\n    )\n  )\nGROUP BY\n  \"o\".\"snapshot_date\",\n  \"o\".\"period_month\",\n  \"o\".\"business_date\",\n  \"o\".\"metric_group\",\n  \"o\".\"metric_name\",\n  \"o\".\"material_code\",\n  \"o\".\"base_group_id\",\n  \"o\".\"base_group_name\"\nORDER BY\n  \"metric_group\",\n  \"metric_name\",\n  \"material_code\",\n  \"o\".\"period_month\",\n  \"o\".\"business_date\",\n  \"base_group_id\",\n  \"base_group_name\",\n  \"o\".\"snapshot_date\",\n  \"o\".\"metric_group\",\n  \"o\".\"metric_name\",\n  \"o\".\"material_code\",\n  \"o\".\"base_group_id\",\n  \"o\".\"base_group_name\"`, [source.pickupPointCode, addDays(calculationDate, -1), calculationDate], { pageSize: 100, groupBy: [\"metric_group\", \"metric_name\"], orderBy: [\"metric_group\", \"metric_name\", \"material_code\", \"period_month\", \"business_date\", \"base_group_id\", \"base_group_name\", \"snapshot_date\"] }),\n    database.query(`WITH \"latest\" AS (\n  SELECT\n    MAX(\"agents_scm_branch_pending_order\".\"source_snapshot_time\") AS \"snapshot_time\"\n  FROM \"agents_scm_branch_pending_order\" AS \"agents_scm_branch_pending_order\"\n)\nSELECT\n  \"p\".\"source_snapshot_time\" AS \"source_snapshot_time\",\n  \"p\".\"executeorderno\" AS \"executeorderno\",\n  \"p\".\"material_code\" AS \"material_code\",\n  SUM(\n    CASE\n      WHEN \"p\".\"order_stage\" = 'PREPARED_UNSHIPPED'\n      THEN \"p\".\"allocated_qty\"\n      ELSE \"p\".\"order_qty\"\n    END\n  ) AS \"order_qty\",\n  CASE\n    WHEN COUNT(*) FILTER(WHERE\n      \"p\".\"order_stage\" IS NULL\n      OR (\n        \"p\".\"order_stage\" = 'PREPARING' AND \"p\".\"order_qty\" IS NULL\n      )) > 0\n    THEN NULL\n    ELSE SUM(CASE WHEN \"p\".\"order_stage\" = 'PREPARING' THEN \"p\".\"order_qty\" ELSE 0 END)\n  END AS \"preparing_qty\",\n  CASE\n    WHEN COUNT(*) FILTER(WHERE\n      \"p\".\"order_stage\" IS NULL\n      OR (\n        \"p\".\"order_stage\" = 'PREPARING'\n        AND (\n          \"p\".\"order_qty\" IS NULL\n          OR \"p\".\"allocated_qty\" IS NULL\n          OR \"p\".\"order_qty\" < 0\n          OR \"p\".\"allocated_qty\" < 0\n          OR \"p\".\"allocated_qty\" > \"p\".\"order_qty\"\n        )\n      )) > 0\n    THEN NULL\n    ELSE SUM(CASE WHEN \"p\".\"order_stage\" = 'PREPARING' THEN \"p\".\"allocated_qty\" ELSE 0 END)\n  END AS \"preparing_allocated_qty\",\n  MAX(CAST(\"p\".\"cust_name\" AS TEXT)) AS \"cust_name\",\n  MAX(CAST(\"p\".\"cust_code\" AS TEXT)) AS \"cust_code\",\n  CASE\n    WHEN COUNT(DISTINCT REPLACE(CAST(\"p\".\"required_delivery_at\" AS TEXT), ' ', 'T')) = 1\n    THEN MAX(REPLACE(CAST(\"p\".\"required_delivery_at\" AS TEXT), ' ', 'T'))\n  END AS \"required_delivery_at\",\n  SUM(\"p\".\"allocated_qty\") AS \"allocated_qty\",\n  COUNT(*) FILTER(WHERE\n    \"p\".\"order_stage\" IS NULL) AS \"legacy_count\",\n  MAX(\"p\".\"updated_time\") AS \"updated_time\"\nFROM \"agents_scm_branch_pending_order\" AS \"p\"\nJOIN \"latest\" AS \"latest\"\n  ON \"latest\".\"snapshot_time\" = \"p\".\"source_snapshot_time\"\nWHERE\n  TRIM(\"p\".\"pickup_point\") = $1\n  AND (\n    \"p\".\"order_stage\" IN ('PREPARING', 'PREPARED_UNSHIPPED')\n    OR \"p\".\"order_stage\" IS NULL\n  )\nGROUP BY\n  \"p\".\"source_snapshot_time\",\n  \"p\".\"executeorderno\",\n  \"p\".\"material_code\"\nORDER BY\n  \"executeorderno\",\n  \"material_code\",\n  \"p\".\"source_snapshot_time\",\n  \"p\".\"executeorderno\",\n  \"p\".\"material_code\"`, [source.pickupPointCode]),\n    database.query(`/* branch:monthly-fulfillment */\nSELECT\n  SUM(\"f\".\"metric_value\") FILTER(WHERE\n    \"f\".\"metric_name\" = 'order_qty') AS \"order_qty\",\n  SUM(\"f\".\"metric_value\") FILTER(WHERE\n    \"f\".\"metric_name\" = 'shipped_qty') AS \"shipped_qty\",\n  MAX(\"f\".\"updated_time\") AS \"updated_time\"\nFROM \"agents_scm_branch_operation_fact\" AS \"f\"\nWHERE\n  \"f\".\"pickup_point\" = $1\n  AND \"f\".\"metric_group\" = 'branch_fulfillment'\n  AND \"f\".\"period_month\" = CAST(DATE_TRUNC('MONTH', CAST($2 AS DATE)) AS DATE)`, [source.pickupPointCode, addDays(calculationDate, -1)]),\n    database.query(`/* branch:actual-outbound-30d */\nSELECT\n  \"agents_scm_branch_operation_fact\".\"material_code\" AS \"material_code\",\n  CASE\n    WHEN COUNT(*) FILTER(WHERE\n      \"agents_scm_branch_operation_fact\".\"metric_value\" IS NULL\n      OR \"agents_scm_branch_operation_fact\".\"metric_value\" < 0\n      OR \"agents_scm_branch_operation_fact\".\"business_date\" IS NULL) > 0\n    THEN NULL\n    ELSE SUM(\"agents_scm_branch_operation_fact\".\"metric_value\")\n  END AS \"outbound_qty\"\nFROM \"agents_scm_branch_operation_fact\" AS \"agents_scm_branch_operation_fact\"\nWHERE\n  \"agents_scm_branch_operation_fact\".\"pickup_point\" = $1\n  AND \"agents_scm_branch_operation_fact\".\"metric_name\" = 'out_qty_daily'\n  AND \"agents_scm_branch_operation_fact\".\"business_date\" >= CAST($2 AS DATE) - INTERVAL '29 DAYS'\n  AND \"agents_scm_branch_operation_fact\".\"business_date\" <= CAST($2 AS DATE)\nGROUP BY\n  \"agents_scm_branch_operation_fact\".\"material_code\"\nORDER BY\n  \"agents_scm_branch_operation_fact\".\"material_code\"`, [source.pickupPointCode, addDays(calculationDate, -1)]),\n  ];\n  // Observe failures immediately; the original promises are still awaited below.\n  for (const query of independentQueries) void query.catch(() => {});\n  const [planResult, optionalTables] = await planPromise;\n\n  // Choose one version for the whole warehouse/month, never a per-SKU fallback.\n  const versionPriority = (value: unknown) => text(value) === \"MONTH_START\" ? 0 : text(value) === \"ROLLING\" ? 1 : 2;\n  const selectedVersions = new Map<string, string>();\n  for (const row of [...planResult.rows].sort((a,b) => versionPriority(a.plan_version)-versionPriority(b.plan_version) || text(a.plan_version).localeCompare(text(b.plan_version)))) {\n    const month=text(row.target_month);\n    if (!selectedVersions.has(month)) selectedVersions.set(month,text(row.plan_version));\n  }\n  planResult.rows = planResult.rows.filter(row=>text(row.plan_version)===selectedVersions.get(text(row.target_month)));\n  const planDates = [...new Set(planResult.rows.map((row) => text(row.target_month)).filter(Boolean))].sort();\n  // Missing plans must not hide real stock. Calendar values label the empty\n  // plan panel only; never synthesize plan rows, quantities or snapshot dates.\n  const currentPlanDate = planDates[0] ?? `${addDays(calculationDate, -1).slice(0, 7)}-01`;\n  const nextPlanDate = planDates[1] ?? (planDates[0] || `${nextMonth(currentPlanDate.slice(0, 7))}-01`);\n  const currentPlanRows = planResult.rows.filter((row) => text(row.target_month) === currentPlanDate);\n  const planMaterialCodes = [...new Set(currentPlanRows.map((row) => text(row.material_code)).filter(Boolean))];\n  if (planResult.rows.length && (!planDates.length || !planMaterialCodes.length)) throw new WarehouseSnapshotDataError(`${source.warehouseName}最新计划缺少月份或 SKU`);\n\n  const hasOrderFulfillment = Boolean(optionalTables.rows[0]?.order_fulfillment);\n  const planningEnabled = Boolean(optionalTables.rows[0]?.imported_plans && optionalTables.rows[0]?.cycle_config);\n\n  const queries = [independentQueries[0], independentQueries[1], independentQueries[2],\n    database.query(`SELECT\n  CAST(\"p\".\"base_finish_date\" AS TEXT) AS \"base_finish_date\",\n  \"p\".\"warehouse_group_id\" AS \"warehouse_group_id\",\n  \"p\".\"warehouse_group_name\" AS \"warehouse_group_name\",\n  \"p\".\"base_name\" AS \"base_name\",\n  \"p\".\"material_code\" AS \"material_code\",\n  SUM(\"p\".\"planned_qty\") AS \"planned_qty\",\n  MAX(\"p\".\"updated_time\") AS \"updated_time\"\nFROM \"agents_scm_branch_production_plan\" AS \"p\"\nWHERE\n  \"p\".\"material_code\" IN (:list_1)\n  AND \"p\".\"base_finish_date\" >= CAST($2 AS DATE)\n  AND \"p\".\"base_finish_date\" <= CAST($2 AS DATE) + INTERVAL '6 DAYS'\nGROUP BY\n  \"p\".\"base_finish_date\",\n  \"p\".\"warehouse_group_id\",\n  \"p\".\"warehouse_group_name\",\n  \"p\".\"base_name\",\n  \"p\".\"material_code\"\nORDER BY\n  \"p\".\"base_finish_date\",\n  \"warehouse_group_name\",\n  \"material_code\",\n  \"warehouse_group_id\",\n  \"p\".\"warehouse_group_id\",\n  \"p\".\"warehouse_group_name\",\n  \"p\".\"base_name\",\n  \"p\".\"material_code\"`, [planMaterialCodes, calculationDate]),\n    independentQueries[3], independentQueries[4],\n  ];\n\n  // Details depend only on pending order keys, not inventory/operations totals.\n  const orderDetailPromise = queries[2].then(async (pendingOrderResult) => {\n  const orderNumbers = [...new Set(pendingOrderResult.rows.map((row) => text(row.executeorderno)).filter(Boolean))];\n  // GEA rejects FROM UNNEST. Keep the same paired membership test with scalar\n  // parameters: independent order/SKU IN lists would admit cross-pair matches.\n  // OR does not multiply rows when a pending order/SKU pair appears twice.\n  const orderPairs = pendingOrderResult.rows.flatMap((row) => [text(row.executeorderno), text(row.material_code)]);\n  const pairPredicate = pendingOrderResult.rows.map((_, index) =>\n    `(f.executeorderno = CAST($${3 + index * 2} AS TEXT) AND f.new_material_code = CAST($${4 + index * 2} AS TEXT))`,\n  ).join(\" OR \");\n  return hasOrderFulfillment && orderNumbers.length ? database.query(`WITH \"filtered_order_details\" AS (\n  SELECT\n    \"f\".\"executeorderno\" AS \"executeorderno\",\n    \"f\".\"new_material_code\" AS \"new_material_code\",\n    \"f\".\"new_material_name\" AS \"new_material_name\",\n    \"f\".\"cust_code\" AS \"cust_code\",\n    \"f\".\"cust_name\" AS \"cust_name\",\n    \"f\".\"header_addtime\" AS \"header_addtime\",\n    \"f\".\"qtyshipped\" AS \"qtyshipped\",\n    \"f\".\"snapshot_date\" AS \"snapshot_date\"\n  FROM \"agents_scm_order_fulfillment\" AS \"f\"\n  WHERE\n    \"f\".\"executeorderno\" IN (:list_1)\n    AND \"f\".\"warehouseid\" IN (\n      SELECT DISTINCT\n        \"i\".\"warehouseid\" AS \"warehouseid\"\n      FROM \"agents_scm_branch_inventory_snapshot\" AS \"i\"\n      WHERE\n        \"i\".\"snapshot_date\" = (\n          SELECT\n            MAX(\"agents_scm_branch_inventory_snapshot\".\"snapshot_date\") AS \"_col_0\"\n          FROM \"agents_scm_branch_inventory_snapshot\" AS \"agents_scm_branch_inventory_snapshot\"\n        )\n        AND COALESCE(NULLIF(TRIM(\"i\".\"pickup_point\"), ''), NULLIF(TRIM(\"i\".\"self_pickup_point\"), '')) = $2\n    )\n    AND \"f\".\"pick_point_type2\" = '分仓'\n    AND (\n      ${pairPredicate}\n    )\n)\nSELECT\n  \"f\".\"executeorderno\" AS \"executeorderno\",\n  \"f\".\"new_material_code\" AS \"material_code\",\n  MAX(\"f\".\"new_material_name\") AS \"material_name\",\n  MAX(\"f\".\"cust_code\") AS \"cust_code\",\n  MAX(\"f\".\"cust_name\") AS \"cust_name\",\n  CAST(CAST(MIN(\"f\".\"header_addtime\") AS DATE) AS TEXT) AS \"order_date\",\n  SUM(\"f\".\"qtyshipped\") FILTER(WHERE\n    \"f\".\"snapshot_date\" = (\n      SELECT\n        MAX(\"agents_scm_order_fulfillment\".\"snapshot_date\") AS \"_col_0\"\n      FROM \"agents_scm_order_fulfillment\" AS \"agents_scm_order_fulfillment\"\n    )) AS \"shipped_qty\"\nFROM \"filtered_order_details\" AS \"f\"\nINNER JOIN (\n  SELECT\n    \"d\".\"executeorderno\" AS \"executeorderno\",\n    \"d\".\"new_material_code\" AS \"new_material_code\",\n    CASE\n      WHEN COUNT(\"d\".\"snapshot_date\") < COUNT(*)\n      THEN NULL\n      ELSE MAX(\"d\".\"snapshot_date\")\n    END AS \"latest_snapshot\"\n  FROM \"filtered_order_details\" AS \"d\"\n  GROUP BY\n    \"d\".\"executeorderno\",\n    \"d\".\"new_material_code\"\n) AS \"latest\"\n  ON \"latest\".\"executeorderno\" = \"f\".\"executeorderno\"\n  AND \"latest\".\"new_material_code\" = \"f\".\"new_material_code\"\n  AND (\n    \"latest\".\"latest_snapshot\" = \"f\".\"snapshot_date\"\n    OR (\n      \"latest\".\"latest_snapshot\" IS NULL AND \"f\".\"snapshot_date\" IS NULL\n    )\n  )\nGROUP BY\n  \"f\".\"executeorderno\",\n  \"f\".\"new_material_code\"\nORDER BY\n  \"executeorderno\",\n  \"material_code\",\n  \"f\".\"executeorderno\",\n  \"f\".\"new_material_code\"`, [orderNumbers, source.pickupPointCode, ...orderPairs]) : { rows: [] };\n  });\n  // Product dimensions depend on inventory SKU keys and plans, not on operations or order details.\n  const productMetadataPromise = queries[0].then(inventory => hasOrderFulfillment\n    ? loadPlanProductMetadata(database, source.pickupPointCode,\n      [...new Set([...planMaterialCodes, ...inventory.rows.map(row => text(row.material_code)).filter(Boolean)])], { onConflict: \"omit\" })\n    : new Map());\n  const [[inventoryResult, operationResult, pendingOrderResult, productionResult, fulfillmentSummaryResult, dailyOutbound], orderDetailResult, planningState, monthlyShipments, budgetResult, productMetadata] = await Promise.all([\n    Promise.all(queries), orderDetailPromise,\n    planningEnabled ? readPlanningState(warehouseId, planningDatabase) : null,\n    planningEnabled ? database.query(`/* planning:monthly-shipments */\nSELECT\n  \"f\".\"material_code\" AS \"sku\",\n  CASE\n    WHEN COUNT(*) FILTER(WHERE\n      \"f\".\"metric_value\" IS NULL) > 0\n    THEN NULL\n    ELSE SUM(\"f\".\"metric_value\")\n  END AS \"shipped_qty\"\nFROM \"agents_scm_branch_operation_fact\" AS \"f\"\nWHERE\n  \"f\".\"pickup_point\" = $1\n  AND \"f\".\"metric_group\" = 'branch_activity'\n  AND \"f\".\"metric_name\" = 'actual_shipped_qty'\n  AND \"f\".\"period_month\" = CAST($2 AS DATE)\nGROUP BY\n  \"f\".\"material_code\"\nORDER BY\n  \"sku\",\n  \"f\".\"material_code\"`, [source.pickupPointCode, currentPlanDate]) : { rows: [] },\n    queryBusinessDatabase(database, `/* branch:monthly-budgets */\nSELECT\n  \"agents_scm_branch_budget_monthly\".\"year_month\" AS \"year_month\",\n  \"agents_scm_branch_budget_monthly\".\"shipping_code\" AS \"shipping_code\",\n  \"agents_scm_branch_budget_monthly\".\"shipping_name\" AS \"shipping_name\",\n  \"agents_scm_branch_budget_monthly\".\"budget_mny\" AS \"budget_mny\",\n  \"agents_scm_branch_budget_monthly\".\"pre_mny\" AS \"pre_mny\",\n  \"agents_scm_branch_budget_monthly\".\"ly_same_mny\" AS \"ly_same_mny\",\n  \"agents_scm_branch_budget_monthly\".\"total_rate\" AS \"total_rate\",\n  \"agents_scm_branch_budget_monthly\".\"history_rate\" AS \"history_rate\",\n  \"agents_scm_branch_budget_monthly\".\"avg_3month_rate\" AS \"avg_3month_rate\",\n  \"agents_scm_branch_budget_monthly\".\"growth_factor\" AS \"growth_factor\",\n  \"agents_scm_branch_budget_monthly\".\"recent_rate_count\" AS \"recent_rate_count\",\n  \"agents_scm_branch_budget_monthly\".\"data_status\" AS \"data_status\",\n  \"agents_scm_branch_budget_monthly\".\"updated_time\" AS \"updated_time\"\nFROM \"agents_scm_branch_budget_monthly\" AS \"agents_scm_branch_budget_monthly\"\nWHERE\n  \"agents_scm_branch_budget_monthly\".\"shipping_code\" = $1\n  AND \"agents_scm_branch_budget_monthly\".\"year_month\" BETWEEN TO_CHAR(CAST($2 AS DATE) - INTERVAL '14 MONTHS', 'YYYYMM') AND TO_CHAR(CAST($2 AS DATE), 'YYYYMM')\nORDER BY\n  \"year_month\" DESC`, [source.pickupPointCode, addDays(calculationDate, -1)], { pageSize: 15 }),\n    productMetadataPromise,\n  ]);\n\n  const planBySku = new Map<string, Record<string, unknown>>();\n  const nextPlanBySku = new Map<string, Record<string, unknown>>();\n  for (const row of currentPlanRows) planBySku.set(text(row.material_code), row);\n  for (const row of planResult.rows.filter((value) => text(value.target_month) === nextPlanDate)) nextPlanBySku.set(text(row.material_code), row);\n\n  const inventoryGroups = new Map<string, { name: string; category: string; quantity: number; available: number | null; batches: InventoryBatch[]; batchSummary?: InventoryRow[\"batchSummary\"] }>();\n  const inventorySnapshotDate = text(inventoryResult.rows[0]?.snapshot_date, text(planResult.rows[0]?.plan_snapshot_date).slice(0, 10));\n  for (const row of inventoryResult.rows) {\n    const sku = text(row.material_code);\n    if (!sku) continue;\n    const group = inventoryGroups.get(sku) ?? { name: text(row.material_name, sku), category: text(row.product_categ_name, \"未分类\"), quantity: 0, available: 0, batches: [] };\n    const batchQuantity = optionalNumber(row.live_qty) ?? 0;\n    const productionDate = text(row.prod_date);\n    group.quantity += batchQuantity;\n    const available = optionalNumber(row.available_qty);\n    group.available = group.available === null || available === null ? null : group.available + available;\n    if (inventoryDetail === \"summary\") {\n      group.batchSummary = { ageBuckets: [quantity(row.age_0_30_qty), quantity(row.age_30_60_qty), quantity(row.age_60_90_qty), quantity(row.stagnant_qty)], unknownAgeQty: quantity(row.unknown_age_qty), positiveQty: quantity(row.positive_qty), weightedAge: quantity(row.weighted_age),\n        bigDateQty: quantity(row.big_date_qty), stagnantQty: quantity(row.stagnant_qty), maxAgeDays: quantity(row.max_age_days), negativeBatchCount: quantity(row.negative_batch_count) };\n    } else group.batches.push({\n      batchNo: `PG-${sku}-${productionDate || \"UNKNOWN\"}`,\n      quantity: batchQuantity,\n      availableQty: optionalNumber(row.available_qty),\n      ageDays: ageDays(inventorySnapshotDate, productionDate),\n      productionDate: productionDate || \"—\",\n    });\n    inventoryGroups.set(sku, group);\n  }\n\n  const activityBySku = new Map<string, Map<string, number | null>>();\n  for (const row of operationResult.rows) {\n    if (text(row.metric_group) !== \"branch_activity\" || !text(row.material_code)) continue;\n    const sku = text(row.material_code), name = text(row.metric_name), value = optionalNumber(row.metric_value);\n    const metrics = activityBySku.get(sku) ?? new Map<string, number | null>();\n    const previous = metrics.get(name);\n    metrics.set(name, previous === null || value === null || value < 0 ? null : (previous ?? 0) + value);\n    activityBySku.set(sku, metrics);\n  }\n  const activitySum = (sku: string, names: string[]) => sumKnownQuantities(names.map(name => activityBySku.get(sku)?.get(name) ?? null));\n  const inTransitBySku = new Map<string, number | null>();\n  // Separate, server-owned metric contract: deduplicated open ASN remaining\n  // quantities, with business-confirmed statuses and stock-unit conversion.\n  // Explicit zero rows are required; absence never means zero.\n  const verifiedTransitBySku = new Map<string, number | null>();\n  const operationNameBySku = new Map<string, string>();\n  const operationTotals = new Map<string, number>();\n  for (const row of operationResult.rows) {\n    const metricKey = `${text(row.metric_group)}:${text(row.metric_name)}`;\n    const metricValue = optionalNumber(row.metric_value);\n    if (text(row.metric_group) === \"base_supply\" && text(row.metric_name) === \"verified_in_transit_qty\" && text(row.material_code)) {\n      const sku = text(row.material_code);\n      verifiedTransitBySku.set(sku, verifiedTransitBySku.has(sku) || metricValue === null || metricValue < 0 ? null : metricValue);\n    }\n    if (metricValue !== null) operationTotals.set(metricKey, (operationTotals.get(metricKey) ?? 0) + metricValue);\n    if (text(row.metric_name) === \"in_transit_qty\" && text(row.material_code)) {\n      const sku = text(row.material_code);\n      const previous = inTransitBySku.get(sku);\n      inTransitBySku.set(sku, previous === null || metricValue === null || metricValue < 0 ? null : (previous ?? 0) + metricValue);\n      if (text(row.material_name)) operationNameBySku.set(sku, text(row.material_name));\n    }\n  }\n\n  const productionBySku = new Map<string, number>();\n  for (const row of productionResult.rows) {\n    const sku = text(row.material_code);\n    productionBySku.set(sku, (productionBySku.get(sku) ?? 0) + quantity(row.planned_qty));\n  }\n\n  const plans: PlanRow[] = currentPlanRows.map((row) => {\n    const sku = text(row.material_code);\n    const next = nextPlanBySku.get(sku);\n    return {\n      month: monthValue(currentPlanDate),\n      currentAvailable: usableSourcePlan(row),\n      currentTransferAvailable: optionalNumber(row.transfer_plan_qty) !== null,\n      nextTransferAvailable: optionalNumber(next?.transfer_plan_qty) !== null,\n      nextAvailable: usableSourcePlan(next),\n      sku,\n      productName: text(row.material_name, sku),\n      currentOutboundQty: quantity(row.shipment_plan_qty),\n      currentTransferQty: quantity(row.transfer_plan_qty),\n      nextOutboundQty: quantity(next?.shipment_plan_qty),\n      nextTransferQty: quantity(next?.transfer_plan_qty),\n      currentDailyOutboundQty: quantity(row.shipment_plan_qty) / daysInMonth(currentPlanDate),\n      nextDailyOutboundQty: quantity(next?.shipment_plan_qty) / daysInMonth(nextPlanDate),\n      source: text(row.plan_status).includes(\"MISSING\") || text(row.bi_target_status) === \"MISSING\" ? \"历史估算\" : \"BI\",\n      versionKind: text(row.plan_version).toUpperCase().includes(\"ROLLING\") ? \"rolling\" : \"month-start\",\n      versionId: `pg:${text(row.plan_snapshot_date)}:${text(row.plan_version)}:${text(next?.plan_version, \"NO_NEXT\")}`,\n      status: usableSourcePlan(row) && usableSourcePlan(next) ? \"confirmed\" : \"incomplete\",\n    };\n  });\n\n  const replenishments: ReplenishmentRow[] = currentPlanRows.map((row) => {\n    const sku = text(row.material_code);\n    const inventory = inventoryGroups.get(sku);\n    const inventoryQty = optionalNumber(inventory?.quantity ?? row.current_inventory_qty) ?? 0;\n    const availableQty = optionalNumber(inventory?.available ?? row.current_inventory_qty) ?? 0;\n    // Legacy expectedqty totals include historical ASN records. They cannot\n    // establish current unreceived stock without status/receipt-level data.\n    const inTransitQty = verifiedTransitBySku.get(sku) ?? null;\n    const monthlyDemand = quantity(row.shipment_plan_qty);\n    const plannedDailyShipment = monthlyDemand / daysInMonth(currentPlanDate);\n    const cycleDays = Math.max(1, Math.round(quantity(row.replenishment_cycle_days) || BRANCH_RULESET.defaultCycleDays));\n    const targetInventoryQty = calculateTargetInventory(plannedDailyShipment, cycleDays);\n    const recommendedQty = inTransitQty === null || !usableSourcePlan(row) ? null : Math.max(0, targetInventoryQty - availableQty - inTransitQty);\n    return {\n      sku,\n      productName: text(row.material_name, sku),\n      category: text(row.product_categ_name, \"未分类\"),\n      materialGroup: productMetadata.get(sku)?.materialGroup ?? \"未提供\",\n      inventoryQty,\n      availableQty,\n      currentAvailableQty: inventory ? inventory.available : optionalNumber(row.current_inventory_qty),\n      inTransitQty,\n      reportedInTransitQty: inTransitBySku.get(sku) ?? null,\n      transferReceivedQty: activityBySku.get(sku)?.get(\"month_received_qty\") ?? null,\n      transferPendingQty: activityBySku.get(sku)?.get(\"month_pending_qty\") ?? null,\n      transferShippedQty: activityBySku.get(sku)?.get(\"month_shipped_qty\") ?? null,\n      transferredQty: activitySum(sku, [\"month_received_qty\", \"month_pending_qty\", \"month_shipped_qty\"]),\n      openTransferQty: activitySum(sku, [\"open_pending_qty\", \"open_shipped_qty\"]),\n      monthlyDemand,\n      currentOutboundQty: usableSourcePlan(row) ? quantity(row.shipment_plan_qty) : null,\n      expectedMonthEndInventoryQty: usableSourcePlan(row) ? optionalNumber(row.expected_month_end_inventory_qty) : null,\n      plannedDailyShipment,\n      cycleDays,\n      cycleRuleLevel: text(row.cycle_rule_source).toUpperCase().includes(\"SKU\") ? \"sku\" : \"default\",\n      targetInventoryQty,\n      recommendedQty,\n      actualQty: recommendedQty,\n      reason: \"\",\n      urgent: recommendedQty !== null && recommendedQty > 0 && availableQty + (inTransitQty ?? 0) < plannedDailyShipment * BRANCH_RULESET.preparationDays,\n      dueDate: addDays(inventorySnapshotDate, Math.min(cycleDays, BRANCH_RULESET.preparationDays)),\n      baseInventoryQty: null,\n      baseCapacityQty: optionalNumber(productionBySku.get(sku)),\n    };\n  });\n\n  const replenishmentBySku = new Map(replenishments.map((row) => [row.sku, row]));\n  const inventory: InventoryRow[] = [...new Set([...inventoryGroups.keys(), ...planMaterialCodes, ...verifiedTransitBySku.keys()])].sort().map((sku) => {\n    const group = inventoryGroups.get(sku);\n    const plan = planBySku.get(sku);\n    const replenishment = replenishmentBySku.get(sku);\n    const batches = inventoryDetail === \"summary\" ? [] : group?.batches.length ? group.batches : [{ batchNo: `PG-${sku}-NO-STOCK`, quantity: 0, ageDays: 0, productionDate: \"—\" }];\n    const inventoryQty = group?.quantity ?? quantity(plan?.current_inventory_qty);\n    const inTransitQty = verifiedTransitBySku.get(sku) ?? null;\n    const plannedDaily = replenishment?.plannedDailyShipment ?? 0;\n    return {\n      sku,\n      productName: group?.name || text(plan?.material_name, operationNameBySku.get(sku) || sku),\n      category: group?.category || text(plan?.product_categ_name, \"未分类\"),\n      materialGroup: productMetadata.get(sku)?.materialGroup ?? \"未提供\",\n      quantity: inventoryQty,\n      availableQty: group?.available ?? null,\n      inTransitQty,\n      reportedInTransitQty: inTransitBySku.get(sku) ?? null,\n      // Order-stage quantities are separate from verified physical in-transit stock.\n      orderedNotShippedQty: activityBySku.get(sku)?.get(\"open_pending_qty\") ?? null,\n      shippedNotReceivedQty: activityBySku.get(sku)?.get(\"open_shipped_qty\") ?? null,\n      turnoverDays: null, // Filled only from the dated actual outbound measure below.\n      batches,\n      ...(inventoryDetail === \"summary\" ? { batchSummary: group?.batchSummary ?? { positiveQty: 0, weightedAge: 0, bigDateQty: 0, stagnantQty: 0, maxAgeDays: 0, negativeBatchCount: 0 } } : {}),\n    };\n  });\n\n  const orderDetailByKey = new Map(orderDetailResult.rows.map((row) => [`${text(row.executeorderno)}:${text(row.material_code)}`, row]));\n  const orderGroups = new Map<string, CustomerOrder>();\n  for (const row of pendingOrderResult.rows) {\n    const orderNo = text(row.executeorderno);\n    const sku = text(row.material_code);\n    const detail = orderDetailByKey.get(`${orderNo}:${sku}`);\n    const orderedQty = quantity(row.order_qty);\n    const allocatedQty = Math.min(orderedQty, quantity(row.allocated_qty));\n    const actualShippedQty = optionalNumber(detail?.shipped_qty);\n    const shortageQty = Math.max(0, orderedQty - allocatedQty);\n    const existing = orderGroups.get(orderNo) ?? {\n      orderNo,\n      customer: text(row.cust_name, text(detail?.cust_name, text(row.cust_code, text(detail?.cust_code, \"客户信息未提供\")))),\n      requestedDate: text(row.required_delivery_at).slice(0, 10) || \"—\", // Only the authoritative requested delivery date.\n      status: \"正常\",\n      lines: [],\n    };\n    existing.lines.push({\n      sku,\n      productName: text(detail?.material_name, inventoryGroups.get(sku)?.name || text(planBySku.get(sku)?.material_name, sku)),\n      orderedQty,\n      preparingQty: optionalNumber(row.preparing_qty),\n      preparingAllocatedQty: optionalNumber(row.preparing_allocated_qty),\n      allocatedQty,\n      shippedQty: actualShippedQty,\n      shortageQty,\n    });\n    const totalOrdered = existing.lines.reduce((sum, line) => sum + line.orderedQty, 0);\n    const totalShortage = existing.lines.reduce((sum, line) => sum + line.shortageQty, 0);\n    existing.status = severityForShortage(totalShortage, totalOrdered);\n    orderGroups.set(orderNo, existing);\n  }\n  const orders = [...orderGroups.values()];\n  for (const row of replenishments) {\n    const lines = orders.flatMap(order => order.lines).filter(line => line.sku === row.sku);\n    row.preparingQty = lines.some(line => line.preparingQty == null) ? null : lines.reduce((sum, line) => sum + (line.preparingQty ?? 0), 0);\n  }\n\n\n  const productionByBase = new Map<string, { quantity: number; latestDate: string }>();\n  for (const row of productionResult.rows) {\n    const baseName = text(row.base_name, text(row.warehouse_group_name, text(row.warehouse_group_id, \"未命名基地\")));\n    const current = productionByBase.get(baseName) ?? { quantity: 0, latestDate: inventorySnapshotDate };\n    current.quantity += quantity(row.planned_qty);\n    if (text(row.base_finish_date) > current.latestDate) current.latestDate = text(row.base_finish_date);\n    productionByBase.set(baseName, current);\n  }\n  const recommendedTotal = replenishments.length ? sumKnownQuantities(replenishments.map((row) => row.recommendedQty)) : null;\n  const baseResources: BaseResource[] = [...productionByBase.entries()].map(([baseName, value]) => {\n    const leadTimeDays = null; // Production dates do not establish transport lead time.\n    return {\n      baseName,\n      materialGroup: \"PG 基地生产计划覆盖当前补货 SKU\",\n      availableQty: null,\n      capacityQty: integerQuantity(value.quantity),\n      leadTimeDays,\n      status: \"关注\",\n    };\n  });\n\n  const allBatches = inventory.flatMap((row) => row.batches.map((batch) => ({ ...batch, sku: row.sku })));\n  const inventoryQty = sumKnownQuantities([...inventoryGroups.values()].map(row => row.available));\n  const inTransitQty = sumKnownQuantities(inventory.map((row) => row.inTransitQty));\n  const transitVerified = inventory.length > 0 && inTransitQty !== null && recommendedTotal !== null;\n  const rawReportedInTransitQty = sumKnownQuantities([...inTransitBySku.values()]);\n  const positiveBatches = allBatches.filter((batch) => batch.quantity > 0);\n  const weightedAge = inventoryDetail === \"summary\" ? inventory.reduce((sum, row) => sum + (row.batchSummary?.weightedAge ?? 0), 0) : positiveBatches.reduce((sum, batch) => sum + batch.quantity * batch.ageDays, 0);\n  const positiveQty = inventoryDetail === \"summary\" ? inventory.reduce((sum, row) => sum + (row.batchSummary?.positiveQty ?? 0), 0) : positiveBatches.reduce((sum, row) => sum + row.quantity, 0);\n  const bigDate = allBatches.filter((batch) => batch.quantity > 0 && batch.ageDays >= BRANCH_RULESET.bigDateDays);\n  const stagnant = allBatches.filter((batch) => batch.quantity > 0 && batch.ageDays >= BRANCH_RULESET.stagnantDays);\n  const orderLines = orders.flatMap((order) => order.lines);\n  const allocatedQty = orderLines.reduce((sum, row) => sum + row.allocatedQty, 0);\n  const fulfillmentSummary = fulfillmentSummaryResult.rows[0];\n  const orderQty = optionalNumber(fulfillmentSummary?.order_qty);\n  const shippedQty = optionalNumber(fulfillmentSummary?.shipped_qty);\n  const shortageLines = orderLines.filter((row) => row.shortageQty > 0);\n\n  const actualBySku = new Map(dailyOutbound.rows.map(row => [text(row.material_code), optionalNumber(row.outbound_qty)]));\n  for (const row of inventory) {\n    const out = actualBySku.get(row.sku);\n    row.actualDailyOutboundQty = out == null ? null : Math.ceil(out / 30);\n    row.turnoverDays = row.availableQty != null && out != null && out > 0 ? row.availableQty / (out / 30) : null;\n  }\n  const turnoverBySku = new Map(inventory.map(row => [row.sku, row.turnoverDays]));\n  for (const row of replenishments) {\n    row.historicalTurnoverDays = turnoverBySku.get(row.sku) ?? null;\n    const out = actualBySku.get(row.sku);\n    row.actualDailyOutboundQty = out == null ? null : Math.ceil(out / 30);\n  }\n  const actualTotal = dailyOutbound.rows.reduce((sum,row) => sum + (optionalNumber(row.outbound_qty) ?? 0), 0);\n  // The warehouse denominator includes all actual shipments, including sold-out SKUs.\n  // Do not require a shipment row for every inventory SKU or average SKU ratios.\n  const turnoverDays = dailyOutbound.rows.length > 0 && dailyOutbound.rows.every(row => optionalNumber(row.outbound_qty) !== null) && inventoryQty !== null && actualTotal > 0 ? inventoryQty / (actualTotal / 30) : null;\n\n  const operations: OperationsObservation[] = [\n    {\n      id: `${warehouseId}-pg-replenishment`,\n      severity: \"高\",\n      title: transitVerified ? \"已按核实在途恢复补货计算\" : \"在途口径待核实，补货建议暂停\",\n      detail: transitVerified ? `按目标库存减可用库存及核实在途计算，建议补货 ${recommendedTotal} 件。` : \"当前在途来源为 ASN 历史预期数量累计，尚不能确定有效未收货量；补货量和紧急程度未知，不代表无需补货。\",\n      suggestedAction: transitVerified ? \"复核计划覆盖、实际补货量和调减原因后确认待办。\" : \"补齐有效 ASN 状态、实收及单位口径后重新计算，再确认业务待办。\",\n    },\n    {\n      id: `${warehouseId}-pg-order-gap`,\n      severity: shortageLines.length ? \"高\" : \"低\",\n      title: \"待处理订单分配缺口\",\n      detail: `${orders.filter(order => order.lines.some(line => line.shortageQty > 0)).length} 个订单存在分配缺口，缺口合计 ${Math.round(shortageLines.reduce((sum, row) => sum + row.shortageQty, 0))} 件。`,\n      suggestedAction: \"优先处理缺口比例高的订单，并复核可用库存。\",\n    },\n    {\n      id: `${warehouseId}-pg-flow`,\n      severity: freshness(latestTimestamp(operationResult.rows.map((row) => row.updated_time)), now) === \"stale\" ? \"中\" : \"低\",\n      title: \"仓库流量事实\",\n      detail: `本月入库 ${operationTotals.get(\"warehouse_flow:in_qty\") ?? \"待核实\"} 件、出库 ${operationTotals.get(\"warehouse_flow:out_qty\") ?? \"待核实\"} 件。`,\n      suggestedAction: \"结合库存水位和出库节奏持续观察周转变化。\",\n    },\n  ];\n  const operationsSummary = {\n    inboundQty: optionalNumber(operationTotals.get(\"warehouse_flow:in_qty\")),\n    outboundQty: optionalNumber(operationTotals.get(\"warehouse_flow:out_qty\")),\n    storageFee: optionalNumber(operationTotals.get(\"warehouse_cost:storage_fee\")),\n    transportFee: optionalNumber(operationTotals.get(\"warehouse_cost:transport_fee\")),\n  };\n  const assessmentMetricDefinitions = [\n    [\"deliveryTimelinessRate\", \"交付及时率\", \"delivery_timeliness_rate\"],\n    [\"coldChainComplianceRate\", \"冷链符合率\", \"cold_chain_compliance_rate\"],\n    [\"accurateDeliveryRate\", \"准确交付率\", \"accurate_delivery_rate\"],\n    [\"warehouseTemperatureComplianceRate\", \"库温符合率\", \"warehouse_temperature_compliance_rate\"],\n    [\"receiptConfirmationTimelinessRate\", \"回单确认及时率\", \"receipt_confirmation_timeliness_rate\"],\n    [\"freshnessRate\", \"新鲜度占比\", \"freshness_rate\"],\n  ] as const;\n  const assessmentMetrics = assessmentMetricDefinitions.map(([key, label, metricName]) => {\n    const values = operationResult.rows\n      .filter((row) => text(row.metric_group) === \"warehouse_examine\" && text(row.metric_name) === metricName)\n      .map((row) => optionalNumber(row.metric_value))\n      .filter((value): value is number => value !== null);\n    return { key, label, value: values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : null };\n  });\n  const throughput = {\n    branchShipQty: optionalNumber(operationTotals.get(\"warehouse_throughput:branch_ship_qty\")),\n    provinceShipQty: optionalNumber(operationTotals.get(\"warehouse_throughput:province_ship_qty\")),\n  };\n  const businessPeriods = { operationsMonth: addDays(calculationDate, -1).slice(0, 7), productionStart: calculationDate, productionEnd: addDays(calculationDate, 6) };\n  const monthlyBudgets = budgetResult.rows.map(row => ({\n    month: text(row.year_month).replace(/^(\\d{4})(\\d{2})$/, \"$1-$2\"),\n    shippingCode: text(row.shipping_code), shippingName: text(row.shipping_name),\n    budget: optionalNumber(row.budget_mny), previousBudget: optionalNumber(row.pre_mny), lastYearBudget: optionalNumber(row.ly_same_mny),\n    monthRate: optionalNumber(row.total_rate), yearRate: optionalNumber(row.history_rate), recentRate: optionalNumber(row.avg_3month_rate),\n    growthFactor: optionalNumber(row.growth_factor), recentRateCount: quantity(row.recent_rate_count), status: text(row.data_status, \"BUDGET_MISSING\"),\n  }));\n  const currentBudget = monthlyBudgets.find(row => row.month === businessPeriods.operationsMonth);\n  const growth = {\n    referenceShipmentQty: currentPlanRows.reduce((sum, row) => sum + quantity(row.reference_shipment_qty), 0),\n    targetGrowthRate: currentBudget?.monthRate ?? null,\n    historySamePeriodGrowthRate: currentBudget?.yearRate ?? null,\n    recentThreeMonthGrowthRate: currentBudget?.recentRate ?? null,\n    overallGrowthRate: currentBudget?.growthFactor ?? null,\n  };\n  const pendingQuality = {\n    status: !pendingOrderResult.rows.length ? \"empty\" as const : pendingOrderResult.rows.some(row => optionalNumber(row.legacy_count) === null || quantity(row.legacy_count) > 0) ? \"legacy\" as const : \"verified\" as const,\n    reason: \"备单状态新口径尚未完成同步，当前包含历史未标记订单；分配缺口仅供核对，不表示已按新备单规则筛选。\",\n  };\n  if (pendingQuality.status === \"verified\") pendingQuality.reason = \"当前订单行已按备单状态筛选；分配缺口不等同未发货量。\";\n  if (pendingQuality.status === \"empty\") pendingQuality.reason = \"当前范围没有待分配订单行，不能据此判断备单新口径已同步。\";\n\n  const sourceUpdatedTime = latestTimestamp([\n    ...planResult.rows.map((row) => row.updated_time),\n    ...inventoryResult.rows.map((row) => row.updated_time),\n    ...operationResult.rows.map((row) => row.updated_time),\n    ...pendingOrderResult.rows.map((row) => row.updated_time),\n    ...productionResult.rows.map((row) => row.updated_time),\n    ...fulfillmentSummaryResult.rows.map((row) => row.updated_time),\n    ...budgetResult.rows.map((row) => row.updated_time),\n  ]);\n  const planSnapshotDate = text(planResult.rows[0]?.plan_snapshot_date);\n  const currentVersion = text(currentPlanRows[0]?.plan_version, \"UNKNOWN\");\n  const nextVersion = text(nextPlanBySku.values().next().value?.plan_version, \"NO_NEXT\");\n  const missingStockPlans = inventory.filter((row) => row.quantity > 0 && !planBySku.has(row.sku)).length;\n  const missingShortagePlans = new Set(shortageLines.filter((row) => !planBySku.has(row.sku)).map((row) => row.sku)).size;\n  const missingOrderDetails = orders.filter((row) => row.requestedDate === \"—\" || row.customer === \"客户信息未提供\" || row.lines.some((line) => line.shippedQty === null)).length;\n  const sourceDates = {\n    库存: inventorySnapshotDate,\n    计划: planSnapshotDate,\n    运营月份: businessPeriods.operationsMonth,\n    排产范围: `${businessPeriods.productionStart} 至 ${businessPeriods.productionEnd}（含首尾）`,\n    预算更新: latestTimestamp(budgetResult.rows.map(row => row.updated_time)) || \"未提供\",\n    运营更新: latestTimestamp(operationResult.rows.map((row) => row.updated_time)) || \"未提供\",\n    履约更新: latestTimestamp(fulfillmentSummaryResult.rows.map((row) => row.updated_time)) || \"未提供\",\n  };\n  const warnings = [\n    ...(!planResult.rows.length ? [\"该分仓暂无当前同步计划；保留真实库存和订单，计划、目标及补货量未补零；基地排产仍按已有计划 SKU 关联，空结果不代表无排产。\"] : []),\n    ...(pendingQuality.status === \"legacy\" ? [pendingQuality.reason] : []),\n    ...(!currentBudget || currentBudget.status !== \"COMPLETE\" ? [\"当期预算或历史月份不完整，原始缺项保留待核实；加权增长率按入库规则计算，不重复汇总 SKU 上的预算。\"] : []),\n    `${transitVerified ? \"有效在途已按标准指标接入\" : \"有效在途未核实\"}；基地可用库存、供货关系和真实提前期未提供。生产计划量不等同可承诺产能。`,\n    \"各源数据日期不同，请展开核对；回顾周转按可用库存/近30日实际日均出库计算，缺少日出库不补零。订单要求日期来自执行单要求交付时间，缺失不以创建日期替代。\",\n    ...(missingStockPlans || missingShortagePlans ? [`${missingStockPlans} 个正库存 SKU、${missingShortagePlans} 个缺货 SKU 缺少计划，未进入补货计算，需补齐计划。`] : []),\n    ...(missingOrderDetails ? [`${missingOrderDetails}/${orders.length} 个订单明细字段不完整，未知发货量不按 0 处理。`] : []),\n    ...(plans.some((row) => row.status === \"incomplete\") ? [\"计划存在目标/月份缺失或未确认状态；历史估算不等同已确认 BI 目标。\"] : []),\n    ...(currentPlanRows.some((row) => text(row.bi_target_status) === \"READY_HISTORY_PARTIAL\") ? [\"预算历史增长数据不完整，缺项按原规则以零贡献计入加权增长率，未重新分配权重。\"] : []),\n    ...((inventoryDetail === \"summary\" ? inventory.some(row => (row.batchSummary?.negativeBatchCount ?? 0) > 0) : allBatches.some((row) => row.quantity < 0)) ? [\"源库存包含负数，现库存合计保留原值；库龄及临期数量仅统计正库存批次。\"] : []),\n  ];\n\n  const result: WarehouseSnapshot = {\n    monthlyBudgets, businessPeriods,\n    dataQuality: { warnings, sourceDates, pendingOrders: pendingQuality, inTransit: { status: transitVerified ? \"verified\" : \"unverified\", rawReportedQty: rawReportedInTransitQty, reason: transitVerified ? \"有效在途来自经状态筛选、实收核减、去重及单位统一后的标准指标；历史 ASN 总量不参与计算。\" : \"ASN 历史预期数量未核减实收和完成/取消单据；有效在途待核实，暂不生成补货建议或创建待办。\" } },\n    metricScopes: {\n      fulfillment: `${businessPeriods.operationsMonth} 订单履约（分仓运营事实表按月份、分仓汇总）；与近60天待分配缺口独立统计${fulfillmentSummary?.order_qty == null ? \"；履约数据缺失\" : \"\"}`,\n      pendingOrders: \"近60天备单中及备单完成未发货订单；备单中取订单量，备单完成未发货取占单量，完整保留无缺口订单；缺口不等于未发货量\",\n    },\n    warehouseId,\n    warehouseName: source.warehouseName,\n    region: source.region,\n    snapshotDate: inventorySnapshotDate,\n    snapshotTime: shanghaiTimestamp(sourceUpdatedTime || `${inventorySnapshotDate}T00:00:00+08:00`),\n    currentMonthLabel: monthLabel(currentPlanDate),\n    nextMonthLabel: monthLabel(nextPlanDate),\n    dataSource: \"PostgreSQL data_service 分仓库存标准表\",\n    version: `pg-${warehouseId}-${planSnapshotDate}-${sourceUpdatedTime || inventorySnapshotDate}`.slice(0, 160),\n    previewStatus: \"preview\",\n    freshness: [planResult, inventoryResult, operationResult, pendingOrderResult, fulfillmentSummaryResult].every((result) => freshness(latestTimestamp(result.rows.map((row) => row.updated_time)), now) === \"fresh\") ? \"fresh\" : \"stale\",\n    ruleTrace: {\n      solidifiedVersion: BRANCH_RULESET.solidifiedVersion,\n      businessVersion: BRANCH_RULESET.businessVersion,\n      sourcePriority: \"PG 标准表 > 已确认人工计划 > 可见降级\",\n      planVersion: `PG ${currentVersion} + ${nextVersion}`,\n      planSource: !plans.length ? \"未提供\" : plans.some((row) => row.source === \"历史估算\") ? \"历史估算\" : \"BI\",\n    },\n    inventory,\n    replenishments,\n    orders,\n    plans,\n    baseResources,\n    operationsSummary,\n    assessmentMetrics,\n    throughput,\n    growth,\n    operations,\n    businessExceptions: [],\n    metrics: {\n      inventoryQty,\n      inTransitQty,\n      orderedNotShippedQty: sumKnownQuantities(inventory.map(row => row.orderedNotShippedQty)),\n      shippedNotReceivedQty: sumKnownQuantities(inventory.map(row => row.shippedNotReceivedQty)),\n      turnoverDays,\n      previousTurnoverDays: null,\n      targetTurnoverDays: BRANCH_RULESET.defaultCycleDays + BRANCH_RULESET.preparationDays,\n      averageAgeDays: positiveQty > 0 ? Number((weightedAge / positiveQty).toFixed(1)) : 0,\n      bigDateQty: inventoryDetail === \"summary\" ? inventory.reduce((sum, row) => sum + (row.batchSummary?.bigDateQty ?? 0), 0) : bigDate.reduce((sum, batch) => sum + batch.quantity, 0),\n      bigDateSkuCount: inventoryDetail === \"summary\" ? inventory.filter(row => (row.batchSummary?.bigDateQty ?? 0) > 0).length : new Set(bigDate.map((batch) => batch.sku)).size,\n      stagnantQty: inventoryDetail === \"summary\" ? inventory.reduce((sum, row) => sum + (row.batchSummary?.stagnantQty ?? 0), 0) : stagnant.reduce((sum, batch) => sum + batch.quantity, 0),\n      stagnantSkuCount: inventoryDetail === \"summary\" ? inventory.filter(row => (row.batchSummary?.stagnantQty ?? 0) > 0).length : new Set(stagnant.map((batch) => batch.sku)).size,\n      orderQty,\n      allocatedQty,\n      shippedQty,\n      fulfillmentRate: orderQty === null || shippedQty === null ? \"—\" : formatRatio(shippedQty, orderQty),\n      recommendedQty: recommendedTotal,\n      replenishmentSkuCount: recommendedTotal === null ? null : replenishments.filter((row) => (row.recommendedQty ?? 0) > 0).length,\n      shortageQty: shortageLines.reduce((sum, row) => sum + row.shortageQty, 0),\n      shortageSkuCount: new Set(shortageLines.map((row) => row.sku)).size,\n    },\n  };\n  Object.assign(result, {permissionGaps: Object.entries({plan:planResult,inventory:inventoryResult,operation:operationResult,pending:pendingOrderResult,fulfillment:fulfillmentSummaryResult}).filter(([,r])=>(r as any).rejectedColumns?.length).map(([source])=>source)});\n  return planningState ? applyBusinessPlanning(result, planningState, new Map(monthlyShipments.rows.map(row => [text(row.sku), optionalNumber(row.shipped_qty)])), calculationDate) : result;\n}\n"},"source/inventory-light-plugins/src/governed/parameters.ts":{"blob":"e08a67b694fbf16200ed0ce6bdc96dd3f706757a","sha256":"780117245df97ff507ab4ec5e251cb2317fd39136b7df7e0ec2d0af734ec3e10","text":"/** Fixed SQL templates only. Business values always travel as named scalar parameters. */\nexport function bindGovernedSql(sql: string, values: unknown[] = []) {\n  const parameters: Record<string, string | number | boolean | null> = {};\n  const put = (name: string, value: unknown) => {\n    if (!(value === null || typeof value === 'string' || typeof value === 'boolean' ||\n      (typeof value === 'number' && Number.isFinite(value)))) throw Error('GEA_SQL_PARAMETER_INVALID');\n    parameters[name] = value;\n    return ':' + name;\n  };\n  const bound = sql.replace(/'(?:''|[^'])*'|\"(?:\"\"|[^\"])*\"|--[^\\r\\n]*|\\/\\*[\\s\\S]*?\\*\\/|:scope_(\\d+)\\b|:list_(\\d+)\\b|\\$(\\d+)\\b/g,\n    (token, scope, list, scalar) => {\n      const index = Number(scope || list || scalar);\n      if (!index) return token;\n      if (index > values.length) throw Error('GEA_SQL_PARAMETER_MISSING');\n      const value = values[index - 1];\n      if (scope) return put('scope_' + index, value === null);\n      if (list) {\n        if (value !== null && !Array.isArray(value)) throw Error('GEA_SQL_PARAMETER_INVALID');\n        // Positive IN only: empty membership matches no rows, including nullable keys.\n        const items = value === null || value.length === 0 ? [null] : value;\n        return items.map((item, i) => put(`list_${index}_${i}`, item)).join(', ');\n      }\n      return put('gea_p' + index, value);\n    });\n  return {sql: bound, parameters};\n}\n"},"source/inventory-light-plugins/src/governed/qll-projections.json":{"blob":"93c66f68a94a93958628f06152bd69ce3437601f","sha256":"6647ce7e80ba7aa9175add4024872d3df5ec557c05e6aeb68f9ed2537d9e7ea4","text":"{\n  \"BASE_SQL\": [\n    \"snapshot_date\",\n    \"base_name\",\n    \"category\",\n    \"sku\",\n    \"current_qty\",\n    \"target_qty\",\n    \"planned_daily_qty\",\n    \"external_demand_30d\",\n    \"transfer_out_30d\",\n    \"source_target_turnover_days\"\n  ],\n  \"BRANCH_SQL\": [\n    \"snapshot_date\",\n    \"branch\",\n    \"category\",\n    \"sku\",\n    \"current_qty\",\n    \"available_qty\",\n    \"planned_daily_qty\",\n    \"forecast_inventory_qty\",\n    \"target_qty\",\n    \"external_demand_30d\",\n    \"mapping_issue_count\"\n  ],\n  \"CUSTOMER_SQL\": [\n    \"snapshot_date\",\n    \"stat_date\",\n    \"cust_code\",\n    \"cust_name\",\n    \"category\",\n    \"material_code\",\n    \"current_qty\",\n    \"target_qty\",\n    \"sales_30d\",\n    \"source_conflict\"\n  ],\n  \"BASE_AGE_SQL\": [\n    \"snapshot_date\",\n    \"object_name\",\n    \"category\",\n    \"sku\",\n    \"batch\",\n    \"qty\",\n    \"age_days\"\n  ],\n  \"BRANCH_AGE_SQL\": [\n    \"snapshot_date\",\n    \"object_name\",\n    \"category\",\n    \"sku\",\n    \"batch\",\n    \"qty\",\n    \"age_days\"\n  ],\n  \"CUSTOMER_AGE_SQL\": [\n    \"snapshot_date\",\n    \"cust_code\",\n    \"object_name\",\n    \"category\",\n    \"sku\",\n    \"batch\",\n    \"qty\",\n    \"age_days\",\n    \"daily_velocity\",\n    \"source\"\n  ],\n  \"ORDER_SQL\": [\n    \"snapshot_date\",\n    \"month\",\n    \"pickup_type\",\n    \"object_name\",\n    \"category\",\n    \"sku\",\n    \"order_qty\",\n    \"order_ids\",\n    \"affected_order_ids\",\n    \"demand_qty\",\n    \"shortage_qty\",\n    \"shipped_qty\",\n    \"affected_orders\"\n  ],\n  \"ORDER_7D_SQL\": [\n    \"snapshot_date\",\n    \"month\",\n    \"pickup_type\",\n    \"object_name\",\n    \"category\",\n    \"sku\",\n    \"order_qty\",\n    \"order_ids\",\n    \"affected_order_ids\",\n    \"demand_qty\",\n    \"shortage_qty\",\n    \"shipped_qty\",\n    \"affected_orders\"\n  ],\n  \"PENDING_SQL\": [\n    \"snapshot_date\",\n    \"branch\",\n    \"sku\",\n    \"shortage_qty\",\n    \"demand_qty\",\n    \"allocated_qty\",\n    \"prepared_qty\",\n    \"legacy_count\"\n  ],\n  \"ACTIVE_CUSTOMERS_SQL\": [\n    \"cust_code\"\n  ],\n  \"TREND_SQL\": [\n    \"snapshot_date\",\n    \"layer\",\n    \"qty\"\n  ],\n  \"COMPANY_TREND_SQL\": [\n    \"snapshot_date\",\n    \"layer\",\n    \"qty\"\n  ],\n  \"ORDER_TREND_SQL\": [\n    \"snapshot_date\",\n    \"month\",\n    \"pickup_type\",\n    \"order_qty\",\n    \"demand_qty\",\n    \"shortage_qty\",\n    \"shipped_qty\",\n    \"affected_orders\"\n  ],\n  \"AGING_TREND_SQL\": [\n    \"snapshot_date\",\n    \"layer\",\n    \"average_age\"\n  ],\n  \"BASE_CURRENT_ORDER_SQL\": [\n    \"base_name\",\n    \"snapshot_date\",\n    \"order_qty\",\n    \"shortage_qty\"\n  ],\n  \"BRANCH_OUTBOUND_SQL\": [\n    \"branch\",\n    \"sku\",\n    \"category\",\n    \"snapshot_date\",\n    \"outbound_qty\"\n  ],\n  \"BRANCH_FULFILLMENT_SQL\": [\n    \"branch\",\n    \"snapshot_date\",\n    \"order_qty\",\n    \"shipped_qty\"\n  ]\n}\n"},"source/inventory-light-plugins/src/native/api.ts":{"blob":"8ddd2b455c68d819959b9359dbe16d89343f746c","sha256":"a28fa9be4569bdb847694f4760d67b567964afcb93f57dd4b2e119a84d0ecc52","text":"import { clearReadCache } from \"../data\";\nimport * as engines from \"../engine\";\nimport { call, ready, publish } from \"../channel.js\";\nimport { updateContext } from \"./context\";\ndeclare const PLUGIN_ID: string;\nconst engine = engines as any;\nconst snapshots = new Map<string, any>();\nlet identity: any;\nconst snapshot = async (warehouseId: string) => {\n  let value = snapshots.get(warehouseId);\n  if (!value) {\n    value = engine.load({ warehouseId });\n    snapshots.set(warehouseId, value);\n    value.catch(() => snapshots.delete(warehouseId));\n  }\n  return value;\n};\nasync function dispatch(url: URL, method: string, body: any, signal?: AbortSignal) {\n  const p = url.searchParams,\n    path = url.pathname;\n  if (PLUGIN_ID === \"aqkc\") {\n    if (path === \"/api/inventory/daily-report\" && method === \"GET\") {\n      const base = p.get(\"base\");\n      if (!base || base.length > 80) throw Error(\"请选择日报基地\");\n      const report = await engine.loadDailyReport([base]);\n      updateContext(\"dailyReport\", report);\n      return {report, cacheHit:false, feedback:{available:false,entries:[],warning:\"暂不支持保存日报反馈。\"}};\n    }\n\n    if (path === \"/api/inventory/dashboard\") {\n      const base = p.get(\"base\");\n      return {\n        workspace: await engine.load(\n          undefined,\n          undefined,\n          undefined,\n          base ? base.split(\",\") : undefined,\n        ),\n      };\n    }\n    if (path === \"/api/inventory/dashboard-tabs\")\n      return {\n        tabs: await engine.loadInventoryDashboardTabs(\n          undefined,\n          p.get(\"base\") ?? undefined,\n          p.get(\"category\") ?? undefined,\n          p.get(\"tab\") ?? undefined,\n          undefined,\n          undefined,\n          p.get(\"level\") ?? undefined,\n        ),\n      };\n    if (path === \"/api/inventory/details\")\n      return {\n        page: await engine.loadSafetyStockDetailPage(\n          undefined,\n          body.filters,\n          body.offset ?? 0,\n          body.pageSize ?? 10,\n        ),\n      };\n  }\n  if (PLUGIN_ID === \"fc\") {\n    if ([\"/api/replenishment-detail\",\"/api/dms-export\"].includes(path) && method === \"POST\") {\n      if (!identity?.authorizedWarehouses.includes(body.warehouseId)) throw Error(\"无权访问该分仓\");\n      const full = await snapshot(body.warehouseId);\n      if (path === \"/api/dms-export\") {\n        const adjustments=body.adjustments??[];\n        if(!Array.isArray(adjustments)||adjustments.length>50000||adjustments.some((r:any)=>!r||typeof r.sku!==\"string\"||!Number.isSafeInteger(r.actualQty)||r.actualQty<0||typeof r.reason!==\"string\")) throw Error(\"补货调整参数无效\");\n        for(const row of adjustments){const baseline=full.replenishments.find((r:any)=>r.sku===row.sku);if(baseline?.recommendedQty!=null&&row.actualQty<baseline.recommendedQty&&!row.reason.trim()) throw Error(\"调减建议量必须填写理由：\"+row.sku);}\n        const result=engine.mergeDmsAdjustments(full, adjustments);\n        return {rows:result.rows,missingQuantityCount:result.missingQuantityCount,knownQuantityTotal:result.knownQuantityTotal};\n      }\n      if(typeof body.sku !== \"string\" || !body.sku.trim() || body.sku.length>100 || ![\"transfers\",\"bases\",\"batches\"].includes(body.kind)) throw Error(\"明细参数无效\");\n      if(body.kind === \"batches\" && (typeof body.baseName !== \"string\" || !body.baseName.trim() || body.baseName.length > 100)) throw Error(\"请选择有效基地\");\n      const value = await engine.loadReplenishmentDetail(full,engine.database,{sku:body.sku,kind:body.kind,baseName:body.baseName});\n      return {snapshot:value, detail:{...value.replenishmentDetail,...(body.kind === \"bases\" ? {bases:value.baseResources} : {})}};\n    }\n\n    if (path === \"/api/session\") {\n      const [access, catalog] = await Promise.all([\n        call(\"access\"),\n        engine.catalog(),\n      ]);\n      identity = {\n        mode: \"gea\",\n        userId: access.principalId,\n        authorizedWarehouses: catalog.warehouses.map((w: any) => w.id),\n        warehouseOptions: catalog.warehouses,\n        warehouseCatalogIssues: catalog.issues,\n        warehouseScopeMode: \"gea-governed\",\n      };\n      return identity;\n    }\n    if (path === \"/api/branch-planning\" && method === \"POST\") {\n      if (!identity?.authorizedWarehouses.includes(body.warehouseId))\n        throw Error(\"无权访问该分仓\");\n      const result = await engine.applyLocalPreview(body);\n      snapshots.delete(body.warehouseId);\n      updateContext(\"localPlanning\", result);\n      return result;\n    }\n    if (path === \"/api/branch-planning\" && method === \"GET\") {\n      const month = p.get(\"month\") ?? \"\";\n      if (!/^20\\d{2}-(0[1-9]|1[0-2])$/.test(month)) throw Error(\"计划月份无效\");\n      const warehouseId = p.get(\"warehouseId\");\n      const [value, catalog] = await Promise.all([\n        snapshot(warehouseId!),\n        engine.catalog(),\n      ]);\n      const warehouse = catalog.warehouses.find(\n        (row: any) => row.id === warehouseId,\n      );\n      if (!warehouse) throw Error(\"分仓映射不可用\");\n      return {\n        rows: engine.buildPlanTemplateRows(\n          value,\n          warehouse.pickupPointCode,\n          month,\n        ),\n      };\n    }\n    if (path === \"/api/warehouse-page\") {\n      let value = await snapshot(body.warehouseId);\n      if (body.tab === \"base\")\n        value = await engine.loadBaseResourceSnapshot(\n          value,\n          engine.database,\n          body.search ?? \"\",\n        );\n      return { snapshot: engine.projectWarehousePage(value, body) };\n    }\n    if (path === \"/api/warehouse-snapshot\")\n      return { snapshot: await snapshot(p.get(\"warehouseId\")!) };\n    if (path === \"/api/warehouse-batches\") {\n      const value = await snapshot(p.get(\"warehouseId\")!);\n      const sku = value.inventory.find((row: any) => row.sku === p.get(\"sku\"));\n      return {\n        warehouseId: value.warehouseId,\n        sku: p.get(\"sku\"),\n        snapshotDate: value.snapshotDate,\n        batches: sku?.batches ?? [],\n      };\n    }\n    if (path === \"/api/conversations\" && method === \"GET\")\n      return {\n        conversations: [],\n        databaseAvailable: false,\n        source: \"DSH-native-conversation\",\n      };\n    if (path.startsWith(\"/api/conversations/\"))\n      throw Error(\"暂不支持查询已归档的业务快照。\");\n  }\n  if (PLUGIN_ID === \"qll\") {\n    if (path === \"/api/workspace/details\" && method === \"POST\") return engine.loadDetails(body, signal);\n    if (path === \"/api/workspace/trend\" && method === \"POST\") return engine.loadTrend(body, signal);\n    if (path === \"/api/workspace/history\") {\n      const workspace = await engine.loadHistory(p.get(\"workspaceId\"), signal);\n      snapshots.set(workspace.workspaceId, workspace);\n      return workspace;\n    }\n    if (path === \"/api/workspace\") {\n      const { scope, part, ...filters } = Object.fromEntries(p);\n      const workspace = await engine.load({\n        scope: scope ?? \"company\",\n        part,\n        signal,\n        filters,\n      });\n      snapshots.set(workspace.workspaceId, workspace);\n      return workspace;\n    }\n    if (path.startsWith(\"/api/workspace/snapshot/\")) {\n      const item = snapshots.get(path.split(\"/\").at(-1)!);\n      if (!item)\n        throw Error(\n          \"该历史快照不可用，请重新查询。\",\n        );\n      return item;\n    }\n    if (path === \"/api/thread\" && method === \"GET\")\n      return { threads: [], messages: [] };\n  }\n  throw Error(\n    \"暂不支持此操作，业务数据未保存或提交。\",\n  );\n}\nexport async function mountBusinessFetch() {\n  await ready;\n  window.fetch = async (input: any, init: any = {}) => {\n    const url = new URL(\n      input instanceof Request ? input.url : String(input),\n      \"https://html-plugin.local\",\n    );\n    if (url.origin !== \"https://html-plugin.local\")\n      throw Error(\"当前数据访问方式不可用，请重新打开工作台。\");\n    const method =\n      init.method ?? (input instanceof Request ? input.method : \"GET\");\n    let body = {};\n    if (init.body) body = JSON.parse(String(init.body));\n    init.signal?.throwIfAborted();\n    try {\n      const result = await dispatch(url, method, body, init.signal);\n      init.signal?.throwIfAborted();\n      if (PLUGIN_ID === 'qll' && ['/api/workspace/details','/api/workspace/trend'].includes(url.pathname)) {\n        updateContext('detail', {plugin:PLUGIN_ID,path:url.pathname,parameters:body,loadedAt:new Date().toISOString(),...result});\n        return Response.json(result);\n      }\n      updateContext(\"data\", {\n        plugin: PLUGIN_ID,\n        path: url.pathname,\n        parameters: { ...Object.fromEntries(url.searchParams), ...body },\n        loadedAt: new Date().toISOString(),\n        summary:\n          result.snapshot?.metrics ?? result.workspace?.kpis ?? result.kpis,\n        computedOverview: result.snapshot?.page?.overview,\n        sourceTrace: result.snapshot?.ruleTrace,\n        localPreview: result.snapshot?.localPreview,\n        sourceTime: result.snapshot?.snapshotTime,\n        dataQuality: result.snapshot?.dataQuality,\n        evidence: result.evidence ?? result.summary,\n      });\n      return Response.json(result);\n    } catch (e) {\n      if (init.signal?.aborted) throw e;\n      const message = (e as Error).message;\n      return Response.json(\n        {\n          error: message,\n          message,\n          errors: (e as any).errors,\n          recoverable: true,\n          sampleFallback: false,\n        },\n        { status: 503 },\n      );\n    }\n  };\n}\nexport function clearBusinessCache(identityChanged = false) {\n  clearReadCache();\n  snapshots.clear();\n  engine.clearFacts?.();\n  if (identityChanged) engine.clearPreviews?.();\n}\n"},"source/inventory-light-plugins/src/native/context.ts":{"blob":"5a19c638ecf27fce54844765dc478f786c09ce13","sha256":"f911ace5d2feb140150b13430730289a105d525a6bf11b4af0840916be280ec8","text":"import { publish } from \"../channel.js\";\ndeclare const PLUGIN_ID: string;\nconst parts = new Map<string, unknown>();\nlet timer: ReturnType<typeof setTimeout> | undefined;\nfunction bounded(value: any, depth = 0): any {\n  if (depth > 7) return \"[已省略深层字段]\";\n  if (typeof value === \"string\") return value.slice(0, 3000);\n  if (Array.isArray(value))\n    return value.length > 30\n      ? {\n          rows: value.slice(0, 30).map((v) => bounded(v, depth + 1)),\n          totalRows: value.length,\n          truncated: true,\n        }\n      : value.map((v) => bounded(v, depth + 1));\n  if (value && typeof value === \"object\")\n    return Object.fromEntries(\n      Object.entries(value)\n        .slice(0, 40)\n        .map(([k, v]) => [k, bounded(v, depth + 1)]),\n    );\n  return value;\n}\nexport function pageContext() {\n  return {\n    source: \"GEA\",\n    businessDefinitions:\n      PLUGIN_ID === \"fc\"\n        ? {\n            localWorkflow: {\n              excelTemplate: \"已实现，HTML 从 GEA 基线生成模板\",\n              excelImportPreview: \"已实现：用户在 HTML 上传 Excel、校验、应用本页预览并重算；不需要 GEA 写接口\",\n              cyclePreview: \"已实现：用户在 HTML 配置周期并重算；不需要 GEA 写接口\",\n              resetPreview: \"已实现：撤销本页计划和周期预览，恢复 GEA 基线\",\n              dmsExport: \"已实现：完整分仓系统建议合并人工草稿，调减需理由；导出前用户确认，未知数量不进入文件，不代表已提交DMS\",\n              formalSaveAndSubmit: \"未实现，需要 GEA 正式写入接口；不可与本页导入预览混淆\",\n              modelActions: \"模型可执行 filter/refresh/draft；文件上传与周期预览由用户在页面操作\",\n            },\n            navigation:\n              \"监控指标、缺货订单、补货下单、滞库消化、大日期处理旁的1至5是步骤序号，不是业务数量\",\n            replenishment:\n              \"order-net-gap-v3：订单扣减后可供库存=可用库存−(备单中量−已占用量)；目标=(周期+3)×ceil(本月出货计划/月天数)；建议=ceil(max(0,max(缺货量,目标−订单扣减后可供库存)−所有月份未完成调拨量))；必要输入缺失时未知，不按零处理\",\n            coverage:\n              \"正建议SKU数 skuCount 不等于已计算SKU数 computedCount；缺失数量使用 computedOverview.calculated.missingCount，不用总数减正建议数\",\n            periods:\n              \"当前待分配订单是近60天口径；订单满足率是本月履约口径，不可互减推算未解释的缺口\",\n            aging:\n              \"滞库与大日期集合可能重叠，不能将两个指标直接相加；缺少SKU交集就保留未知\",\n            plan: \"BI表示同步来源，其来源细分仍以sourceTrace为准，可能是历史估算；人工计划和周期仅本页预览，查看 localPreview 标识，不是 GEA 正式配置\",\n            actions:\n              \"支持读取上下文、刷新、filter 和文字草稿；filter 参数见 pageFilters；没有正式提交动作\",\n          }\n        : undefined,\n    capturedAt: new Date().toISOString(),\n    parts: Object.fromEntries(parts),\n    visibleText: document.getElementById(\"app\")?.innerText.slice(0, 16000),\n    coverage: \"当前页面与已读取结果摘要；截断的行不能用于全量汇总\",\n  };\n}\nexport function updateContext(key: string, value: unknown) {\n  const limited = bounded(value),\n    serialized = JSON.stringify(limited);\n  parts.set(\n    key,\n    serialized?.length > 18000\n      ? { truncated: true, preview: serialized.slice(0, 18000) }\n      : limited,\n  );\n  clearTimeout(timer);\n  timer = setTimeout(() => void publish(pageContext()).catch(() => {}), 350);\n}\nexport function clearContext() {\n  parts.clear();\n  clearTimeout(timer);\n}\n"},"source/inventory-light-plugins/src/native/dealer.tsx":{"blob":"fd76ec36d8f493b3372d11b224dc3af9c2e1887b","sha256":"71fbe6ede12bbeb6407c94b3e3806341d4220a9891ff47ddd5a1e50d138671a2","text":"import { WorkbenchLoading } from \"../dsh-ui/workbench-loading\";\nimport {applicablePolicies,orderTotals} from \"../dealer-order\";\nimport {DealerOverview} from \"../pages/dealer/overview\";\nimport css from \"../pages/dealer/workbench.module.css\";\nimport React, { useEffect, useRef, useState } from \"react\";\nimport {\n  Alert,\n  Button,\n  Input,\n  InputNumber,\n  Select,\n  Table,\n  Tabs,\n  Space,\n  Card,\n} from \"../dsh-ui/controls\";\nimport { loadDealerCustomers, loadDealerDemoPayload } from \"../dealer-engine\";\nimport { ask, action } from \"../channel.js\";\nimport { pageContext, updateContext } from \"./context\";\nimport { makeDraft, draftProblems } from \"../dealer-draft.ts\";\nimport { exportLocalJson } from \"./page-filter\";\nlet retainedCart: Record<string, any> = {};\nwindow.addEventListener(\"gea-identity-changed\", () => {\n  retainedCart = {};\n});\nconst display = (v: any) =>\n  v == null\n    ? \"—\"\n    : typeof v === \"number\"\n      ? v.toLocaleString(\"zh-CN\", { maximumFractionDigits: 2 })\n      : String(v);\nconst status = (v: string) =>\n  ({\n    available: \"已读取\",\n    empty: \"无记录\",\n    unavailable: \"当前账号暂无数据权限\",\n    select_customer: \"请先选择单个客户\",\n    partial: \"仅当前页\",\n  })[v] ?? v;\nexport default function Dealer() {\n  const [customers, setCustomers] = useState<any[]>([]),\n    [customer, setCustomer] = useState(\"\"),\n    [data, setData] = useState<any>(null),\n    [tab, setTab] = useState(\"customer\"),\n    [page, setPage] = useState(1),\n    [loading, setLoading] = useState(true),\n    [error, setError] = useState(\"\"),\n    [cart, setCart] = useState<Record<string, any>>(() => retainedCart),\n    [search, setSearch] = useState(\"\");\n  const [exportBusy,setExportBusy]=useState(false);\n  const [catalogSearch,setCatalogSearch]=useState(\"\");\n  const [catalogFilters,setCatalogFilters]=useState({search:\"\",category:\"\",productTag:\"\"});\n  useEffect(()=>{const timer=setTimeout(()=>{setCatalogFilters(f=>({...f,search:catalogSearch}));setPage(1)},350);return()=>clearTimeout(timer)},[catalogSearch]);\n  const [orderPanel,setOrderPanel]=useState(\"suggestion\");\n  const [view,setView]=useState(\"stock\"), [pageSize,setPageSize]=useState(10), [revision,setRevision]=useState(0);\n  const [orderBusy,setOrderBusy]=useState(false), [suggestions,setSuggestions]=useState<any[]>([]);\n  const [orderHeaders,setOrderHeaders]=useState<Record<string,{car:string;pickup:string;receive:string}>>({});\n  const header=orderHeaders[customer]??{car:\"\",pickup:\"\",receive:\"\"};\n  const setHeader=(field:string,value:string)=>setOrderHeaders(old=>({...old,[customer]:{...(old[customer]??{car:\"\",pickup:\"\",receive:\"\"}),[field]:value}}));\n  const navigate=(value:string)=>{setTab(value);setPage(1);setSearch(\"\");setView(\"stock\")};\n  useEffect(()=>{setSuggestions([])},[customer]);\n  useEffect(()=>{updateContext(\"dealerOrderHeader\",{customerCode:customer,...header,status:\"local-only\"})},[customer,orderHeaders]);\n  async function loadSuggestions(){\n    if(!customer||!data)return;\n    const scope=customer;setOrderBusy(true);setError(\"\");\n    try{\n      const result=await loadDealerDemoPayload(scope,{scope:\"single\",orderSuggestionsOnly:true,exportTab:\"sku\",snapshotDate:data.snapshotDate,planMonth:data.planMonth});\n      if(current.current.customer!==scope)return;\n      setSuggestions(result.skus);updateContext(\"dealerOrderSuggestions\",{customerCode:scope,snapshotDate:result.snapshotDate,planMonth:result.planMonth,rows:result.skus,status:\"local-only\"});setView(\"order\");\n    }catch(e){if(current.current.customer===scope)setError((e as Error).message)}finally{setOrderBusy(false)}\n  }\n\n  const loadedScope = useRef<string | null>(null);\n  const [stockCategory, setStockCategory] = useState(\"all\");\n  const [stockAction, setStockAction] = useState(\"all\");\n  useEffect(() => { setStockCategory(\"all\"); setStockAction(\"all\"); setSearch(\"\"); }, [customer, tab]);\n  const sequence = useRef(0),\n    customerSequence = useRef(0),\n    customerTimer = useRef<ReturnType<typeof setTimeout>>();\n  const current = useRef({ customer, tab, page });\n  current.current = { customer, tab, page };\n  async function findCustomers(text = \"\") {\n    const n = ++customerSequence.current;\n    try {\n      const result = await loadDealerCustomers(text, 0, 50);\n      if (n === customerSequence.current) setCustomers(result.customers);\n    } catch (e) {\n      setError((e as Error).message);\n    }\n  }\n  useEffect(() => {\n    void findCustomers();\n    return () => {\n      clearTimeout(customerTimer.current);\n      ++customerSequence.current;\n    };\n  }, []);\n  useEffect(() => {\n    let active = true;\n    const n = ++sequence.current;\n    const scopeKey = JSON.stringify([customer, tab, catalogFilters]);\n    setLoading(true);\n    // Keep the current workbench mounted for pagination within the same scope.\n    if (loadedScope.current !== scopeKey) setData(null);\n    setError(\"\");\n    loadDealerDemoPayload(customer || undefined, {\n      scope: customer ? \"single\" : \"all\",\n      companyProductsOnly: tab === \"catalog\",\n      companyProductFacets: tab === \"catalog\",\n      companyProductFilters: tab === \"catalog\" ? catalogFilters : undefined,\n      stockTab: [\"customer\", \"category\", \"sku\", \"shortage\", \"expiry\"].includes(\n        tab,\n      )\n        ? (tab as any)\n        : \"sku\",\n      detailPage: page - 1,\n      detailPageSize: pageSize,\n      customerPage: page - 1,\n      customerPageSize: pageSize,\n      shortagePage: page - 1,\n      shortagePageSize: pageSize,\n    })\n      .then((result) => {\n        if (!active || n !== sequence.current) return;\n        loadedScope.current = scopeKey;\n        setData(result);\n        updateContext(\"dealer\", {\n          customerCode: customer || null,\n          tab,\n          page,\n          snapshotDate: result.snapshotDate,\n          planMonth: result.planMonth,\n          scope: result.scopeLabel,\n          inventory: result.totalInventory,\n          recordTotal: result.recordTotal,\n          visibleRows:\n            tab === \"customer\"\n              ? result.customerSummaries\n              : tab === \"category\"\n                ? result.categorySummaries\n                : tab === \"shortage\"\n                  ? result.shortageSkus\n                  : result.skus,\n          policiesStatus: result.policiesStatus,\n          customerCarsStatus: result.customerCarsStatus,\n        });\n      })\n      .catch((e) => {\n        if (active) setError(e.message);\n      })\n      .finally(() => {\n        if (active) setLoading(false);\n      });\n    return () => {\n      active = false;\n    };\n  }, [customer, tab, page, pageSize, revision, catalogFilters]);\n  useEffect(() => {\n    action(\n      \"filter\",\n      \"按 GEA 授权客户代码和业务页签查询：{customerCode,tab,page}，tab 可为 customer/category/sku/shortage/expiry/policies/cars/pickups/receives/catalog\",\n      (args) => {\n        if (\n          !args ||\n          typeof args !== \"object\" ||\n          Array.isArray(args) ||\n          Object.keys(args).some(\n            (k) => ![\"customerCode\", \"tab\", \"page\"].includes(k),\n          )\n        )\n          throw Error(\"筛选参数无效\");\n        if (\n          args.customerCode !== undefined &&\n          (typeof args.customerCode !== \"string\" ||\n            args.customerCode.length > 100)\n        )\n          throw Error(\"客户代码无效\");\n        if (\n          args.tab &&\n          ![\n            \"customer\",\n            \"category\",\n            \"sku\",\n            \"shortage\",\n            \"expiry\",\n            \"policies\",\n            \"cars\",\n            \"pickups\",\n            \"receives\",\n            \"catalog\",\n          ].includes(args.tab)\n        )\n          throw Error(\"页签无效\");\n        if (\n          args.page !== undefined &&\n          (!Number.isInteger(args.page) || args.page < 1 || args.page > 10000)\n        )\n          throw Error(\"页码无效\");\n        setCustomer(args.customerCode ?? current.current.customer);\n        setTab(args.tab ?? current.current.tab);\n        if(args.tab)setView([\"policies\",\"cars\",\"pickups\",\"receives\"].includes(args.tab)?\"master\":\"stock\");\n        setPage(\n          args.page ??\n            (args.customerCode !== undefined || args.tab !== undefined\n              ? 1\n              : current.current.page),\n        );\n        setSearch(\"\");\n        return { querying: true };\n      },\n    );\n  }, []);\n  function add(row: any, manual = false) {\n    try {\n      const item = {...makeDraft(row, customer, manual),unitPrice:row.commerceFacts?.price??row.price??null,category:row.category,policyId:\"\"};\n      setCart((old) => (old[item.key] ? old : { ...old, [item.key]: item }));\n      setView(\"order\");\n    } catch (e) {\n      setError((e as Error).message);\n    }\n  }\n  useEffect(() => {\n    retainedCart = cart;\n    updateContext(\"purchaseDraft\", {\n      problems: draftProblems(Object.values(cart)),\n      status: \"local-only\",\n      rows: Object.values(cart),\n    });\n  }, [cart]);\n  function exportRows(items=shown, filename=\"经销商库存-当前页.csv\") {\n    const keys = columns\n      .filter((c) => c.dataIndex)\n      .map((c) => [c.title, c.dataIndex]);\n    const csv = [\n      keys.map(([title]) => title),\n      ...items.map((row: any) => keys.map(([, key]) => row[key])),\n    ]\n      .map((row) =>\n        row\n          .map(\n            (v: any) =>\n              '\"' +\n              String(v ?? \"\")\n                .replace(/^(\\s*[=+@-])/, \"'$1\")\n                .replaceAll('\"', '\"\"') +\n              '\"',\n          )\n          .join(\",\"),\n      )\n      .join(\"\\r\\n\");\n    const url = URL.createObjectURL(\n      new Blob([\"\\ufeff\", csv], { type: \"text/csv;charset=utf-8\" }),\n    );\n    const a = document.createElement(\"a\");\n    a.href = url;\n    a.download = filename;\n    a.click();\n    setTimeout(() => URL.revokeObjectURL(url), 1000);\n  }\n  function matchesStockFilters(row: any) {\n    const qty = row.suggestedStockQty;\n    const action = row.liveAction?.includes(\"核查\") || typeof qty !== \"number\" || !Number.isFinite(qty) ? \"unknown\" : qty > 0 ? \"replenish\" : \"observe\";\n    return (!search.trim() || [row.sku, row.code, row.dealerName, row.dealerCode].some(value => String(value ?? \"\").toLowerCase().includes(search.trim().toLowerCase())))\n      && (stockCategory === \"all\" || row.category === stockCategory)\n      && (tab !== \"sku\" || stockAction === \"all\" || action === stockAction);\n  }\n  async function exportCustomer(){\n    if(tab !== \"sku\") return;\n    const scope=customer; const sourceTab=tab; setExportBusy(true);setError(\"\");\n    try{\n      const result=await loadDealerDemoPayload(scope || undefined,{scope:scope?\"single\":\"all\",exportTab:\"sku\",snapshotDate:data?.snapshotDate,planMonth:data?.planMonth});\n      if(current.current.customer!==scope || current.current.tab!==sourceTab)return;\n      exportRows(result.skus.filter(matchesStockFilters),`经销商-${scope || \"全部授权客户\"}-SKU库存.csv`);\n    }catch(e){setError((e as Error).message)}finally{setExportBusy(false)}\n  }\n  const col = (title: string, dataIndex: string): any => ({\n    title,\n    dataIndex,\n    render: display,\n  });\n  const skuCols = [\n    {title:\"SKU\",width:240,render:(_:any,row:any)=><div className={css.product}><strong>{row.sku}</strong><small>{row.code}</small>{!customer&&<small>{row.dealerName||row.dealerCode}</small>}</div>},\n    {title:\"品类 / 产品系列\",render:(_:any,row:any)=><div className={css.product}><span>{row.category||\"—\"}</span><small>{row.productRange||\"—\"}</small></div>},\n    {title:\"标签 / 规格\",render:(_:any,row:any)=><div className={css.product}><span>{row.productTag||\"—\"}</span><small>{row.materialSize||\"—\"}</small></div>},\n    col(\"在仓库存\", \"stock\"),\n    col(\"在途\", \"transit\"),\n    col(\"近7日销量\", \"sales7\"),\n    col(\"近30日销量\", \"sales30\"),\n    col(\"近30日销售额\", \"publishedSalesAmount30\"),\n    col(\"统一到岸价\", \"cifPrice\"),\n    col(\"平均货龄\", \"averageAge\"),\n    col(\"目标库存\", \"targetInventory\"),\n    col(\"正常库存\", \"normalStock\"),\n    col(\"临期库存\", \"nearExpiryStock\"),\n    col(\"库存金额\", \"stockAmount\"),\n    col(\"库存日期\", \"inventorySnapshotDate\"),\n    col(\"建议补货\", \"suggestedStockQty\"),\n    col(\"依据 / 缺失\", \"liveReason\"),\n    {\n      title: \"草稿\",\n      render: (_: any, row: any) => (\n        <Space>\n          <Button\n            size=\"mini\"\n            disabled={\n              !customer ||\n              !row.suggestedStockQty ||\n              Boolean(cart[customer + \":\" + row.code])\n            }\n            onClick={() => add(row)}\n          >\n            采纳建议\n          </Button>\n          <Button\n            size=\"mini\"\n            disabled={!customer || Boolean(cart[customer + \":\" + row.code])}\n            onClick={() => add(row, true)}\n          >\n            人工选品\n          </Button>\n        </Space>\n      ),\n    },\n  ];\n  let rows: any[] = [],\n    columns: any[] = skuCols,\n    total = 0;\n  if (data) {\n    if (tab === \"customer\") {\n      rows = data.customerSummaries;\n      total = data.customerSummaryTotal;\n      columns = [\n        {title:\"名称 / 编码\",width:240,render:(_:any,row:any)=><div className={css.product}><strong>{row.name}</strong><small>{row.code}</small></div>},\n        col(\"库存\", \"stock\"),\n        col(\"临期库存\", \"nearExpiryStock\"),\n        col(\"正常库存\", \"normalStock\"),\n        col(\"库存价值\", \"stockAmount\"),\n        col(\"在途\", \"transit\"),\n        col(\"目标库存\", \"targetInventory\"),\n        {\n          title: \"查看\",\n          render: (_: any, row: any) => (\n            <Button\n              size=\"mini\"\n              onClick={() => {\n                setCustomer(row.code);\n                setSearch(\"\");\n                setPage(1);\n                setTab(\"sku\");\n              }}\n            >\n              客户明细\n            </Button>\n          ),\n        },\n      ];\n    } else if (tab === \"category\") {\n      rows = data.categorySummaries;\n      total = rows.length;\n      columns = [\n        col(\"品类\", \"category\"),\n        col(\"SKU数\", \"skuCount\"),\n        col(\"库存\", \"stock\"),\n        col(\"在途\", \"transit\"),\n        col(\"正常库存\", \"normalStock\"),\n        col(\"近30日销量\", \"sales30\"),\n        col(\"库存价值\", \"stockAmount\"),\n        col(\"临期库存\", \"nearExpiryStock\"),\n        col(\"目标库存\", \"targetInventory\"),\n      ];\n    } else if (tab === \"policies\") {\n      rows = data.policies;\n      total = rows.length;\n      columns = [\n        col(\"政策\", \"name\"),\n        col(\"类型\", \"type\"),\n        col(\"起始日\", \"start\"),\n        col(\"截止日\", \"end\"),\n        col(\"规则\", \"rule\"),\n        col(\"提货点\", \"pickupName\"),\n        col(\"可用数量\", \"usableQuantity\"),\n      ];\n    } else if (tab === \"pickups\") {\n      rows = data.customerPickupPoints ?? [];\n      total = rows.length;\n      columns = [\n        col(\"提货点代码\", \"code\"),\n        col(\"提货点\", \"name\"),\n        col(\"基地\", \"baseName\"),\n        col(\"默认\", \"isDefault\"),\n        col(\"可用\", \"available\"),\n        col(\"匹配状态\", \"matched\"),\n      ];\n    } else if (tab === \"receives\") {\n      rows = data.customerReceives ?? [];\n      total = rows.length;\n      columns = [\n        col(\"收货地址代码\", \"code\"),\n        col(\"收货方\", \"name\"),\n        col(\"地址\", \"address\"),\n        col(\"主驾驶员\", \"mainDriver\"),\n        col(\"驾驶员上限\", \"maxDriver\"),\n      ];\n    } else if (tab === \"catalog\") {\n      rows = data.companyProducts ?? [];\n      total = data.companyProductTotal ?? data.recordTotal;\n      columns = [\n        col(\"客户\", \"dealerCode\"),\n        col(\"SKU\", \"code\"),\n        col(\"商品\", \"sku\"),\n        col(\"品类\", \"category\"),\n        col(\"规格\", \"materialSize\"),\n        col(\"标签\", \"productTag\"),\n      ];\n    } else if (tab === \"cars\") {\n      rows = data.customerCars ?? [];\n      total = rows.length;\n      columns = [\n        col(\"代码\", \"code\"),\n        col(\"车型\", \"name\"),\n        col(\"仓组\", \"warehouse\"),\n        col(\"最小装载\", \"min\"),\n        col(\"最大装载\", \"max\"),\n      ];\n    } else {\n      rows = tab === \"shortage\" ? data.shortageSkus : data.skus;\n      total = tab === \"shortage\" ? data.shortageTotal : data.recordTotal;\n    }\n  }\n  const supportsStockFilters = [\"sku\", \"shortage\", \"expiry\"].includes(tab);\n  const stockCategories = Array.from(new Set(rows.map(row => row.category).filter(Boolean))) as string[];\n  const shown = supportsStockFilters ? rows.filter(matchesStockFilters) : rows;\n  const customerCart=Object.values(cart).filter((r:any)=>!customer||r.customerCode===customer);\n  const totals=orderTotals(customerCart);\n  const problems = [...draftProblems(Object.values(cart)),...customerCart.filter((r:any)=>r.policyId&&!applicablePolicies(data?.policies??[],r.customerCode,r.code,header.pickup).some((p:any)=>p.id===r.policyId)).map((r:any)=>`${r.code}：政策已不匹配当前提货点或有效期，请重新选择`)];\n  useEffect(() => {\n    updateContext(\"dealerVisiblePage\", {\n      customerCode: customer || null,\n      tab,\n      page,\n      search,\n      loaded: !loading && Boolean(data),\n      visibleRows: shown,\n      total,\n      coverage: \"仅当前筛选页，不能作为全量明细\",\n    });\n  }, [customer, tab, page, search, stockCategory, stockAction, data, loading]);\n  if (loading && !data && !error) return <WorkbenchLoading title=\"客户库存\" cards={8} compact />;\n  return (\n    <section className={css.shell}>\n      <header className={css.topbar}>\n      <nav className={css.navigation} aria-label=\"客户库存与客户订单\">\n        <button aria-current={view===\"stock\"} onClick={()=>navigate(customer?\"sku\":\"customer\")}>客户库存</button>\n        <button aria-current={view!==\"stock\"} onClick={()=>{setView(\"order\"); if(!customer && customers[0]){setCustomer(customers[0].code);setPage(1)}}}>客户订单</button>\n      </nav>\n      <div className={css.customerPicker}>\n        <details className={css.customerMenu} key={customer}>\n          <summary>{customers.find(c=>c.code===customer)?.name || customer || \"全部负责客户\"}<span aria-hidden=\"true\">⌄</span></summary>\n          <div className={css.customerOptions}>\n            <Input aria-label=\"选择客户搜索\" placeholder=\"搜索客户名称或编码\" onChange={text=>{clearTimeout(customerTimer.current); ++customerSequence.current; customerTimer.current=setTimeout(()=>void findCustomers(text),350)}}/>\n            {view === \"stock\" && <button onClick={()=>{setCustomer(\"\");setPage(1);setSearch(\"\")}}>全部负责客户</button>}\n            {customers.map(c=><button key={c.code} aria-pressed={customer===c.code} onClick={()=>{setCustomer(c.code);setPage(1);setSearch(\"\")}}><span>{c.name}</span><small>{c.code}</small></button>)}\n            {!customers.length && <small>暂无匹配客户</small>}\n          </div>\n        </details>\n        {view === \"stock\" && <small>库存快照：{data?.inventoryDateLabel||data?.snapshotDate||\"—\"}</small>}\n      </div>\n      </header>\n      {view !== \"stock\" && <nav className={css.orderNavigation} aria-label=\"客户订单内容\">\n        <button aria-current={view===\"master\"&&tab===\"catalog\"} onClick={()=>{setView(\"master\");setTab(\"catalog\");setPage(1)}}>公司商品</button>\n        <button aria-current={view===\"master\"&&tab===\"policies\"} onClick={()=>{setView(\"master\");setTab(\"policies\");setPage(1)}}>本月政策</button>\n        <button aria-current={view===\"master\"&&tab===\"sku\"} onClick={()=>{setView(\"master\");setTab(\"sku\");setPage(1)}}>当前库存</button>\n        <button aria-current={view===\"order\"} onClick={()=>setView(\"order\")}>建议订单</button>\n      </nav>}\n      {error && (\n        <Alert type=\"error\" style={{ marginTop: 16 }} content={error} />\n      )}\n      {data && view === \"stock\" && <DealerOverview data={data} onNavigate={navigate}/>}\n      {view !== \"order\" && <section className={css.listPanel} aria-label=\"库存明细与工具\">\n      {view === \"stock\" && <Tabs\n        activeTab={tab}\n        onChange={(value) => {\n          setTab(value);\n          setSearch(\"\");\n          setPage(1);\n        }}\n      >\n        {[\n          [\"customer\", \"客户库存\"],\n          [\"category\", \"品类库存\"],\n          [\"sku\", \"SKU库存\"],\n          [\"shortage\", \"缺货库存\"],\n          [\"expiry\", \"临期库存\"],\n          [\"policies\", \"促销政策\"],\n          [\"cars\", \"客户车型\"],\n          [\"pickups\", \"提货点\"],\n          [\"receives\", \"收货地址\"],\n          [\"catalog\", \"公司可售商品\"],\n        ].filter(([key])=>[\"customer\",\"category\",\"sku\",\"shortage\",\"expiry\"].includes(key)).map(([key, title]) => (\n          <Tabs.TabPane key={key} title={title} />\n        ))}\n      </Tabs>}\n      {data?.pricing?._error && (\n        <Alert type=\"warning\" content={data.pricing._error.message} />\n      )}\n      {data && [\"pickups\", \"receives\", \"catalog\"].includes(tab) && (\n        <Alert\n          content={status(\n            data[\n              tab === \"pickups\"\n                ? \"customerPickupPointsStatus\"\n                : tab === \"receives\"\n                  ? \"customerReceivesStatus\"\n                  : \"companyProductsStatus\"\n            ],\n          )}\n        />\n      )}\n      {data && [\"policies\", \"cars\"].includes(tab) && (\n        <Alert\n          content={status(\n            tab === \"policies\" ? data.policiesStatus : data.customerCarsStatus,\n          )}\n        />\n      )}\n      {tab === \"catalog\" && <div className={css.toolbar}><Input aria-label=\"商品搜索条件\" placeholder=\"商品名称或编码\" value={catalogSearch} onChange={setCatalogSearch}/><select aria-label=\"商品品类筛选\" value={catalogFilters.category} onChange={e=>{setCatalogFilters(f=>({...f,category:e.target.value}));setPage(1)}}><option value=\"\">全部品类</option>{(data?.companyProductFacets?.categories??[]).map((v:string)=><option key={v}>{v}</option>)}</select><select aria-label=\"商品标签筛选\" value={catalogFilters.productTag} onChange={e=>{setCatalogFilters(f=>({...f,productTag:e.target.value}));setPage(1)}}><option value=\"\">全部标签</option>{(data?.companyProductFacets?.tags??[]).map((v:string)=><option key={v}>{v}</option>)}</select></div>}\n      <div className={css.stockSectionHead}>\n        <h3>{({customer:\"客户库存\",category:\"品类库存\",sku:\"SKU库存\",shortage:\"缺货库存\",expiry:\"临期库存\",catalog:\"公司可售商品\",policies:\"促销政策\",cars:\"客户车型\",pickups:\"提货点\",receives:\"收货地址\"} as Record<string,string>)[tab]}</h3>\n        {supportsStockFilters && <div className={css.stockFilters}>\n          {tab === \"sku\" && <select aria-label=\"建议动作筛选\" value={stockAction} onChange={e=>setStockAction(e.target.value)}>\n            <option value=\"all\">全部建议</option><option value=\"replenish\">建议补货</option><option value=\"observe\">无需补货</option><option value=\"unknown\">待核查</option>\n          </select>}\n          <select aria-label=\"品类筛选\" value={stockCategory} onChange={e=>setStockCategory(e.target.value)}><option value=\"all\">全部品类</option>{Array.from(new Set([...stockCategories, ...(stockCategory === \"all\" ? [] : [stockCategory])])).map(category=><option key={category} value={category}>{category}</option>)}</select>\n          <Input aria-label=\"SKU筛选\" placeholder=\"SKU筛选\" value={search} onChange={setSearch}/>\n        </div>}\n        {tab === \"sku\" && <Button loading={exportBusy} disabled={!data || loading} title=\"下载当前筛选后的全部数据（CSV）\" onClick={()=>void exportCustomer()}>下载</Button>}\n      </div>\n      <Table\n        loading={loading}\n        rowKey={(row) =>\n          String(row.code ?? row.id ?? row.category) +\n          String(row.dealerCode ?? \"\")\n        }\n        columns={columns}\n        data={shown}\n        scroll={{ x: 1100 }}\n        pagination={\n          [\"customer\", \"sku\", \"shortage\", \"expiry\", \"catalog\"].includes(tab)\n            ? { current: page, pageSize, total, onChange: (nextPage: number, nextSize: number) => { setPage(nextPage); setPageSize(nextSize); } }\n            : false\n        }\n      />\n      </section>}\n      {view === \"order\" && <>\n      <div className={css.orderHeader}>\n        <nav className={css.orderPanels} aria-label=\"建议订单内容\"><button aria-current={orderPanel===\"suggestion\"} onClick={()=>setOrderPanel(\"suggestion\")}>建议订单</button><button aria-current={orderPanel===\"cart\"} onClick={()=>setOrderPanel(\"cart\")}>购物车 · {customerCart.length}</button></nav>\n        <Button disabled={!customer||loading} loading={orderBusy} onClick={()=>void loadSuggestions()}>生成建议订单</Button>\n      </div>\n      {!customer && <Alert content=\"请先选择单个客户；不同客户的商品、车型和政策不能混用。\"/>}\n      <div className={css.orderMeta}>\n        <label>客户车型<select aria-label=\"订单车型\" disabled={!customer} value={header.car} onChange={e=>setHeader(\"car\",e.target.value)}><option value=\"\">请选择车型</option>{(data?.customerCars??[]).map((r:any)=><option key={r.id||r.code} value={r.id||r.code}>{r.name} · {r.min??\"—\"}～{r.max??\"—\"}</option>)}</select></label>\n        <label>提货点<select aria-label=\"订单提货点\" disabled={!customer} value={header.pickup} onChange={e=>setHeader(\"pickup\",e.target.value)}><option value=\"\">请选择提货点</option>{(data?.customerPickupPoints??[]).map((r:any)=><option key={r.code} value={r.code}>{r.name}</option>)}</select></label>\n        <label>收货地址<select aria-label=\"订单收货地址\" disabled={!customer} value={header.receive} onChange={e=>setHeader(\"receive\",e.target.value)}><option value=\"\">请选择收货地址</option>{(data?.customerReceives??[]).map((r:any)=><option key={r.code} value={r.code}>{r.name} · {r.address}</option>)}</select></label>\n      </div>\n      {orderPanel === \"suggestion\" && <section className={css.orderBody} aria-label=\"建议订单明细\">\n      <Table rowKey=\"code\" loading={orderBusy} pagination={false} data={suggestions} columns={[\n        col(\"SKU\",\"code\"),col(\"商品\",\"sku\"),col(\"品类\",\"category\"),col(\"在仓\",\"stock\"),col(\"在途\",\"transit\"),\n        {title:\"订单建议量\",render:(_:any,r:any)=>display(r.orderRecommendation?.quantity)},\n        {title:\"计算依据\",render:(_:any,r:any)=>r.orderRecommendation?.reason??\"尚未核实\"},\n        {title:\"操作\",render:(_:any,r:any)=><Button disabled={!customer||!(r.orderRecommendation?.quantity>0)||Boolean(cart[customer+\":\"+r.code])} onClick={()=>add({...r,suggestedStockQty:r.orderRecommendation.quantity,liveReason:r.orderRecommendation.reason})}>采纳至草稿</Button>}\n      ]}/>\n      </section>}\n      {orderPanel === \"cart\" && <section className={css.orderBody} aria-label=\"购物车\">\n      <Alert content=\"草稿关闭页面后清除，尚未提交订单。人工选品需填写数量与理由。\" />\n      {problems.length > 0 && (\n        <Alert type=\"warning\" content={problems.join(\"；\")} />\n      )}\n      <Table\n        rowKey=\"key\"\n        data={customerCart}\n        pagination={false}\n        columns={[\n          col(\"客户\", \"customerCode\"),\n          col(\"SKU\", \"code\"),\n          col(\"商品\", \"name\"),\n          {\n            title: \"来源\",\n            render: (_: any, row: any) =>\n              row.source === \"manual\" ? \"人工选品\" : \"采纳建议\",\n          },\n          col(\"原建议量\", \"suggestedQuantity\"),\n          col(\"单价（元）\",\"unitPrice\"),\n          {title:\"金额（元）\",render:(_:any,r:any)=>display(r.unitPrice==null?null:r.unitPrice*r.quantity)},\n          {title:\"活动政策\",render:(_:any,r:any)=><select aria-label={\"活动政策-\"+r.code} value={r.policyId??\"\"} onChange={e=>setCart(old=>({...old,[r.key]:{...old[r.key],policyId:e.target.value}}))}><option value=\"\">不选政策</option>{applicablePolicies(data?.policies??[],r.customerCode,r.code,header.pickup).map((p:any)=><option key={p.id} value={p.id}>{p.name}</option>)}</select>},\n          col(\"选品时依据\", \"evidence\"),\n          {\n            title: \"调整理由\",\n            render: (_: any, row: any) => (\n              <Input\n                aria-label={\"调整理由-\" + row.code}\n                value={row.reason}\n                onChange={(reason) =>\n                  setCart((old) => ({\n                    ...old,\n                    [row.key]: { ...old[row.key], reason },\n                  }))\n                }\n                placeholder=\"人工选品、调减必填\"\n              />\n            ),\n          },\n          {\n            title: \"数量\",\n            render: (_: any, row: any) => (\n              <InputNumber\n                aria-label={\"草稿数量-\" + row.code}\n                min={0}\n                max={1e9}\n                value={row.quantity}\n                onChange={(value) =>\n                  setCart((old) => ({\n                    ...old,\n                    [row.key]: { ...row, quantity: value },\n                  }))\n                }\n              />\n            ),\n          },\n          {\n            title: \"操作\",\n            render: (_: any, row: any) => (\n              <Button\n                onClick={() =>\n                  setCart((old) => {\n                    const next = { ...old };\n                    delete next[row.key];\n                    return next;\n                  })\n                }\n              >\n                移除\n              </Button>\n            ),\n          },\n        ]}\n      />\n      <p className={css.orderFooter}>当前范围 {totals.count} 个 SKU · 数量 {display(totals.quantity)} · 金额 {display(totals.amount)} 元。政策优惠未计入金额；实时报价未接入时金额保持未知。</p>\n      <Space>\n        <Button\n          disabled={!Object.keys(cart).length || problems.length > 0}\n          onClick={() =>\n            exportLocalJson(\n              {\n                status: \"local-only\",\n                orderHeaders,\n                exportedAt: new Date().toISOString(),\n                rows: Object.values(cart),\n              },\n              \"经销商补货-未提交草稿.json\",\n            )\n          }\n        >\n          导出补货草稿\n        </Button>\n        <Button\n          disabled={!Object.keys(cart).length || problems.length > 0}\n          onClick={() =>\n            void ask(\n              \"请核对当前补货草稿的业务依据和数据缺失，整理待办；不要宣称已经下单或审批。\",\n              pageContext(),\n            ).catch((e) => setError(e.message))\n          }\n        >\n          核对草稿\n        </Button>\n        <Button disabled title=\"暂不支持提交订单\">提交订单</Button>\n      </Space>\n      </section>}\n      </>}\n    </section>\n  );\n}\n"},"source/inventory-light-plugins/src/native/entry.tsx":{"blob":"d1ef9d62fc29043a09983f788b943d4c26701b0f","sha256":"84c1242fe2fd4c52fe41e34a1e0f87cc65cdb89647d7a5aca7cfd7e719879604","text":"import React, { useState, useEffect } from \"react\";\nimport { createRoot } from \"react-dom/client\";\nimport Page from \"@business-page\";\nimport { mountBusinessFetch, clearBusinessCache } from \"./api\";\nimport { action, ready } from \"../channel.js\";\nimport { updateContext, clearContext } from \"./context\";\nimport \"@business-style\";\n\nclass Boundary extends React.Component<any, { error: string }> {\n  state = { error: \"\" };\n  static getDerivedStateFromError(e: Error) {\n    return { error: e.message };\n  }\n  render() {\n    return this.state.error ? (\n      <p role=\"alert\">页面暂不可用：{this.state.error}</p>\n    ) : (\n      this.props.children\n    );\n  }\n}\nlet refreshPage = () => {};\nfunction App() {\n  const [revision, bump] = useState(0),\n    [warnings, setWarnings] = useState<string[]>([]);\n  useEffect(() => {\n    const warn = (event: any) => {\n      setWarnings((values) => [...new Set([...values, event.detail.message])]);\n      updateContext(\"queryFailure\", {\n        message: event.detail.message,\n        coverage: \"部分或全部查询未成功，不能用缺失数据推断零值\",\n      });\n    };\n    window.addEventListener(\"gea-query-warning\", warn);\n    return () => window.removeEventListener(\"gea-query-warning\", warn);\n  }, []);\n  refreshPage = () => {\n    clearBusinessCache();\n    clearContext();\n    setWarnings([]);\n    window.dispatchEvent(new Event(\"light-refresh\"));\n    bump((n) => n + 1);\n  };\n  return (\n    <>\n      {warnings.length > 0 && (\n        <div\n          role=\"alert\"\n          style={{ padding: 12, color: \"#a34200\", background: \"#fff7e8\" }}\n        >\n          {warnings.map((w) => (\n            <p key={w}>{w}</p>\n          ))}\n        </div>\n      )}\n      <Boundary key={revision}>\n        <Page />\n      </Boundary>\n    </>\n  );\n}\nasync function mount() {\n  await mountBusinessFetch();\n  const root = createRoot(document.getElementById(\"app\")!);\n  root.render(<App />);\n  action(\"refresh\", \"清除本页快照并重新查询 GEA\", () => {\n    refreshPage();\n    return { refreshing: true };\n  });\n  window.addEventListener(\"gea-identity-changed\", () => {\n    clearBusinessCache(true);\n    clearContext();\n    root.unmount();\n    document.getElementById(\"app\")!.textContent =\n      \"登录身份已变化，请重新打开业务页\";\n  });\n}\nvoid ready.then(mount).catch((e) => {\n  document.getElementById(\"app\")!.textContent = e.message;\n});\n"},"source/inventory-light-plugins/src/native/page-filter.tsx":{"blob":"73c5080e1e35482af1b7a0de4216b0cb4547cecc","sha256":"c02645406e124c6e473ec5126e3e5a87bfedd44be182680311aa1b670a92fbba","text":"import { useEffect, useRef } from \"react\";\nimport { action, ask } from \"../channel.js\";\nimport { pageContext, updateContext } from \"./context\";\nexport function usePageFilter(current: any, apply: (args: any) => void) {\n  const ref = useRef({ current, apply });\n  ref.current = { current, apply };\n  useEffect(() => {\n    updateContext(\"pageFilters\", current);\n  }, [JSON.stringify(current)]);\n  useEffect(() => {\n    action(\n      \"filter\",\n      \"筛选本页；先读 context.parts.pageFilters 的 allowedFields、可选范围和当前值，仅传需要改变的字段。不会修改业务数据。\",\n      (input: any) => {\n        if (!input || typeof input !== \"object\" || Array.isArray(input))\n          throw Error(\"筛选参数必须为对象\");\n        const { current: c, apply } = ref.current;\n        if (Object.keys(input).some((k) => !c.allowedFields.includes(k)))\n          throw Error(\"不支持的筛选字段\");\n        if (input.tab !== undefined && !c.tabs.includes(input.tab))\n          throw Error(\"页签无效\");\n        if (\n          input.warehouseId !== undefined &&\n          !c.warehouses.includes(input.warehouseId)\n        )\n          throw Error(\"分仓不在当前授权范围\");\n        if (\n          input.bases !== undefined &&\n          (!Array.isArray(input.bases) ||\n            input.bases.some((b: any) => !c.bases.includes(b)))\n        )\n          throw Error(\"基地不在当前可见范围\");\n        if (\n          input.search !== undefined &&\n          (typeof input.search !== \"string\" || input.search.length > 100)\n        )\n          throw Error(\"搜索词无效\");\n        for (const k of [\"urgentOnly\", \"riskOnly\", \"businessOnly\"])\n          if (input[k] !== undefined && typeof input[k] !== \"boolean\")\n            throw Error(\"筛选开关无效\");\n        if (input.urgentOnly && input.riskOnly)\n          throw Error(\"紧急与低于建议筛选不能同时开启\");\n        if (\n          input.scope !== undefined &&\n          ![\"company\", \"all-channel\"].includes(input.scope)\n        )\n          throw Error(\"查询范围无效\");\n        if (\n          input.month !== undefined &&\n          (typeof input.month !== \"string\" ||\n            !/^20\\d{2}-(0[1-9]|1[0-2])$/.test(input.month))\n        )\n          throw Error(\"月份无效\");\n        apply(input);\n        return {\n          querying: true,\n          requested: input,\n          notice: \"等待页面查询完成后再读取上下文\",\n        };\n      },\n    );\n  }, []);\n}\nexport function exportLocalJson(value: unknown, name: string) {\n  const url = URL.createObjectURL(\n    new Blob([JSON.stringify(value, null, 2)], { type: \"application/json\" }),\n  );\n  const link = document.createElement(\"a\");\n  link.href = url;\n  link.download = name;\n  link.click();\n  setTimeout(() => URL.revokeObjectURL(url), 1000);\n}\nexport async function reviewLocalDraft() {\n  return ask(\n    \"核对本页补货草稿、计算范围和缺失信息，提出人工确认清单；人工计划和周期为本页预览时不得当作正式方案，不得宣称已提报。\",\n    pageContext(),\n  );\n}\n"},"source/inventory-light-plugins/src/pages/dealer/overview.tsx":{"blob":"9fa95fab7ba350da187e4efbe95dd19d16a98162","sha256":"28e8c1fb67923843dc6fb4cab7a51a7b42ecee5f0b7e78c6b2a44986dcdc0289","text":"import {useState} from 'react';\nimport {Modal, Button, Table} from '../../dsh-ui/controls';\nimport css from './workbench.module.css';\nconst n=(v:unknown)=>typeof v==='number'&&Number.isFinite(v)?v.toLocaleString('zh-CN',{maximumFractionDigits:2}):'—';\nexport function DealerOverview({data,onNavigate}:{data:any;onNavigate:(tab:string)=>void}) {\n const [detail,setDetail]=useState<string|null>(null);\n const total=data.totalInventory==null||data.totalTransitInventory==null?null:data.totalInventory+data.totalTransitInventory;\n const cover=total!=null&&data.forecastSales>0?Math.round(total/(data.forecastSales/30)):null;\n const metrics=[\n ['库存健康分',null,'数据待完善','health'],['库存总量',total,`在仓 ${n(data.totalInventory)} / 在途 ${n(data.totalTransitInventory)}`,'sku'],\n ['库存价值',data.totalInventoryValue,'元 · 按已覆盖的日库存金额','sku'],['近7日动销',data.sales7Coverage?data.totalSales7:null,'箱 · 保留源数据覆盖范围','sku'],\n ['近30日动销',data.sales30Coverage?data.totalSales30:null,'箱 · 保留源数据覆盖范围','sku'],['平均覆盖',cover,'天 · 按总览销量口径计算','sku'],\n ['客户数量',data.customerCount??data.customerSummaryTotal,'当前授权范围','customer'],['门店数量',data.storeCount,'未接入时保持未知','customer'],\n ];\n const metricUnits: Record<string,string> = {库存价值:'元',近7日动销:'箱',近30日动销:'箱',平均覆盖:'天'};\n const metricDetails: Record<string,Array<[string,string]>> = {\n  库存健康分:[['数据状态','待完善']],\n  库存总量:[['在仓库存',n(data.totalInventory)],['在途库存',n(data.totalTransitInventory)]],\n  库存价值:[['统计范围','已覆盖日库存']],\n  近7日动销:[['统计范围','源数据覆盖范围']],\n  近30日动销:[['统计范围','源数据覆盖范围']],\n  平均覆盖:[['计算依据','总览销量口径']],\n  客户数量:[['统计范围','当前授权范围']],\n  门店数量:[['数据状态',typeof data.storeCount === 'number' && Number.isFinite(data.storeCount) ? '已提供' : '待完善']],\n };\n const health=[\n {title:'备货合理度',tab:'sku',items:[['合理备货 SKU',data.reasonableSkuCount],['不合理备货 SKU',data.unreasonableSkuCount],['目标备货',data.totalTargetInventory]]},\n {title:'库存保障度',tab:'shortage',items:[['货够 SKU',data.coveredSkuCount],['缺货 SKU',data.shortageSkuCount]]},\n {title:'库存新鲜度',tab:'expiry',items:[['临期 SKU',data.nearExpirySkuCount],['平均货龄（天）',data.averageAge]]},\n ];\n return <>\n <div className={css.metrics} aria-label=\"库存总览指标\">{metrics.map(([label,value])=>{\n  const title=String(label), available=typeof value === 'number' && Number.isFinite(value);\n  return <button className={css.metric} aria-haspopup=\"dialog\" aria-expanded={detail === label} key={title} onClick={()=>setDetail(title)}>\n   <span className={css.metricTop}><span>{label}</span><b className={`${css.metricStatus} ${available ? css.metricCurrent : css.metricMissing}`}>{available ? '当前值' : '待完善'}</b></span>\n   <strong title={n(value)}>{available && Math.abs(value)>=10000 ? `${(value/10000).toLocaleString(\"zh-CN\",{maximumFractionDigits:2})}万` : n(value)}{available && metricUnits[title] && <small className={css.metricUnit}>{metricUnits[title]}</small>}</strong>\n   <dl className={css.metricDetails}>{metricDetails[title].map(([name,text])=><div key={name}><dt>{name}</dt><dd>{text}</dd></div>)}</dl>\n  </button>;\n })}</div>\n <div className={css.health} aria-label=\"库存健康度指标\">{health.map(item=><button key={item.title} className={css.healthCard} onClick={()=>onNavigate(item.tab)}><h3>{item.title}<span>查看明细 ›</span></h3><dl>{item.items.map(([label,value])=><div key={String(label)}><dt>{label}</dt><dd>{n(value)}</dd></div>)}</dl></button>)}</div>\n <details className={css.coverage}><summary>数据范围与口径 · 日库存覆盖 {data.inventoryDailyCustomerCount}/{data.inventoryDailyExpectedCustomerCount} 个客户</summary><p>库存日期 {data.inventoryDateLabel||data.snapshotDate||'未提供'}；计划月 {data.planMonth||'未提供'}。缺失指标显示横杠，不以零替代。库存健康分及未发布的统计项保持待完善。</p></details>\n <Modal visible={!!detail} title={detail??''} onCancel={()=>setDetail(null)} footer={<Button onClick={()=>{const item=metrics.find(r=>r[0]===detail);setDetail(null);onNavigate(item?.[3]==='health'?'category':String(item?.[3]??'sku'))}}>查看对应库存明细</Button>}>\n <p>{String(metrics.find(r=>r[0]===detail)?.[2]??'')}。当前范围：{data.scopeLabel}；库存日期：{data.inventoryDateLabel||data.snapshotDate||'未提供'}。</p>\n <Table pagination={false} rowKey=\"label\" columns={[{title:'指标',dataIndex:'label'},{title:'当前值',dataIndex:'value'}]} data={metrics.map(([label,value])=>({label,value:n(value)}))}/>\n </Modal>\n </>;\n}\n"},"source/inventory-light-plugins/src/pages/dealer/workbench.module.css":{"blob":"8aa0b2e106f255df1b6be4decbb19fbf3518f670","sha256":"b9609e7a6688fba5adcccf0eaed41804a42e062e8b5d46ded6189e0e0c7b7260","text":"/* workbench-ui-style: page structure stays with the dealer business workflow. */\n.shell {\n  min-height:100%; min-width:0; padding:0 16px 20px;\n  background:var(--ui-canvas); color:var(--ui-ink);\n  font-family:var(--ui-font); font-size:12px; line-height:1.7;\n}\n.navigation {\n  display:flex; gap:0; margin:0 -16px; padding:0 16px;\n  height:46px; background:var(--ui-surface); border-bottom:1px solid var(--ui-border);\n  overflow-x:auto; scrollbar-width:none;\n}\n.navigation::-webkit-scrollbar { display:none; }\n.navigation button {\n  flex:none; min-width:90px; height:46px; padding:0 14px;\n  border:0; border-bottom:2px solid transparent; border-radius:0;\n  background:var(--ui-surface); color:var(--ui-secondary);\n  font-size:11px; font-weight:600; line-height:1.4; white-space:nowrap;\n}\n.navigation button:hover { color:var(--ui-accent); background:var(--ui-hover); }\n.navigation button[aria-current=true] { color:var(--ui-accent); border-bottom-color:var(--ui-accent); background:var(--ui-surface); font-weight:800; }\n.header {\n  display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap;\n  gap:12px; min-height:72px; margin:0 -16px 16px; padding:12px 16px;\n  background:var(--ui-surface); border-bottom:1px solid var(--ui-border);\n}\n.header h2 { margin:0 0 4px; font-size:18px; font-weight:700; line-height:1.35; }\n.header small, .coverage, .product small { font-size:10px; line-height:1.4; color:var(--ui-muted); }\n.customerPicker { display:flex; align-items:center; flex-wrap:wrap; gap:8px; min-width:0; max-width:100%; }\n.metrics { display:grid; grid-template-columns:repeat(8,minmax(0,1fr)); gap:12px; margin:0 0 12px; }\n.metric, .healthCard {\n  min-width:0; text-align:left; color:var(--ui-ink); background:var(--ui-surface);\n  border:1px solid var(--ui-border); border-radius:10px; box-shadow:var(--ui-shadow);\n  transition:background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;\n}\n.metric { display:flex; flex-direction:column; align-items:stretch; justify-content:flex-start; padding:12px; gap:0; }\n.metricTop { display:flex; align-items:center; justify-content:space-between; gap:4px; min-height:24px; font-size:11px; line-height:1.4; font-weight:600; color:var(--ui-muted); }\n.metric > strong { display:block; margin:14px 0 11px; font-size:23px; font-weight:700; line-height:1.15; letter-spacing:-.04em; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }\n .metricStatus { flex:none; padding:3px 6px; border-radius:999px; font-size:8px; line-height:1.25; font-weight:700; }\n.metricCurrent { color:var(--ui-success); background:var(--ui-success-soft); }\n.metricMissing { color:var(--ui-neutral); background:var(--ui-neutral-soft); }\n.metricUnit { margin-left:3px; color:var(--ui-ink); font-size:11px; font-weight:400; letter-spacing:normal; }\n.metricDetails { display:grid; align-content:start; gap:5px; min-height:42px; margin:0; padding-top:8px; border-top:1px solid var(--ui-border); font-size:10px; line-height:1.4; }\n.metricDetails > div { display:flex; align-items:baseline; justify-content:space-between; gap:6px; }\n.metricDetails dt { color:var(--ui-muted); font-weight:400; flex:none; }\n.metricDetails dd { margin:0; text-align:right; color:var(--ui-secondary); font-weight:700; font-variant-numeric:tabular-nums; }\n\n.metric:hover, .healthCard:hover { background:var(--ui-hover); border-color:var(--ui-accent-line); box-shadow:var(--ui-shadow-hover); }\n.metric[aria-expanded=true] { background:var(--ui-accent-soft); border-color:var(--ui-accent); }\n.health { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-bottom:12px; }\n.healthCard { display:flex; flex-direction:column; align-items:stretch; justify-content:flex-start; padding:12px; }\n.healthCard h3 { display:flex; justify-content:space-between; align-items:baseline; gap:8px; margin:0; padding:0 0 12px; border-bottom:1px solid var(--ui-divider); color:var(--ui-ink); font-size:11px; line-height:1.4; font-weight:700; }\n.healthCard h3 span { flex:none; color:var(--ui-accent); font-size:10px; font-weight:400; }\n.healthCard dl { display:grid; gap:8px; margin:12px 0 0; font-size:10px; line-height:1.4; }\n.healthCard dl div { display:flex; align-items:baseline; justify-content:space-between; gap:12px; }\n.healthCard dt { color:var(--ui-muted); }\n.healthCard dd { margin:0; color:var(--ui-secondary); font-weight:600; font-variant-numeric:tabular-nums; }\n.coverage { margin:12px 0; }\n.coverage p { color:var(--ui-secondary); font-size:12px; line-height:1.7; }\n.listPanel { min-width:0; background:var(--ui-surface); border:1px solid var(--ui-border); border-radius:10px; box-shadow:var(--ui-shadow); }\n.listPanel > [role=tablist] { margin:0; padding:0 16px; border-radius:10px 10px 0 0; background:var(--ui-surface); }\n.listPanel > [role=tablist] button { flex:none; min-width:90px; height:46px; padding:0 14px; border-bottom:2px solid transparent; color:var(--ui-secondary); font-weight:600; }\n.listPanel > [role=tablist] button:hover { color:var(--ui-accent); background:var(--ui-hover); }\n.listPanel > [role=tablist] button[aria-selected=true] { color:var(--ui-accent); border-bottom-color:var(--ui-accent); font-weight:800; }\n.toolbar { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin:0; padding:12px 16px; }\n.toolbar + .toolbar { padding-top:0; }\n.toolbar label { display:flex; align-items:center; gap:8px; font-size:11px; }\n.toolbar small { color:var(--ui-muted); font-size:10px; line-height:1.4; }\n.shell select, .shell input:not([type=checkbox]):not([type=radio]) { min-height:36px; border-radius:8px; border-color:var(--ui-border-strong); font-size:11px; }\n.shell select:hover, .shell input:not([type=checkbox]):not([type=radio]):hover { border-color:var(--ui-accent-line); }\n.shell :global(.dsh-table-body) { border:1px solid var(--ui-border); border-radius:10px; background:var(--ui-surface); }\n.listPanel :global(.dsh-table-body) { border:0; border-top:1px solid var(--ui-border); border-radius:0 0 10px 10px; }\n.shell table { width:100%; }\n.shell th { height:38px; padding:8px 14px; background:var(--ui-soft); color:#747b86; font-size:9px; line-height:1.35; font-weight:800; }\n.shell td { height:44px; padding:5px 14px; color:var(--ui-secondary); font-size:10px; line-height:1.4; font-weight:400; border-bottom:1px solid var(--ui-divider); }\n.shell tbody tr { background:var(--ui-surface); }\n.shell tbody tr:hover { background:var(--ui-hover); }\n.shell td > button { height:28px; min-height:28px; border-radius:6px; padding:0 10px; font-size:10px; line-height:1.4; }\n.listPanel nav { padding:12px 16px; }\n.product { display:flex; flex-direction:column; gap:4px; min-width:140px; max-width:240px; white-space:normal; line-height:1.4; }\n.product strong { color:var(--ui-ink); font-weight:600; }\n.orderHeader { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin:16px 0; }\n.orderHeader h3 { margin:0; font-size:14px; line-height:1.4; font-weight:700; }\n.orderMeta { display:flex; flex-wrap:wrap; gap:12px; padding:16px; background:var(--ui-surface); border:1px solid var(--ui-border); border-radius:10px; }\n.orderMeta label { display:flex; flex-direction:column; gap:8px; font-size:11px; min-width:150px; max-width:100%; }\n.orderFooter { display:flex; align-items:center; flex-wrap:wrap; gap:12px; padding:16px 0; border-top:1px solid var(--ui-border); }\n@media(max-width:1200px) { .metrics { grid-template-columns:repeat(4,minmax(0,1fr)); } }\n\n@media(max-width:720px) { .metrics { grid-template-columns:repeat(2,minmax(0,1fr)); } }\n@media(max-width:520px) { .metrics { grid-template-columns:1fr; } .customerPicker { width:100%; } }\n\n/* Keep the three health dimensions side by side in the client split pane. */\n.health { grid-template-columns:repeat(3,minmax(0,1fr)); overflow-x:auto; }\n.healthCard { min-width:0; }\n.healthCard h3 { flex-wrap:wrap; }\n.healthCard dl div { flex-wrap:wrap; }\n@media(max-width:520px) { .health { grid-template-columns:repeat(3,minmax(180px,1fr)); } }\n\n.stockSectionHead { display:flex; align-items:center; flex-wrap:wrap; gap:8px; padding:12px 16px; }\n.stockSectionHead h3 { margin:0; font-size:14px; font-weight:600; }\n.stockFilters { display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin-left:auto; }\n.stockFilters input { width:180px; max-width:100%; }\n@media (max-width:640px) { .stockFilters { margin-left:0; } }\n\n.topbar { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; margin:0 -16px 12px; padding:0 16px; background:var(--ui-surface); border-bottom:1px solid var(--ui-border); }\n.topbar .navigation { margin:0; padding:0; border:0; }\n.customerMenu { position:relative; width:260px; max-width:100%; }\n.customerMenu summary { display:flex; align-items:center; justify-content:space-between; gap:12px; cursor:pointer; list-style:none; padding:6px 10px; border:1px solid var(--ui-border-strong); border-radius:8px; background:var(--ui-surface); font-size:11px; }\n.customerMenu summary:hover, .customerMenu[open] summary { color:var(--ui-accent); border-color:var(--ui-accent-line); background:var(--ui-hover); }\n.customerMenu summary:focus-visible, .navigation button:focus-visible, .listPanel > [role=tablist] button:focus-visible { outline:2px solid var(--ui-accent); outline-offset:2px; }\n.customerMenu summary::-webkit-details-marker { display:none; }\n.customerOptions { position:absolute; top:calc(100% + 4px); right:0; width:320px; max-width:calc(100vw - 40px); max-height:320px; overflow:auto; z-index:10; display:grid; gap:4px; padding:8px; border:1px solid var(--ui-border); border-radius:8px; background:var(--ui-surface); box-shadow:var(--ui-shadow-hover); }\n.customerOptions button { display:flex; flex-direction:column; text-align:left; border:0; background:var(--ui-surface); padding:6px 8px; }\n.customerOptions button:hover, .customerOptions button[aria-pressed=true] { background:var(--ui-accent-soft); color:var(--ui-accent); }\n.customerPicker > small { font-size:10px; color:var(--ui-muted); }\n.orderNavigation, .orderPanels { display:flex; flex-wrap:wrap; align-items:center; gap:4px; }\n.orderNavigation { margin-bottom:12px; border-bottom:1px solid var(--ui-border); background:var(--ui-surface); }\n.orderNavigation button, .orderPanels button { border:0; border-bottom:2px solid transparent; border-radius:0; background:transparent; padding:8px 14px; color:var(--ui-secondary); font-size:11px; }\n.orderNavigation button[aria-current=true], .orderPanels button[aria-current=true] { color:var(--ui-accent); border-bottom-color:var(--ui-accent); }\n.orderNavigation button:hover, .orderPanels button:hover { background:var(--ui-hover); color:var(--ui-accent); }\n.orderHeader { margin:0; padding:8px 12px; background:var(--ui-surface); border-bottom:1px solid var(--ui-border); }\n.orderMeta { display:grid; grid-template-columns:minmax(140px,1fr) minmax(140px,1fr) minmax(200px,2fr); border:0; border-bottom:1px solid var(--ui-border); border-radius:0; gap:12px; padding:12px; }\n.orderMeta label { min-width:0; flex-direction:row; align-items:center; gap:8px; white-space:nowrap; }\n.orderMeta select { min-width:0; flex:1; width:100%; }\n.orderBody { padding:12px; background:var(--ui-surface); }\n@media(max-width:900px) { .orderMeta { grid-template-columns:1fr 1fr; } .orderMeta label:last-child { grid-column:1 / -1; } }\n@media(max-width:520px) { .orderMeta { grid-template-columns:1fr; } .topbar .customerPicker { padding-bottom:8px; } }\n"},"source/inventory-light-plugins/src/platform-pending.ts":{"blob":"ed629df1338eab597254df6283688f29cb99d483","sha256":"edba04c342397b24be9d38ecff1bd04a5408b6e1133cf09fc4869ea6823707c5","text":"/** No internal service calls or credentials may enter an HTML plugin. */\nexport async function loadDealerSapPrices() {\n  return {ok:false,data:null,_error:{code:'GEA_CAPABILITY_PENDING',message:'SAP 定价尚未接入 GEA 公共能力；价格未知',retryable:false}};\n}\n"},"source/inventory-light-plugins/src/query-error.js":{"blob":"632336de3bc5bac063c45167efee76b9c524b57e","sha256":"f6535b2b354b3625e288e46d904cf44edd03b1b18a27a1010d4acb3dba485df6","text":"/** Keep session failures and query failures distinct from explicit permission denial. */\nexport const DATA_PERMISSION_MESSAGE = \"当前账号暂无数据权限\";\nexport function sqlQueryError(cause) {\n  if (cause?.name === \"AbortError\") return cause;\n  if (cause?.code === \"GEA_SQL_DISPLAY_ERROR\") return cause;\n  const code = String(cause?.code ?? \"\");\n  const message = String(cause?.message ?? \"\");\n  const denied = /(?:DATA_PERMISSION_DENIED|RETURN_PERMISSION_DENIED|NO_RETURN_COLUMN_ALLOWED|ACCESS_DENIED)/.test(code + \" \" + message);\n  const expired = /(?:SESSION_(?:EXPIRED|REJECTED|NOT_FOUND|MAX_LIFETIME_EXCEEDED)|会话已失效)/.test(code + \" \" + message);\n  const error = new Error(denied ? DATA_PERMISSION_MESSAGE : expired\n    ? \"数据会话已失效，请刷新页面重试\"\n    : \"数据读取失败，请刷新重试；若仍失败，请查看接口错误详情\", { cause });\n  error.code = \"GEA_SQL_DISPLAY_ERROR\";\n  return error;\n}\nexport function queryErrorText(value) {\n  const text = value instanceof Error ? value.message : value;\n  return typeof text === \"string\" && text.includes(DATA_PERMISSION_MESSAGE)\n    ? DATA_PERMISSION_MESSAGE : text;\n}\n/** Only used for SQL-backed report diagnostics, after the calculations finish. */\nexport function sqlReportCopy(value) {\n  if (typeof value === \"string\") return queryErrorText(value);\n  if (Array.isArray(value)) return value.map(sqlReportCopy);\n  if (value && typeof value === \"object\") return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, sqlReportCopy(item)]));\n  return value;\n}\n"},"source/inventory-light-plugins/tests/query-error.test.mjs":{"blob":"845e5d7dd9c36ea1a42187bb50b7e0452ef14dec","sha256":"6f80e30aa987d09f7ea17be8c67c5c1bb776b3461e7d3ab7fd69cd98bcb86c20","text":"import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport {build} from '../../node_modules/esbuild/lib/main.js';\nimport {DATA_PERMISSION_MESSAGE,sqlQueryError,queryErrorText,sqlReportCopy} from '../src/query-error.js';\n\ntest('SQL failures distinguish expired sessions from denied permissions',()=>{\n for(const [message,expected] of [\n  ['GEA_GATEWAY_SESSION_REJECTED','数据会话已失效，请刷新页面重试'],\n  ['AI_GATEWAY_SESSION_EXPIRED','数据会话已失效，请刷新页面重试'],\n  ['AI_GATEWAY_DATA_PERMISSION_DENIED',DATA_PERMISSION_MESSAGE],\n  ['GEA_HTTP_200: 受控 SQL 执行失败','数据读取失败，请刷新重试；若仍失败，请查看接口错误详情'],\n ]){\n  const cause=Error(message),error=sqlQueryError(cause);\n  assert.equal(error.message,expected);assert.equal(error.cause,cause);\n  assert.equal(sqlQueryError(error),error);\n }\n assert.equal(queryErrorText('基地日监控：'+DATA_PERMISSION_MESSAGE+'；详情'),DATA_PERMISSION_MESSAGE);\n const cancel=new DOMException('cancelled','AbortError');assert.equal(sqlQueryError(cancel),cancel);\n assert.equal(queryErrorText('保存失败'),'保存失败');\n assert.equal(queryErrorText('暂无数据'),'暂无数据');\n});\ntest('SQL-backed report copy does not change metrics or true empty states',()=>{\n const report={sources:[{status:'读取失败，数据不足'},{status:'无可见数据或未发布'}],metric:0,missing:null,notes:['当前订单读取失败，缺货暂不可判断']};\n const result=sqlReportCopy(report);\n  assert.equal(result.sources[0].status,report.sources[0].status);\n assert.equal(result.sources[1].status,report.sources[1].status);\n  assert.equal(result.notes[0],report.notes[0]);assert.equal(result.metric,0);assert.equal(result.missing,null);\n assert.equal(report.sources[0].status,'读取失败，数据不足');\n});\ntest('SQL adapter normalizes single/batch failures, leaves success and cancellation intact',async()=>{\n for(const batched of [false,true]){\n  const output=await build({entryPoints:['src/data.ts'],bundle:true,platform:'node',format:'esm',write:false,\n   define:{DSH_COLUMNAR_SQL:String(batched),DSH_GOVERNED_SQL:'true'},plugins:[{name:'transport-fixture',setup(b){\n    b.onResolve({filter:/channel\\.js$/},()=>({path:'channel',namespace:'fixture'}));\n    b.onLoad({filter:/.*/,namespace:'fixture'},()=>({contents:'export const call=(...args)=>globalThis.__sqlErrorTransport(...args);'}));\n   }}]});\n  const {database}=await import('data:text/javascript;base64,'+Buffer.from(output.outputFiles[0].text).toString('base64'));\n  try{\n   globalThis.__sqlErrorTransport=async()=>{throw Error('GEA_HTTP_200: SQL failed')};\n   await assert.rejects(database.query('SELECT 1'),e=>e.message.startsWith('数据读取失败')&&e.cause.message.includes('GEA_HTTP'));\n   if(batched){globalThis.__sqlErrorTransport=async()=>({results:[{ok:false,error:'受控 SQL 执行失败'}]});await assert.rejects(database.query('SELECT 1'),e=>e.message.startsWith('数据读取失败'));}\n   const value={rows:[{qty:0},{qty:null}],total:2};\n   globalThis.__sqlErrorTransport=async()=>batched?{results:[{ok:true,value}]}:value;\n   assert.deepEqual((await database.query('SELECT 1')).rows,value.rows);\n   const signal=new AbortController();signal.abort();\n   globalThis.__sqlErrorTransport=async()=>{throw signal.signal.reason};\n   await assert.rejects(database.query('SELECT 1',[],{signal:signal.signal}),e=>e===signal.signal.reason);\n  }finally{delete globalThis.__sqlErrorTransport;}\n }\n});\n"}}},"personal":{"commit":"15def488134527647a819812a4b6657ecf9772fe","files":{"source/inventory-light-plugins/src/personal/data.ts":{"blob":"fc8b92092cfdeca8259cac38a4785febea24e81f","sha256":"037a11807e33adcd50800d7c72b6180a8216aedaca4d0ed4ebb41521e90c7d40","text":"import {applySourcePermissions} from './permissions';\nimport {loadDailyReportInput} from '../aqkc-report';\nimport {buildDailyReport} from '../../../aqkc/web/src/lib/daily-report';\nimport {catalog,load,clearFacts} from '../fc-engine';\nimport {clearReadCache} from '../data';\nimport {known,sum,type ObjectData,type Risk} from './model';\nexport function reset(){clearFacts();clearReadCache()}\nexport async function loadPersonal(onObjects:(o:ObjectData[])=>void){\n const objects:ObjectData[]=[];const errors:string[]=[];\n const push=(items:ObjectData[])=>{objects.push(...items);onObjects([...objects])};\n await Promise.allSettled([\n  (async()=>{try{const input=await loadDailyReportInput();\n   if(input.failedSources.length) errors.push(\"基地部分数据源未返回：\"+input.failedSources.join(\"、\"));\n   const names=[...new Set([...input.stock,...input.age].map(r=>r.base).filter(Boolean))];\n   push(names.map(name=>{const report=buildDailyReport({...input,selectedBases:[name],includeAllRisks:true});const metric=(label:string)=>known(report.metrics.find(m=>m.label===label)?.value);const id='base:'+name;\n    return {id,name:name+'基地',kind:'base' as const,inventory:metric('当前库存'),target:report.missingTargetCount?null:metric('目标库存'),age:metric('平均货龄'),ageWeight:known(report.ageInventory),shortage:report.metrics.find(m=>m.label==='当前缺货量')?.note?.includes('部分')?null:metric('当前缺货量'),stagnant:report.missingMovementCount?null:known(report.modules.find(m=>m.id==='movement')?.overview[0]?.metrics.find(m=>m.label==='风险库存')?.value),snapshot:report.sources.map(s=>s.snapshot).filter(Boolean).join(' / '),risks:report.risks.filter(r=>r.module!=='quality').map(r=>({id:r.id,objectId:id,object:name+'基地',sku:r.material,category:r.category,type:r.module==='shortage'?(r.kind.includes('潜在')?'低库存':'缺货'):r.module==='movement'?'滞库':r.kind.includes('60')?'大日期':'货龄',tags:[],priority:r.module==='shortage'?(r.kind.includes('潜在')?3:1):r.module==='age'?2:4,issue:r.evidence,action:r.action,role:r.role,details:r.details}))};}).map(object=>applySourcePermissions(object,(input as any).permissionGaps)));\n  }catch(e){errors.push('基地日监控：'+(e as Error).message)}})(),\n  (async()=>{try{const directory=await catalog();let cursor=0;await Promise.all([0,1].map(async()=>{while(cursor<directory.warehouses.length){const warehouse=directory.warehouses[cursor++];const id='branch:'+warehouse.id;\n    try{const snapshot=await load({warehouseId:warehouse.id});const m=snapshot.metrics;const ageWeight=sum(snapshot.inventory.map(r=>r.batchSummary?.positiveQty ?? (r.batches.length ? r.batches.filter(b=>b.quantity>0).reduce((n,b)=>n+b.quantity,0) : null)));const targetCovered=snapshot.inventory.every(r=>r.quantity<=0||snapshot.replenishments.some(p=>p.sku===r.sku));const risks:Risk[]=snapshot.replenishments.filter(r=>(r.shortageQty??0)>0).map(r=>({id:id+':'+r.sku,objectId:id,object:warehouse.name,sku:r.sku,category:r.category,type:'缺货',tags:[],priority:1,issue:`当前缺口 ${r.shortageQty} 件`,action:'核对可用库存、未完成调拨与补货计划',role:'区域计划员',details:{SKU:r.sku,商品:r.productName,可用库存:r.availableQty,当前缺口:r.shortageQty,未完成调拨:r.openTransferQty,建议补货:r.recommendedQty,计算依据:r.reason}}));\n    for(const r of snapshot.inventory){const big=r.batchSummary?.bigDateQty??sum(r.batches.filter(b=>b.ageDays>=60).map(b=>b.quantity));const stagnant=r.batchSummary?.stagnantQty??sum(r.batches.filter(b=>b.ageDays>=90).map(b=>b.quantity));\n     if(big!==null&&big>0)risks.push({id:id+':age:'+r.sku,objectId:id,object:warehouse.name,sku:r.sku,category:r.category,type:'大日期',tags:[],priority:2,issue:`60天及以上库存 ${big} 件`,action:'核对批次与消化路径',role:'区域计划员',details:{SKU:r.sku,商品:r.productName,大日期库存:big}});\n     if(stagnant!==null&&stagnant>0)risks.push({id:id+':stagnant:'+r.sku,objectId:id,object:warehouse.name,sku:r.sku,category:r.category,type:'滞库',tags:[],priority:4,issue:`90天及以上库存 ${stagnant} 件（沿用分仓口径）`,action:'核对动销、调拨及接收能力',role:'区域计划员',details:{SKU:r.sku,商品:r.productName,滞库库存:stagnant}});\n    }\n    push([applySourcePermissions({id,name:warehouse.name,kind:'branch',inventory:known(m.inventoryQty),target:targetCovered?sum(snapshot.replenishments.map(r=>known(r.targetInventoryQty))):null,age:ageWeight!==null&&ageWeight>0?known(m.averageAgeDays):null,ageWeight,shortage:known(m.shortageQty),stagnant:known(m.stagnantQty),snapshot:snapshot.snapshotTime,risks},(snapshot as any).permissionGaps)]);\n    }catch(e){push([{id,name:warehouse.name,kind:'branch',inventory:null,target:null,age:null,ageWeight:null,shortage:null,stagnant:null,snapshot:'',risks:[],error:(e as Error).message}])}\n   }}));}catch(e){errors.push('分仓日监控：'+(e as Error).message)}})()\n ]);\n return {objects,errors};\n}\n"},"source/inventory-light-plugins/src/personal/model.ts":{"blob":"4cd9ed6309890e908b3fbeb0b52b7f147c6b0f4f","sha256":"50df0432acaf6ea6966061e0206e5ace2f800ab93d2a4f73d41f25fb59c5902b","text":"export type Risk = {id:string; objectId:string; object:string; sku:string; productName?:string; category:string; type:string; tags:string[]; priority:number; issue:string; action:string; role:string; details:unknown};\nexport type MetricKey='inventory'|'target'|'age'|'shortage'|'stagnant'|'over30';\nexport type ObjectData = {categories?:(ObjectData & {category:string})[];id:string;name:string;kind:'base'|'branch';inventory:number|null;target:number|null;age:number|null;ageWeight:number|null;shortage:number|null;stagnant:number|null;over30?:number|null;partial?:Partial<Record<MetricKey,boolean>>;snapshot:string;risks:Risk[];error?:string};\nexport const known=(v:unknown):number|null=>typeof v==='number'&&Number.isFinite(v)?v:null;\nexport const sum=(values:(number|null)[])=>values.length&&values.every(v=>v!==null)?values.reduce<number>((n,v)=>n+v!,0):null;\nexport function summarize(objects:ObjectData[]){\n const total=(key:MetricKey)=>sum(objects.map(o=>known(o[key])).filter(v=>v!==null));\n const inventory=total('inventory'),target=total('target');\n const comparable=objects.filter(o=>o.inventory!==null&&o.target!==null);\n const ageObjects=objects.filter(o=>o.age!==null&&o.ageWeight!==null&&o.ageWeight>0);\n const weight=sum(ageObjects.map(o=>o.ageWeight));\n const age=weight!==null&&weight>0?ageObjects.reduce((n,o)=>n+o.age!*o.ageWeight!,0)/weight:null;\n const partial=Object.fromEntries((['inventory','target','age','shortage','stagnant','over30'] as MetricKey[]).map(key=>[key,objects.some(o=>o.partial?.[key] || (key==='age'?o.age===null&&o.ageWeight!==0:known(o[key])===null))])) as Record<MetricKey,boolean>;\n return {inventory,target,gap:sum(comparable.map(o=>o.inventory!-o.target!)),age,over30:total('over30'),shortage:total('shortage'),stagnant:new Set(objects.map(o=>o.kind)).size>1?null:total('stagnant'),partial:{...partial,gap:partial.inventory||partial.target},mixedStagnant:new Set(objects.map(o=>o.kind)).size>1};\n}\nexport function dedupeRisks(risks:Risk[]){\n const merged=new Map<string,Risk>();\n for(const risk of risks){const key=JSON.stringify([risk.objectId,risk.sku||risk.id]);const old=merged.get(key);if(!old){merged.set(key,{...risk,tags:[...new Set([risk.type,...risk.tags])]});continue}const first=risk.priority<old.priority?risk:old;merged.set(key,{...first,tags:[...new Set([...old.tags,risk.type,...risk.tags])]});}\n return [...merged.values()].sort((a,b)=>a.priority-b.priority||a.id.localeCompare(b.id));\n}\n"},"source/inventory-light-plugins/src/personal/permissions.ts":{"blob":"e587ebed725d87d5e98c40cc3fa3b12e911e421c","sha256":"c9bfd370207c63155b2533808a20723f2676425ec0d7c0deb6fae679399326ac","text":"import type {ObjectData} from './model';\nimport {DATA_PERMISSION_MESSAGE} from '../query-error.js';\n/** Keep independent sources visible; never calculate zero from a cropped input. */\nexport function applySourcePermissions(object: ObjectData, gaps: string[] = [], failed: string[] = []): ObjectData {\n  const missing = [...gaps, ...failed];\n  if (!missing.length) return object;\n  const result = {...object};\n  const has = (...sources: string[]) => sources.some(source => missing.includes(source));\n  if (has('stock', 'inventory')) result.inventory = null;\n  if (has('stock', 'plan', 'inventory')) result.target = null;\n  if (has('age', 'inventory')) {result.age = null; result.ageWeight = null; result.over30 = null;}\n  if (has('pending', 'fulfillment', 'operation', 'inventory', 'plan')) result.shortage = null;\n  if (has('stock', 'age', 'inventory')) result.stagnant = null;\n  result.risks = result.risks.filter(r =>\n    ['缺货','低库存'].includes(r.type) ? result.shortage !== null :\n    ['货龄','大日期'].includes(r.type) ? result.age !== null :\n    r.type === '滞库' ? result.stagnant !== null : true);\n  result.error = gaps.length ? DATA_PERMISSION_MESSAGE : '数据读取失败，请刷新重试';\n  return result;\n}\n"},"source/aqkc/web/src/lib/daily-report.ts":{"blob":"022378bb2955cbb30877a5b0ffde2ca9e825845e","sha256":"ccb4e81777e8f30fc834f9424dba3e886fe46c7aa5ed237b55036892f660c3bc","text":"/** Pure, deterministic report contract. Never treats unknown facts as zero. */\nexport const DAILY_REPORT_BASES = [\"华东\", \"华南\", \"西南\", \"遂平\", \"郑州\"];\nexport type DailySource = \"stock\" | \"age\" | \"pending\" | \"fulfillment\";\nexport type DailyStock = {\n  base: string; material: string; name: string; category: string;\n  inventory: number | null; target: number | null; demand: number | null;\n  shipment30: number | null; snapshot: string;\n};\nexport type DailyAge = {\n  base: string; material: string; name: string; category: string;\n  inventory: number | null; bands: (number | null)[];\n  natural7?: number | null; natural14?: number | null; weightedAge: number | null; invalidQuantity: boolean; snapshot: string;\n};\nexport type DailyPending = {\n  base: string; material: string; quantity: number | null;\n  shortage: number | null; allocated: number | null; snapshot: string; inventorySnapshot: string;\n};\nexport type DailyFulfillment = {\n  base: string; material: string; need: number | null; shortage: number | null;\n  invalidQuantity: boolean; snapshot: string;\n};\nexport type DailyReportInput = {\n  stock: DailyStock[]; age: DailyAge[]; pending: DailyPending[]; fulfillment: DailyFulfillment[];\n  pendingSnapshot: string; failedSources: DailySource[];\n  targetMonth: string; targetVersion: string; targetRule: string;\n  generatedAt: string; localPreview: boolean; selectedBases?: string[]; includeAllRisks?: boolean;\n};\nexport type ReportModuleId = \"age\" | \"shortage\" | \"movement\" | \"quality\";\nexport type ReportModule = { id: ReportModuleId; title: string; description: string; conclusion: string; yesterday?: string; overview: {title:string; metrics:ReportMetric[]}[]; groups: {base: string; risks: ReportRisk[]}[] };\nexport type ReportMetric = { label: string; value: number | null; unit: string; note?: string; auxiliaries?: string[] };\nexport type ReportRisk = {\n  id: string; object: string; kind: string; level: string; quantity: number;\n  base: string; material: string; category: string; module: ReportModuleId;\n  evidence: string; action: string; role: string; priority: number;\n  cause: string; feedbackStatus: string; details: {label: string; value: string}[];\n};\nexport type DailyReport = {\n  title: string; date: string; generatedAt: string; scope: string; bases: string[];\n  localPreview: boolean; empty: boolean; summary: string[]; metrics: ReportMetric[];\n  ageInventory: number | null;\n  ageBands: { label: string; quantity: number | null; share: number | null; objects: string }[];\n  risks: ReportRisk[]; riskCount: number; missingTargetCount: number; missingMovementCount: number;\n  sources: { label: string; status: string; snapshot: string }[];\n  notes: string[]; coreMetrics: ReportMetric[]; modules: ReportModule[];\n  status: \"已生成\" | \"部分生成\"; riskLevel: string; visibleObjectKeys: string[];\n  qualityIssues: string[];\n};\nexport function reportNumber(value: unknown): number | null {\n  if (value === null || value === undefined || value === \"\" || typeof value === \"boolean\") return null;\n  const result = Number(value);\n  return Number.isFinite(result) ? result : null;\n}\nconst quantityFormats=new Map<number,Intl.NumberFormat>();\nexport function reportQuantity(value: number | null, digits = 0): string {\n  if(value===null)return \"—\";\n  if(!quantityFormats.has(digits))quantityFormats.set(digits,new Intl.NumberFormat(\"zh-CN\",{maximumFractionDigits:digits}));\n  return quantityFormats.get(digits)!.format(value);\n}\nexport function reportDate(value: string): string {\n  const parsed = new Date(value);\n  if (!Number.isFinite(parsed.getTime())) return \"\";\n  return new Intl.DateTimeFormat(\"sv-SE\", { timeZone: \"Asia/Shanghai\", year: \"numeric\", month: \"2-digit\", day: \"2-digit\" }).format(parsed);\n}\nexport function reportTimestamp(value: string): string {\n  const parsed = new Date(value);\n  if (!value || !Number.isFinite(parsed.getTime())) return \"暂无快照\";\n  return new Intl.DateTimeFormat(\"zh-CN\", { timeZone: \"Asia/Shanghai\", dateStyle: \"short\", timeStyle: \"short\", hour12: false }).format(parsed);\n}\nfunction total(values: (number | null)[]): number | null {\n  return !values.length || values.some(value => value === null) ? null : values.reduce<number>((sum, value) => sum + value!, 0);\n}\nfunction knownTotal(values: (number | null)[]): number | null {\n  return total(values.filter(value => value !== null));\n}\nexport const reportObjectKey = (row: {base: string; material: string}) => JSON.stringify([row.base,row.material]);\nconst key = reportObjectKey;\nconst objectName = (row: {base: string; material: string; name: string}) => `${row.base} · ${row.name || row.material}（${row.material}）`;\nconst visible = (row: {base: string; material: string}) => DAILY_REPORT_BASES.includes(row.base) && Boolean(row.material);\n\n/** All inputs must already have passed GEA row permissions; the intersection is\n * additional protection against joining auxiliary rows outside visible objects. */\nexport function buildDailyReport(input: DailyReportInput): DailyReport {\n  const inScope = (row: {base:string;material:string}) => visible(row) && (!input.selectedBases || input.selectedBases.includes(row.base));\n  const unique = <T extends {base:string;material:string}>(rows:T[]) => [...new Map(rows.map(row=>[key(row),row])).values()];\n  const stock = unique(input.stock.filter(inScope));\n  const age = unique(input.age.filter(inScope));\n  const allowed = new Set([...stock, ...age].map(key));\n  const pending = unique(input.pending.filter(row => allowed.has(key(row))));\n  const fulfillment = unique(input.fulfillment.filter(row => allowed.has(key(row))));\n  const bases = [...new Set([...stock, ...age].map(row => row.base))].sort((a,b) => a.localeCompare(b,\"zh-CN\"));\n  const ageValid = age.length > 0 && !age.some(row => row.invalidQuantity);\n  const ageInventory = ageValid ? total(age.map(row => row.inventory)) : null;\n  const current = stock.length ? total(stock.map(row => row.inventory)) : ageInventory;\n  const target = knownTotal(stock.map(row => row.target));\n  const gap = current !== null && stock.length && target !== null ? current - target : null;\n  const demand = knownTotal(stock.map(row => row.demand));\n  const turnover = stock.length && current !== null && demand !== null && demand > 0 ? current / demand : null;\n  const targetTurnover = target !== null && demand !== null && demand > 0 ? target / demand : null;\n  const missingTargetCount = stock.filter(row => row.target === null).length;\n  const missingDemandCount = stock.filter(row => row.demand === null).length;\n  const missingMovementCount = stock.filter(row => row.shipment30 === null).length;\n  const bandTotals = [0,1,2,3,4].map(index => ageValid ? total(age.map(row => row.bands[index] ?? null)) : null);\n  const weightedAge = ageValid ? total(age.map(row => row.weightedAge)) : null;\n  const averageAge = ageInventory !== null && ageInventory > 0 && weightedAge !== null && bandTotals[4] === 0\n    ? weightedAge / ageInventory : null;\n  const pendingReady = !input.failedSources.includes(\"pending\") && Boolean(input.pendingSnapshot);\n  const order = pendingReady ? pending.length ? total(pending.map(row => row.quantity)) : 0 : null;\n  const shortage = pendingReady ? pending.length ? knownTotal(pending.map(row => row.shortage)) : 0 : null;\n  const missingShortageCount = pending.filter(row=>row.shortage===null).length;\n  const allocated = pendingReady ? pending.length ? total(pending.map(row => row.allocated)) : 0 : null;\n  const need = total(fulfillment.map(row => row.need));\n  const unfilled = total(fulfillment.map(row => row.shortage));\n  const fulfillmentRate = need !== null && need > 0 && unfilled !== null && unfilled >= 0 && unfilled <= need\n    && !fulfillment.some(row => row.invalidQuantity) ? 1 - unfilled / need : null;\n  const notes: string[] = [\n    \"本报告按当前可见权限范围即时生成；数量沿用已接入数据的件数口径，时间均为北京时间。\",\n    `目标口径：${input.targetMonth || \"当前月份\"} · ${input.targetVersion || \"暂无可用版本\"}。${input.targetRule}`,\n    \"货龄按P1设计为0–30天（含30）、31–40天（>30且≤40）、41–60天（>40且≤60）、60+（>60）；连续货龄值按以上边界归类。固定看板保留原口径。占比分母只使用货龄表库存。\",\n    \"当前订单仅汇总可见库存对象，采用既有五个提货点及备单状态规则；当前缺货按基地/SKU计算备单中订单量−占用量−可用库存的正值后汇总，为测算线索。\",\n    \"当月订单满足率沿用工厂提货、排除饺鲜说的履约口径：1−缺货量/需求数量。已发货完成订单范围尚待确认，不能据此称为已核验的事后满足率。\",\n    \"近30日量来自基地/SKU日均动销×30；不代表具体批次出库。近7日趋势、批次出库、生产入库压力和促销政策本次尚未接入，相关原因数据不足，需人工确认。\",\n    \"60天以上库存仅作为大日期候选；本报告不执行25日批次锁定、专项建档、责任判定、费用分摊或业务指令。\",\n    \"库存高于目标仅作差异复核；明显超目标、动销弱及总体红橙黄阈值尚未定稿，不自动定级。响应角色为建议角色，实际负责人和进展待人工确认。\",\n  ];\n  if (input.localPreview) notes.unshift(\"本地验证模式：当前未使用门户用户权限，仅展示开发数据库已发布基地的数据；不代表任何生产用户的授权范围。\");\n  if (!stock.length) notes.push(\"目标版本未发布或库存主表不可用：当前库存采用货龄表可见库存，目标、差额和周转不作判断。\");\n  if (stock.length && current !== null && ageInventory !== null && Math.abs(current - ageInventory) > 0.01) {\n    notes.push(`库存主表与货龄表统计范围不一致：主表${reportQuantity(current)}件，货龄表${reportQuantity(ageInventory)}件；两者相差${reportQuantity(Math.abs(current-ageInventory))}件，需复核SKU与仓库范围，不能混用占比分母。`);\n  }\n  if (missingTargetCount) notes.push(`${missingTargetCount}个基地/SKU缺少目标。与看板一致，差额按当前库存减已知目标、目标天数按已知目标除已知日均计划量计算，均标注部分；不能把未覆盖部分判断为超储。`);\n  if (missingDemandCount) notes.push(`${missingDemandCount}个基地/SKU缺少日均计划量，周转使用已知计划量并标注部分。`);\n  if (missingShortageCount) notes.push(`${missingShortageCount}个基地/SKU缺少缺货计算依据，仅展示已核验缺货合计，不认定其余对象无缺货。`);\n  if (missingMovementCount) notes.push(`${missingMovementCount}个基地/SKU缺少近30日动销，不视为零动销。`);\n  if (!ageValid && age.length) notes.push(\"货龄数据存在无效库存数量，货龄汇总暂不展示，需人工确认。\");\n  if (bandTotals[4] !== null && bandTotals[4] > 0) notes.push(`有${reportQuantity(bandTotals[4])}件货龄未知，单独展示，平均货龄暂不作结论。`);\n  const risks: ReportRisk[] = [];\n  const addRisk = (row: DailyStock | DailyAge, kind: string, level: string, quantity: number,\n    evidence: string, action: string, role: string, priority: number, module:ReportModuleId = kind.includes(\"缺货\") ? \"shortage\" : kind.includes(\"动销\") ? \"movement\" : \"age\") => {\n    risks.push({id:JSON.stringify([row.base,row.material,kind]), base:row.base, material:row.material, category:row.category,\n      module, object:objectName(row), kind, level, quantity, evidence, action, role, priority,\n      cause:\"需业务确认；当前数据不足以判定形成原因。\",feedbackStatus:\"待反馈\",details:[]});\n  };\n  const pendingMap = new Map(pending.map(row => [key(row),row]));\n  const ageMap = new Map(age.map(row => [key(row),row]));\n  const stockMap = new Map(stock.map(row=>[key(row),row]));\n  for (const row of age) {\n    if (row.invalidQuantity) continue;\n    for (const [index,kind,level,action,priority] of [\n      [3,\"60天以上库存\",\"大日期候选\",\"建议复核生产日期与可用量，确认专项消化方式；尚未进行批次锁定。\",1],\n      [2,\"41–60天库存\",\"重点关注\",\"建议确认消化路径，优先复核近期订单和可适用的销售机会。\",2],\n      [1,\"31–40天库存\",\"关注\",\"建议关注正常出库节奏，及时复核货龄变化。\",3],\n    ] as const) {\n      const quantity = row.bands[index];\n      const shipment30 = stockMap.get(key(row))?.shipment30;\n      const isWeakMovement = shipment30 !== null && shipment30 !== undefined && quantity !== null && shipment30 <= quantity;\n      const meetsAgeFocus = index === 1 ? isWeakMovement : true;\n      if (quantity !== null && quantity > 1 && meetsAgeFocus) addRisk(row,kind,level,quantity,\n        `货龄快照中该区间库存${reportQuantity(quantity)}件。`,action,\"基地计划员 / 品类计划员\",priority);\n    }\n  }\n  for (const row of stock) {\n    if (row.inventory === null) continue;\n    const currentOrder = pendingMap.get(key(row));\n    if (row.target !== null && row.inventory < row.target && currentOrder?.shortage !== null && currentOrder?.shortage !== undefined && currentOrder.shortage > 0) {\n      addRisk(row,\"低于目标且当前缺货\",\"需复核\",currentOrder.shortage,\n        `库存${reportQuantity(row.inventory)}件，目标${reportQuantity(row.target)}件，当前测算缺货${reportQuantity(currentOrder.shortage)}件。`,\n        \"建议复核占用及可用库存，评估补货保障；不直接下发补货。\",\"基地计划 / 生产 / 供应\",0);\n    }\n  }\n  const shortageObjects=new Set(risks.filter(r=>r.module===\"shortage\").map(key));\n  for (const row of pending) {\n    if (row.shortage === null || row.shortage <= 0 || shortageObjects.has(key(row))) continue;\n    const object = stockMap.get(key(row)) ?? ageMap.get(key(row));\n    if (object) addRisk(object,\"当前订单缺货\",\"优先处理\",row.shortage,\n      `当前订单${reportQuantity(row.quantity)}件，按未备单完成需求、占用与可用库存测算缺货${reportQuantity(row.shortage)}件。`,\n      \"建议基地计划确认补产时间及可调拨库存；生产计划与在途数据尚未接入。\",\"基地计划 / 生产 / 供应\",0);\n  }\n  for (const row of stock) {\n    if(row.inventory!==null && row.target!==null && row.inventory>row.target && row.shipment30===0)\n      addRisk(row,\"高库存且近30日无动销\",\"重点关注\",row.inventory,\n        `库存${reportQuantity(row.inventory)}件，高于目标${reportQuantity(row.inventory-row.target)}件，近30日动销为0。`,\n        \"建议先确认客户拉货或活动消化，再由基地计划复核调剂与后续生产节奏。\",\"销售 / 基地计划\",2);\n    const currentOrder=pendingMap.get(key(row));\n    if(row.inventory!==null && row.target!==null && row.inventory>row.target && row.shipment30!==null && row.shipment30>0 && row.shipment30<row.inventory) {\n      const plan=row.demand===null?null:row.demand*30;\n      const kind=plan===null?\"低动销且需求计划待核验\":plan<row.inventory?\"低动销且需求计划不足\":\"低动销但需求计划覆盖\";\n      addRisk(row,kind,\"关注\",row.inventory,\n        `库存${reportQuantity(row.inventory)}件，近30日动销${reportQuantity(row.shipment30)}件；30日需求计划参考${reportQuantity(plan)}件（日均计划×30）。`,\n        plan===null?\"补齐需求计划，核对销售机会及生产节奏。\":plan<row.inventory?\"推动销售拉货、活动消化，并控制后续生产；先核对基地内可调剂量，再评估跨基地。\":\"跟踪需求计划转订单及客户拉货；未兑现前保留风险。\",\"销售 / 基地计划\",3,\"movement\");\n    }\n    if(pendingReady && (!currentOrder || currentOrder.shortage===0) && row.inventory!==null && row.target!==null && row.inventory<row.target && row.demand!==null && row.demand>0 && row.inventory<row.demand*7)\n      addRisk(row,\"潜在缺货：7日需求保障不足\",\"需关注\",row.target-row.inventory,\n        `库存${reportQuantity(row.inventory)}件，低于目标${reportQuantity(row.target-row.inventory)}件；7日需求计划参考${reportQuantity(row.demand*7)}件。当前无已核验订单缺口。`,\n        \"核对未来7日生产与到货计划，优先保障新增订单；不直接下发补货。\",\"基地计划 / 生产\",2,\"shortage\");\n  }\n  risks.sort((a,b) => a.priority-b.priority || b.quantity-a.quantity || a.id.localeCompare(b.id));\n  // Reserve examples for every risk type, but do not turn the daily report into\n  // a SKU list. The fixed board remains the complete-detail surface.\n  const kindCounts = new Map<string,number>();\n  const selectedRisks = risks.filter(row => {\n    const count = kindCounts.get(row.kind) ?? 0;\n    kindCounts.set(row.kind,count+1);\n    return count < 3;\n  }).slice(0,12);\n  selectedRisks.sort((a,b)=>a.priority-b.priority || b.quantity-a.quantity || a.id.localeCompare(b.id));\n  const focus=(module:ReportModuleId)=>{\n    const rows=risks.filter(r=>r.module===module), counts=new Map<string,number>();\n    const representative=rows.filter(r=>{const count=counts.get(r.kind)??0;counts.set(r.kind,count+1);return count<3;}).slice(0,8);\n    const ids=new Set(representative.map(r=>r.id));\n    return [...representative,...rows.filter(r=>!ids.has(r.id))].slice(0,8).sort((a,b)=>a.priority-b.priority||b.quantity-a.quantity);\n  };\n  const moduleRisks = new Map<ReportModuleId,ReportRisk[]>([\n    [\"age\",focus(\"age\")],\n    [\"shortage\",focus(\"shortage\")],\n    [\"movement\",focus(\"movement\")],\n    [\"quality\",[]],\n  ]);\n  const displayed=new Map([...selectedRisks,...[...moduleRisks.values()].flat()].map(r=>[r.id,r]));\n  for (const risk of input.includeAllRisks ? risks : displayed.values()) {\n    const s=stockMap.get(key(risk)), a=ageMap.get(key(risk)), p=pendingMap.get(key(risk));\n    const q=(value:number|null|undefined,unit=\"件\")=>value==null?\"—\":`${reportQuantity(value,unit===\"天\"?1:0)}${unit}`;\n    risk.details=[{label:\"品类\",value:risk.category||\"—\"},{label:\"SKU\",value:risk.material},\n      {label:\"当前库存\",value:q(s?.inventory??a?.inventory)},{label:\"目标库存\",value:q(s?.target)},\n      {label:\"库存差额\",value:q(s?.inventory!=null&&s.target!=null?s.inventory-s.target:null)},\n      {label:\"周转天数\",value:q(s?.inventory!=null&&s.demand!=null&&s.demand>0?s.inventory/s.demand:null,\"天\")},\n      {label:\"近30日动销\",value:q(s?.shipment30)},\n      {label:\"预计消化天数\",value:s?.shipment30===0?\"无动销，无法估算\":q(s?.inventory!=null&&s?.shipment30!=null&&s.shipment30>0?s.inventory/(s.shipment30/30):null,\"天\")},\n      {label:\"平均货龄\",value:q(a&&!a.invalidQuantity&&a.inventory!=null&&a.inventory>0&&a.weightedAge!=null&&a.bands[4]===0?a.weightedAge/a.inventory:null,\"天\")},\n      ...[\"0–30天\",\"31–40天\",\"41–60天\",\"60+天\"].map((label,i)=>({label,value:q(a&&!a.invalidQuantity?a.bands[i]:null)})),\n      {label:\"未来7日新增60+（不扣动销）\",value:q(a&&!a.invalidQuantity&&a.natural7!=null&&a.bands[3]!=null?Math.max(0,a.natural7-a.bands[3]):null)},\n      {label:\"未来14日新增60+（不扣动销）\",value:q(a&&!a.invalidQuantity&&a.natural14!=null&&a.bands[3]!=null?Math.max(0,a.natural14-a.bands[3]):null)},\n      {label:\"当前订单\",value:q(p?.quantity)},{label:\"缺货量\",value:q(p?.shortage)},{label:\"占用量\",value:q(p?.allocated)},\n      {label:\"影响订单数 / 预计补齐\",value:\"数据未接入\"}];\n  }\n  const latest = (values: string[]) => values.filter(Boolean).sort((a,b) => new Date(a).getTime()-new Date(b).getTime()).at(-1) ?? \"\";\n  const sourceDefs: [DailySource,string,string,boolean][] = [\n    [\"stock\",\"库存与目标\",latest(stock.map(row=>row.snapshot)),stock.length>0],\n    [\"age\",\"库存货龄\",latest(age.map(row=>row.snapshot)),age.length>0],\n    [\"pending\",\"当前订单\",input.pendingSnapshot,pendingReady],\n    [\"fulfillment\",\"当月履约\",latest(fulfillment.map(row=>row.snapshot)),fulfillment.length>0],\n  ];\n  const sources = sourceDefs.map(([source,label,snapshot,available]) => ({label,snapshot,\n    status:input.failedSources.includes(source)?\"读取失败，数据不足\":available?\"已读取\":\"无可见数据或未发布\"}));\n  const date = reportDate(input.generatedAt);\n  if (sources.some(source=>source.snapshot && reportDate(source.snapshot)!==date)) notes.push(\"部分来源不是今日快照。本报告使用最新可用数据，不能视为今日实时库存或订单。\");\n  for(const source of sources) if(source.status!==\"已读取\") notes.push(`${source.label}：${source.status}，相关指标和判断保留缺失。`);\n  const qualityIssues=[\n    input.failedSources.includes(\"pending\") ? \"当前订单读取失败，缺货暂不可判断\" : null,\n    shortage===null || missingShortageCount>0 ? \"部分订单占用或可用库存不足，整体缺货暂不可完整判断\" : null,\n    stock.length && current!==null && ageInventory!==null && Math.abs(current-ageInventory)>0.01 ? \"库存主表与货龄表范围不一致\" : null,\n    !input.targetVersion || (stock.length && missingTargetCount / stock.length >= 0.2) ? \"目标库存版本缺失或覆盖不足\" : null,\n    !age.length ? \"货龄来源无可见数据，货龄模块无法判断\" : !ageValid ? \"货龄数量无效\" : null,\n    (bandTotals[4]??0)>0 ? \"存在未知货龄，平均货龄无法判断\" : null,\n    ...sources.filter(s=>s.status!==\"已读取\").map(s=>`${s.label}：${s.status}`),\n  ].filter(Boolean) as string[];\n  const potential=risks.filter(r=>r.kind.startsWith(\"潜在缺货\"));\n  const movingRisks=risks.filter(r=>r.module===\"movement\");\n  const movementComparable=stock.filter(r=>r.inventory!==null&&r.target!==null&&r.shipment30!==null);\n  const movementPartial=movementComparable.length<stock.length;\n  const potentialReady=pendingReady&&stock.some(r=>r.target!==null&&r.inventory!==null&&r.demand!==null&&(!pendingMap.has(key(r))||pendingMap.get(key(r))?.shortage!==null));\n  const insufficient=movingRisks.filter(r=>{const row=stockMap.get(key(r));return row?.demand!==null && row?.demand!==undefined && row.inventory!==null && row.demand*30<row.inventory;});\n  const currentShortages=pending.filter(row=>row.shortage!==null&&row.shortage>0);\n  const stockWithShortage=currentShortages.filter(row=>{const s=stockMap.get(key(row));return s?.inventory!=null&&s?.target!=null&&s.inventory>s.target;});\n  const sumRisks=(rows:ReportRisk[])=>rows.reduce((sum,r)=>sum+r.quantity,0);\n  const unknownMetric=(label:string,note:string):ReportMetric=>({label,value:null,unit:\"\",note});\n  const moduleOverviews:Record<ReportModuleId,ReportModule[\"overview\"]>={\n    age:[{title:\"自然超龄预测\",metrics:[\n      {label:\"未来7日新增60+\",value:ageValid?total(age.map(r=>r.natural7!=null&&r.bands[3]!=null?Math.max(0,r.natural7-r.bands[3]):null)):null,unit:\"件\",note:\"不扣减动销\"},\n      {label:\"未来14日新增60+\",value:ageValid?total(age.map(r=>r.natural14!=null&&r.bands[3]!=null?Math.max(0,r.natural14-r.bands[3]):null)):null,unit:\"件\",note:\"不扣减动销\"}]}],\n    shortage:[{title:\"当前订单缺货\",metrics:[\n      {label:\"当前订单量\",value:order,unit:\"件\"},{label:\"订单SKU\",value:pendingReady?pending.filter(r=>(r.quantity??0)>0).length:null,unit:\"个\"},\n      unknownMetric(\"订单单数\",\"订单级明细未接入\"),\n      {label:missingShortageCount?\"已核验缺口（部分）\":\"订单缺口\",value:shortage,unit:\"件\"},{label:\"缺货SKU\",value:pendingReady?currentShortages.length:null,unit:\"个\",note:missingShortageCount?\"仅已核验对象\":undefined},\n      unknownMetric(\"影响订单单数\",\"缺口尚未分配至单笔订单\"),unknownMetric(\"7日生产覆盖\",\"生产排程未接入\")\n    ]},{title:\"潜在缺货（排除当前已缺货）\",metrics:[\n      {label:\"目标缺口\",value:potentialReady?sumRisks(potential):null,unit:\"件\",note:\"低于目标且不足覆盖7日需求；仅已核验对象\"},\n      {label:\"潜在风险SKU\",value:potentialReady?potential.length:null,unit:\"个\",note:\"仅已核验对象\"},unknownMetric(\"7日生产覆盖\",\"生产排程未接入\")]}],\n    movement:[{title:\"滞库概览\",metrics:[\n      {label:\"风险库存\",value:movementComparable.length?sumRisks(movingRisks):null,unit:\"件\",note:movementPartial?\"部分：缺库存、目标或动销的对象未判断\":undefined},\n      {label:\"风险SKU\",value:movementComparable.length?movingRisks.length:null,unit:\"个\"},\n      {label:\"30日低动销库存\",value:movementComparable.length?sumRisks(movingRisks):null,unit:\"件\",note:\"含零动销；库存高于目标且30日动销不足库存\"},\n      {label:\"30日低动销SKU\",value:movementComparable.length?movingRisks.length:null,unit:\"个\"},\n      {label:\"需求计划不足库存\",value:movementComparable.some(r=>r.demand!==null)?sumRisks(insufficient):null,unit:\"件\",note:\"日均需求计划×30，非生产排程；仅已核验对象\"},\n      {label:\"需求计划不足SKU\",value:movementComparable.some(r=>r.demand!==null)?insufficient.length:null,unit:\"个\"}]}],quality:[]\n  };\n  const moduleDefs: [ReportModuleId,string,string,string][] = [\n    [\"age\",\"货龄结构\",\"仅展示有明确处理价值的老龄或转风险对象；更多明细请查看固定看板。\",\n      bandTotals[3]===null ? \"今日动作：先补齐货龄来源，再确认消化顺序。\" : \"今日动作：先核对60+候选是否已进入专项，已在专项的跟踪进度；再落实41–60天消化和31–40天弱动销对象出库。结合7/14日自然转超龄量安排资源。专项建档台账未接入，暂不判断新增专项。\"],\n    [\"shortage\",\"缺货风险\",\"仅列已确认或可能影响交付的对象；库存低于目标本身不等于缺货。\",\n      `${shortage===null?\"当前订单缺口数据不足。\":`当前${missingShortageCount?\"已核验\":\"订单\"}缺口${reportQuantity(shortage)}件，优先确认交付及补货。`}${potentialReady?`已核验潜在风险${potential.length}个SKU，需核对生产与到货覆盖。`:\"潜在缺货依据不足，暂不可判断。\"}${stockWithShortage.length?`有${stockWithShortage.length}个SKU库存高于目标仍缺货，需核对可用量和占用，不宜只看库存总量。`:\"总库存较大不代表可用库存充足，应按SKU核对。\"}`],\n    [\"movement\",\"滞库风险\",\"按零动销、低动销且需求计划不足、低动销但计划覆盖区分建议；缺失动销不视为零。\",\n      movingRisks.length ? `已识别${movingRisks.length}个风险SKU。先核对基地仓与外仓可用量，再评估基地内调剂；推动销售拉货或活动消化，需求计划不足时复核生产节奏，计划覆盖时跟踪转订单。本地消化不足再评估跨基地，仓库及调拨证据需补充，尚不确定实际调拨量。` : \"当前可核验数据未识别滞库重点对象；缺目标、动销或需求计划的对象不能据此判定正常。\"],\n    [\"quality\",qualityIssues.length?\"数据说明与异常\":\"数据说明\",\"仅保留影响整体判断或核心模块可信度的异常；个别对象字段缺失在对应风险行标记待核验。\",\n      qualityIssues.length ? qualityIssues.join(\"；\") : \"当前已读取数据未识别影响日报判断的重点异常。\"],\n  ];\n  const modules=moduleDefs.map(([id,title,description,conclusion])=>({id,title,description,conclusion,overview:moduleOverviews[id],yesterday:id===\"age\"?\"昨日处理：暂无已读取的昨日处理反馈，无法确认消化进度。\":undefined,groups:bases.map(base=>({base,\n    risks:(moduleRisks.get(id)??[]).filter(r=>r.base===base)})).filter(group=>group.risks.length)}));\n  const coreMetrics:ReportMetric[]=[\n    {label:\"当前库存\",value:current,unit:\"件\",auxiliaries:[`${missingTargetCount?\"已知目标（部分）\":\"目标库存\"} ${reportQuantity(target)}件`,`库存差额${missingTargetCount?\"（部分）\":\"\"} ${reportQuantity(gap)}件`]},\n    {label:\"周转天数\",value:turnover,unit:\"天\",note:missingDemandCount?`部分：${missingDemandCount}个SKU缺日均计划`:undefined,auxiliaries:[`目标天数${missingTargetCount||missingDemandCount?\"（部分）\":\"\"} ${reportQuantity(targetTurnover,1)}天`,`天数差额 ${reportQuantity(turnover!==null&&targetTurnover!==null?turnover-targetTurnover:null,1)}天`]},\n    {label:\"当前货龄\",value:averageAge,unit:\"天\",auxiliaries:[`60+ SKU ${ageValid?age.filter(a=>!a.invalidQuantity&&(a.bands[3]??0)>0).length:\"—\"}个`,`60+库存 ${reportQuantity(bandTotals[3])}件`]},\n    {label:\"当月订单满足率\",value:fulfillmentRate===null?null:fulfillmentRate*100,unit:\"%\",note:\"工厂提货，排除饺鲜说；完成状态待确认\",auxiliaries:[`需求量 ${reportQuantity(need)}件`,`履约缺货 ${reportQuantity(unfilled)}件`]},\n    {label:\"当前订单\",value:order,unit:\"件\",auxiliaries:[shortage===null?\"缺货无法确认\":`${missingShortageCount?\"已核验缺货（部分）\":\"测算缺货\"} ${reportQuantity(shortage)}件`,`占用量 ${reportQuantity(allocated)}件`]},\n  ];\n  const compact=(v:number|null)=>v===null?\"待核验\":`${Math.abs(v)>=10000?`${reportQuantity(v/10000,1)}万`:reportQuantity(v)}件`;\n  const summary=[\n    `当前库存${compact(current)}，对${missingTargetCount?\"已知\":\"\"}目标差额${compact(gap)}${missingTargetCount?\"（部分）\":\"\"}；平均货龄${averageAge===null?\"待核验\":`${reportQuantity(averageAge,1)}天`}，41–60天${compact(bandTotals[2])}、60+ ${compact(bandTotals[3])}。${qualityIssues.length?\"关键数据不完整，相关判断待核验。\":\"库存高低需结合需求与货龄判断。\"}`,\n    `风险按当前订单缺货、货龄、滞库顺序复核：${shortage===null?\"订单缺口暂不可判断\":`${missingShortageCount?\"已核验\":\"当前\"}订单缺口${compact(shortage)}`}；货龄关注大日期候选及即将转超龄对象；${!movementComparable.length?\"滞库数据待核验\":`已核验滞库${movingRisks.length}个SKU`}，按动销及需求计划覆盖区分处理。`,\n    \"先核对订单交付和补货保障，再确认大日期专项进度及临期消化，最后推动滞库拉货、调剂与生产节奏调整。缺失依据先补齐，历史处理结果以有效反馈复核。\",\n  ];\n  const partial=qualityIssues.length>0 || missingTargetCount>0 || missingDemandCount>0 || missingMovementCount>0 || shortage===null || averageAge===null;\n  return {\n    coreMetrics,modules,qualityIssues,status:partial?\"部分生成\":\"已生成\",riskLevel:partial?\"数据待核验\":\"存在待复核事项\",visibleObjectKeys:[...allowed],\n    title:\"库存运营日报\",date,generatedAt:input.generatedAt,scope:input.localPreview?\"本地验证范围\":\"当前权限范围\",bases,\n    localPreview:input.localPreview,empty:current===null,summary,\n    metrics:[\n      {label:\"当前库存\",value:current,unit:\"件\",note:stock.length?\"目标库存主表口径\":\"货龄表口径\"},\n      {label:missingTargetCount?\"已知目标库存\":\"目标库存\",value:target,unit:\"件\",note:missingTargetCount?`${missingTargetCount}个对象缺目标`:input.targetVersion},\n      {label:missingTargetCount?\"库存差额（对已知目标）\":\"库存差额\",value:gap,unit:\"件\"},\n      {label:\"周转天数\",value:turnover,unit:\"天\",note:missingDemandCount?\"部分：库存÷已知日均计划量\":\"库存÷日均计划量\"},\n      {label:\"目标天数\",value:targetTurnover,unit:\"天\",note:missingTargetCount?\"按已知目标计算\":undefined},\n      {label:\"平均货龄\",value:averageAge,unit:\"天\",note:\"货龄表按库存量加权\"},\n      {label:\"当月订单满足率\",value:fulfillmentRate===null?null:fulfillmentRate*100,unit:\"%\",note:\"沿用履约口径，完成状态待确认\"},\n      {label:\"当前订单量\",value:order,unit:\"件\"},\n      {label:\"当前缺货量\",value:shortage,unit:\"件\",note:missingShortageCount?\"部分：仅已核验对象测算线索\":\"测算线索\"},\n      {label:\"当前占用量\",value:allocated,unit:\"件\"},\n      {label:missingMovementCount?\"已知近30日量\":\"近30日量\",value:knownTotal(stock.map(row=>row.shipment30)),unit:\"件\",note:\"基地/SKU粒度\"},\n    ],ageInventory,\n    ageBands:[\"0–30天（含30）\",\"31–40天\",\"41–60天\",\"60+天\",\"货龄未知\"].map((label,index)=>({\n      label,quantity:bandTotals[index],share:ageInventory!==null&&ageInventory>0&&bandTotals[index]!==null?bandTotals[index]!/ageInventory:null,\n      objects:age.filter(row=>!row.invalidQuantity&&(row.bands[index]??0)>0).sort((a,b)=>(b.bands[index]??0)-(a.bands[index]??0)).slice(0,2).map(objectName).join(\"；\")||\"—\",\n    })),risks:input.includeAllRisks?risks:selectedRisks,riskCount:risks.length,missingTargetCount,missingMovementCount,sources,notes,\n  };\n}\n\n/** A signed production session always uses GEA, even if the workbench is direct. */\nexport function dailyReportTransport(hasSession: boolean, config: {nodeEnv: string; workbenchMode: string; requireLaunch: boolean}): \"gea\" | \"direct\" | null {\n  if (hasSession) return \"gea\";\n  return config.nodeEnv !== \"production\" && !config.requireLaunch && config.workbenchMode === \"direct\" ? \"direct\" : null;\n}\n"}}}}
