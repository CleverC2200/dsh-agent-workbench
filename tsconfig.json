{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
