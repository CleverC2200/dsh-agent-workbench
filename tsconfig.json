{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "paths": {
      "@deepseek-ai/dsh-client-ui-chat/src/client/contract/slots.ts": [
        "../../official-latest-standard/packages/client/ui-chat/lib/types/client/contract/slots.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-chat/src/client/chat/MessageItem.tsx": [
        "../../official-latest-standard/packages/client/ui-chat/lib/types/client/chat/MessageItem.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-chat/src/client/chat/MessageIconActions.tsx": [
        "../../official-latest-standard/packages/client/ui-chat/lib/types/client/chat/MessageIconActions.d.ts"
      ],
      "dsh-agent-manage/inventory-compute/*": [
        "../dsh-agent-manage/src/inventory-compute/*.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
