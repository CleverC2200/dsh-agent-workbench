{
  "schema": "2.0",
  "config": {
    "update_multi": true,
    "wide_screen_mode": true
  },
  "header": {
    "template": "blue",
    "title": {
      "tag": "lark_md",
      "content": {
        "$if": "needsProcessing",
        "yes": "${mentions}订单待处理",
        "no": "${mentions}订单待确认"
      }
    }
  },
  "body": {
    "elements": [
      {
        "$each": "sections",
        "as": "section",
        "template": [
          {
            "$if": "section.separator",
            "yes": {
              "tag": "hr"
            }
          },
          {
            "tag": "div",
            "text": {
              "tag": "plain_text",
              "text_color": "red",
              "content": {
                "$concat": [
                  {
                    "$if": "section.rateKnown",
                    "yes": {
                      "$if": "section.ready",
                      "yes": "订单满足率达到90%，请确认是否开单？",
                      "no": "订单满足率未达到90%，请先处理缺货订单。"
                    },
                    "no": "订单满足率暂未完整提供，请核对后处理。"
                  },
                  {
                    "$each": "section.shortages",
                    "as": "shortage",
                    "template": "\nSKU：${shortage.sku} 原订单缺货：${shortage.quantity}"
                  },
                  {
                    "$if": "section.moreShortages",
                    "yes": "\n其余缺货商品请在“订单处理”中核对。"
                  }
                ]
              }
            }
          },
          {
            "tag": "column_set",
            "flex_mode": "stretch",
            "columns": [
              {
                "tag": "column",
                "width": "weighted",
                "weight": 4,
                "elements": [
                  {
                    "tag": "markdown",
                    "content": {
                      "$if": "section.hasDetails",
                      "yes": "订单号：[${section.orderNoMarkdown}](${section.detailsUrl})",
                      "no": "订单号：${section.orderNoMarkdown}"
                    }
                  },
                  {
                    "tag": "div",
                    "text": {
                      "tag": "plain_text",
                      "content": "客户：${section.customer}",
                      "text_color": "grey-700"
                    }
                  },
                  {
                    "tag": "div",
                    "text": {
                      "tag": "plain_text",
                      "content": "订单满足率：${section.rate}",
                      "text_color": "grey-700"
                    }
                  },
                  {
                    "tag": "div",
                    "text": {
                      "tag": "plain_text",
                      "content": "总数量：${section.quantity}",
                      "text_color": "grey-700"
                    }
                  }
                ]
              },
              {
                "tag": "column",
                "width": "weighted",
                "weight": 1,
                "elements": [
                  {
                    "$if": "section.pending",
                    "yes": [
                      {
                        "$if": "section.ready",
                        "yes": {
                          "tag": "button",
                          "type": "primary",
                          "text": {
                            "tag": "plain_text",
                            "content": "确认发货"
                          },
                          "behaviors": {
                            "$if": "section.hasConfirm",
                            "yes": [
                              {
                                "type": "open_url",
                                "default_url": "${section.ConfirmUrl}"
                              }
                            ]
                          },
                          "disabled": {
                            "$if": "section.hasConfirm",
                            "yes": false,
                            "no": true
                          },
                          "disabled_tips": {
                            "$if": "section.hasConfirm",
                            "no": {
                              "tag": "plain_text",
                              "content": "等待 GEA 提供当前订单的受控操作入口"
                            }
                          }
                        }
                      },
                      {
                        "tag": "button",
                        "type": "text",
                        "text": {
                          "tag": "plain_text",
                          "content": "暂缓发货"
                        },
                        "behaviors": {
                          "$if": "section.hasDefer",
                          "yes": [
                            {
                              "type": "open_url",
                              "default_url": "${section.DeferUrl}"
                            }
                          ]
                        },
                        "disabled": {
                          "$if": "section.hasDefer",
                          "yes": false,
                          "no": true
                        },
                        "disabled_tips": {
                          "$if": "section.hasDefer",
                          "no": {
                            "tag": "plain_text",
                            "content": "等待 GEA 提供当前订单的受控操作入口"
                          }
                        }
                      },
                      {
                        "$if": "section.ready",
                        "no": {
                          "tag": "button",
                          "type": "primary",
                          "text": {
                            "tag": "plain_text",
                            "content": "订单处理"
                          },
                          "behaviors": {
                            "$if": "section.hasEdit",
                            "yes": [
                              {
                                "type": "open_url",
                                "default_url": "${section.EditUrl}"
                              }
                            ]
                          },
                          "disabled": {
                            "$if": "section.hasEdit",
                            "yes": false,
                            "no": true
                          },
                          "disabled_tips": {
                            "$if": "section.hasEdit",
                            "no": {
                              "tag": "plain_text",
                              "content": "等待 GEA 提供当前订单的受控操作入口"
                            }
                          }
                        }
                      }
                    ],
                    "no": {
                      "tag": "markdown",
                      "content": {
                        "$if": "section.deferred",
                        "yes": "已暂缓",
                        "no": "已处理"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "$if": "preview",
        "yes": {
          "tag": "markdown",
          "content": "本地样例预览 · 不发货、不改单；延期及提交不保存。"
        }
      },
      {
        "$if": "pilot",
        "yes": {
          "tag": "markdown",
          "content": "试点验收 · 仅登记销售决定，不执行真实发货或改单"
        }
      },
      {
        "$if": "hasMore",
        "yes": {
          "tag": "markdown",
          "content": "另有 ${remaining} 笔记录，[查看全部 ${total} 笔](${allUrl})"
        }
      }
    ]
  }
}
