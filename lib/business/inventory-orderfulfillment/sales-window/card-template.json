{
  "schema": "2.0",
  "config": {
    "update_multi": true,
    "wide_screen_mode": true
  },
  "header": {
    "template": "blue",
    "title": {
      "tag": "lark_md",
      "content": "${mentions}订单待确认"
    }
  },
  "body": {
    "elements": [
      {
        "$each": "sections",
        "as": "section",
        "template": [
          {
            "$if": "section.separator",
            "yes": {
              "tag": "hr"
            }
          },
          {
            "tag": "div",
            "text": {
              "tag": "plain_text",
              "text_color": "red",
              "content": {
                "$if": "section.hasInstruction",
                "yes": "${section.instruction}",
                "no": {
                  "$concat": [
                    {
                      "$if": "section.rateKnown",
                      "yes": {
                        "$if": "section.ready",
                        "yes": "请核对订单信息并处理。",
                        "no": "请核对订单信息并处理。"
                      },
                      "no": "订单满足率暂未完整提供，请核对后处理。"
                    },
                    {
                      "$each": "section.shortages",
                      "as": "shortage",
                      "template": "\nSKU：${shortage.sku} 原订单缺货：${shortage.quantity}"
                    },
                    {
                      "$if": "section.moreShortages",
                      "yes": "\n其余缺货商品请在“订单处理”中核对。"
                    }
                  ]
                }
              }
            }
          },
          {
            "tag": "column_set",
            "flex_mode": "stretch",
            "columns": [
              {
                "tag": "column",
                "width": "weighted",
                "weight": 4,
                "elements": [
                  {
                    "tag": "markdown",
                    "content": {
                      "$if": "section.hasExecutionOrderNo",
                      "yes": {
                        "$if": "section.hasEntry",
                        "yes": "<font color='grey'>执行单号：[${section.executionOrderNo}](${section.entryUrl}%26view%3Ddetails)</font>",
                        "no": {
                          "$if": "section.hasDetails",
                          "yes": "<font color='grey'>执行单号：[${section.executionOrderNo}](${section.detailsUrl})</font>",
                          "no": "<font color='grey'>执行单号：${section.executionOrderNo}</font>"
                        }
                      },
                      "no": "<font color='grey'>执行单号：—</font>"
                    }
                  },
                  {
                    "tag": "markdown",
                    "content": {
                      "$if": "section.hasEntry",
                      "yes": "<font color='grey'>DMS订单号：[${section.orderNoMarkdown}](${section.entryUrl}%26view%3Ddetails)</font>",
                      "no": {
                        "$if": "section.hasDetails",
                        "yes": "<font color='grey'>DMS订单号：[${section.orderNoMarkdown}](${section.detailsUrl})</font>",
                        "no": "<font color='grey'>DMS订单号：${section.orderNoMarkdown}</font>"
                      }
                    }
                  },
                  {
                    "tag": "markdown",
                    "content": "<font color='grey'>客户：${section.customer}</font>"
                  },
                  {
                    "tag": "markdown",
                    "content": "<font color='grey'>订单满足率：${section.rate}</font>"
                  },
                  {
                    "tag": "markdown",
                    "content": "<font color='grey'>总数量：${section.quantity}</font>"
                  },
                  {
                    "tag": "markdown",
                    "content": "<font color='grey'>订单交货日期：${section.deliveryDate}</font>"
                  }
                ]
              },
              {
                "tag": "column",
                "width": "weighted",
                "weight": 1,
                "elements": [
                  {
                    "$if": "section.pending",
                    "yes": [
                      {
                        "$if": "section.creditInsufficient",
                        "yes": [
                          {
                            "tag": "button",
                            "type": "primary",
                            "text": {
                              "tag": "plain_text",
                              "content": "额度已补充"
                            },
                            "behaviors": {
                              "$if": "section.hasEntry",
                              "yes": [
                                {
                                  "type": "open_url",
                                  "default_url": "${section.entryUrl}%26view%3Dprocess"
                                }
                              ],
                              "no": {
                                "$if": "section.hasProcess",
                                "yes": [
                                  {
                                    "type": "open_url",
                                    "default_url": "${section.ProcessUrl}"
                                  }
                                ]
                              }
                            },
                            "disabled": {
                              "$if": "section.hasEntry",
                              "yes": false,
                              "no": {
                                "$if": "section.hasProcess",
                                "yes": false,
                                "no": true
                              }
                            },
                            "disabled_tips": {
                              "$if": "section.hasEntry",
                              "no": {
                                "$if": "section.hasProcess",
                                "no": {
                                  "tag": "plain_text",
                                  "content": "等待 GEA 提供当前订单的受控操作入口"
                                }
                              }
                            }
                          },
                          {
                            "tag": "markdown",
                            "content": "<font color='grey'>订单处理（额度待核验）</font>"
                          }
                        ],
                        "no": [
                          {
                            "tag": "button",
                            "type": "primary",
                            "text": {
                              "tag": "plain_text",
                              "content": "订单处理"
                            },
                            "behaviors": {
                              "$if": "section.hasEntry",
                              "yes": [
                                {
                                  "type": "open_url",
                                  "default_url": "${section.entryUrl}%26view%3Dprocess"
                                }
                              ],
                              "no": {
                                "$if": "section.hasProcess",
                                "yes": [
                                  {
                                    "type": "open_url",
                                    "default_url": "${section.ProcessUrl}"
                                  }
                                ]
                              }
                            },
                            "disabled": {
                              "$if": "section.hasEntry",
                              "yes": false,
                              "no": {
                                "$if": "section.hasProcess",
                                "yes": false,
                                "no": true
                              }
                            },
                            "disabled_tips": {
                              "$if": "section.hasEntry",
                              "no": {
                                "$if": "section.hasProcess",
                                "no": {
                                  "tag": "plain_text",
                                  "content": "等待 GEA 提供当前订单的受控操作入口"
                                }
                              }
                            }
                          },
                          {
                            "tag": "button",
                            "type": "text",
                            "text": {
                              "tag": "plain_text",
                              "content": "暂缓发货"
                            },
                            "behaviors": {
                              "$if": "section.hasEntry",
                              "yes": [
                                {
                                  "type": "open_url",
                                  "default_url": "${section.entryUrl}%26view%3Ddefer"
                                }
                              ],
                              "no": {
                                "$if": "section.hasDefer",
                                "yes": [
                                  {
                                    "type": "open_url",
                                    "default_url": "${section.DeferUrl}"
                                  }
                                ]
                              }
                            },
                            "disabled": {
                              "$if": "section.hasEntry",
                              "yes": false,
                              "no": {
                                "$if": "section.hasDefer",
                                "yes": false,
                                "no": true
                              }
                            },
                            "disabled_tips": {
                              "$if": "section.hasEntry",
                              "no": {
                                "$if": "section.hasDefer",
                                "no": {
                                  "tag": "plain_text",
                                  "content": "等待 GEA 提供当前订单的受控操作入口"
                                }
                              }
                            }
                          }
                        ]
                      }
                    ],
                    "no": {
                      "tag": "markdown",
                      "content": {
                        "$if": "section.deferred",
                        "yes": "<font color='grey'>已暂缓</font>",
                        "no": "<font color='grey'>已处理</font>"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "$if": "hasMore",
        "yes": {
          "tag": "markdown",
          "content": {
            "$if": "hasAllEntry",
            "yes": "另有 ${remaining} 笔记录，[查看全部 ${total} 笔](${allEntryUrl}%26view%3Dlist)",
            "no": "另有 ${remaining} 笔记录，[查看全部 ${total} 笔](${allUrl})"
          }
        }
      }
    ]
  }
}
